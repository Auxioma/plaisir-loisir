# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
# Expéditeur par défaut de tous les e-mails sortants. Sans en-tête « From »,
# Symfony refuse d'envoyer (« An email must have a From or a Sender header »).
MAILER_SENDER="TrouveMoi <no-reply@trouvemoi.eu>"
###< symfony/mailer ###

###> app/redis ###
# Redis (cache / sessions). Mêmes ports en local et sur le serveur (Guillaume).
# Client predis/predis installé (pas besoin d'extension PHP redis).
# NON utilisé tant que le cache n'est pas basculé sur Redis (voir config/packages/cache.yaml).
REDIS_URL=redis://localhost:6379
###< app/redis ###

###> app/search ###
# Adresse d'Elasticsearch (recherche). En dev, le conteneur Docker expose le port 9200.
ELASTICSEARCH_URL=http://127.0.0.1:9200
###< app/search ###

###> stripe ###
# Clés Stripe. Les VRAIES valeurs (de test) sont dans .env.local (non versionné).
# Ne jamais mettre de secret ici : ce fichier est committé.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Secret de signature du webhook (créé via la Stripe CLI ou le dashboard).
STRIPE_WEBHOOK_SECRET=
###< stripe ###

###> app/oauth ###
# Connexion par Google, Facebook et « Se connecter avec Apple ».
#
# LES VALEURS CI-DESSOUS SONT DES IDENTIFIANTS DE DÉMONSTRATION, en attendant
# ceux du CTO. Tout préfixe « test- » est reconnu comme tel (voir
# App\User\OAuth\OAuthCredentials) : le bouton correspondant reste inactif et la
# route affiche un message clair au lieu de mener à une erreur du fournisseur.
# Le code, lui, est complet — seules ces lignes changeront.
#
# Comme pour Stripe, les VRAIES valeurs iront dans .env.local, jamais ici :
# ce fichier est committé.
#
# Base des URL de retour. À déclarer AU CARACTÈRE PRÈS dans chaque console :
#   Google   : <base>/connexion/google/retour
#   Facebook : <base>/connexion/facebook/retour
#   Apple    : <base>/connexion/apple/retour
# En production : https://trouvemoi.eu
OAUTH_REDIRECT_BASE=http://127.0.0.1:8000

# Google — console.cloud.google.com, identifiant OAuth « Application Web ».
GOOGLE_OAUTH_CLIENT_ID=test-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=test-google-client-secret

# Facebook — developers.facebook.com, produit « Facebook Login ».
# L'application exige une URL de politique de confidentialité publiée.
FACEBOOK_OAUTH_CLIENT_ID=test-facebook-app-id
FACEBOOK_OAUTH_CLIENT_SECRET=test-facebook-app-secret

# Apple — developer.apple.com (programme payant, 99 $/an).
# APPLE_OAUTH_CLIENT_ID est l'identifiant de SERVICE, pas celui d'application.
# La clé privée est le fichier .p8 téléchargé une seule fois : le placer hors
# du dépôt et ne jamais le commiter.
APPLE_OAUTH_CLIENT_ID=test-apple-services-id
APPLE_OAUTH_TEAM_ID=test-apple-team-id
APPLE_OAUTH_KEY_ID=test-apple-key-id
APPLE_OAUTH_PRIVATE_KEY_PATH=test-apple-private-key-path
###< app/oauth ###
