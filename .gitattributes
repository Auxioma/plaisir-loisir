# Normalisation des fins de ligne : LF dans le dépôt pour tout le monde.
# Évite la divergence Windows (CRLF) / Linux CI (LF) et le bruit dans les diffs.
* text=auto eol=lf

# Sources et configuration : toujours LF
*.php   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.twig  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.neon  text eol=lf
*.css   text eol=lf
*.js    text eol=lf

# Scripts Windows : doivent rester en CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Fichiers binaires : ne jamais convertir
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.pdf  binary
