{#
    Étape 4 — Validation du paiement (maquette « Parcours du client —
    Paiement d'une réservation », 20/10) : rappel du moyen choisi, puis
    départ vers la page sécurisée de Stripe / PayPal (paiement versé sur le
    compte de l'organisateur) ou envoi de la demande (espèces sur place).
    Données : BookingController::review().
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Validation du paiement'|trans }}{% endblock %}

{% block body %}
{% set amount = booking.totalPrice|number_format(2, ',', ' ') ~ ' €' %}
{% set organizer = service.provider ? service.provider.displayName : 'l’organisateur'|trans %}
<main class="bk container">
    {% include 'booking/_steps.html.twig' with {current: 4} %}
    <h1 class="bk-title">{{ 'Confirmation de votre réservation'|trans }}</h1>

    <div class="bk-grid">
        <section class="bk-card">
            {% include 'booking/_recap.html.twig' %}
        </section>

        <aside class="bk-card bk-pay">
            <p class="bk-pay__lead">{{ 'Vous avez sélectionné :'|trans }}</p>
            <div class="bk-method is-static">
                {% if method == 'stripe' %}
                    <span class="bk-method__ico">{{ icon.card(20) }}</span>
                    <span class="bk-method__label">{{ 'Stripe CB'|trans }}</span>
                    <span class="bk-method__logos">{{ icon.pay_visa() }}{{ icon.pay_mastercard() }}</span>
                {% elseif method == 'paypal' %}
                    <span class="bk-method__label bk-method__label--paypal"><b>Pay</b><b>Pal</b></span>
                    <span class="bk-method__logos">{{ icon.pay_paypal() }}</span>
                {% else %}
                    <span class="bk-method__ico">{{ icon.banknote(20) }}</span>
                    <span class="bk-method__label">{{ payment_methods is empty ? 'Règlement à convenir avec l’organisateur'|trans : 'Paiement sur place « Espèces »'|trans }}</span>
                {% endif %}
            </div>

            <div class="bk-info">
                {{ icon.info(18) }}
                <p>
                    {%- if method == 'stripe' -%}
                        {{ 'Vous allez être redirigé vers la plateforme sécurisée de Stripe pour finaliser votre paiement de %amount%, versé directement à %organizer%.'|trans({'%amount%': amount, '%organizer%': organizer}) }}
                    {%- elseif method == 'paypal' -%}
                        {{ 'Vous allez être redirigé vers PayPal pour finaliser votre paiement de %amount%, versé directement à %organizer%.'|trans({'%amount%': amount, '%organizer%': organizer}) }}
                    {%- else -%}
                        {{ 'Votre demande sera envoyée à %organizer%, qui confirmera la réservation. Vous réglerez %amount% sur place, le jour de l’activité.'|trans({'%amount%': amount, '%organizer%': organizer}) }}
                    {%- endif -%}
                </p>
            </div>

            {# Pas de Turbo : la réponse redirige vers Stripe / PayPal (autre domaine, CORS). #}
            <form method="post" action="{{ path('app_booking_pay', {id: booking.id}) }}" data-turbo="false">
                <input type="hidden" name="_token" value="{{ csrf_token('booking') }}">
                <input type="hidden" name="moyen" value="{{ method }}">
                <button class="pl-btn pl-btn--primary pl-btn--block">{{ method == 'onsite' ? 'Envoyer ma demande de réservation'|trans : 'Confirmer la réservation'|trans }}</button>
            </form>
            <a class="bk-link" href="{{ path('app_booking_payment', {id: booking.id, moyen: method}) }}">{{ icon.arrow_left(14) }} {{ 'Changer de moyen de paiement'|trans }}</a>
        </aside>
    </div>
</main>
{% endblock %}
