{#
    Étape 5 — Paiement effectué / réservation confirmée, côté client —
    maquette reservation_confirmee_client (20/10), contenu seulement : la page
    vit dans l'espace compte (sidebar, en-tête et pied de page de la
    plateforme). Transaction, réservation, paiement, facture / reçu, QR à
    présenter le jour J, actions.

    Le client a payé l'organisateur directement (carte sur le compte Stripe de
    l'organisateur, PayPal), ou le réglera sur place.
    Données : BookingController::confirmation() (BookingPaymentPresenter).
#}
{% extends 'account/_layout.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Votre réservation'|trans }}{% endblock %}

{% block account %}
{% set side = 'client' %}
{% set online_pending = payment and payment.online and not paid and not cancelled %}
{% set sent = payment is not null and not online_pending %}
{% import '_partials/_ga.html.twig' as ga %}
{% set ga_items = [] %}
{% for it in booking.items %}{% set ga_items = ga_items|merge([{item_id: (service ? service.slug : 'activite'), item_name: (service ? service.title : it.label), item_variant: it.label, price: it.unitPrice + 0, quantity: it.quantity}]) %}{% endfor %}
{% if ga_items is empty and service %}{% set ga_items = [{item_id: service.slug, item_name: service.title, price: booking.totalPrice + 0, quantity: 1}] %}{% endif %}
{% if sent and not cancelled %}{{ ga.event('purchase', {transaction_id: booking.reference, currency: 'EUR', value: booking.totalPrice + 0, items: ga_items}, 'booking-' ~ booking.reference) }}{% endif %}

<div class="rg">
    {# Bandeau d'état (maquette : « Paiement effectué avec succès ! ») #}
    {% if cancelled %}
        <section class="rg-banner is-red">
            <span class="rg-banner__ico">{{ icon.x(30) }}</span>
            <div><h1>{{ 'Réservation annulée'|trans }}</h1><p>{{ 'Cette réservation a été annulée.'|trans }}{% if paid %} {{ 'Pour un remboursement, contactez le prestataire : le paiement lui a été versé directement.'|trans }}{% endif %}</p></div>
        </section>
    {% elseif paid %}
        <section class="rg-banner">
            <span class="rg-banner__ico">{{ icon.check(34) }}</span>
            <div>
                <h1>{{ payment.online ? 'Paiement effectué avec succès !'|trans : 'Règlement reçu par le prestataire !'|trans }}</h1>
                <p>{{ booking.status.value == 'pending' ? 'Votre paiement a bien été reçu ; le prestataire va confirmer votre réservation.'|trans : 'Votre paiement a bien été reçu et votre réservation est confirmée.'|trans }}</p>
            </div>
            <span class="rg-banner__spark" aria-hidden="true"></span>
        </section>
    {% elseif online_pending %}
        <section class="rg-banner is-orange">
            <span class="rg-banner__ico">{{ icon.clock(30) }}</span>
            <div><h1>{{ 'Paiement non finalisé'|trans }}</h1><p>{{ 'Aucun montant n’a été débité.'|trans }} <a href="{{ path('app_booking_payment', {id: booking.id}) }}">{{ 'Reprendre le paiement'|trans }}</a></p></div>
        </section>
    {% elseif booking.status.value == 'pending' and not sent %}
        <section class="rg-banner is-orange">
            <span class="rg-banner__ico">{{ icon.clock(30) }}</span>
            <div><h1>{{ 'Demande non envoyée'|trans }}</h1><p>{{ 'Votre demande n’a pas encore été transmise à l’organisateur.'|trans }} <a href="{{ path('app_booking_summary', {id: booking.id}) }}">{{ 'Reprendre ma réservation'|trans }}</a></p></div>
        </section>
    {% elseif booking.status.value == 'pending' %}
        <section class="rg-banner is-orange">
            <span class="rg-banner__ico">{{ icon.send(28) }}</span>
            <div><h1>{{ 'Demande envoyée à l’organisateur'|trans }}</h1><p>{{ 'L’organisateur va confirmer votre réservation : vous serez prévenu par notification et par e-mail. Vous le réglerez sur place.'|trans }}</p></div>
        </section>
    {% else %}
        <section class="rg-banner">
            <span class="rg-banner__ico">{{ icon.check(34) }}</span>
            <div><h1>{{ 'Réservation confirmée !'|trans }}</h1><p>{{ 'Votre réservation est confirmée. Vous réglerez le prestataire sur place, le jour de l’activité.'|trans }}</p></div>
            <span class="rg-banner__spark" aria-hidden="true"></span>
        </section>
    {% endif %}

    <div class="rg-grid">
        {% include 'payment/_transaction_card.html.twig' %}
        {% include 'payment/_reservation_card.html.twig' %}

        <div class="rg-col">
            <section class="pf-card rg-card">
                <h2 class="rg-card__title"><span class="rg-card__ico">{{ icon.euro(20) }}</span>{{ 'Détail du paiement'|trans }}</h2>
                <dl class="rg-rows">
                    <div class="is-strong"><dt>{{ paid ? 'Montant total payé'|trans : 'Montant à régler'|trans }}</dt><dd>{{ booking.totalPrice|number_format(2, ',', ' ') }} €</dd></div>
                    <div><dt>{{ 'Mode de paiement'|trans }}</dt><dd>{{ method_label|trans }}</dd></div>
                    {% if card_label %}<div><dt>{{ 'Carte utilisée'|trans }}</dt><dd>{{ card_label }}</dd></div>{% endif %}
                    <div><dt>{{ 'Facture / reçu'|trans }}</dt><dd>{% if paid %}<a class="rg-status is-green" href="{{ path('app_booking_invoice', {id: booking.id}) }}" target="_blank" rel="noopener">{{ icon.file_text(14) }} {{ 'Disponible'|trans }}</a>{% else %}<span class="pf-muted">{{ 'Après règlement'|trans }}</span>{% endif %}</dd></div>
                </dl>
                {% if not paid and not cancelled and payment_instructions %}<p class="rg-note">{{ icon.info(14) }} {{ payment_instructions|nl2br }}</p>{% endif %}
            </section>

            {% if qr %}{% include 'payment/_qr_card.html.twig' %}{% endif %}
        </div>

        <section class="pf-card rg-card">
            <div class="rg-card__head">
                <h2 class="rg-card__title"><span class="rg-card__ico">{{ icon.file_text(20) }}</span>{{ 'Facture / Reçu'|trans }}</h2>
                {% if paid %}<span class="rg-status is-green">{{ icon.check(14) }} {{ 'Facture disponible'|trans }}</span>{% endif %}
            </div>
            {% if paid %}
                {% include 'payment/_invoice_preview.html.twig' with {download_url: path('app_booking_invoice', {id: booking.id, telecharger: 1})} %}
            {% else %}
                <p class="pf-muted">{{ 'La facture sera disponible ici dès que votre règlement aura été reçu par le prestataire.'|trans }}</p>
            {% endif %}
        </section>
    </div>

    <section class="pf-card rg-actions">
        <h2 class="rg-card__title"><span class="rg-card__ico">{{ icon.gear(20) }}</span>{{ 'Actions'|trans }}</h2>
        <div class="rg-actions__list">
            {% if paid %}<a class="pf-btn pf-btn--primary" href="{{ path('app_booking_invoice', {id: booking.id, telecharger: 1}) }}">{{ icon.download(18) }} {{ 'Télécharger la facture'|trans }}</a>{% endif %}
            {% if qr %}<a class="pf-btn" href="{{ path('app_booking_qr', {id: booking.id}) }}">{{ icon.qr_code(18) }} {{ 'Télécharger le QR'|trans }}</a>{% endif %}
            <a class="pf-btn{{ not paid ? ' pf-btn--primary' }}" href="{{ path('app_account_history') }}">{{ icon.list_view(18) }} {{ 'Voir mes réservations'|trans }}</a>
            {% if provider and provider.slug and provider.status.value == 'verified' %}
                <form method="post" action="{{ path('app_account_messages_start', {slug: provider.slug}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                    <button class="pf-btn">{{ icon.chat_bubble(18) }} {{ 'Contacter le prestataire'|trans }}</button>
                </form>
            {% endif %}
        </div>
    </section>
</div>
{% endblock %}
