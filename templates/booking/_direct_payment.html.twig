{#
    Règlement direct au professionnel (17/10, demande du client) : TrouveMoi
    n'encaisse aucune prestation, le client paie le professionnel par les
    moyens que celui-ci propose (ProviderPaymentMethods::configured()).
    Variables : service, payment_methods, payment_instructions,
    details (afficher IBAN, liens… : après l'envoi de la demande).
#}
{% import '_partials/_icons.html.twig' as icon %}
{% set ico = {link: icon.card(18), paypal: icon.pay_paypal(), transfer: icon.building(18), onsite: icon.map_pin(18)} %}
{% if payment_methods is empty %}
    <p class="bk-note">{{ 'L’organisateur vous indiquera ses modalités de règlement lors de la confirmation.'|trans }}</p>
{% else %}
    <ul class="bk-paylist">
        {% for m in payment_methods %}
            <li>
                <span class="bk-paylist__ico">{{ ico[m.type] }}</span>
                <div>
                    <strong>{{ m.label|trans }}</strong>
                    {% if details %}
                        {% if m.type == 'link' %}
                            <a class="bk-link" href="{{ m.value }}" target="_blank" rel="noopener nofollow">{{ 'Payer l’organisateur en ligne'|trans }} {{ icon.arrow_up_right(14) }}</a>
                        {% elseif m.type == 'paypal' and 'paypal.me' in m.value %}
                            <a class="bk-link" href="{{ m.value starts with 'http' ? m.value : 'https://' ~ m.value }}" target="_blank" rel="noopener nofollow">{{ m.value }}</a>
                        {% else %}
                            <small>{{ m.value }}{% if m.detail %} · {{ 'Titulaire'|trans }} : {{ m.detail }}{% endif %}</small>
                        {% endif %}
                    {% elseif m.type == 'onsite' %}
                        <small>{{ m.value }}</small>
                    {% endif %}
                </div>
            </li>
        {% endfor %}
    </ul>
    {% if payment_instructions %}<p class="bk-note">{{ payment_instructions|nl2br }}</p>{% endif %}
{% endif %}
<p class="bk-note">{{ icon.info(14) }} {{ 'Vous réglez directement l’organisateur. TrouveMoi n’encaisse aucun paiement pour les activités et ne prélève aucune commission.'|trans }}</p>
