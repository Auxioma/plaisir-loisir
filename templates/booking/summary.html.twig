{#
    Récapitulatif avant l'envoi de la demande (tunnel de réservation, 03/10).
    Aucun paiement sur TrouveMoi (17/10) : le client règle l'organisateur.
    Données : BookingController::summary().
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Récapitulatif de votre réservation'|trans }}{% endblock %}

{% block body %}
{% import '_partials/_ga.html.twig' as ga %}
{% set ga_items = [] %}
{% for it in booking.items %}{% set ga_items = ga_items|merge([{item_id: (service ? service.slug : 'activite'), item_name: (service ? service.title : it.label), item_variant: it.label, price: it.unitPrice + 0, quantity: it.quantity}]) %}{% endfor %}
{% if ga_items is empty and service %}{% set ga_items = [{item_id: service.slug, item_name: service.title, price: booking.totalPrice + 0, quantity: 1}] %}{% endif %}
{{ ga.event('begin_checkout', {currency: 'EUR', value: booking.totalPrice + 0, items: ga_items}) }}
<main class="bk container">
    <ol class="bk-steps" aria-label="{{ 'Étapes'|trans }}">
        <li class="is-done">{{ 'Sélection'|trans }}</li>
        <li class="is-current" aria-current="step">{{ 'Récapitulatif'|trans }}</li>
        <li>{{ 'Demande envoyée'|trans }}</li>
        <li>{{ 'Confirmation'|trans }}</li>
    </ol>
    <h1 class="bk-title">{{ 'Récapitulatif de votre réservation'|trans }}</h1>

    <div class="bk-grid">
        <section class="bk-card">
            {% include 'booking/_recap.html.twig' %}
            <a class="bk-link" href="{{ path('app_activity_show', {slug: service.slug}) }}#reserver">{{ icon.arrow_left(14) }} {{ 'Modifier ma sélection'|trans }}</a>
        </section>

        <aside class="bk-card bk-pay">
            <h2>{{ 'Réservation et règlement'|trans }}</h2>
            <p>{{ 'Montant de la prestation'|trans }} : <strong>{{ booking.totalPrice|number_format(2, ',', ' ') }} €</strong>, {{ 'à régler directement à l’organisateur.'|trans }}</p>
            <form method="post" action="{{ path('app_booking_request', {id: booking.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('booking') }}">
                <button class="pl-btn pl-btn--primary pl-btn--block">{{ icon.send(18) }} {{ 'Envoyer ma demande de réservation'|trans }}</button>
            </form>
            {# Parcours expliqué (13/10, retour client n° 36 ; encaissement direct le 17/10). #}
            <ol class="bk-steps">
                <li>{{ 'Vous envoyez votre demande : rien n’est débité sur TrouveMoi.'|trans }}</li>
                <li>{{ 'L’organisateur confirme votre réservation : vous êtes prévenu par notification et par e-mail.'|trans }}</li>
                <li>{{ 'Vous réglez directement l’organisateur, par l’un des moyens qu’il propose :'|trans }}</li>
            </ol>
            {% include 'booking/_direct_payment.html.twig' with {details: false} %}
            <p class="bk-note">✓ {{ 'Annulation gratuite'|trans }} {{ "Jusqu'à 7 jours avant"|trans }}</p>
            <form method="post" action="{{ path('app_booking_abandon', {id: booking.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('booking') }}">
                <button class="bk-link bk-link--btn">{{ 'Abandonner cette réservation'|trans }}</button>
            </form>
        </aside>
    </div>
</main>
{% endblock %}
