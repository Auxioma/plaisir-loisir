{#
    Étape 2 — Récapitulatif de la réservation (maquette « Parcours du client
    — Paiement d'une réservation », 20/10) puis « Procéder au paiement ».
    Le client paiera le professionnel directement (17/10).
    Données : BookingController::summary().
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Récapitulatif de votre réservation'|trans }}{% endblock %}

{% block body %}
{% import '_partials/_ga.html.twig' as ga %}
{% set ga_items = [] %}
{% for it in booking.items %}{% set ga_items = ga_items|merge([{item_id: (service ? service.slug : 'activite'), item_name: (service ? service.title : it.label), item_variant: it.label, price: it.unitPrice + 0, quantity: it.quantity}]) %}{% endfor %}
{% if ga_items is empty and service %}{% set ga_items = [{item_id: service.slug, item_name: service.title, price: booking.totalPrice + 0, quantity: 1}] %}{% endif %}
{{ ga.event('begin_checkout', {currency: 'EUR', value: booking.totalPrice + 0, items: ga_items}) }}
<main class="bk container">
    {% include 'booking/_steps.html.twig' with {current: 2} %}
    <h1 class="bk-title">{{ 'Récapitulatif de votre réservation'|trans }}</h1>

    <div class="bk-grid">
        <section class="bk-card">
            {% include 'booking/_recap.html.twig' %}
            <a class="bk-link" href="{{ path('app_activity_show', {slug: service.slug}) }}#reserver">{{ icon.arrow_left(14) }} {{ 'Modifier ma sélection'|trans }}</a>
        </section>

        <aside class="bk-card bk-pay">
            <h2>{{ 'Votre réservation'|trans }}</h2>
            <dl class="bk-total">
                <dt>{{ 'Total'|trans }}</dt>
                <dd>{{ booking.totalPrice|number_format(2, ',', ' ') }} €</dd>
            </dl>
            <a class="pl-btn pl-btn--primary pl-btn--block" href="{{ path('app_booking_payment', {id: booking.id}) }}">{{ 'Procéder au paiement'|trans }}</a>
            <p class="bk-note">{{ icon.padlock(14) }} {{ 'Vous payez directement l’organisateur, par les moyens qu’il accepte : TrouveMoi n’encaisse aucun paiement et ne prélève aucune commission.'|trans }}</p>
            <p class="bk-note">✓ {{ 'Annulation gratuite'|trans }} {{ "Jusqu'à 7 jours avant"|trans }}</p>
            <form method="post" action="{{ path('app_booking_abandon', {id: booking.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('booking') }}">
                <button class="bk-link bk-link--btn">{{ 'Abandonner cette réservation'|trans }}</button>
            </form>
        </aside>
    </div>
</main>
{% endblock %}
