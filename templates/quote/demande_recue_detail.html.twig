{#
    Détail d'une demande côté professionnel : la description du client, et le
    formulaire de dépôt de devis (§10, §11 du CDC). QuoteService applique déjà
    les règles métier (demande close, doublon) ; l'écran affiche l'erreur
    qu'il renvoie le cas échéant. Rejoint la coquille account/_layout.html.twig
    le 14/09 (voir provider/tableau_de_bord.html.twig).
#}
{% extends 'account/_layout.html.twig' %}

{% block title %}{{ demande.title }}{% endblock %}

{% block account %}
    {% include 'account/_page_head.html.twig' with {
        crumbs: [{ label: 'Demandes reçues'|trans, href: path('app_pro_requests') }, { label: demande.title }],
        title: demande.title,
    } %}

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h1 class="h4 mb-2">{{ demande.title }}</h1>
            <p class="text-muted small mb-3">{{ demande.category.name }} — {{ demande.createdAt|date('d/m/Y') }}</p>
            <p class="mb-0">{{ demande.description|nl2br }}</p>
        </div>
    </div>

    {% if devis_existant %}
        <div class="alert alert-info">
            {{ 'Vous avez déjà proposé un devis de'|trans }}
            <strong>{{ devis_existant.amount|number_format(2, ',', ' ') }} {{ devis_existant.currency }}</strong>
            {{ 'pour cette demande.'|trans }}
            {% if devis_existant.status.value == 'accepted' %}
                {{ 'Il a été accepté par le client.'|trans }}
            {% elseif devis_existant.status.value == 'declined' %}
                {{ 'Il a été refusé par le client.'|trans }}
            {% else %}
                {{ 'Il est en attente de réponse.'|trans }}
            {% endif %}
        </div>
    {% elseif not demande.open %}
        <div class="alert alert-secondary">{{ 'Cette demande est clôturée : le client a déjà retenu un devis.'|trans }}</div>
    {% else %}
        <form method="post" class="card shadow-sm">
            <div class="card-body p-4">
                <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">

                <div class="mb-3">
                    <label class="form-label" for="montant">{{ 'Montant proposé (€)'|trans }}</label>
                    <input class="form-control" type="text" id="montant" name="montant" required
                           placeholder="{{ 'Ex. 450.00'|trans }}">
                </div>

                <div class="mb-4">
                    <label class="form-label" for="message">{{ 'Message au client (facultatif)'|trans }}</label>
                    <textarea class="form-control" id="message" name="message" rows="4"
                              placeholder="{{ 'Présentez votre proposition…'|trans }}"></textarea>
                </div>

                <button type="submit" class="btn pl-btn pl-btn--cta">{{ 'Envoyer mon devis'|trans }}</button>
            </div>
        </form>
    {% endif %}
{% endblock %}
