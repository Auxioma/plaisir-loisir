{#
    Liste des demandes de devis postées par le client (§10, §11 du CDC).
    Aucune maquette : réutilise le gabarit de l'espace compte (en-tête,
    sidebar) et une liste Bootstrap plutôt qu'une reconstitution au pixel.
#}
{% extends 'account/_layout.html.twig' %}

{% block title %}{{ 'Mes demandes'|trans }}{% endblock %}

{% block account %}
    {% include 'account/_page_head.html.twig' with {
        crumbs: [{ label: 'Mes demandes'|trans }],
        title: 'Mes demandes'|trans,
        subtitle: 'Suivez les devis reçus des professionnels.'|trans,
    } %}

    <div class="mb-4">
        <a href="{{ path('app_account_requests_new') }}" class="btn pl-btn pl-btn--cta">
            {{ 'Poser une nouvelle demande'|trans }}
        </a>
    </div>

    {% if requests is empty %}
        {% include 'account/_empty.html.twig' with { message: "Vous n'avez posté aucune demande pour le moment."|trans } %}
    {% else %}
        <div class="list-group">
            {% for demande in requests %}
                <a href="{{ path('app_account_requests_show', {id: demande.id}) }}"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <div>
                        <strong>{{ demande.title }}</strong>
                        <div class="text-muted small">{{ demande.category.name }} — {{ demande.createdAt|date('d/m/Y') }}</div>
                    </div>
                    <div class="text-end">
                        <span class="badge rounded-pill {{ demande.open ? 'text-bg-success' : 'text-bg-secondary' }}">
                            {{ demande.open ? 'Ouverte'|trans : 'Clôturée'|trans }}
                        </span>
                        <div class="text-muted small mt-1">
                            {{ demande.quotes|length }} {{ demande.quotes|length > 1 ? 'devis reçus'|trans : 'devis reçu'|trans }}
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
