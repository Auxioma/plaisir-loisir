{#
    Détail d'une demande côté client (§10, §11 du CDC), refait le 05/10 :
    récapitulatif, devis comparés (du moins cher au plus cher, l'accepté en
    tête) avec la note et les activités du professionnel, accepter /
    refuser / contacter, clôture de la demande, avis après acceptation.
    QuoteService::accept() refuse déjà automatiquement les autres devis et
    clôture la demande — l'écran ne fait qu'appeler le service.

    Note en étoiles (widget CSS pur, voir account.css) : un avis se donne en
    étoiles partout ailleurs sur le site.
#}
{% extends 'account/_layout.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ demande.title }}{% endblock %}

{% block account %}
    <header class="pf-head">
        <div>
            <a class="pf-link" href="{{ path('app_account_requests') }}">{{ icon.arrow_left(14) }} {{ 'Mes demandes'|trans }}</a>
            <h1 class="pf-title">{{ demande.title }}</h1>
            <p class="pf-sub">
                {% if demande.open %}<span class="pf-pill pf-pill--green">{{ 'Ouverte aux propositions'|trans }}</span>{% else %}<span class="pf-pill pf-pill--grey">{{ 'Clôturée'|trans }}</span>{% endif %}
                · {{ 'publiée le'|trans }} {{ demande.createdAt|date('d/m/Y') }}
            </p>
        </div>
        {% if demande.open %}
            <form method="post" action="{{ path('app_account_requests_close', {id: demande.id}) }}" onsubmit="return confirm('{{ 'Clôturer cette demande ? Les devis en attente seront refusés.'|trans|e('js') }}')">
                <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                <button class="pf-btn">{{ icon.x(14) }} {{ 'Clôturer la demande'|trans }}</button>
            </form>
        {% endif %}
    </header>

    <section class="pf-card rq-summary">
        <ul class="rq-facts">
            {% if demande.category %}<li>{{ icon.grid(16) }} <span><small>{{ 'Catégorie'|trans }}</small>{{ demande.category.name|trans }}</span></li>{% endif %}
            {% if demande.city %}<li>{{ icon.map_pin(16) }} <span><small>{{ 'Lieu'|trans }}</small>{{ demande.city }}</span></li>{% endif %}
            {% if demande.desiredDate %}<li>{{ icon.calendar(16) }} <span><small>{{ 'Date souhaitée'|trans }}</small>{{ demande.desiredDate|pf_date('EEEE d MMMM y')|capitalize }}</span></li>{% endif %}
            {% if demande.participants %}<li>{{ icon.users(16) }} <span><small>{{ 'Personnes'|trans }}</small>{{ demande.participants }}</span></li>{% endif %}
            {% if demande.budget %}<li>{{ icon.euro(16) }} <span><small>{{ 'Budget indicatif'|trans }}</small>{{ (demande.budget + 0)|number_format(0, ',', ' ') }} €</span></li>{% endif %}
        </ul>
        <p class="rq-summary__text">{{ demande.description|nl2br }}</p>
    </section>

    <h2 class="rq-h2">{{ quotes|length }} {{ quotes|length > 1 ? 'devis reçus'|trans : 'devis reçu'|trans }}</h2>

    {% if quotes is empty %}
        <div class="pf-card pf-empty rq-empty">
            {{ icon.hourglass(32) }}
            <strong>{{ 'Aucun professionnel n’a encore répondu.'|trans }}</strong>
            <span>{{ 'Les professionnels concernés ont été prévenus ; vous recevrez une notification à chaque devis.'|trans }}</span>
            {% if demande.category %}<a class="pf-btn" href="{{ path('app_provider_search', {metier: demande.category.slug}) }}">{{ 'Voir les professionnels de cette catégorie'|trans }}</a>{% endif %}
        </div>
    {% else %}
        <div class="rq-quotes">
            {% for devis in quotes %}
                {% set p = providers[devis.id ~ ''] ?? null %}
                <article class="pf-card rq-quote{{ devis.status.value == 'accepted' ? ' is-accepted' : (devis.status.value == 'declined' ? ' is-declined') }}">
                    <div class="rq-quote__head">
                        <span class="pd-avatar">{% if p and p.avatar %}<img src="{{ asset(p.avatar) }}" alt="">{% else %}{{ devis.provider.displayName|first|upper }}{% endif %}</span>
                        <span class="rq-quote__who">
                            <a href="{{ path('app_provider_profile', {slug: devis.provider.slug}) }}"><strong>{{ devis.provider.displayName }}</strong></a>
                            <small>
                                {% if p and p.rating %}{{ icon.star_solid(12) }} {{ p.rating|number_format(1, ',') }} ({{ p.reviews }} {{ 'avis'|trans }}) · {% endif %}
                                {% if p %}{{ p.activities|length }} {{ p.activities|length > 1 ? 'activités'|trans : 'activité'|trans }}{% endif %}
                                {% if devis.provider.city %} · {{ devis.provider.city }}{% endif %}
                            </small>
                        </span>
                        <span class="rq-quote__amount">{{ (devis.amount + 0)|number_format(2, ',', ' ') }} <small>{{ devis.currency }}</small></span>
                    </div>
                    {% if devis.message %}<p class="rq-quote__msg">{{ devis.message|nl2br }}</p>{% endif %}
                    <div class="rq-quote__foot">
                        <span class="pf-pill pf-pill--{{ devis.status.value == 'accepted' ? 'green' : (devis.status.value == 'declined' ? 'grey' : 'orange') }}">{{ devis.status.value == 'accepted' ? 'Accepté'|trans : (devis.status.value == 'declined' ? 'Refusé'|trans : 'En attente de votre réponse'|trans) }}</span>
                        <span class="rq-quote__actions">
                            <form method="post" action="{{ path('app_account_messages_start', {slug: devis.provider.slug}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                                <button type="submit" class="pf-btn">{{ icon.chat_bubble(14) }} {{ 'Contacter'|trans }}</button>
                            </form>
                            {% if demande.open and devis.status.value == 'pending' %}
                                <form method="post" action="{{ path('app_account_requests_quote_decline', {id: demande.id, quoteId: devis.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                                    <button type="submit" class="pf-btn">{{ 'Refuser'|trans }}</button>
                                </form>
                                <form method="post" action="{{ path('app_account_requests_quote_accept', {id: demande.id, quoteId: devis.id}) }}" onsubmit="return confirm('{{ 'Accepter ce devis ? Les autres seront automatiquement refusés.'|trans|e('js') }}')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                                    <button type="submit" class="pf-btn pf-btn--primary">{{ icon.check(14) }} {{ 'Accepter'|trans }}</button>
                                </form>
                            {% endif %}
                        </span>
                    </div>
                    {% if devis.status.value == 'accepted' %}
                        <div class="rq-quote__review">
                            {% if (devis.id ~ '') in reviewed_quote_ids %}
                                <span class="pf-muted">{{ icon.check_badge(14) }} {{ 'Vous avez déjà noté ce professionnel. Merci !'|trans }}</span>
                            {% else %}
                                <form method="post" action="{{ path('app_account_quote_review', {id: devis.id}) }}" class="rq-review">
                                    <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                                    <strong>{{ 'Votre avis sur la prestation'|trans }}</strong>
                                    <span class="review-stars-input" role="radiogroup" aria-label="{{ 'Votre note'|trans }}">
                                        {% for i in [5, 4, 3, 2, 1] %}
                                            <input type="radio" id="note-{{ devis.id }}-{{ i }}" name="note" value="{{ i }}" required>
                                            <label for="note-{{ devis.id }}-{{ i }}" aria-label="{{ i }} {{ i > 1 ? 'étoiles'|trans : 'étoile'|trans }}">{{ icon.star_solid(22) }}</label>
                                        {% endfor %}
                                    </span>
                                    <input type="text" name="commentaire" maxlength="2000" placeholder="{{ 'Votre commentaire (facultatif)'|trans }}">
                                    <button type="submit" class="pf-btn pf-btn--primary">{{ 'Publier mon avis'|trans }}</button>
                                </form>
                            {% endif %}
                        </div>
                    {% endif %}
                </article>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
