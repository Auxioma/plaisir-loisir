{#
    Assistant « Créer un événement » — maquettes docs/maquettes/
    creation_evenements (étapes 1 à 8, 04/10). Données :
    EventWizardController::create(). Validation serveur à chaque étape
    (EventDraftService::validateStep), erreurs affichées sous les champs.
    Styles : assets/styles/event-wizard.css (.ew-*).
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Créer un événement'|trans }} — {{ steps[step - 1].title|trans }}{% endblock %}
{% block meta_description %}{{ 'Créez votre événement en 8 étapes : détails, date, lieu, catégorie, images, options, invitations et publication.'|trans }}{% endblock %}

{% macro err(errors, key) %}{% if errors[key] is defined %}<p class="ew-error" role="alert">{{ errors[key]|trans }}</p>{% endif %}{% endmacro %}

{% block body %}
<div class="ew">
    {# Boutons en haut ET en bas (retours client du 07/10). #}
{% set wizard_actions %}
                <button type="submit" name="action" value="draft" class="ew-btn ew-btn--ghost" formnovalidate>{{ 'Enregistrer en brouillon'|trans }}</button>
                {% if step > 1 %}
                    <button type="submit" name="action" value="prev" class="ew-btn ew-btn--ghost" formnovalidate>{{ 'Précédent'|trans }}</button>
                {% endif %}
                <button type="submit" name="action" value="next" class="ew-btn ew-btn--primary">{{ step == 8 ? 'Publier'|trans : 'Suivant'|trans }}</button>
{% endset %}
<form class="ew-form" method="post" action="{{ path('app_event_create', {etape: step}) }}" enctype="multipart/form-data" novalidate data-ew-form>
        <input type="hidden" name="_token" value="{{ csrf_token('event_wizard') }}">

        <header class="ew-head">
            <div>
                <h1 class="ew-head__title"><span class="ew-head__ico">{{ icon.calendar_grid(30) }}</span>{{ 'Créer un événement'|trans }}</h1>
                <p class="ew-head__sub">{{ 'Organisez facilement vos activités, sorties ou rencontres et invitez vos proches à participer.'|trans }}</p>
            </div>
            <div class="ew-head__actions">
                {{ wizard_actions }}
            </div>
        </header>

        {% if errors is not empty %}
            <div class="ew-alert" role="alert">{{ icon.info(18) }} {{ 'Certaines informations sont manquantes ou incorrectes : corrigez les champs signalés pour continuer.'|trans }}</div>
        {% endif %}

        <div class="ew-grid">
            <div class="ew-col">
                <nav class="ew-card ew-steps" aria-label="{{ 'Étapes de création'|trans }}">
                    {% for s in steps %}
                        {% set n = loop.index %}
                        {% set is_done = n in done and n != step %}
                        {% set reachable = is_done or n == step %}
                        {% if reachable and n != step %}
                            <a class="ew-step is-done" href="{{ path('app_event_create', {etape: n}) }}">
                        {% else %}
                            <span class="ew-step{{ n == step ? ' is-active' }}{{ is_done ? ' is-done' }}"{% if n == step %} aria-current="step"{% endif %}>
                        {% endif %}
                            <span class="ew-step__dot">{% if is_done %}{{ icon.check(14) }}{% else %}{{ n }}{% endif %}</span>
                            <span class="ew-step__text"><strong>{{ s.title|trans }}</strong><small>{{ s.subtitle|trans }}</small></span>
                        {% if reachable and n != step %}</a>{% else %}</span>{% endif %}
                    {% endfor %}
                </nav>
                <aside class="ew-card ew-help">
                    <span class="ew-help__art" aria-hidden="true">{{ icon.calendar_grid(56) }}</span>
                    <h2>{{ 'Besoin d’aide ?'|trans }}</h2>
                    <p>{{ 'Consultez notre guide pour créer un événement réussi.'|trans }}</p>
                    <a class="ew-btn ew-btn--outline" href="{{ path('app_event_guide') }}" target="_blank" rel="noopener">{{ 'Voir le guide'|trans }}</a>
                </aside>
            </div>

            <section class="ew-card ew-main">
                {% include 'event/wizard/step' ~ step ~ '.html.twig' %}
                <div class="aw-foot">{{ wizard_actions }}</div>
            </section>

            <div class="ew-col">
                {% include 'event/wizard/_preview.html.twig' %}
                <aside class="ew-card ew-advice">
                    <h2>{{ advice.title|trans }}</h2>
                    <ul>{% for item in advice.items %}<li>{{ icon.check_square(16) }} {{ item|trans }}</li>{% endfor %}</ul>
                </aside>
            </div>
        </div>
    </form>
</div>
{% endblock %}
