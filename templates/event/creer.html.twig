{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Créer un événement'|trans }} — {{ steps[step - 1].title }}{% endblock %}
{% block meta_description %}{{ 'Créez votre événement en 8 étapes : détails, date, lieu, catégorie, images, options, invitations et publication.'|trans }}{% endblock %}

{% block header %}
    {% include '_partials/navbar_events.html.twig' %}
{% endblock %}

{% block body %}
<div class="ev-page">
    <div class="container">

        <nav class="act-breadcrumb ev-breadcrumb" aria-label="{{ "Fil d'Ariane"|trans }}">
            <a href="{{ path('app_home') }}">{{ 'Accueil'|trans }}</a>
            <span aria-hidden="true">|</span>
            <a href="{{ path('app_event_create') }}">{{ 'Créer un événement'|trans }}</a>
            <span aria-hidden="true">|</span>
            <span aria-current="page">{{ steps[step - 1].title }}</span>
        </nav>

        {# Le formulaire enveloppe l'en-tete ET la grille : le bouton « Suivant »
           est en haut, les champs en dessous. `display: contents` fait qu'il ne
           cree aucune boite et ne s'interpose dans aucun agencement. #}
        <form class="ev-wizard__form" method="post" action="{{ path('app_event_create', { etape: step }) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">

        {# En-tête : H1 + sous-titre + actions contextuelles (spec layout). #}
        <div class="ev-head">
            <div>
                <h1 class="ev-head__title">{{ 'Créer un événement'|trans }}</h1>
                <p class="ev-head__subtitle">{{ 'Organisez facilement vos activités, sorties ou rencontres et invitez vos proches à participer.'|trans }}</p>
            </div>
            <div class="ev-head__actions">
                <button type="button" class="pl-btn ev-btn-ghost">{{ 'Enregistrer en brouillon'|trans }}</button>
                {# « Suivant » envoie l'etape : sans cela les huit ecrans se
                   suivaient sans rien enregistrer. « Precedent » reste un lien,
                   la saisie etant conservee d'une etape a l'autre. #}
                {% if step == 1 %}
                    <button type="submit" class="pl-btn pl-btn--primary">{{ "Publier l'événement"|trans }}</button>
                {% else %}
                    <a href="{{ path('app_event_create', { etape: step - 1 }) }}" class="pl-btn ev-btn-ghost">{{ 'Précédent'|trans }}</a>
                    <button type="submit" class="pl-btn pl-btn--primary">{{ 'Suivant'|trans }}</button>
                {% endif %}
            </div>
        </div>

        <div class="ev-grid">

            {# COL 1 : stepper + « Besoin d'aide ? ». #}
            <div class="ev-col ev-col--left">
                {% include 'event/_stepper.html.twig' with { steps: steps, step: step } %}

                <aside class="ev-card ev-help">
                    <img src="{{ asset('images/events/help-manual.jpg') }}" alt="">
                    <h2 class="ev-help__title">{{ "Besoin d'aide ?"|trans }}</h2>
                    <p class="ev-help__text">{{ 'Seulement sur invitation ou personnes invitées'|trans }}</p>
                    <button type="button" class="pl-btn pl-btn--outline-action">{{ 'Voir le guide'|trans }}</button>
                </aside>
            </div>

            {# COL 2 : le contenu de l'étape active. #}
            <div class="ev-card ev-main">
                {% include 'event/steps/step' ~ step ~ '.html.twig' %}
            </div>

            {# COL 3 : aperçu live + conseil contextuel. #}
            <div class="ev-col ev-col--right">
                {% include 'event/_preview.html.twig' with { preview_photo: preview_photo, preview_filled: preview_filled } %}

                <aside class="ev-card ev-advice">
                    <h2 class="ev-advice__title">{{ icon.bulb(18) }} {{ 'Conseil'|trans }}</h2>
                    {% if advice.intro %}
                        <p class="ev-advice__intro">{{ advice.intro }}</p>
                    {% endif %}
                    <ul class="ev-advice__list">
                        {% for item in advice.items %}
                            <li>{{ icon.check(15) }} <span>{{ item }}</span></li>
                        {% endfor %}
                    </ul>
                </aside>
            </div>

        </div>
        </form>
    </div>
</div>
{% endblock %}
