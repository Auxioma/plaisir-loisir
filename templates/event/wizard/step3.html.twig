{#
    Étape 3 — Lieu (maquette creation_evenement_3) : recherche d'adresse
    (Base Adresse Nationale, api-adresse.data.gouv.fr) et carte Leaflet ;
    les coordonnées alimentent la carte des événements.
#}
{% import 'event/wizard/_ui.html.twig' as ui %}
{% import '_partials/_icons.html.twig' as icon %}

<h2 class="ew-main__title">{{ '3. Lieu'|trans }}</h2>
<p class="ew-main__lead">{{ 'Indiquez où se déroulera votre événement.'|trans }}</p>

<h3 class="ew-main__label">{{ 'Type de lieu'|trans }}</h3>
<div class="ew-choices ew-choices--4" role="radiogroup" data-ew-loctype>
    {{ ui.choice('location_type', 'precise', draft.location_type, 'Lieu précis', 'Adresse exacte ou lieu spécifique', 'pin', 'ew-choice--stack') }}
    {{ ui.choice('location_type', 'approx', draft.location_type, 'Lieu approximatif', 'Indiquez une zone ou un quartier', 'footprints', 'ew-choice--stack') }}
    {{ ui.choice('location_type', 'online', draft.location_type, 'En ligne', 'Événement virtuel', 'monitor', 'ew-choice--stack') }}
    {{ ui.choice('location_type', 'tbd', draft.location_type, 'Lieu à définir', 'Précisé plus tard', 'link', 'ew-choice--stack') }}
</div>
{{ ui.err(errors, 'location_type') }}

<div data-ew-loc="precise approx"{{ draft.location_type not in ['precise', 'approx'] ? ' hidden' }}>
    <div class="ew-field{{ errors.address is defined ? ' has-error' }}">
        <label for="ew-address"><span data-ew-loclabel>{{ draft.location_type == 'approx' ? 'Zone ou quartier'|trans : 'Lieu exact'|trans }}</span> <em>*</em></label>
        <span class="ew-search">
            <input id="ew-address" name="address" value="{{ draft.address ?? '' }}" autocomplete="off" placeholder="{{ 'Recherchez une adresse ou un lieu…'|trans }}" data-ew-address data-ew-bind="place">
            {{ icon.search(18) }}
            <ul class="ew-suggest" data-ew-suggest hidden></ul>
        </span>
        <input type="hidden" name="city" value="{{ draft.city ?? '' }}" data-ew-city>
        <input type="hidden" name="postal_code" value="{{ draft.postal_code ?? '' }}" data-ew-postcode>
        <input type="hidden" name="lat" value="{{ draft.lat ?? '' }}" data-ew-lat>
        <input type="hidden" name="lng" value="{{ draft.lng ?? '' }}" data-ew-lng>
        {{ ui.err(errors, 'address') }}
    </div>
    <div class="ew-place" data-ew-place{{ not (draft.address ?? '') ? ' hidden' }}>
        <span class="ew-place__ico">{{ icon.map_pin(20) }}</span>
        <span><strong data-ew-place-name>{{ draft.address ?? '' }}</strong><small data-ew-place-city>{{ draft.postal_code ?? '' }} {{ draft.city ?? '' }}</small></span>
        <button type="button" data-ew-place-clear aria-label="{{ 'Effacer le lieu'|trans }}">{{ icon.x(16) }}</button>
    </div>
    <div class="ew-map" data-ew-map data-lat="{{ draft.lat ?? '' }}" data-lng="{{ draft.lng ?? '' }}"></div>
    <a class="ew-maplink" data-ew-gmaps href="https://www.google.com/maps/search/?api=1&query={{ (draft.address ?? '')|url_encode }}" target="_blank" rel="noopener"{{ not (draft.address ?? '') ? ' hidden' }}>{{ 'Voir sur Google Maps'|trans }} {{ icon.arrow_up_right(14) }}</a>
</div>

<div class="ew-field{{ errors.online_url is defined ? ' has-error' }}" data-ew-loc="online"{{ draft.location_type != 'online' ? ' hidden' }}>
    <label for="ew-online">{{ 'Lien de connexion'|trans }} <em>*</em></label>
    <input id="ew-online" type="url" name="online_url" value="{{ draft.online_url ?? '' }}" placeholder="https://meet.example.com/…">
    {{ ui.err(errors, 'online_url') }}
</div>
<p class="ew-tip" data-ew-loc="tbd"{{ draft.location_type != 'tbd' ? ' hidden' }}>{{ icon.info(16) }} <span>{{ 'Vous pourrez préciser le lieu plus tard ; les participants seront prévenus.'|trans }}</span></p>

<h3 class="ew-main__label">{{ 'Informations complémentaires'|trans }}</h3>
<div class="ew-row">
    <div class="ew-field{{ errors.instructions is defined ? ' has-error' }}">
        <label for="ew-instructions">{{ 'Instructions ou précisions pour s’y rendre'|trans }}</label>
        <span class="ew-textarea"><textarea id="ew-instructions" name="instructions" rows="3" maxlength="200" placeholder="{{ 'Ex : Entrée principale côté boulevard des Belges…'|trans }}" data-ew-count>{{ draft.instructions ?? '' }}</textarea><small class="ew-count"><b>{{ (draft.instructions ?? '')|length }}</b>/200</small></span>
        {{ ui.err(errors, 'instructions') }}
    </div>
    <div class="ew-field{{ errors.meeting_point is defined ? ' has-error' }}">
        <label for="ew-meeting">{{ 'Point de rendez-vous'|trans }} ({{ 'optionnel'|trans }})</label>
        <span class="ew-textarea"><textarea id="ew-meeting" name="meeting_point" rows="3" maxlength="200" placeholder="{{ 'Ex : Devant la fontaine principale à 14h45…'|trans }}" data-ew-count>{{ draft.meeting_point ?? '' }}</textarea><small class="ew-count"><b>{{ (draft.meeting_point ?? '')|length }}</b>/200</small></span>
        {{ ui.err(errors, 'meeting_point') }}
    </div>
</div>
