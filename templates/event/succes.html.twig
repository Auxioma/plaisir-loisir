{#
    Confirmation de création d'un événement. Données :
    EventWizardController::success() (event).
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ event.status == 'draft' ? 'Brouillon enregistré'|trans : 'Événement créé avec succès'|trans }}{% endblock %}

{% block body %}
<div class="ev-success">
    <h1 class="ev-success__title">
        {% if event.status == 'draft' %}{{ 'Brouillon enregistré'|trans }}
        {% elseif event.status == 'scheduled' %}{{ 'Publication programmée'|trans }}
        {% else %}{{ 'Événement créé avec succès'|trans }}{% endif %}
    </h1>
    <img class="ev-success__badge" src="{{ asset('images/events/success-badge.jpg') }}" alt="">
    <p class="ev-success__text">
        {% if event.status == 'draft' %}{{ 'Votre événement est enregistré en brouillon : reprenez-le quand vous voulez depuis « Mes événements ».'|trans }}
        {% elseif event.status == 'scheduled' %}{{ '« %title% » sera publié le %date%.'|trans({'%title%': event.title, '%date%': event.publishAt|date('d/m/Y à H:i')}) }}
        {% else %}{{ "C'est officiel, votre événement « %title% » est en ligne !"|trans({'%title%': event.title}) }}<br>{{ 'Préparez-vous à passer un moment inoubliable !'|trans }}{% endif %}
    </p>
    <div class="ev-success__actions">
        {% if event.status == 'draft' %}
            <a href="{{ path('app_event_resume', {slug: event.slug}) }}" class="pl-btn pl-btn--primary">{{ 'Reprendre le brouillon'|trans }}</a>
        {% else %}
            <a href="{{ path('app_events_detail', {slug: event.slug}) }}" class="pl-btn ev-btn-ghost">{{ 'Voir votre événement'|trans }}</a>
            {# 07/10 : carton d'invitation avec QR code, lien privé et suivi des réponses. #}
            <a href="{{ path('app_events_invitation', {slug: event.slug}) }}" class="pl-btn pl-btn--primary">{{ 'Créer le carton d’invitation'|trans }} {{ icon.share(16) }}</a>
        {% endif %}
        <a href="{{ is_granted('ROLE_PROVIDER') ? path('app_pro_events') : path('app_account_events') }}" class="pl-btn ev-btn-ghost">{{ 'Mes événements'|trans }}</a>
    </div>
</div>
{% endblock %}
