{#
    Étape 3 — Nom du groupe : input unique. La maquette montre l'écran déjà
    rempli (Suivant actif) : on préremplit la valeur de démo en corrigeant
    ses coquilles (« Plaisisr & Loisisrs » → Plaisir & Loisirs, saisie
    utilisateur d'après la spec). Longueur max 60 caractères (spec).
#}
<h1 class="gw-title">{{ 'Nommez votre groupe'|trans }}</h1>

<div class="gw-field">
    <input id="gw-name" name="nom" class="gw-field__control" type="text" value="{{ draft.nom|default('Plaisir & Loisirs') }}"
           maxlength="60" aria-label="{{ 'Nom du groupe'|trans }}">
</div>
