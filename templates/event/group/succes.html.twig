{#
    Écran de succès du wizard « Créer un groupe ». Réutilise le composant
    succès partagé (badge vert « vérifié » des flows Événement et Cadeaux).
    Coquille maquette corrigée : « Votre groupe à été crée » → a été créé.
    Décision : le bouton Retour ramène au listing des groupes (revenir dans
    un wizard déjà soumis n'aurait pas de sens).
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}Groupe créé avec succès{% endblock %}
{% block meta_description %}Votre groupe a été créé : devenez organisateur et créez votre premier événement.{% endblock %}

{% block header %}
    {% include '_partials/navbar_events.html.twig' with { connected: true, nav_active: 'evenements' } %}
{% endblock %}

{% block body %}
<div class="gw-page">
    <div class="home-container">
        <a href="{{ path('app_groups') }}" class="gw-back">{{ icon.arrow_left(16) }} Retour</a>
    </div>

    <div class="ev-success gw-success">
        <h1 class="ev-success__title">Votre groupe a été créé</h1>
        {# Badge croppé de la maquette groupe (fond blanc, halo + ombre) —
           même visuel que le badge partagé des flows Événement/Cadeaux. #}
        <img class="ev-success__badge" src="{{ asset('images/groups/success-badge.png') }}" alt="">
        <p class="ev-success__text">Vous pouvez désormais devenir organisateur :<br>créez un événement aujourd'hui !</p>
        <div class="ev-success__actions">
            <a href="{{ path('app_event_create') }}" class="pl-btn pl-btn--primary">Créer un événement</a>
        </div>
    </div>
</div>
{% endblock %}
