{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Tous les groupes'|trans }}{% endblock %}
{% block meta_description %}{{ 'Tous les groupes et clubs de la communauté : fitness, nature, culture, jeux… rejoignez ceux qui partagent vos passions.'|trans }}{% endblock %}

{% block header %}
    {% include '_partials/navbar_events.html.twig' with { nav_active: 'groupes' } %}
{% endblock %}

{% block body %}
<div class="evn-page evn-listing">

    {# Écran E : listing groupes — pas de bannière, onglet Groupes actif.
       Typo corrigée : « Touts les groupes » → Tous les groupes. #}
    {% include 'event/nav/_listing_head.html.twig' with {
        crumb: 'Groupes'|trans,
        tabs_active: 'groupes',
        title: 'Tous les groupes'|trans,
        search_action: path('app_groups'),
        search_where: false,
        q: q,
        total: groups|length,
    } %}

    <section class="act-section">
        <div class="container">
            <div class="card-grid evn-grid evn-groups-grid">
                {% for g in groups %}
                    {% include 'event/nav/_group_card.html.twig' with { g: g } %}
                {% endfor %}
            </div>
            {% if groups is empty %}<p class="evn-empty__text">{{ 'Aucun groupe ne correspond à cette recherche.'|trans }}</p>{% endif %}
        </div>
    </section>

</div>
{% endblock %}
