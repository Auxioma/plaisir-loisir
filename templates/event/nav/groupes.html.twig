{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Tous les groupes'|trans }}{% endblock %}
{% block meta_description %}{{ 'Tous les groupes et clubs de la communauté : fitness, nature, culture, jeux… rejoignez ceux qui partagent vos passions.'|trans }}{% endblock %}

{% block header %}
    {% include '_partials/navbar_events.html.twig' with { connected: true, nav_active: 'groupes' } %}
{% endblock %}

{% block body %}
<div class="evn-page evn-listing">

    {# Écran E : listing groupes — pas de bannière, onglet Groupes actif.
       Typo corrigée : « Touts les groupes » → Tous les groupes. #}
    {% include 'event/nav/_listing_head.html.twig' with {
        crumb: 'Groupes'|trans,
        tabs_active: 'groupes',
        title: 'Tous les groupes'|trans,
        chips: [
            { icon: 'grid', label: 'Tous les groupes'|trans, active: true },
            { icon: 'person_plus', label: 'Nouveau groupe'|trans },
            { icon: 'wellness', label: 'Bien-être'|trans },
            { icon: 'culture', label: 'Culture & Découvertes'|trans },
            { icon: 'palette', label: 'Ateliers & Créations'|trans },
        ],
    } %}

    <section class="act-section">
        <div class="container">
            <div class="card-grid evn-grid evn-groups-grid">
                {% for g in groups %}
                    {% include 'event/nav/_group_card.html.twig' with { g: g, avatars: avatars } %}
                {% endfor %}
            </div>
            <div class="act-more">
                <button type="button" class="pl-btn pl-btn--outline-action">{{ 'Voir plus de groupes'|trans }} {{ icon.chevron_down(16) }}</button>
            </div>
        </div>
    </section>

</div>
{% endblock %}
