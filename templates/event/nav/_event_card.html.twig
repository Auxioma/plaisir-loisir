{#
    <EventCard> (spec §E1) : badge catégorie coloré, cœur, pastille date
    navy translucide en bas de l'image, titre, lieu (pin), horaire
    (horloge), participants + pile d'avatars. Pas de prix (événements
    communautaires). Variables : e (avatars, facultatif, n'est plus affiché).
#}
{% import '_partials/_icons.html.twig' as icon %}

<a href="{{ path('app_events_detail', { slug: e.slug }) }}" class="evn-card">
    <div class="evn-card__media">
        {# Un evenement cree par l'assistant n'a PAS de photo : l'etape de
           televersement n'est pas branchee. Sans ce garde-fou, `asset(null)`
           faisait tomber en erreur 500 les trois ecrans de listing des qu'un
           evenement etait cree — defaut trouve par les tests fonctionnels. #}
        <img src="{{ asset(e.image ?? 'images/events/ev-raft-clean.jpg') }}" alt="{{ e.title }}" loading="lazy" decoding="async">
        <span class="evn-badge evn-badge--{{ e.color }}">{{ e.category }}</span>
        {% include '_partials/_event_fav.html.twig' with { type: 'evenement', key: e.slug } %}
        <span class="evn-card__date">{{ e.date }}</span>
    </div>
    <div class="evn-card__body">
        <span class="evn-card__title">{{ e.title }}</span>
        <span class="evn-card__meta">{{ icon.map_pin(15) }} {{ e.location }}</span>
        <span class="evn-card__meta">{{ icon.clock(15) }} {{ e.hours }}</span>
        <span class="evn-card__foot">
            {# Nombre réel d'inscrits (13/10) : plus de photos de démonstration
               identiques sur toutes les cartes. #}
            <span class="evn-card__meta">{{ icon.person(15) }} {{ e.participants }} {{ (e.participants > 1 ? 'participants' : 'participant')|trans }}</span>
        </span>
    </div>
</a>
