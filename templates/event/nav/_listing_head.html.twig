{#
    En-tête commun des listings du flow navigation Événements : fil
    d'Ariane, bannière CTA, onglets Événements/Groupes, titre, recherche,
    pastilles de catégories, ligne résultats.

    Données réelles uniquement (06/11) : plus de lieu « Paris » pré-rempli,
    de texte « à Lille », de « 400+ résultats » ni de pastilles de maquette.

    Variables : crumb, banner_text/banner_cta/banner_href (optionnels),
    tabs_active (optionnel), title, intro (bool, défaut true),
    search_action (défaut : listing des événements), search_where (bool,
    champ « Où ? », défaut true), q / where (valeurs saisies),
    categories (liste {name, slug}, pastilles vers le listing filtré),
    total (nombre de résultats, optionnel), sort (libellé du tri appliqué).
#}
{% import '_partials/_icons.html.twig' as icon %}

<section class="act-head evn-head">
    <div class="container">
        <nav class="act-breadcrumb" aria-label="{{ "Fil d'Ariane"|trans }}">
            <a href="{{ path('app_home') }}">{{ 'Accueil'|trans }}</a>
            <span aria-hidden="true">|</span>
            <span aria-current="page" class="evn-crumb-current">{{ crumb }}</span>
        </nav>

        {% if banner_text is defined %}
            {% include 'event/nav/_banner.html.twig' with { text: banner_text, cta: banner_cta, cta_href: banner_href|default(null) } %}
        {% endif %}

        {% if tabs_active is defined %}
            {% include 'event/nav/_tabs.html.twig' with { active: tabs_active } %}
        {% endif %}

        <h1 class="act-head__title evn-title">{{ title }}</h1>
        {% if intro is defined ? intro : true %}
            <p class="act-head__subtitle">{{ 'Trouvez, rejoignez et partagez des moments uniques : événements entre membres partout en France.'|trans }}</p>
        {% endif %}

        <form class="act-search" role="search" action="{{ search_action|default(path('app_events')) }}" method="get">
            <div class="act-search__bar">
                {% if search_where is defined ? search_where : true %}
                    <label class="act-search__field">
                        {{ icon.map_pin(18) }}
                        <input type="text" name="ou" value="{{ where|default('') }}" placeholder="{{ 'Toute la France'|trans }}" aria-label="{{ 'Lieu'|trans }}">
                    </label>
                    <span class="act-search__sep" aria-hidden="true"></span>
                {% endif %}
                <label class="act-search__field">
                    {{ icon.search(18) }}
                    <input type="text" name="q" value="{{ q|default('') }}" placeholder="{{ 'Recherches par mots-clés'|trans }}" aria-label="{{ 'Mots-clés'|trans }}">
                </label>
            </div>
            <button type="submit" class="act-search__submit" aria-label="{{ 'Rechercher'|trans }}">{{ icon.search(20) }}</button>
        </form>

        {% if categories|default([]) is not empty %}
            <div class="act-chipbar evn-chipbar">
                <div class="act-chipbar__scroll">
                    <a class="act-chip is-active" href="{{ path('app_events') }}">{{ icon.grid(16) }} {{ 'Tous les événements'|trans }}</a>
                    {% for c in categories %}
                        <a class="act-chip" href="{{ path('app_events', { categorie: c.slug }) }}">{{ c.name }}</a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {% if total is defined or sort is defined %}
            <div class="act-results">
                {% if total is defined %}<p class="act-results__count"><strong>{{ total }}</strong> {{ (total > 1 ? 'résultats trouvés' : 'résultat trouvé')|trans }}</p>{% endif %}
                {% if sort is defined %}<p class="act-tool act-tool--plain">{{ icon.sort(16) }} {{ 'Trier par:'|trans }} <strong>{{ sort }}</strong></p>{% endif %}
            </div>
        {% endif %}
    </div>
</section>
