{#
    <GroupHeader> (spec §E4) : cover + colonne identité (titre, note,
    lieu, membres, partage) + barre d'onglets avec menu ⋮ et bouton
    « Demander à rejoindre le groupe » (grammaire corrigée : « la
    groupe » → le groupe). Variables : group (carte du groupe, voir
    GroupPresenter::card()), tab (onglet actif).

    17/09 : nom, lieu, membres et couverture viennent du groupe réellement
    consulté (auparavant figés sur « Cours collectifs de fitness à Lyon »,
    quel que soit le groupe cliqué). La note/avis (aucune entité derrière,
    voir apropos.html.twig) et le partage restent décoratifs.
#}
{% import '_partials/_icons.html.twig' as icon %}

<div class="evn-ghead">
    <img class="evn-ghead__cover" src="{{ asset(group.image ?? 'images/events/grp-fitness-cover.jpg') }}" alt="{{ group.name }}">
    <div class="evn-ghead__id">
        <h1 class="evn-ghead__title">{{ group.name }}</h1>
        <p class="evn-groupcard__rating evn-ghead__rating">
            <span class="evn-stars" aria-label="{{ '4,5 étoiles sur 5'|trans }}">
                {% for i in 1..5 %}<span class="{{ i <= 3 ? 'is-on' : 'is-off' }}">{{ icon.star(18) }}</span>{% endfor %}
            </span>
            <strong>4.5</strong>
            <span class="evn-dot" aria-hidden="true"></span>
            <a href="#">{{ '14 évaluations'|trans }}</a>
        </p>
        {% if group.location %}<p class="evn-ghead__meta">{{ icon.map_pin(17) }} {{ group.location }}</p>{% endif %}
        <p class="evn-ghead__meta">{{ icon.users(17) }} {{ group.members }} {{ 'membres'|trans }}</p>
        <p class="evn-ghead__share-label">{{ 'Partager'|trans }}</p>
        <div class="evn-ghead__share">
            <a href="#" aria-label="{{ 'Partager sur LinkedIn'|trans }}"><span class="evn-share-ic">in</span></a>
            <a href="#" aria-label="{{ 'Partager sur Facebook'|trans }}">{{ icon.facebook(17) }}</a>
            <a href="#" aria-label="{{ 'Partager sur X'|trans }}"><span class="evn-share-ic">𝕏</span></a>
        </div>
    </div>
</div>

<div class="evn-gtabs">
    <nav class="evn-gtabs__nav" aria-label="{{ 'Sections du groupe'|trans }}">
        {% for t in [
            { key: 'apropos', label: 'À propos'|trans },
            { key: 'evenements', label: 'Événements'|trans },
            { key: 'membres', label: 'Membres'|trans },
            { key: 'photos', label: 'Photos'|trans },
            { key: 'discussions', label: 'Discussions'|trans },
        ] %}
            <a href="{{ path('app_group_detail', { slug: group.slug, onglet: group_tab(t.key) }) }}" class="evn-gtab {{ tab == t.key ? 'is-active' }}" {{ tab == t.key ? 'aria-current="page"' }}>
                {%- if t.key == 'apropos' %}{{ icon.check_badge(22) }}
                {%- elseif t.key == 'evenements' %}{{ icon.calendar_check(22) }}
                {%- elseif t.key == 'membres' %}{{ icon.users(22) }}
                {%- elseif t.key == 'photos' %}{{ icon.image(22) }}
                {%- else %}{{ icon.comment(22) }}
                {%- endif %}
                <span>{{ t.label }}</span>
            </a>
        {% endfor %}
    </nav>
    <div class="evn-gtabs__actions">
        <button type="button" class="evn-dots" aria-label="{{ "Plus d'actions"|trans }}">{{ icon.dots(18) }}</button>
        <button type="button" class="pl-btn pl-btn--primary" data-bs-toggle="modal" data-bs-target="#evn-join">{{ 'Demander à rejoindre le groupe'|trans }}</button>
    </div>
</div>
