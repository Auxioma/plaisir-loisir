{#
    Section « Votre sélection D'événements » : carrousel de villes +
    cartes catégorie avec compteur d'événements (écrans B, H, I).
    Variables : selections (title, slug, count, image), cities (noms de
    villes) — calculées depuis les événements publics à venir (06/11).
#}
{% import '_partials/_icons.html.twig' as icon %}

{% if selections is not empty %}
<section class="act-section evn-selection">
    <div class="container">
        <h2 class="evn-section__title evn-selection__title">{{ "Votre sélection D'événements"|trans }}</h2>
        {% if cities is not empty %}
            <div class="act-citybar">
                <div class="act-citybar__scroll">
                    {% for city in cities %}
                        <a class="act-chip" href="{{ path('app_events', { ou: city }) }}">{{ city }}</a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
        <div class="card-grid evn-sel-grid">
            {% for s in selections %}
                <a href="{{ path('app_events', { categorie: s.slug }) }}" class="pl-card evn-sel-card">
                    <div class="pl-card__media"><img src="{{ image_url(s.image, 'card') }}" alt="{{ s.title }}" loading="lazy" decoding="async"></div>
                    <div class="pl-card__body">
                        <span class="pl-card__title">{{ s.title }}</span>
                        <span class="evn-sel-card__count">{{ icon.book_open(16) }} {{ s.count }} {{ (s.count > 1 ? 'événements' : 'événement')|trans }}</span>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}
