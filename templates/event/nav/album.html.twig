{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Week-end spa & bien-être — Photos du groupe'|trans }}{% endblock %}
{% block meta_description %}{{ "L'album photo Week-end spa & bien-être du groupe Cours collectifs de fitness à Lyon."|trans }}{% endblock %}

{% block header %}
    {% include '_partials/navbar_events.html.twig' with { connected: true, nav_active: 'groupes' } %}
{% endblock %}

{% block body %}
<div class="evn-page evn-group">
    <div class="home-container">

        <nav class="act-breadcrumb" aria-label="{{ "Fil d'Ariane"|trans }}">
            <a href="{{ path('app_home') }}">{{ 'Accueil'|trans }}</a>
            <span aria-hidden="true">/</span>
            <a href="{{ path('app_groups') }}">{{ 'Groupes'|trans }}</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page" class="evn-crumb-current">{{ 'Groupe détails'|trans }}</span>
        </nav>

        {% include 'event/nav/_group_header.html.twig' with { tab: 'photos' } %}

        {# Détail d'un album (capture 23). Typos corrigées : « Week-en » →
           Week-end, « Ouvrir l'événements » → l'événement. #}
        <section class="evn-gsection">
            <div class="evn-album-head">
                <a href="{{ path('app_group_detail', { onglet: 'photos' }) }}" class="evn-album-head__back" aria-label="{{ 'Retour aux albums'|trans }}">←</a>
                <h2 class="evn-gh2 evn-gh2--tab">{{ 'Week-end spa & bien-être'|trans }}</h2>
            </div>
            <div class="evn-album-head__meta">
                <span>{{ 'Mis à jour le 28 Juill. 2026'|trans }}</span>
                <a href="{{ path('app_events_detail') }}" class="evn-album-open">{{ "Ouvrir l'événement"|trans }} {{ icon.arrow_up_right(14) }}</a>
            </div>

            <div class="card-grid evn-grid evn-album-photos">
                {% for i in 1..5 %}
                    <img src="{{ asset('images/events/alb-spa2.jpg') }}" alt="Photo de l'album Week-end spa & bien-être">
                {% endfor %}
            </div>
        </section>

        <section class="evn-section evn-section--similar">
            <div class="evn-section__head">
                <h2 class="evn-section__title evn-section__title--lower">{{ 'événements similaires à proximité'|trans }}</h2>
                <a href="{{ path('app_events_all') }}" class="evn-btn-dark">{{ 'Tout voir'|trans }} {{ icon.arrow_up_right(15) }}</a>
            </div>
            <div class="card-grid evn-similar-grid">
                {% for g in similar %}
                    {% include 'event/nav/_group_card.html.twig' with { g: g, avatars: avatars } %}
                {% endfor %}
            </div>
        </section>

    </div>
</div>
{% endblock %}
