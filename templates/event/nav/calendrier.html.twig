{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Calendrier des événements'|trans }}{% endblock %}
{% block meta_description %}{{ 'Le calendrier de tous les événements communautaires : retrouvez les prochains rendez-vous mois par mois.'|trans }}{% endblock %}

{% block header %}
    {% include '_partials/navbar_events.html.twig' with { connected: true, nav_active: 'calendrier' } %}
{% endblock %}

{% block body %}
<div class="evn-page evn-listing">

    {% include 'event/nav/_listing_head.html.twig' with {
        crumb: 'Calendrier'|trans,
        banner_text: "Créez votre propre groupe et commencez à organiser des événements aujourd'hui !"|trans,
        banner_cta: 'Créer un groupe'|trans,
        banner_href: path('app_group_create'),
        tabs_active: 'evenements',
        title: 'Tous les événements'|trans,
        sort: 'Avenir'|trans,
        chips: [
            { icon: 'grid', label: 'Tous les événements'|trans, active: true },
            { icon: 'culture', label: 'Culture & Découverte'|trans },
            { icon: 'family', label: 'En famille'|trans },
            { icon: 'palette', label: 'Ateliers & Créations'|trans },
            { icon: 'wellness', label: 'Bien-être'|trans },
            { icon: 'culture', label: 'Culture & …'|trans },
        ],
    } %}

    {# La grille de cartes est remplacée par le calendrier mensuel (E3). #}
    <section class="act-section">
        <div class="home-container">
            {% include 'event/nav/_month_calendar.html.twig' with { calendar: calendar } %}
        </div>
    </section>

    {% include 'event/nav/_selection.html.twig' with { selections: selections, cities: cities } %}

</div>
{% endblock %}
