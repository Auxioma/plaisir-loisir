{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Participants — %title%'|trans({'%title%': event.title}) }}{% endblock %}
{% block meta_description %}{{ "La liste des participants de l'événement %title%."|trans({'%title%': event.title}) }}{% endblock %}

{% block header %}
    {% include '_partials/navbar_events.html.twig' with { nav_active: 'evenements' } %}
{% endblock %}

{% block body %}
<div class="evn-page evn-participants">
    <div class="container">

        <nav class="act-breadcrumb" aria-label="{{ "Fil d'Ariane"|trans }}">
            <a href="{{ path('app_home') }}">{{ 'Accueil'|trans }}</a>
            <span aria-hidden="true">|</span>
            <a href="{{ path('app_events') }}">{{ 'Événements'|trans }}</a>
            <span aria-hidden="true">|</span>
            <span aria-current="page" class="evn-crumb-current">{{ event.title }}</span>
        </nav>

        {# Colonne centrée, légèrement en retrait comme la maquette. #}
        <div class="evn-participants__col">
            <a href="{{ path('app_events_detail', { slug: event.slug }) }}" class="evn-back">← {{ 'Retour'|trans }}</a>

            <h1 class="evn-participants__title">{{ 'Participants'|trans }}</h1>
            <p class="evn-participants__subtitle">{{ event.title }}</p>

            <div class="evn-participants__tools">
                <label class="evn-input-search">
                    {{ icon.search(18) }}
                    <input type="search" placeholder="{{ 'Recherche des participants'|trans }}" aria-label="{{ 'Recherche des participants'|trans }}" data-evn-filter>
                </label>
                <label class="act-tool act-tool--plain evn-sort-right">{{ icon.sort(16) }} {{ 'Trier par:'|trans }}
                    <select data-evn-sort aria-label="{{ 'Trier'|trans }}">
                        <option value="date">{{ 'Date d’inscription'|trans }}</option>
                        <option value="name">{{ 'Nom'|trans }}</option>
                    </select>
                </label>
            </div>

            <span class="evn-chip-count">{{ icon.check(14) }} {{ going|length }} {{ going|length > 1 ? 'participants'|trans : 'participant'|trans }}</span>

            {% if hidden_list %}
                <p class="evn-muted">{{ 'L’organisateur a choisi de ne pas afficher la liste des participants.'|trans }}</p>
            {% else %}
                <div class="evn-plist" data-evn-plist>
                    {% for r in going %}
                        <div class="evn-prow" data-name="{{ (r.user.firstName ~ ' ' ~ r.user.lastName)|lower }}" data-order="{{ loop.index }}">
                            {% if r.user.avatarPath %}<img class="evn-prow__avatar" src="{{ asset(r.user.avatarPath) }}" alt="">{% else %}<span class="evn-prow__avatar evn-part__initials">{{ (r.user.firstName|first ~ r.user.lastName|first)|upper }}</span>{% endif %}
                            <span class="evn-prow__id">
                                <span class="evn-prow__name">{{ r.user.firstName }} {{ r.user.lastName|first }}.</span>
                                {% if r.user == entity.organizer %}<span class="evn-role-badge">{{ icon.crown(13) }} {{ 'Organisateur'|trans }}</span>{% endif %}
                            </span>
                            <small class="evn-muted">{{ 'Inscrit le'|trans }} {{ r.createdAt|date('d/m/Y') }}</small>
                        </div>
                    {% else %}
                        <p class="evn-muted">{{ 'Aucun participant pour le moment.'|trans }}</p>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

    </div>
</div>
{% endblock %}
