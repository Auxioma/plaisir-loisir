{#
    <JoinGroupModal> (spec §E7) : modale « Rejoindre ce groupe ».

    09/11 : les trois états de la maquette (dépôt d'une photo fictive, aperçu
    figé, avatar d'exemple) n'enregistraient rien. La modale montre désormais
    la photo de profil du compte et envoie la vraie demande d'adhésion ; un
    visiteur est invité à se connecter.
#}
{% import '_partials/_icons.html.twig' as icon %}

<div class="modal fade evn-modal" id="evn-join" tabindex="-1" aria-label="{{ 'Rejoindre ce groupe'|trans }}">
  <div class="modal-dialog">
    <div class="modal-content evn-modal__box">
        <button type="button" class="evn-modal__close" data-bs-dismiss="modal" aria-label="{{ 'Fermer'|trans }}">{{ icon.x(18) }}</button>

        <div class="evn-modal__step evn-join__final">
            <p class="evn-modal__title evn-modal__title--center">{{ 'Rejoindre ce groupe'|trans }}</p>
            {% if app.user %}
                <span class="evn-join__avatar">
                    <img src="{{ image_url(app.user.avatarPath ?? 'images/account/avatar-default.svg', 'avatar') }}" alt="" loading="lazy" decoding="async">
                </span>
                <p class="evn-join__terms">
                    {% if group.owner %}
                        {{ 'Votre demande sera transmise au créateur du groupe, qui vous répondra.'|trans }}
                    {% else %}
                        {{ 'Vous rejoindrez le groupe immédiatement.'|trans }}
                    {% endif %}
                    {{ 'Votre photo de profil se modifie depuis'|trans }} <a href="{{ path('app_account_profile') }}">{{ 'votre compte'|trans }}</a>.
                </p>
                <form method="post" action="{{ path('app_group_join', {slug: group.slug}) }}" class="evn-modal__foot evn-modal__foot--center">
                    <input type="hidden" name="_token" value="{{ csrf_token('group_join') }}">
                    <button class="pl-btn pl-btn--primary">{{ 'Rejoindre ce groupe'|trans }}</button>
                </form>
            {% else %}
                <p class="evn-join__terms">{{ 'Connectez-vous pour rejoindre ce groupe.'|trans }}</p>
                <div class="evn-modal__foot evn-modal__foot--center">
                    <a href="{{ path('app_login') }}" class="pl-btn pl-btn--primary">{{ 'Se connecter'|trans }}</a>
                </div>
            {% endif %}
        </div>
    </div>
  </div>
</div>
