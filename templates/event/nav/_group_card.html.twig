{#
    <GroupCard> (spec §E2) : pill note jaune 4.5 + « 142 avis », badge
    « Nouveau » optionnel, titre, description 2-3 lignes, lieu, membres +
    pile d'avatars. Variables : g, avatars, href (défaut : détail groupe).
#}
{% import '_partials/_icons.html.twig' as icon %}

<a href="{{ href|default(path('app_group_detail')) }}" class="evn-card evn-gcard">
    <div class="evn-card__media">
        {# Meme garde-fou que la carte d'evenement : un groupe cree par
           l'assistant n'a pas de photo, et `asset(null)` fait tomber la page. #}
        <img src="{{ asset(g.image ?? 'images/events/grp-nature.jpg') }}" alt="{{ g.name }}">
        {% if g.badge %}<span class="evn-badge evn-badge--new">{{ g.badge }}</span>{% endif %}
        <span class="evn-card__fav" aria-label="{{ 'Ajouter aux favoris'|trans }}">{{ icon.heart(16) }}</span>
    </div>
    <div class="evn-card__body">
        <span class="evn-gcard__rating"><span class="evn-rating-pill">{{ icon.star(13) }} 4.5</span> {{ '142 avis'|trans }}</span>
        <span class="evn-card__title">{{ g.name }}</span>
        <span class="evn-gcard__desc">{{ g.description|nl2br }}</span>
        <span class="evn-card__meta">{{ icon.map_pin(15) }} {{ g.location }}</span>
        <span class="evn-card__foot">
            <span class="evn-card__meta">{{ icon.person(15) }} {{ g.members }} {{ 'membres'|trans }}</span>
            <span class="evn-avatars">
                {% for a in avatars %}<img src="{{ asset(a) }}" alt="">{% endfor %}
            </span>
        </span>
    </div>
</a>
