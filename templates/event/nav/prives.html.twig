{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Événements privés'|trans }}{% endblock %}
{% block meta_description %}{{ 'Les événements privés de la communauté : rejoignez des moments uniques entre amis, en famille ou entre passionnés.'|trans }}{% endblock %}

{% block header %}
    {% include '_partials/navbar_events.html.twig' with { nav_active: 'prives' } %}
{% endblock %}

{% block body %}
<div class="evn-page evn-listing">

    {# Écran I : variante du listing B sans onglets ni paragraphe d'intro.
       Typo maquette corrigée : « Evénements privée » → Événements privés. #}
    {% include 'event/nav/_listing_head.html.twig' with {
        crumb: 'Événements'|trans,
        banner_text: "Créez votre propre groupe et commencez à organiser des événements aujourd'hui !"|trans,
        banner_cta: 'Créer un groupe'|trans,
        banner_href: path('app_group_create'),
        title: 'Événements privés'|trans,
        intro: false,
        total: events|length,
    } %}

    <section class="act-section">
        <div class="container">
            <div class="card-grid evn-grid">
                {% for e in events %}
                    {% include 'event/nav/_event_card.html.twig' with { e: e } %}
                {% endfor %}
            </div>
            {% if events is empty %}
                <p class="evn-empty__text">{{ is_granted('ROLE_USER') ? 'Aucun événement privé pour le moment.'|trans : 'Connectez-vous pour voir les événements privés auxquels vous êtes invité.'|trans }}</p>
            {% endif %}
        </div>
    </section>

    {% include 'event/nav/_selection.html.twig' with { selections: selections, cities: cities } %}

</div>
{% endblock %}
