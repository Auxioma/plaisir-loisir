{#
    Fiche d'un événement (04/10) : inscriptions réelles (EventRegistration),
    participants, photos (couverture + galerie de l'assistant), lieu, accès,
    agenda (.ics). Données : EventsController::detail().
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ event.title }}{% endblock %}
{% block meta_description %}{{ event.title }} {{ event.location ? ('à ' ~ event.location) : '' }} : {{ "rejoignez l'événement et découvrez les participants."|trans }}{% endblock %}

{# SEO (12/10) : seul un événement public et publié est indexé. #}
{% block meta_robots %}{% if entity.visibility != 'public' or entity.status != 'published' %}<meta name="robots" content="noindex, nofollow">{% endif %}{% endblock %}
{% block og_image %}{{ absolute_url(asset(event.image ?: 'images/brand/og-default.jpg')) }}{% endblock %}
{% block structured_data %}
    {% if entity.visibility == 'public' and entity.status == 'published' %}
        {% include '_partials/_event_ld.html.twig' with {
            name: entity.title, description: entity.description, url: url('app_events_detail', {slug: entity.slug}),
            image: entity.imagePath, start: entity.startsAt, end: entity.endsAt, city: entity.city, postal_code: entity.postalCode,
            online: entity.locationType == 'online', organizer: entity.organizer ? entity.organizer.firstName : null, capacity: entity.capacity,
        } %}
    {% endif %}
{% endblock %}

{% block header %}
    {% include '_partials/navbar_events.html.twig' with { nav_active: 'evenements' } %}
{% endblock %}

{% block body %}
<div class="evn-page evn-detail">
    <div class="container">

        <nav class="act-breadcrumb" aria-label="{{ "Fil d'Ariane"|trans }}">
            <a href="{{ path('app_home') }}">{{ 'Accueil'|trans }}</a>
            <span aria-hidden="true">|</span>
            <a href="{{ path('app_events') }}">{{ 'Événements'|trans }}</a>
            <span aria-hidden="true">|</span>
            <span aria-current="page" class="evn-crumb-current">{{ event.title }}</span>
        </nav>

        {% set photos = (event.image ? [event.image] : [])|merge(entity.gallery) %}
        <div class="evd-hero">
            <div class="evd-gallery">
                {% if photos is not empty %}
                    <a class="evd-gallery__cover" href="#event-photos"><img src="{{ asset(photos|first) }}" alt="{{ event.title }}" fetchpriority="high"></a>
                    <div class="evd-gallery__bottom">
                        <div class="evd-gallery__thumbs">{% for photo in photos|slice(0, 3) %}<a href="{{ asset(photo) }}" target="_blank" rel="noopener"><img src="{{ asset(photo) }}" alt="{{ 'Photo de l’événement'|trans }} {{ loop.index }}"></a>{% endfor %}</div>
                        <a class="evd-gallery__all" href="#event-photos">{{ icon.camera(18) }} {{ 'Photos'|trans }} ({{ photos|length }})</a>
                    </div>
                {% else %}
                    <div class="evd-gallery__empty">{{ icon.camera(40) }} {{ 'Photos'|trans }}</div>
                {% endif %}
            </div>
            <div class="evd-reservation">
                <div class="evd-actions">
                    {% if entity.category %}<span class="evd-badge">{{ entity.category.name }}</span>{% endif %}
                    <button type="button" class="evd-share" aria-label="{{ 'Partager l’événement'|trans }}" data-share-url="{{ url('app_events_detail', {slug: event.slug}) }}" data-share-title="{{ event.title }}" data-share-done="{{ 'Lien copié !'|trans }}">{{ icon.share(20) }}</button>
                    {% include '_partials/_event_fav.html.twig' with {type: 'evenement', key: event.slug, class: 'pa-fav'} %}
                </div>
                <div class="evn-book">
                    <p class="evn-book__price"><strong>{{ 'Gratuit'|trans }}</strong> {{ '· entre membres'|trans }}</p>
                    <h1 class="evn-detail__title">{{ event.title }}</h1>
                <p class="evn-organizer">
                    <img src="{{ asset(entity.organizer and entity.organizer.avatarPath ? entity.organizer.avatarPath : 'images/account/avatar-default.svg') }}" alt="" loading="lazy" decoding="async">
                    {{ 'Organisé par'|trans }} <strong>{% if entity.organizer and not entity.organizer.isProvider %}<a href="{{ path('app_member_profile', {id: entity.organizer.id}) }}">{{ event.organizer }}</a>{% else %}{{ event.organizer }}{% endif %}</strong>
                    {# Suivre l'organisateur : il apparaît dans « Mes favoris » (01/10). #}
                    {% if app.user and event.organizerId and event.organizerId != app.user.id ~ '' %}
                        {% include '_partials/_event_fav.html.twig' with { type: 'organisateur', key: event.organizerId, class: 'pa-fav' } %}
                    {% endif %}
                </p>

                    <ul class="evd-summary">
                        <li>{{ icon.calendar(20) }} {{ entity.startsAt|pf_date('EEEE d MMMM y')|capitalize }}</li>
                        <li>{{ icon.clock(20) }} {{ event.hours }} <a href="{{ path('app_events_ics', {slug: event.slug}) }}">{{ 'Ajouter à votre agenda'|trans }}</a></li>
                        <li>{{ icon.map_pin(20) }} {{ entity.locationType == 'online' ? 'En ligne'|trans : (entity.locationType == 'tbd' ? 'Lieu à définir'|trans : event.location) }}</li>
                        <li>{{ icon.users(20) }} {{ entity.participantsCount }}{% if entity.capacity %} / {{ entity.capacity }}{% endif %} {{ 'participants'|trans }}</li>
                    </ul>
                    {% if entity.capacity %}
                        {% set occupancy = min(100, (entity.participantsCount / entity.capacity * 100)|round) %}
                        <div class="evd-progress" role="progressbar" aria-label="{{ 'Participants'|trans }}" aria-valuenow="{{ occupancy }}" aria-valuemin="0" aria-valuemax="100"><span style="width: {{ occupancy }}%"></span></div>
                    {% endif %}

                    <p class="evn-book__places">
                        {% if entity.capacity %}
                            {% set left = entity.capacity - entity.participantsCount %}
                            {{ left > 0 ? left ~ ' ' ~ (left > 1 ? 'places restantes'|trans : 'place restante'|trans) : 'Complet'|trans }}
                        {% else %}{{ 'Places illimitées'|trans }}{% endif %}
                        {% if not entity.registrationRequired %}<small>{{ 'Inscription facultative : vous pouvez aussi venir directement.'|trans }}</small>{% endif %}
                    </p>
                    {% if entity.status == 'suspended' %}
                        <p class="evn-book__state">{{ 'Suspendu par l’administration'|trans }}. {{ 'Contactez le support pour plus d’informations.'|trans }}</p>
                    {% elseif is_organizer %}
                        <p class="evn-book__state">{{ icon.check_badge(16) }} {{ 'Vous organisez cet événement.'|trans }}</p>
                        <a class="pl-btn pl-btn--primary pl-btn--block" href="{{ path('app_events_invitation', {slug: event.slug}) }}">{{ 'Carton d’invitation & partage'|trans }}</a>
                        <a class="pl-btn pl-btn--outline-dark pl-btn--block" href="{{ path('app_event_resume', {slug: event.slug}) }}">{{ 'Modifier l’événement'|trans }}</a>
                    {% elseif entity.startsAt < date() %}
                        <p class="evn-book__state">{{ 'Cet événement a déjà eu lieu.'|trans }}</p>
                    {% elseif is_granted('ROLE_PROVIDER') and not registration %}
                        {% include '_partials/_provider_free_notice.html.twig' %}
                    {% else %}
                        <form method="post" action="{{ path('app_events_join', {slug: event.slug}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('event_join') }}">
                            {% if registration and registration.status == 'going' %}
                                <p class="evn-book__state">{{ icon.check_badge(16) }} {{ 'Vous participez à cet événement.'|trans }}</p>
                                <button class="pl-btn evn-btn-ghost pl-btn--block" data-confirm="{{ 'Annuler votre participation ?'|trans }}">{{ 'Me désinscrire'|trans }}</button>
                            {% elseif registration %}
                                <p class="evn-book__state">{{ icon.clock(16) }} {{ 'Vous êtes sur la liste d’attente.'|trans }}</p>
                                <button class="pl-btn evn-btn-ghost pl-btn--block">{{ 'Quitter la liste d’attente'|trans }}</button>
                            {% elseif entity.capacity and entity.participantsCount >= entity.capacity %}
                                {% if entity.waitlist %}<button class="pl-btn pl-btn--primary pl-btn--block">{{ 'Rejoindre la liste d’attente'|trans }}</button>
                                {% else %}<button class="pl-btn pl-btn--block" disabled>{{ 'Complet'|trans }}</button>{% endif %}
                            {% else %}
                                <button class="pl-btn pl-btn--primary pl-btn--block">{{ 'Je participe'|trans }}</button>
                            {% endif %}
                        </form>
                    {% endif %}
                    {% if entity.allowGuestInvites and entity.visibility == 'public' %}
                        <button type="button" class="pl-btn pl-btn--outline-dark pl-btn--block" data-share-url="{{ url('app_events_detail', {slug: event.slug}) }}" data-share-title="{{ event.title }}" data-share-done="{{ 'Lien copié !'|trans }}">{{ icon.users(18) }} {{ 'Inviter des amis'|trans }}</button>
                    {% endif %}
                </div>

            </div>
        </div>
        <div class="evd-benefits">
            <div>{{ icon.users(24) }} <span><strong>{{ 'Entre membres'|trans }}</strong>{{ 'Rencontres et activités'|trans }}</span></div>
            <div>{{ icon.calendar(24) }} <span><strong>{{ 'Ajouter à votre agenda'|trans }}</strong>{{ event.date }}</span></div>
            <div>{{ icon.check_badge(24) }} <span><strong>{{ 'Gratuit'|trans }}</strong>{{ '· entre membres'|trans }}</span></div>
        </div>
        <div class="evd-content">
            <div class="evd-main">
                <section class="evd-panel" id="event-about">
                    <nav class="evd-nav" aria-label="{{ 'Infos pratiques'|trans }}">
                        <a href="#event-about">{{ 'À propos'|trans }}</a>
                        <a href="#event-location">{{ 'Lieu'|trans }}</a>
                        <a href="#event-participants">{{ 'Participants'|trans }}</a>
                        <a href="#event-photos">{{ 'Photos'|trans }}</a>
                    </nav>
                    <h2 class="evn-h2">{{ 'À propos de l’événement'|trans }}</h2>
                    {% if entity.shortDescription %}<p class="evn-detail__lead">{{ entity.shortDescription }}</p>{% endif %}
                    {% if event.description %}<div class="evn-detail__text">{{ event.description|replace({'**': ''})|nl2br }}</div>{% endif %}
                    <h2 class="evn-h2">{{ 'Conditions de participation'|trans }}</h2>
                    <ul class="evd-conditions">
                        <li>{{ icon.check_badge(16) }} {{ 'Événement gratuit entre membres'|trans }}</li>
                        <li>{{ icon.check_badge(16) }} {{ entity.registrationRequired ? 'Inscription obligatoire'|trans : 'Inscription facultative : vous pouvez aussi venir directement.'|trans }}</li>
                        <li>{{ icon.check_badge(16) }} {{ 'En cas d’annulation, pensez à vous désinscrire pour libérer votre place.'|trans }}</li>
                    </ul>
                </section>
                <section class="evd-panel" id="event-participants">
                <div class="evn-parts__head">
                    <h2 class="evn-h2">{{ 'Participants'|trans }} <span class="evn-count-chip">{{ going|length }}</span></h2>
                    {% if entity.showParticipants or is_organizer %}<a href="{{ path('app_events_participants', { slug: event.slug }) }}" class="evn-btn-dark">{{ 'Tout voir'|trans }} {{ icon.arrow_up_right(15) }}</a>{% endif %}
                </div>
                {% if entity.showParticipants or is_organizer %}
                    <div class="evn-parts">
                        {% for r in going|slice(0, 5) %}
                            <div class="evn-part">
                                <span class="evn-part__avatar">
                                    {% if r.user.avatarPath %}<img src="{{ asset(r.user.avatarPath) }}" alt="" loading="lazy" decoding="async">{% else %}<span class="evn-part__initials">{{ (r.user.firstName|first ~ r.user.lastName|first)|upper }}</span>{% endif %}
                                    {% if r.user == entity.organizer %}<span class="evn-part__tag">{{ 'Hôte'|trans }}</span>{% endif %}
                                </span>
                                <span class="evn-part__name">{{ r.user.firstName }} {{ r.user.lastName|first }}.</span>
                                <span class="evn-part__role">{{ r.user == entity.organizer ? 'Organisateur'|trans : 'Membre'|trans }}</span>
                            </div>
                        {% else %}
                            <p class="evn-muted">{{ 'Soyez le premier à participer !'|trans }}</p>
                        {% endfor %}
                        {% if going|length > 5 %}
                            <a href="{{ path('app_events_participants', { slug: event.slug }) }}" class="evn-part evn-part--more"><span class="evn-part__plus">+{{ going|length - 5 }}</span><span class="evn-part__name">{{ 'de plus'|trans }}</span></a>
                        {% endif %}
                    </div>
                {% else %}
                    <p class="evn-muted">{{ 'L’organisateur a choisi de ne pas afficher la liste des participants.'|trans }}</p>
                {% endif %}

                </section>
                <section class="evd-panel" id="event-photos">
                    <h2 class="evn-h2">{{ 'Photos'|trans }} <span class="evn-count-chip">{{ photos|length }}</span></h2>
                    <div class="evd-photos">{% for photo in photos %}<a href="{{ asset(photo) }}" target="_blank" rel="noopener"><img src="{{ asset(photo) }}" alt="{{ 'Photo de l’événement'|trans }} {{ loop.index }}" loading="lazy"></a>{% else %}<p class="evn-muted">{{ 'Aucune photo pour le moment.'|trans }}</p>{% endfor %}</div>
                </section>
            </div>
            <aside class="evd-aside">
                <section class="evd-panel">
                    <h2 class="evn-h2">{{ 'Organisé par'|trans }}</h2>
                <p class="evn-organizer">
                    <img src="{{ asset(entity.organizer and entity.organizer.avatarPath ? entity.organizer.avatarPath : 'images/account/avatar-default.svg') }}" alt="" loading="lazy" decoding="async">
                    {{ 'Organisé par'|trans }} <strong>{% if entity.organizer and not entity.organizer.isProvider %}<a href="{{ path('app_member_profile', {id: entity.organizer.id}) }}">{{ event.organizer }}</a>{% else %}{{ event.organizer }}{% endif %}</strong>
                    {# Suivre l'organisateur : il apparaît dans « Mes favoris » (01/10). #}
                    {% if app.user and event.organizerId and event.organizerId != app.user.id ~ '' %}
                        {% include '_partials/_event_fav.html.twig' with { type: 'organisateur', key: event.organizerId, class: 'pa-fav' } %}
                    {% endif %}
                </p>

                </section>
                <section class="evd-panel" id="event-location">
                    <h2 class="evn-h2">{{ 'Lieu de rendez-vous'|trans }}</h2>
                <ul class="evn-facts">
                    <li>{{ icon.calendar(16) }} <span>{{ entity.startsAt|pf_date('EEEE d MMMM y')|capitalize }} · {{ event.hours }}{% if entity.recurrence %} · {{ entity.recurrence == 'weekly' ? 'toutes les semaines'|trans : 'tous les mois'|trans }}{% endif %}</span></li>
                    {% if entity.arrivalTime %}<li>{{ icon.clock(16) }} <span>{{ 'Arrivée conseillée à'|trans }} {{ entity.arrivalTime }}</span></li>{% endif %}
                    <li>{{ icon.map_pin(16) }} <span>{% if entity.locationType == 'online' %}{{ 'En ligne'|trans }}{% if registration and registration.status == 'going' or is_organizer %} — <a href="{{ entity.onlineUrl }}" target="_blank" rel="noopener">{{ 'Lien de connexion'|trans }}</a>{% else %} — {{ 'le lien est visible une fois inscrit'|trans }}{% endif %}{% elseif entity.locationType == 'tbd' %}{{ 'Lieu à définir'|trans }}{% else %}{{ entity.address ?? event.location }}{% if entity.locationType == 'approx' %} ({{ 'zone approximative'|trans }}){% endif %}{% endif %}</span></li>
                    {% if entity.meetingPoint %}<li>{{ icon.users(16) }} <span>{{ 'Rendez-vous :'|trans }} {{ entity.meetingPoint }}</span></li>{% endif %}
                    {% if entity.accessInstructions %}<li>{{ icon.info(16) }} <span>{{ entity.accessInstructions }}</span></li>{% endif %}
                    <li>{{ icon.users(16) }} <span>{{ entity.capacity ? entity.participantsCount ~ ' / ' ~ entity.capacity ~ ' ' ~ 'participants'|trans : entity.participantsCount ~ ' ' ~ 'participants'|trans }}{% if waitlist_count > 0 %} · {{ waitlist_count }} {{ 'en liste d’attente'|trans }}{% endif %}</span></li>
                </ul>
                {% if entity.latitude and entity.longitude %}
                    <div class="evn-detail__map" data-evl-map data-markers="{{ [{lat: entity.latitude + 0, lng: entity.longitude + 0, title: entity.title, url: path('app_events_detail', {slug: entity.slug}), date: event.day ~ ' ' ~ event.month, where: event.where}]|json_encode }}"></div>
                    <a class="evn-maplink" href="https://www.google.com/maps/search/?api=1&query={{ entity.latitude }},{{ entity.longitude }}" target="_blank" rel="noopener">{{ 'Itinéraire Google Maps'|trans }} {{ icon.arrow_up_right(14) }}</a>
                {% endif %}

                </section>
                <section class="evd-panel">
                    <h2 class="evn-h2">{{ 'Partager cet événement'|trans }}</h2>
                    {% if entity.visibility == 'public' %}
                    <div class="evd-share-links">
                        <a href="https://wa.me/?text={{ (event.title ~ ' ' ~ url('app_events_detail', {slug: event.slug}))|url_encode }}" target="_blank" rel="noopener">WhatsApp</a>
                        <a href="https://www.facebook.com/sharer/sharer.php?u={{ url('app_events_detail', {slug: event.slug})|url_encode }}" target="_blank" rel="noopener">Facebook</a>
                    </div>
                    {% endif %}
                    <button type="button" class="pl-btn pl-btn--outline-dark pl-btn--block" data-share-url="{{ url('app_events_detail', {slug: event.slug}) }}" data-share-title="{{ event.title }}" data-share-done="{{ 'Lien copié !'|trans }}">{{ icon.share(16) }} {{ 'Partager l’événement'|trans }}</button>
                    <a class="evd-download" href="{{ path('app_events_pdf', {slug: event.slug, cle: app.request.query.get('cle')}) }}" data-turbo="false">{{ icon.download(16) }} {{ 'Télécharger le PDF'|trans }}</a>
                </section>
                <button type="button" class="evn-report-btn" id="evn-report-open" data-bs-toggle="modal" data-bs-target="#evn-report">{{ icon.send(16) }} {{ "Signaler l'événement"|trans }}</button>
            </aside>
        </div>

        {# « Vous aimerez peut-être aussi » : d'autres événements réels
           (EventsController::detail()), avec la carte prévue pour ce
           contenu — point à trancher n°1, tranché en faveur d'événements
           plutôt que de groupes sans rapport avec la page consultée. #}
        <section class="evn-section evn-section--similar">
            <h2 class="evn-section__title">{{ 'Vous aimerez peut-être aussi'|trans }}</h2>
            <div class="card-grid evn-similar-grid">
                {% for e in similar %}
                    {% include 'event/nav/_event_card.html.twig' with { e: e, avatars: avatars } %}
                {% endfor %}
            </div>
        </section>

    </div>

    {% include 'event/nav/_report_modal.html.twig' %}
</div>
{% endblock %}
