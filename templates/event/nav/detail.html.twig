{#
    17/09 : fiche événement réelle (EventsController::detail(), route
    /evenements/detail/{slug}). Auparavant figée sur « Compétitions Canoë /
    Kayak » quel que soit l'événement cliqué (signalement du 15 septembre).

    La carte « groupe associé » a été retirée : aucun lien Event <-> Group
    n'existe en base (voir EventsController::groupDetail(), même limite),
    l'inventer aurait associé l'événement à un groupe au hasard. Le bloc
    réservation (prix, voyageurs, « Réservez maintenant ») reste décoratif :
    aucun modèle de paiement n'existe pour les événements communautaires
    (le modèle réel du site est Catalog/Booking, voir CLAUDE.md) — non
    touché ici, ce n'était pas ce que le signalement du 15 septembre visait.
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ event.title }}{% endblock %}
{% block meta_description %}{{ event.title }} {{ event.location ? ('à ' ~ event.location) : '' }} : {{ "rejoignez l'événement et découvrez les participants."|trans }}{% endblock %}

{% block header %}
    {% include '_partials/navbar_events.html.twig' with { nav_active: 'evenements' } %}
{% endblock %}

{% block body %}
<div class="evn-page evn-detail">
    <div class="container">

        <nav class="act-breadcrumb" aria-label="{{ "Fil d'Ariane"|trans }}">
            <a href="{{ path('app_home') }}">{{ 'Accueil'|trans }}</a>
            <span aria-hidden="true">|</span>
            <a href="{{ path('app_events') }}">{{ 'Événements'|trans }}</a>
            <span aria-hidden="true">|</span>
            <span aria-current="page" class="evn-crumb-current">{{ event.title }}</span>
        </nav>

        {% include 'event/nav/_banner.html.twig' with {
            text: "Devenez organisateur : créez un événement aujourd'hui !"|trans,
            cta: 'Créer un événement'|trans,
        } %}

        <div class="evn-detail__layout">

            {# ========================================================
               COLONNE GAUCHE : titre, organisateur, détails, participants,
               photos, signalement, similaires.
               Typo corrigée : « Organiser par » → Organisé par.
               ======================================================== #}
            <div class="evn-detail__main">
                <h1 class="evn-detail__title">{{ event.title }}</h1>

                <p class="evn-organizer">
                    <img src="{{ asset('images/events/avatar-thomas.jpg') }}" alt="">
                    {{ 'Organisé par'|trans }} <strong>{{ event.organizer }}</strong>
                    {# Suivre l'organisateur : il apparaît dans « Mes favoris » (01/10). #}
                    {% if app.user and event.organizerId and event.organizerId != app.user.id ~ '' %}
                        {% include '_partials/_event_fav.html.twig' with { type: 'organisateur', key: event.organizerId, class: 'pa-fav' } %}
                    {% endif %}
                </p>

                {% if event.description %}
                    <h2 class="evn-h2">{{ 'Détails'|trans }}</h2>
                    <p class="evn-detail__text">{{ event.description }}</p>
                {% endif %}

                <div class="evn-parts__head">
                    <h2 class="evn-h2">{{ 'Participants'|trans }} <span class="evn-count-chip">{{ event.participants }}</span></h2>
                    <a href="{{ path('app_events_participants', { slug: event.slug }) }}" class="evn-btn-dark">{{ 'Tout voir'|trans }} {{ icon.arrow_up_right(15) }}</a>
                </div>
                {# Aucune entité d'inscription à un événement n'existe encore
                   (voir Group::membersCount, même situation) : le compte
                   ci-dessus est réel, ce détail de rôles reste décoratif. #}
                <div class="evn-parts">
                    {% for p in participants[1:4] %}
                        <div class="evn-part">
                            <span class="evn-part__avatar">
                                <img src="{{ asset(p.avatar) }}" alt="">
                                {% if loop.first %}<span class="evn-part__tag">{{ 'Hôte'|trans }}</span>{% endif %}
                            </span>
                            <span class="evn-part__name">{{ p.name }}</span>
                            <span class="evn-part__role">{{ loop.first ? ('Assistant organisateur'|trans) : ('Membre'|trans) }}</span>
                        </div>
                    {% endfor %}
                    <a href="{{ path('app_events_participants', { slug: event.slug }) }}" class="evn-part evn-part--more">
                        <span class="evn-part__cluster">
                            {% for a in avatars[:3] %}<img src="{{ asset(a) }}" alt="">{% endfor %}
                            <span class="evn-part__plus">+8</span>
                        </span>
                        <span class="evn-part__name">{{ '+8 de plus'|trans }}</span>
                    </a>
                </div>

                {# Photo de l'événement : sa propre couverture (Event::imagePath,
                   la même que sur les cartes) — un seul cliché réel plutôt
                   qu'une photo sans rapport, faute d'album propre à Event. #}
                <h2 class="evn-h2">{{ 'Photos'|trans }} <span class="evn-count-chip">{{ event.image ? '01' : '00' }}</span></h2>
                {% if event.image %}
                    <div class="evn-photos">
                        <img src="{{ asset(event.image) }}" alt="{{ 'Photo de l\'événement'|trans }}">
                    </div>
                {% endif %}

                <button type="button" class="evn-report-btn" id="evn-report-open" data-bs-toggle="modal" data-bs-target="#evn-report">{{ icon.send(16) }} {{ "Signaler l'événement"|trans }}</button>
            </div>

            {# ========================================================
               COLONNE DROITE (sticky) : cover + flyer, réservation,
               « C'est pour offrir ? », agenda.
               ======================================================== #}
            <aside class="evn-detail__side">
                <div class="evn-cover">
                    <img src="{{ asset(event.image ?? 'images/events/ev-raft-clean.jpg') }}" alt="">
                    <button type="button" class="evn-cover__flyer">{{ icon.image(16) }} {{ 'Partager un flyer'|trans }}</button>
                </div>

                <div class="evn-book">
                    <p class="evn-book__price"><strong>{{ 'À partir de 29€'|trans }}</strong> {{ '/ personne'|trans }}</p>
                    <div class="evn-book__sep" aria-hidden="true"></div>
                    <p class="evn-book__label">{{ 'Voyageurs'|trans }}</p>
                    <div class="evn-book__row">
                        <span>{{ 'Adulte (18 et + )'|trans }}</span>
                        <span class="evn-stepper" data-evn-stepper data-min="1">
                            <button type="button" data-step="-1" aria-label="{{ "Moins d'adultes"|trans }}">{{ icon.minus(14) }}</button>
                            <output>2</output>
                            <button type="button" data-step="1" aria-label="{{ "Plus d'adultes"|trans }}">{{ icon.plus(14) }}</button>
                        </span>
                    </div>
                    <div class="evn-book__row">
                        <span>{{ 'Enfants (0 à 17 ans )'|trans }}</span>
                        <span class="evn-stepper" data-evn-stepper data-min="0">
                            <button type="button" data-step="-1" aria-label="{{ "Moins d'enfants"|trans }}">{{ icon.minus(14) }}</button>
                            <output>0</output>
                            <button type="button" data-step="1" aria-label="{{ "Plus d'enfants"|trans }}">{{ icon.plus(14) }}</button>
                        </span>
                    </div>
                    <div class="evn-book__total">
                        <span>{{ 'Total'|trans }}</span>
                        <strong>29€</strong>
                    </div>
                    <button type="button" class="pl-btn pl-btn--primary pl-btn--block">{{ 'Réservez maintenant'|trans }}</button>
                </div>

                <div class="evn-gift">
                    <p class="evn-gift__title">{{ "C'est pour offrir ?"|trans }}</p>
                    <p class="evn-gift__text">{{ 'Choisissez le bon cadeau'|trans }}  <strong>Plaisirs &amp; Loisirs</strong> {{ 'et offrez cette expérience en quelques minutes !'|trans }}</p>
                    <a href="{{ path('app_gifts') }}" class="pl-btn pl-btn--primary pl-btn--block">{{ 'Offrir maintenant'|trans }}</a>
                </div>

                <div class="evn-agenda">
                    <p class="evn-agenda__title">{{ 'Ajouter à votre agenda'|trans }} {{ icon.calendar(18) }}</p>
                    <p class="evn-agenda__date">{{ event.date }} {{ event.hours }}</p>
                </div>
            </aside>
        </div>

        {# « Vous aimerez peut-être aussi » : d'autres événements réels
           (EventsController::detail()), avec la carte prévue pour ce
           contenu — point à trancher n°1, tranché en faveur d'événements
           plutôt que de groupes sans rapport avec la page consultée. #}
        <section class="evn-section evn-section--similar">
            <h2 class="evn-section__title">{{ 'Vous aimerez peut-être aussi'|trans }}</h2>
            <div class="card-grid evn-similar-grid">
                {% for e in similar %}
                    {% include 'event/nav/_event_card.html.twig' with { e: e, avatars: avatars } %}
                {% endfor %}
            </div>
        </section>

    </div>

    {% include 'event/nav/_report_modal.html.twig' %}
</div>
{% endblock %}
