{#
    Onglet « Membres ». Les lignes de la maquette (prénoms, photos, « 1991
    membres », « rejoint le 24 Mai 2026 ») sont retirées le 06/11 : l'adhésion
    à un groupe n'est pas encore enregistrée en base. Seul le créateur du
    groupe est connu ; le compteur est celui du groupe.
#}
{% import '_partials/_icons.html.twig' as icon %}

<section class="evn-gsection">
    <h2 class="evn-gh2 evn-gh2--tab">{{ 'Membres'|trans }}</h2>

    <div class="evn-members-tools">
        <div class="evn-members-tools__left">
            <span class="evn-chip-count">{{ group.members }} {{ (group.members > 1 ? 'membres' : 'membre')|trans }}</span>
        </div>
    </div>

    <div class="evn-mlist" id="evn-members-all">
        {% if group.owner %}
            <div class="evn-mrow">
                <img class="evn-mrow__avatar" src="{{ image_url(group.owner.avatar, 'avatar') }}" alt="" loading="lazy" decoding="async">
                <span class="evn-mrow__id">
                    <span class="evn-prow__name">{{ group.owner.name }}</span>
                    <span class="evn-mrow__meta"><strong>{{ 'Créateur'|trans }}</strong></span>
                </span>
            </div>
        {% else %}
            <p class="evn-empty__text">{{ "La liste des membres n'est pas encore disponible."|trans }}</p>
        {% endif %}
    </div>
</section>
