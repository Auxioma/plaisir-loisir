{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}
{% import 'provider/space/_ico.html.twig' as ico %}

{% block title %}{{ 'Événements'|trans }}{% endblock %}
{% block meta_description %}{{ 'Trouvez, rejoignez et partagez des moments uniques : événements entre membres partout en France.'|trans }}{% endblock %}

{% block body %}
<div class="evl">
    <div class="evl-main">
        <section class="evl-hero">
            <img class="evl-hero__bg" src="{{ asset('images/events/banner-explore.jpg') }}" alt="">
            <div class="evl-hero__text">
                <h1>{{ 'Événements'|trans }}</h1>
                <p class="evl-hero__lead">{{ 'Trouvez, rejoignez et partagez des moments uniques'|trans }}</p>
                <p>{{ 'Découvrez des événements privés près de chez vous ou partout en France. Activités entre amis, en famille ou entre passionnés.'|trans }}</p>
            </div>
            <ul class="evl-hero__badges">
                <li><span>{{ icon.users(18) }}</span><strong>{{ '100% privés'|trans }}</strong><small>{{ 'Entre membres'|trans }}</small></li>
                <li><span>{{ icon.shield_check(18) }}</span><strong>{{ 'Gratuit & sans prestataire'|trans }}</strong><small>{{ 'Aucun frais'|trans }}</small></li>
                <li><span>{{ icon.calendar_grid(18) }}</span><strong>{{ 'Partage & convivialité'|trans }}</strong><small>{{ 'Ces liens authentiques'|trans }}</small></li>
            </ul>
        </section>

        <form class="evl-search" method="get" action="{{ path('app_events') }}" role="search">
            {% if filters.sort != 'date' %}<input type="hidden" name="tri" value="{{ filters.sort }}">{% endif %}
            <label class="evl-search__cell">
                <span class="evl-search__ico">{{ icon.map_pin(20) }}</span>
                <span><strong>{{ 'Où ?'|trans }}</strong><input name="ou" value="{{ filters.where }}" placeholder="{{ 'Toute la France'|trans }}" aria-label="{{ 'Ville ou code postal'|trans }}"></span>
            </label>
            <label class="evl-search__cell">
                <span class="evl-search__ico">{{ icon.calendar_grid(20) }}</span>
                <span><strong>{{ 'Quand ?'|trans }}</strong>
                    <select name="quand" aria-label="{{ 'Période'|trans }}">
                        {% for key, label in {'': 'Toutes les dates', aujourdhui: 'Aujourd’hui', demain: 'Demain', weekend: 'Ce week-end', semaine: 'Cette semaine', mois: 'Ce mois-ci'} %}
                            <option value="{{ key }}"{{ filters.when == key ? ' selected' }}>{{ label|trans }}</option>
                        {% endfor %}
                    </select>
                </span>
            </label>
            <label class="evl-search__cell">
                <span class="evl-search__ico">{{ icon.grid(20) }}</span>
                <span><strong>{{ 'Catégorie'|trans }}</strong>
                    <select name="categorie" aria-label="{{ 'Catégorie'|trans }}">
                        <option value="">{{ 'Toutes les catégories'|trans }}</option>
                        {% for c in categories %}<option value="{{ c.slug }}"{{ filters.category == c.slug ? ' selected' }}>{{ c.name|trans }}</option>{% endfor %}
                    </select>
                </span>
            </label>
            <label class="evl-search__cell">
                <span class="evl-search__ico">{{ icon.users(20) }}</span>
                <span><strong>{{ "Type d'événement"|trans }}</strong>
                    <select name="type" aria-label="{{ "Type d'événement"|trans }}">
                        <option value="">{{ 'Tous les types'|trans }}</option>
                        {% for key, t in types %}<option value="{{ key }}"{{ filters.type == key ? ' selected' }}>{{ t.label|trans }}</option>{% endfor %}
                    </select>
                </span>
            </label>
            <button class="evl-search__submit">{{ 'Rechercher'|trans }}</button>
            <a class="evl-search__reset" href="{{ path('app_events') }}">{{ 'Réinitialiser'|trans }} {{ icon.support_cycle(16) }}</a>
            {% if filters.q %}<input type="hidden" name="q" value="{{ filters.q }}">{% endif %}
        </form>

        <nav class="evl-chips" aria-label="{{ 'Catégories'|trans }}">
            {% for slug, chip in chips %}
                <a class="evl-chip{{ filters.category == slug ? ' is-active' }}" href="{{ path('app_events', params|merge({categorie: slug ?: null})) }}">{{ ico.svg(chip[1], 16) }} {{ chip[0]|trans }}</a>
            {% endfor %}
            <details class="evl-advanced">
                <summary>{{ 'Filtres avancés'|trans }} {{ icon.sliders(16) }}</summary>
                <form method="get" class="evl-advanced__panel">
                    {% for k, v in params|filter((v, k) => k not in ['date', 'q']) %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endfor %}
                    <label>{{ 'Mot-clé'|trans }}<input name="q" value="{{ filters.q }}" placeholder="{{ 'Randonnée, barbecue…'|trans }}"></label>
                    <label>{{ 'Date précise'|trans }}<input type="date" name="date" value="{{ filters.date }}" min="{{ 'today'|date('Y-m-d') }}"></label>
                    <button class="evl-search__submit">{{ 'Appliquer'|trans }}</button>
                </form>
            </details>
        </nav>

        <div class="evl-bar">
            <strong>{{ total }} {{ total > 1 ? 'événements trouvés'|trans : 'événement trouvé'|trans }}</strong>
            <form method="get" class="evl-sort">
                {% for k, v in params|filter((v, k) => k != 'tri') %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endfor %}
                <label for="evl-sort">{{ 'Trier par :'|trans }}</label>
                <select id="evl-sort" name="tri" onchange="this.form.submit()">
                    {% for key, label in {date: 'Date (prochainement)', populaires: 'Les plus populaires', recents: 'Ajoutés récemment'} %}<option value="{{ key }}"{{ filters.sort == key ? ' selected' }}>{{ label|trans }}</option>{% endfor %}
                </select>
            </form>
        </div>

        {% if events is empty %}
            <div class="evl-empty">
                {{ icon.calendar_grid(36) }}
                <strong>{{ 'Aucun événement ne correspond à votre recherche.'|trans }}</strong>
                <span>{{ 'Élargissez vos critères ou créez le vôtre !'|trans }}</span>
                <div><a class="evl-btn evl-btn--ghost" href="{{ path('app_events') }}">{{ 'Réinitialiser'|trans }}</a> <a class="evl-btn" href="{{ path('app_event_guide') }}">{{ 'Créer un événement'|trans }}</a></div>
            </div>
        {% else %}
            <div class="evl-grid">
                {% for e in events %}
                    <article class="evl-card" id="ev-{{ loop.index }}">
                        <a class="evl-card__media" href="{{ path('app_events_detail', {slug: e.slug}) }}">
                            <img src="{{ asset(e.image ?? 'images/events/ev-raft-clean.jpg') }}" alt="{{ e.title }}" loading="lazy">
                            <span class="evl-badge evl-badge--{{ e.color }}">{{ e.category|trans }}</span>
                            <span class="evl-card__date"><b>{{ e.day }}</b>{{ e.month }}</span>
                        </a>
                        {% include '_partials/_event_fav.html.twig' with { type: 'evenement', key: e.slug, class: 'evl-card__fav' } %}
                        <div class="evl-card__body">
                            <a class="evl-card__title" href="{{ path('app_events_detail', {slug: e.slug}) }}">{{ e.title }}</a>
                            <span class="evl-card__meta">{{ icon.map_pin(13) }} {{ e.where }}</span>
                            <span class="evl-card__meta">{{ icon.clock(13) }} {{ e.hours }}</span>
                            <span class="evl-card__foot">
                                <span>{{ e.participants }} {{ e.participants > 1 ? 'participants'|trans : 'participant'|trans }}</span>
                                <span class="evl-avatars">{% for a in avatars|slice(0, 4) %}<img src="{{ asset(a) }}" alt="">{% endfor %}</span>
                            </span>
                            <a class="evl-btn evl-btn--ghost evl-btn--block" href="{{ path('app_events_detail', {slug: e.slug}) }}">{{ "Voir l'événement"|trans }}</a>
                        </div>
                    </article>
                {% endfor %}
            </div>
            {% if has_more %}
                <a class="evl-more" href="{{ path('app_events', params|merge({page: page + 1})) }}#ev-{{ events|length + 1 }}">{{ "Charger plus d'événements"|trans }} {{ icon.chevron_down(16) }}</a>
            {% endif %}
        {% endif %}
    </div>

    <aside class="evl-side">
        <section class="evl-panel">
            <h2>{{ 'Carte des événements'|trans }}</h2>
            <div class="evl-map" data-evl-map data-markers="{{ markers|json_encode }}" aria-label="{{ 'Carte des événements'|trans }}"></div>
            <a class="evl-maplink" href="#" data-evl-map-fit>{{ 'Voir les événements sur la carte'|trans }} {{ icon.map_pin(16) }}</a>
        </section>

        <section class="evl-panel">
            <div class="evl-panel__head"><h2>{{ 'Événements à venir'|trans }}</h2><a href="{{ path('app_events', {tri: 'date'}) }}">{{ 'Voir tout'|trans }}</a></div>
            <ul class="evl-upcoming">
                {% for e in upcoming %}
                    <li><a href="{{ path('app_events_detail', {slug: e.slug}) }}">
                        <img src="{{ asset(e.image ?? 'images/events/ev-raft-clean.jpg') }}" alt="">
                        <span><strong>{{ e.title }}</strong><small>{{ e.where }}</small><small>{{ e.startsAt|pf_date('d MMM')|trim('.') }} • {{ e.startsAt|date('H\\hi') }}</small></span>
                        <em>{{ icon.users(13) }} {{ e.participants }}</em>
                    </a></li>
                {% else %}
                    <li class="evl-muted">{{ 'Aucun événement à venir pour le moment.'|trans }}</li>
                {% endfor %}
            </ul>
        </section>

        <section class="evl-panel evl-create">
            <h2>{{ 'Créez votre événement'|trans }}</h2>
            <p>{{ 'Organisez facilement vos activités et invitez vos proches.'|trans }}</p>
            <a class="evl-btn" href="{{ path('app_event_guide') }}">{{ 'Créer un événement'|trans }} {{ icon.calendar_grid(16) }}</a>
            <span class="evl-create__art" aria-hidden="true">🎉</span>
        </section>
    </aside>
</div>

<ul class="evl-features">
    <li>{{ icon.check_badge(22) }}<span><strong>{{ '100% Gratuit'|trans }}</strong><small>{{ 'Aucun frais, jamais'|trans }}</small></span></li>
    <li>{{ icon.shield_check(22) }}<span><strong>{{ 'Sans prestataire'|trans }}</strong><small>{{ 'Entre particuliers uniquement'|trans }}</small></span></li>
    <li>{{ icon.padlock(22) }}<span><strong>{{ 'Sécurisé'|trans }}</strong><small>{{ 'Vos données sont protégées'|trans }}</small></span></li>
    <li>{{ icon.bell(22) }}<span><strong>{{ 'Convivial'|trans }}</strong><small>{{ 'Entre membres bienveillants'|trans }}</small></span></li>
    <li>{{ icon.share(22) }}<span><strong>{{ 'Partage facile'|trans }}</strong><small>{{ 'Photos, discussions, souvenirs'|trans }}</small></span></li>
    <li>{{ icon.monitor(22) }}<span><strong>{{ 'Accessible partout'|trans }}</strong><small>{{ 'Sur mobile et ordinateur'|trans }}</small></span></li>
</ul>
{% endblock %}
