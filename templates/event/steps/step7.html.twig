{#
    Étape 7 — Inviter des personnes (2 onglets client, assets/events.js) :
    A « Inviter des personnes » (défaut) / B « Inviter via un lien ».
    Typo maquette corrigée : « memebre » → membre.
#}
{% import '_partials/_icons.html.twig' as icon %}

<h2 class="ev-main__title">{{ '7. Inviter des personnes (facultatif)'|trans }}</h2>
<p class="ev-main__lead">{{ 'Invitez vos amis, membres ou contacts à participer à votre événement.'|trans }}</p>

<div class="ev-tabs" role="tablist" aria-label="{{ "Mode d'invitation"|trans }}">
    <button type="button" class="ev-tab is-active" id="ev-tab-people" role="tab" aria-selected="true" aria-controls="ev-panel-people">{{ 'Inviter des personnes'|trans }}</button>
    <button type="button" class="ev-tab" id="ev-tab-link" role="tab" aria-selected="false" aria-controls="ev-panel-link">{{ 'Inviter via un lien'|trans }}</button>
</div>

{# Onglet A — Inviter des personnes. #}
<div id="ev-panel-people" role="tabpanel" aria-labelledby="ev-tab-people">
    <div class="ev-suggest__head">
        <h3 class="ev-main__subheading">{{ 'Suggestions'|trans }}</h3>
        <button type="button" class="ev-linkbtn">{{ 'Tout sélectionner'|trans }}</button>
    </div>
    <p class="ev-main__subtext">{{ 'Invitez des personnes que vous connaissez.'|trans }}</p>

    <div class="ev-contacts">
        {% for c in contacts %}
            <div class="ev-contact">
                <input type="checkbox" aria-label="{{ 'Sélectionner %name%'|trans({ '%name%': c.name }) }}" {{ c.invited ? 'checked' }}>
                <img src="{{ asset(c.avatar) }}" alt="">
                <span class="ev-contact__text"><strong>{{ c.name }}</strong><small>{{ c.friends }} {{ 'amis en commun'|trans }}</small></span>
                {% if c.invited %}
                    <button type="button" class="pl-btn pl-btn--primary ev-contact__btn">{{ "Annuler l'invitation"|trans }}</button>
                {% else %}
                    <button type="button" class="ev-contact__btn ev-contact__btn--soft">{{ 'Inviter'|trans }}</button>
                {% endif %}
            </div>
        {% endfor %}
    </div>

    <h3 class="ev-main__subheading">{{ 'Invité(e)s (0)'|trans }}</h3>
    <p class="ev-main__subtext">{{ 'Aucune personne invitée pour le moment.'|trans }}</p>

    <div class="ev-empty">
        {{ icon.users(30) }}
        <strong>{{ 'Aucune personne invitée'|trans }}</strong>
        <p>{{ 'Recherchez et invitez des personnes ci-dessus.'|trans }}</p>
    </div>

    <div class="ev-tip">
        <p class="ev-tip__title">{{ icon.info(16) }} {{ 'Astuce'|trans }}</p>
        <p>{{ "Vous pourrez toujours inviter d'autres personnes après la création de l'événement."|trans }}</p>
    </div>
</div>

{# Onglet B — Inviter via un lien. #}
<div id="ev-panel-link" role="tabpanel" aria-labelledby="ev-tab-link" hidden>
    <div class="ev-field">
        <div class="ev-input-icon">
            <input class="ev-input" type="text" placeholder="{{ 'Rechercher un ami, un membre ou un contact...'|trans }}" aria-label="{{ 'Rechercher un contact'|trans }}">
            <span>{{ icon.search(18) }}</span>
        </div>
    </div>

    <div class="ev-suggest__head">
        <h3 class="ev-main__subheading">{{ 'Suggestions'|trans }}</h3>
        <button type="button" class="ev-linkbtn">{{ 'Tout sélectionner'|trans }}</button>
    </div>
    <p class="ev-main__subtext">{{ 'Invitez des personnes que vous connaissez.'|trans }}</p>

    <div class="ev-contacts">
        {% for c in contacts %}
            <div class="ev-contact">
                <input type="checkbox" aria-label="{{ 'Sélectionner %name%'|trans({ '%name%': c.name }) }}">
                <img src="{{ asset(c.avatar) }}" alt="">
                <span class="ev-contact__text"><strong>{{ c.name }}</strong><small>{{ c.friends }} {{ 'amis en commun'|trans }}</small></span>
                <button type="button" class="ev-contact__btn ev-contact__btn--soft">{{ 'Envoyer un lien'|trans }}</button>
            </div>
        {% endfor %}
    </div>

    <h3 class="ev-main__subheading">{{ 'Invité(e)s (0)'|trans }}</h3>
    <p class="ev-main__subtext">{{ 'Aucune personne invitée pour le moment.'|trans }}</p>

    <div class="ev-empty">
        {{ icon.users(30) }}
        <strong>{{ 'Aucune personne invitée'|trans }}</strong>
        <p>{{ 'Recherchez et invitez des personnes ci-dessus.'|trans }}</p>
    </div>

    <div class="ev-tip">
        <p class="ev-tip__title">{{ icon.info(16) }} {{ 'Astuce'|trans }}</p>
        <p>{{ "Vous pourrez toujours inviter d'autres personnes après la création de l'événement."|trans }}</p>
    </div>
</div>
