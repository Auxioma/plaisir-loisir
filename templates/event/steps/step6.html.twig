{# Étape 6 — Options et paramètres. #}
{% import '_partials/_icons.html.twig' as icon %}

<h2 class="ev-main__title">{{ '6. Options et paramètres'|trans }}</h2>
<p class="ev-main__lead">{{ 'Personnalisez les paramètres de votre événement selon vos besoins.'|trans }}</p>

<h3 class="ev-main__subheading">{{ "Type d'événement"|trans }}</h3>
<div class="ev-visibility ev-visibility--bordered" role="radiogroup" aria-label="{{ "Type d'événement"|trans }}">
    <label class="ev-visibility__item">
        <span class="ev-visibility__icon">{{ icon.lock(20) }}</span>
        <span class="ev-visibility__text"><strong>{{ 'Événement privé'|trans }}</strong>{{ 'Seulement sur invitation ou personnes invitées'|trans }}</span>
        <input type="radio" name="visibility" value="private">
    </label>
    <label class="ev-visibility__item">
        <span class="ev-visibility__icon">{{ icon.globe(20) }}</span>
        <span class="ev-visibility__text"><strong>{{ 'Événement public'|trans }}</strong>{{ 'Ouvert à tous les membres de la communauté'|trans }}</span>
        <input type="radio" name="visibility" value="public" checked>
    </label>
    <label class="ev-visibility__item">
        <span class="ev-visibility__icon">{{ icon.users(20) }}</span>
        <span class="ev-visibility__text"><strong>{{ 'Groupe / Club'|trans }}</strong>{{ 'Événement réservé aux membres du groupe ou du club'|trans }}</span>
        <input type="radio" name="visibility" value="group">
    </label>
</div>

<h3 class="ev-main__subheading">{{ "Paramètres d'inscription"|trans }}</h3>
{% include 'event/_setting_row.html.twig' with { ico: 'person', color: 'orange', title: 'Inscription requise'|trans, desc: "Les participants doivent s'inscrire pour participer."|trans, control: 'toggle', on: true } %}
{% include 'event/_setting_row.html.twig' with { ico: 'users', color: 'blue', title: 'Limite de participants'|trans, desc: 'Définissez le nombre maximum de participants.'|trans, control: 'select', value: '50 participants'|trans } %}
{% include 'event/_setting_row.html.twig' with { ico: 'hourglass', color: 'green', title: "Liste d'attente"|trans, desc: "Activer automatiquement une liste d'attente si l'événement est complet."|trans, control: 'toggle', on: false } %}

<h3 class="ev-main__subheading">{{ 'Visibilité et confidentialité'|trans }}</h3>
{% include 'event/_setting_row.html.twig' with { ico: 'eye', color: 'red', title: 'Afficher la liste des participants'|trans, desc: 'Permettre aux participants de voir la liste des inscrits.'|trans, control: 'toggle', on: true } %}
{% include 'event/_setting_row.html.twig' with { ico: 'person_plus', color: 'blue', title: 'Autoriser les invités'|trans, desc: "Les participants peuvent inviter d'autres personnes."|trans, control: 'toggle', on: true } %}
{% include 'event/_setting_row.html.twig' with { ico: 'comment', color: 'green', title: 'Commentaires'|trans, desc: "Autoriser les participants à commenter l'événement."|trans, control: 'toggle', on: false } %}

<h3 class="ev-main__subheading">{{ 'Rappels et communications'|trans }}</h3>
{% include 'event/_setting_row.html.twig' with { ico: 'bell', color: 'violet', title: "Envoyer un rappel avant l'événement"|trans, desc: 'Les participants recevront un rappel avant le début'|trans, control: 'select', value: '24 heures avant'|trans } %}
{% include 'event/_setting_row.html.twig' with { ico: 'mail', color: 'orange', title: 'Mises à jour par email'|trans, desc: 'Envoyer les mises à jour et changements par email'|trans, control: 'toggle', on: true } %}
