{#
    Liste des conversations (§14 du CDC). Aucune maquette : réutilise le
    gabarit de l'espace compte (en-tête, sidebar) et une liste Bootstrap,
    comme quote/mes_demandes.html.twig.
    Variables : rows (list de {conversation, other, last_message, unread}).
#}
{% extends 'account/_layout.html.twig' %}

{% block title %}{{ 'Messages'|trans }}{% endblock %}

{% block account %}
    {% include 'account/_page_head.html.twig' with {
        crumbs: [{ label: 'Messages'|trans }],
        title: 'Messages'|trans,
        subtitle: 'Vos conversations avec les professionnels.'|trans,
    } %}

    {% if rows is empty %}
        {% include 'account/_empty.html.twig' with { message: "Vous n'avez encore aucune conversation. Elle démarre depuis la fiche d'un professionnel."|trans } %}
    {% else %}
        <div class="list-group">
            {% for row in rows %}
                <a href="{{ path('app_account_messages_show', {id: row.conversation.id}) }}"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <strong>{{ row.other }}</strong>
                        {% if row.last_message %}
                            <div class="text-muted small text-truncate" style="max-width: 32rem;">
                                {{ row.last_message.body }}
                            </div>
                        {% endif %}
                    </div>
                    <div class="text-end text-nowrap">
                        {% if row.last_message %}
                            <div class="text-muted small">{{ row.last_message.createdAt|date('d/m/Y H:i') }}</div>
                        {% endif %}
                        {% if row.unread %}
                            <span class="badge rounded-pill text-bg-danger mt-1">{{ 'Non lu'|trans }}</span>
                        {% endif %}
                    </div>
                </a>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
