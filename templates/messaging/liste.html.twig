{#
    Liste des conversations (§14 du CDC). Aucune maquette : réutilise le
    gabarit de l'espace compte (en-tête, sidebar).
    Variables : rows (list de {conversation, other, last_message, unread}).

    Boîte à deux volets depuis le 20/10 (messaging/_inbox.html.twig).
    Repris en cartes `.acc-conv` (18/09) à la place d'un `.list-group`
    Bootstrap brut : même langage visuel que les notifications (`.acc-notif`)
    — avatar en initiale (aucune photo à afficher, l'autre partie peut être
    un client ou un professionnel), fond blanc + pastille rouge pour une
    conversation non lue, fond gris une fois lue.
#}
{% extends 'account/_layout.html.twig' %}

{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Messages'|trans }}{% endblock %}

{% block account %}
    {% include 'account/_page_head.html.twig' with {
        crumbs: [{ label: 'Messages'|trans }],
        title: 'Messages'|trans,
        subtitle: 'Vos conversations avec les membres et les professionnels.'|trans,
    } %}

    {# Parcours expliqué sur la page (13/10, retour client n° 35). #}
    <details class="acc-howto"{{ rows is empty ? ' open' }}>
        <summary>{{ icon.info(16) }} {{ 'Comment démarrer une conversation ?'|trans }}</summary>
        <ul>
            <li><strong>{{ 'Avec un professionnel'|trans }}</strong> — {{ 'bouton « Contacter le professionnel » sur la fiche d’une activité, sur sa fiche professionnelle, ou après une réservation.'|trans }}</li>
            <li><strong>{{ 'Avec un membre'|trans }}</strong> — {{ 'bouton « Contacter » sur son profil (cliquez sur le nom de l’organisateur d’une activité gratuite ou d’un événement).'|trans }}</li>
            <li><strong>{{ 'Ensuite'|trans }}</strong> — {{ 'la conversation apparaît ici ; vous êtes prévenu de chaque réponse dans vos notifications.'|trans }}</li>
        </ul>
    </details>

    {% include 'messaging/_inbox.html.twig' with {conversation: null, other: null, current_user: null} %}
{% endblock %}
