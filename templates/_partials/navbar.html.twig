{#
    En-tête UNIQUE de la plateforme — maquette assets/maquettes/choix_profil.jpeg
    (30/09). Bandeau bleu nuit : logo, recherche, Activités ▾, Destinations,
    Mes favoris, Album photo (Nouveau), Notifications, Se connecter,
    Déposer une activité. Styles : assets/styles/layout.css (.tm-header).

    Les anciennes variantes (navbar_home, navbar_corporate, navbar_events…)
    ne sont plus que des alias de ce fichier : un seul en-tête partout.

    Les liens que la maquette ne montre plus à plat (Offres du moment, Bons
    cadeaux, Événements, Activités privées, Trouver un professionnel…) restent
    joignables dans le menu déroulant « Activités ».

    L'élément actif est déduit de la route courante ; la variable `nav_active`
    encore passée par certains templates est ignorée.

    Connecté : « Se connecter » laisse la place à l'avatar (menu Profil,
    Messagerie, raccourcis pro, Déconnexion). Favoris et Notifications
    portent leur compteur de non-lus.
#}
{% import '_partials/_icons.html.twig' as icon %}
{# En dev seulement, « ?connecte=1 » prévisualise l'état connecté sans compte. #}
{% set connected = app.user is not null or (app.debug and app.request.query.getBoolean('connecte')) %}
{% set route = app.request.attributes.get('_route', '') %}
{% set is_provider = app.user is not null and is_granted('ROLE_PROVIDER') %}

{% set active =
    route == 'app_favorites_page' ? 'favoris' :
    route == 'app_photo_albums' ? 'album' :
    route starts with 'app_account_notification' ? 'notifications' :
    route starts with 'app_destination' ? 'destinations' :
    (route starts with 'app_activit' or route starts with 'app_offer' or route starts with 'app_gift' or route starts with 'app_event' or route starts with 'app_private_activit') ? 'activites' : ''
%}

<header class="tm-header">
    <div class="tm-header__inner">
        <a href="{{ path('app_home') }}" class="tm-header__logo" aria-label="{{ 'Accueil TrouveMoi'|trans }}">
            <img src="{{ asset('images/logo-trouvemoi.png') }}" alt="TrouveMoi Plaisirs &amp; Loisirs" width="186" height="52">
        </a>

        <form class="tm-search pl-suggest-anchor" action="{{ path('app_activities') }}" method="get" role="search">
            <input class="tm-search__input" type="search" name="q" data-suggest="activite"
                   placeholder="{{ 'Rechercher une activité, un loisir, une destination...'|trans }}"
                   aria-label="{{ 'Rechercher'|trans }}" value="{{ route == 'app_activities' ? app.request.query.get('q') : '' }}">
            <button class="tm-search__btn" type="submit" aria-label="{{ 'Lancer la recherche'|trans }}">{{ icon.search(20) }}</button>
        </form>

        {# Sous 1200px la navigation glisse dans un panneau offcanvas de
           Bootstrap ; au-dessus, le CSS le neutralise et elle reprend sa place
           en ligne (mécanique de `navbar-expand-xl`). #}
        <div class="tm-header__panel offcanvas offcanvas-end" id="tmNav" tabindex="-1" aria-label="{{ 'Menu'|trans }}">
            <div class="tm-header__panel-head">
                <img src="{{ asset('images/logo-trouvemoi.png') }}" alt="TrouveMoi Plaisirs &amp; Loisirs" width="150" height="42">
                <button type="button" class="tm-header__panel-close" data-bs-dismiss="offcanvas" aria-label="{{ 'Fermer'|trans }}">{{ icon.x(18) }}</button>
            </div>

            <nav class="tm-nav" aria-label="{{ 'Navigation principale'|trans }}">
                <details class="pl-dropdown tm-nav__dropdown">
                    <summary class="tm-nav__link{{ active == 'activites' ? ' is-active' }}">{{ 'Activités'|trans }} {{ icon.chevron_down(14) }}</summary>
                    <div class="tm-menu">
                        <a href="{{ path('app_activities') }}" class="tm-menu__item">{{ 'Toutes les activités'|trans }}</a>
                        <a href="{{ path('app_offers') }}" class="tm-menu__item">{{ 'Offres du moment'|trans }}</a>
                        <a href="{{ path('app_gifts') }}" class="tm-menu__item">{{ 'Bons cadeaux'|trans }}</a>
                        <a href="{{ path('app_events') }}" class="tm-menu__item">{{ 'Événements'|trans }}</a>
                        <a href="{{ path('app_private_activities') }}" class="tm-menu__item">{{ 'Activités privées'|trans }}</a>
                        {# Un professionnel crée ses activités depuis son espace pro ; il
                           ne doit jamais être renvoyé dans l'espace particulier (05/10). #}
                        <a href="{{ is_provider ? path('app_pro_activities_new') : path('app_account_private_activities_new') }}" class="tm-menu__item">{{ (is_provider ? 'Créer une activité' : 'Organiser une activité')|trans }}</a>
                        <a href="{{ path('app_event_guide') }}" class="tm-menu__item">{{ 'Créer un événement'|trans }}</a>
                        <a href="{{ path('app_provider_search') }}" class="tm-menu__item">{{ 'Trouver un professionnel'|trans }}</a>
                        {% if not is_provider %}<a href="{{ path('app_account_requests_new') }}" class="tm-menu__item">{{ 'Déposer une demande'|trans }}</a>{% endif %}
                    </div>
                </details>

                <a href="{{ path('app_destinations') }}" class="tm-nav__link{{ active == 'destinations' ? ' is-active' }}">{{ 'Destinations'|trans }}</a>

                <a href="{{ path('app_favorites_page') }}" class="tm-nav__link{{ active == 'favoris' ? ' is-active' }}">
                    <span class="tm-nav__icon">{{ icon.heart(20) }}</span> {{ 'Mes favoris'|trans }}
                </a>

                <a href="{{ path('app_photo_albums') }}" class="tm-nav__link tm-nav__link--badged{{ active == 'album' ? ' is-active' }}">
                    {{ 'Album photo'|trans }}
                    <span class="tm-nav__badge">{{ 'Nouveau'|trans }}</span>
                </a>

                <a href="{{ is_provider ? path('app_pro_notifications') : path('app_account_notifications') }}" class="tm-nav__link{{ active == 'notifications' ? ' is-active' }}">
                    <span class="tm-nav__icon">{{ icon.bell(20) }}</span>
                    {{ 'Notifications'|trans }}
                    {# Maquette : pastille rouge en exposant après le libellé. #}
                    {% if app.user %}
                        {% set unreadNotifications = unread_notifications_count(app.user) %}
                        {% if unreadNotifications > 0 %}
                            <span class="tm-nav__count">{{ unreadNotifications > 99 ? '99+' : unreadNotifications }}</span>
                        {% endif %}
                    {% endif %}
                </a>
            </nav>
        </div>

        <div class="tm-header__actions">
            {% include '_partials/_account_menu.html.twig' %}

            {# Le professionnel ouvre l'assistant de création (05/10) ; le
               visiteur, la présentation de l'offre professionnelle. #}
            <a href="{{ is_provider ? path('app_pro_activities_new') : path('app_corporate_partner') }}" class="tm-btn tm-btn--cta">{{ 'Déposer une activité'|trans }}</a>

            <button class="tm-burger" type="button" data-bs-toggle="offcanvas" data-bs-target="#tmNav"
                    aria-controls="tmNav" aria-label="{{ 'Ouvrir le menu'|trans }}">
                <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
            </button>
        </div>
    </div>
</header>
