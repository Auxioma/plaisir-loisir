{# Pied de page principal, présent en bas de toutes les pages. #}
{% import '_partials/_icons.html.twig' as icon %}

<footer class="pl-footer">
    <div class="pl-footer__inner">
        <div class="pl-footer__columns">
            {# Marque + description + réseaux sociaux #}
            <div class="pl-footer__brand">
                <img class="pl-footer__brand-logo" src="{{ asset('images/logo.svg') }}" alt="TrouveMoi Plaisir & Loisirs">
                <p class="pl-footer__brand-text">{{ 'La plateforme qui vous aide à trouver les meilleures activités et loisirs partout en France.'|trans }}</p>
                <div class="pl-footer__socials">
                    <a href="#" aria-label="Facebook">{{ icon.facebook() }}</a>
                    <a href="#" aria-label="YouTube">{{ icon.youtube() }}</a>
                    <a href="#" aria-label="TikTok">{{ icon.tiktok() }}</a>
                    <a href="#" aria-label="Instagram">{{ icon.instagram() }}</a>
                </div>
            </div>

            {# Colonne Explorer #}
            <div class="pl-footer__col">
                <div class="pl-footer__col-title">{{ 'Explorer'|trans }}</div>
                <div class="pl-footer__links">
                    <a href="{{ path('app_activities') }}">{{ 'Activités'|trans }}</a>
                    <a href="{{ path('app_destinations') }}">{{ 'Destinations'|trans }}</a>
                    <a href="{{ path('app_events_private') }}">{{ 'Activités privées'|trans }}</a>
                    <a href="{{ path('app_gifts') }}">{{ 'Bons cadeaux'|trans }}</a>
                    <a href="{{ path('app_offers') }}">{{ 'Offres du moment'|trans }}</a>
                </div>
            </div>

            {# Colonne À propos #}
            <div class="pl-footer__col">
                <div class="pl-footer__col-title">{{ 'À propos'|trans }}</div>
                <div class="pl-footer__links">
                    <a href="{{ path('app_corporate_about') }}">{{ 'Qui sommes-nous ?'|trans }}</a>
                    <a href="{{ path('app_corporate_partner') }}">{{ 'Devenir prestataire'|trans }}</a>
                    <a href="{{ path('app_corporate_careers') }}">{{ 'Carrières'|trans }}</a>
                    <a href="#">{{ 'Presse'|trans }}</a>
                    <a href="{{ path('app_corporate_contact') }}">{{ 'Contact'|trans }}</a>
                </div>
            </div>

            {# Colonne Aide & support #}
            <div class="pl-footer__col">
                <div class="pl-footer__col-title">{{ 'Aide & support'|trans }}</div>
                <div class="pl-footer__links">
                    <a href="{{ path('app_help_center') }}">{{ "Centre d'aide"|trans }}</a>
                    <a href="{{ path('app_faq') }}">FAQ</a>
                    <a href="{{ path('app_corporate_terms') }}">{{ "Conditions générales d'utilisation"|trans }}</a>
                    <a href="{{ path('app_corporate_sales_terms') }}">{{ 'Conditions générales de vente'|trans }}</a>
                    <a href="{{ path('app_corporate_privacy') }}">{{ 'Politique de confidentialité'|trans }}</a>
                    <a href="{{ path('app_corporate_cookies') }}">{{ 'Politique de cookies'|trans }}</a>
                    <a href="{{ path('app_corporate_legal') }}">{{ 'Mentions légales'|trans }}</a>
                </div>
            </div>

            {# Colonne Paiement sécurisé #}
            <div class="pl-footer__col">
                <div class="pl-footer__col-title">{{ 'Paiement sécurisé'|trans }}</div>
                <div class="pl-footer__payments">
                    {{ icon.pay_visa() }}
                    {{ icon.pay_mastercard() }}
                    {{ icon.pay_paypal() }}
                    {{ icon.pay_applepay() }}
                </div>
            </div>
        </div>

        <hr class="pl-footer__divider">

        <div class="pl-footer__bottom">
            <span>©2024 TrouveMoi Plaisirs &amp; Loisirs | {{ 'Tous droits réservés'|trans }}</span>
            <div class="pl-footer__selectors">
                <button type="button" class="pl-footer__chip">{{ icon.globe() }} France {{ icon.chevron_down(16) }}</button>
                {# Sélecteur de langue fonctionnel (menu ouvert vers le haut). #}
                <details class="pl-dropdown pl-dropdown--footer">
                    <summary class="pl-footer__chip">{{ icon.translate() }} {{ app.request.locale == 'en' ? 'English' : 'Français' }} {{ icon.chevron_down(16) }}</summary>
                    <div class="pl-dropdown__menu pl-dropdown__menu--up">
                        <a href="{{ locale_switch_path('fr') }}" class="pl-dropdown__item{{ app.request.locale != 'en' ? ' is-active' }}">{{ icon.flag_fr(20) }} {{ 'Français'|trans }}</a>
                        <a href="{{ locale_switch_path('en') }}" class="pl-dropdown__item{{ app.request.locale == 'en' ? ' is-active' }}">{{ icon.flag_gb(20) }} {{ 'Anglais'|trans }}</a>
                    </div>
                </details>
            </div>
        </div>
    </div>
</footer>
