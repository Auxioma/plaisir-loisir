{#
    Pied de page UNIQUE de la plateforme — maquette choix_profil.jpeg (30/09).
    Styles : assets/styles/layout.css (.tm-footer).

    Maquette : cinq liens seulement dans « Aide & support ». CGV et politique
    de cookies n'y figurent pas, mais aucune autre page n'y mène et leur accès
    est une obligation légale (vente en ligne, RGPD) : ils sont posés,
    discrets, dans la ligne du copyright. À retirer si le client les place
    ailleurs.

    Le sélecteur « France » en bas à droite porte la langue : elle vit dans
    l'URL, chaque choix mène donc à la MÊME page dans l'autre langue.
#}
{% import '_partials/_icons.html.twig' as icon %}

<footer class="tm-footer">
    <div class="tm-footer__inner">
        <div class="tm-footer__grid">
            <div class="tm-footer__brand">
                <img class="tm-footer__logo" loading="lazy" src="{{ asset('images/logo-trouvemoi-horizontal.webp') }}" alt="TrouveMoi Plaisirs &amp; Loisirs" width="169" height="36">
                <p class="tm-footer__text">{{ 'La plateforme qui vous aide à trouver les meilleures activités et loisirs partout en France.'|trans }}</p>
                <div class="tm-footer__socials">
                    {# Un réseau sans adresse (variable SOCIAL_* vide) n'est pas affiché. #}
                    {% if social_links.facebook %}<a href="{{ social_links.facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{{ icon.facebook(12) }}</a>{% endif %}
                    {% if social_links.instagram %}<a href="{{ social_links.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{{ icon.instagram(12) }}</a>{% endif %}
                    {% if social_links.tiktok %}<a href="{{ social_links.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{{ icon.tiktok(12) }}</a>{% endif %}
                    {% if social_links.youtube %}<a href="{{ social_links.youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{{ icon.youtube(12) }}</a>{% endif %}
                </div>
            </div>

            <nav class="tm-footer__col" aria-label="{{ 'Découvrir'|trans }}">
                <a class="tm-footer__title" href="{{ path('app_explore') }}">{{ 'Découvrir'|trans }}</a>
                <a href="{{ path('app_activities') }}">{{ 'Activités des professionnels'|trans }}</a>
                <a href="{{ path('app_destinations') }}">{{ 'Destinations'|trans }}</a>
                <a href="{{ path('app_private_activities') }}">{{ 'Activités gratuites'|trans }}</a>
                <a href="{{ path('app_gifts') }}">{{ 'Bons cadeaux'|trans }}</a>
                <a href="{{ path('app_offers') }}">{{ 'Offres du moment'|trans }}</a>
                <a href="{{ path('app_corporate_partner') }}">{{ 'Partenaire'|trans }}</a>
            </nav>

            <nav class="tm-footer__col" aria-label="{{ 'À propos'|trans }}">
                <div class="tm-footer__title">{{ 'À propos'|trans }}</div>
                <a href="{{ path('app_corporate_about') }}">{{ 'Qui sommes-nous ?'|trans }}</a>
                <a href="{{ path('app_corporate_partner') }}">{{ 'Devenir partenaire'|trans }}</a>
                <a href="{{ path('app_corporate_careers') }}">{{ 'Carrières'|trans }}</a>
                <a href="{{ path('app_corporate_contact', {sujet: 'presse'}) }}">{{ 'Presse'|trans }}</a>
                <a href="{{ path('app_corporate_contact') }}">{{ 'Contact'|trans }}</a>
            </nav>

            <nav class="tm-footer__col" aria-label="{{ 'Aide & support'|trans }}">
                <div class="tm-footer__title">{{ 'Aide & support'|trans }}</div>
                <a href="{{ path('app_help_center') }}">{{ "Centre d'aide"|trans }}</a>
                <a href="{{ path('app_faq') }}">FAQ</a>
                <a href="{{ path('app_corporate_terms') }}">{{ 'Conditions générales'|trans }}</a>
                <a href="{{ path('app_corporate_privacy') }}">{{ 'Politique de confidentialité'|trans }}</a>
                <a href="{{ path('app_corporate_legal') }}">{{ 'Mentions légales'|trans }}</a>
            </nav>

            <div class="tm-footer__col">
                <div class="tm-footer__title">{{ 'Paiement sécurisé'|trans }}</div>
                <div class="tm-footer__payments">
                    {{ icon.paycard_visa() }}
                    {{ icon.paycard_mastercard() }}
                    {{ icon.paycard_paypal() }}
                    {{ icon.paycard_applepay() }}
                </div>
            </div>
        </div>

        <div class="tm-footer__bottom">
            <div class="tm-footer__legal">
                <span>© {{ 'now'|date('Y') }} TrouveMoi Plaisirs &amp; Loisirs – {{ 'Tous droits réservés'|trans }}</span>
                <a href="{{ path('app_corporate_sales_terms') }}">{{ 'Conditions générales de vente'|trans }}</a>
                <a href="{{ path('app_corporate_cookies') }}">{{ 'Politique de cookies'|trans }}</a>
                <a href="{{ path('app_corporate_cookies') }}" data-cookie-open>{{ 'Gérer mes cookies'|trans }}</a>
            </div>
            {# Langue (13/10) : deux boutons toujours visibles plutôt qu'un menu
               déroulant, qui s'ouvrait hors de l'écran sur mobile. #}
            <nav class="tm-footer__locale" aria-label="{{ 'Langue'|trans }}">
                <a href="{{ locale_switch_path('fr') }}" hreflang="fr" lang="fr" class="tm-footer__lang{{ app.request.locale != 'en' ? ' is-active' }}"{{ app.request.locale != 'en' ? ' aria-current="true"' }}>{{ icon.flag_fr(16) }} Français</a>
                <a href="{{ locale_switch_path('en') }}" hreflang="en" lang="en" class="tm-footer__lang{{ app.request.locale == 'en' ? ' is-active' }}"{{ app.request.locale == 'en' ? ' aria-current="true"' }}>{{ icon.flag_gb(16) }} English</a>
            </nav>
        </div>
    </div>
</footer>
