{# Pied de page principal, présent en bas de toutes les pages. #}
{% import '_partials/_icons.html.twig' as icon %}

<footer class="pl-footer">
    <div class="pl-footer__inner">
        <div class="pl-footer__columns">
            {# Marque + description + réseaux sociaux #}
            <div class="pl-footer__brand">
                <img class="pl-footer__brand-logo" src="{{ asset('images/logo.svg') }}" alt="TrouveMoi Plaisir & Loisirs">
                <p class="pl-footer__brand-text">La plateforme qui vous aide à trouver les meilleures activités et loisirs partout en France.</p>
                <div class="pl-footer__socials">
                    <a href="#" aria-label="Facebook">{{ icon.facebook() }}</a>
                    <a href="#" aria-label="YouTube">{{ icon.youtube() }}</a>
                    <a href="#" aria-label="TikTok">{{ icon.tiktok() }}</a>
                    <a href="#" aria-label="Instagram">{{ icon.instagram() }}</a>
                </div>
            </div>

            {# Colonne Explorer #}
            <div class="pl-footer__col">
                <div class="pl-footer__col-title">Explorer</div>
                <div class="pl-footer__links">
                    <a href="{{ path('app_activities') }}">Activités</a>
                    <a href="{{ path('app_destinations') }}">Destinations</a>
                    <a href="#">Activités privées</a>
                    <a href="{{ path('app_gifts') }}">Bons cadeaux</a>
                    <a href="#">Offres du moment</a>
                </div>
            </div>

            {# Colonne À propos #}
            <div class="pl-footer__col">
                <div class="pl-footer__col-title">À propos</div>
                <div class="pl-footer__links">
                    <a href="#">Qui sommes-nous ?</a>
                    <a href="#">Devenir prestataire</a>
                    <a href="#">Carrières</a>
                    <a href="#">Presse</a>
                    <a href="#">Contact</a>
                </div>
            </div>

            {# Colonne Aide & support #}
            <div class="pl-footer__col">
                <div class="pl-footer__col-title">Aide &amp; support</div>
                <div class="pl-footer__links">
                    <a href="#">Centre d'aide</a>
                    <a href="#">FAQ</a>
                    <a href="#">Conditions générales</a>
                    <a href="#">Politique de confidentialité</a>
                    <a href="#">Mentions légales</a>
                </div>
            </div>

            {# Colonne Paiement sécurisé #}
            <div class="pl-footer__col">
                <div class="pl-footer__col-title">Paiement sécurisé</div>
                <div class="pl-footer__payments">
                    {{ icon.pay_visa() }}
                    {{ icon.pay_mastercard() }}
                    {{ icon.pay_paypal() }}
                    {{ icon.pay_applepay() }}
                </div>
            </div>
        </div>

        <hr class="pl-footer__divider">

        <div class="pl-footer__bottom">
            <span>©2024 TrouveMoi Plaisirs &amp; Loisirs | Tous droits réservés</span>
            <div class="pl-footer__selectors">
                <button type="button" class="pl-footer__chip">{{ icon.globe() }} France {{ icon.chevron_down(16) }}</button>
                <button type="button" class="pl-footer__chip">{{ icon.translate() }} Français {{ icon.chevron_down(16) }}</button>
            </div>
        </div>
    </div>
</footer>
