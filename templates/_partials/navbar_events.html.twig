{#
    En-tête du contexte « Événements » (variante C de la spec Événements) :
    même structure que le header commun mais navigation propre au flow
    (Événements actif violet, Groupe & Clubs, Calendrier, Événements
    privés) et CTA « Créer un événement » en VIOLET plein (≠ orange).
    Typos maquette corrigées : « Créer un évenement » → événement,
    « Evénément privées » → Événements privés, « S'incrire » → S'inscrire.
#}
{% import '_partials/_icons.html.twig' as icon %}

<header class="pl-navbar pl-navbar--connected">
    <div class="pl-navbar__inner">
        <div class="pl-navbar__left">
            <a href="{{ path('app_home') }}" class="pl-navbar__logo" aria-label="Accueil TrouveMoi">
                <img src="{{ asset('images/logo.svg') }}" alt="TrouveMoi Plaisir & Loisirs">
            </a>

            <nav class="pl-nav pl-nav--connected" aria-label="Navigation principale">
                <a href="{{ path('app_event_create') }}" class="pl-nav__link is-active">Événements</a>
                <a href="#" class="pl-nav__link">Groupe &amp; Clubs</a>
                <a href="#" class="pl-nav__link">Calendrier</a>
                <a href="#" class="pl-nav__link pl-nav__link--badged">Événements privés <span class="pl-nav__badge">Nouveau</span></a>
            </nav>
        </div>

        <div class="pl-navbar__actions">
            <a href="{{ path('app_event_create') }}" class="pl-btn pl-btn--primary">Créer un événement</a>
            <a href="{{ path('app_auth_choice') }}" class="pl-btn pl-btn--outline-dark pl-btn--signup">{{ icon.person(18) }} S'inscrire</a>
        </div>
    </div>
</header>
