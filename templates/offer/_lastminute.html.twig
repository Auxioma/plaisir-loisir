{# Section « Dernière minutes » : en-tête + 4 cartes en mode last-minute. #}
{% import '_partials/_icons.html.twig' as icon %}

<section class="act-section">
    <div class="container">
        <div class="home-section__head">
            <div>
                <h2 class="home-section__title">{{ 'Dernière minutes'|trans }}</h2>
            </div>
            <a href="{{ path('app_offers_all') }}" class="btn-see-all">{{ 'Voir toutes les dernières minutes'|trans }} {{ icon.arrow_up_right(16) }}</a>
        </div>
        <div class="card-grid">
            {% for o in lastMinute %}
                {% include 'offer/_card.html.twig' with { o: o } %}
            {% endfor %}
        </div>
    </div>
</section>
