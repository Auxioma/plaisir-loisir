{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}Offres du moments{% endblock %}
{% block meta_description %}Profitez des meilleures offres et promotions sur vos activités préférées : réductions jusqu'à -50%, ventes flash et dernières minutes.{% endblock %}

{% block header %}
    {% include '_partials/navbar.html.twig' with { connected: true, nav_active: 'offres' } %}
{% endblock %}

{% block body %}
<div class="of-page">

    {# ==================================================================
       HERO : famille aux valises jaunes + voile blanc + blob orange -50%.
       ================================================================ #}
    <section class="of-hero">
        <img class="of-hero__bg" src="{{ asset('images/offers/hero-offres.jpg') }}" alt="">
        <div class="of-hero__overlay" aria-hidden="true"></div>
        <div class="home-container of-hero__inner">
            <h1 class="of-hero__title">Offres du moments</h1>
            <p class="of-hero__subtitle">Profitez des meilleures offres et promotions sur vos activités préférées.</p>
            <div class="of-hero__pills">
                <span class="home-pill">{{ icon.tag(16) }} Meilleur prix garanti</span>
                <span class="home-pill">{{ icon.gift(16) }} Offres limitées</span>
                <span class="home-pill">{{ icon.calendar(16) }} Réservation immédiate</span>
                <span class="home-pill">{{ icon.ban(16) }} Annulation facile</span>
            </div>
        </div>
        {# Blob orange organique « Jusqu'à -50% » (décor signature). #}
        <div class="of-hero__blob" aria-hidden="true">
            <svg viewBox="0 0 200 200" class="of-hero__blob-shape">
                <path fill="var(--pl-cta)" d="M55 22c25-16 62-22 85-8 22 13 34 42 30 68-3 22-18 38-33 55-16 18-40 32-63 26-24-6-40-30-48-54-8-25-6-52 8-68 8-9 13-13 21-19z"/>
            </svg>
            <span class="of-hero__blob-spark of-hero__blob-spark--1"></span>
            <span class="of-hero__blob-spark of-hero__blob-spark--2"></span>
            <div class="of-hero__blob-text">
                <span class="of-hero__blob-upto">Jusqu'à</span>
                <span class="of-hero__blob-pct">-50%</span>
                <span class="of-hero__blob-note">Sur une sélection d'activités</span>
            </div>
        </div>
    </section>

    <div class="home-container">
        <nav class="act-breadcrumb of-breadcrumb" aria-label="Fil d'Ariane">
            <a href="{{ path('app_home') }}">Accueil</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Offres du moments</span>
        </nav>
    </div>

    {# ==================================================================
       CATEGORIES POPULAIRES : pastilles pleines colorées + volume.
       ================================================================ #}
    <section class="home-section">
        <div class="home-container">
            <div class="home-section__head">
                <div>
                    <h2 class="home-section__title">Categories populaires</h2>
                    <p class="home-section__subtitle">Des réductions dans toutes vos catégories préférées : trouvez l'offre qui vous ressemble.</p>
                </div>
                <a href="{{ path('app_offers_all') }}" class="btn-see-all">Voir toutes les offres {{ icon.arrow_up_right(16) }}</a>
            </div>
            <div class="of-cats">
                {% for c in categories %}
                    <a href="{{ path('app_offers_all') }}" class="of-cat">
                        <span class="of-cat__icon of-cat__icon--{{ c.color }}">
                            {%- if c.icon == 'sports' %}{{ icon.cat_sports(18) }}
                            {%- elseif c.icon == 'crafts' %}{{ icon.cat_crafts(18) }}
                            {%- elseif c.icon == 'wellness' %}{{ icon.cat_wellness(18) }}
                            {%- elseif c.icon == 'culture' %}{{ icon.cat_culture(18) }}
                            {%- elseif c.icon == 'family' %}{{ icon.cat_family(18) }}
                            {%- else %}{{ icon.flame(18) }}
                            {%- endif %}
                        </span>
                        <span class="of-cat__name">{{ c.name }}</span>
                        <span class="of-cat__count">{{ c.count }}</span>
                    </a>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ==================================================================
       OFFRES EXCLUSIVES POUR VOUS.
       ================================================================ #}
    <section class="act-section">
        <div class="home-container">
            <h2 class="home-section__title of-section-title">Offres exclusives pour vous</h2>
            <div class="card-grid">
                {% for o in exclusives %}
                    {% include 'offer/_card.html.twig' with { o: o } %}
                {% endfor %}
            </div>
        </div>
    </section>

    {# ==================================================================
       BANNIÈRE VENTE FLASH (spec C3).
       ================================================================ #}
    <section class="home-section">
        <div class="home-container">
            <div class="of-flash">
                <div class="of-flash__promo" aria-hidden="true">
                    <svg class="of-flash__bolt of-flash__bolt--left" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/></svg>
                    <div class="of-flash__panel">
                        <span class="of-flash__upto">Jusqu'à</span>
                        <span class="of-flash__pct">-50%</span>
                        <span class="of-flash__note">Sur une sélection d'activités</span>
                    </div>
                    <svg class="of-flash__bolt of-flash__bolt--right" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/></svg>
                </div>
                <div class="of-flash__text">
                    <h2 class="of-flash__title">Vente Flash</h2>
                    <p class="of-flash__tagline">Offres limitées à ne pas manquer&nbsp;!</p>
                    <p class="of-flash__desc">Ne manquez pas nos meilleures offres de la saison. Profitez dès maintenant de réductions sur vos activités préférées.</p>
                    <div class="of-flash__count" role="timer" aria-label="Fin de la vente flash">
                        <span class="of-flash__cell"><strong>10</strong>Jours</span>
                        <span class="of-flash__cell"><strong>08</strong>Heures</span>
                        <span class="of-flash__cell"><strong>23</strong>Min.</span>
                        <span class="of-flash__cell"><strong>47</strong>Secondes</span>
                    </div>
                    <a href="{{ path('app_offers_all') }}" class="pl-btn pl-btn--cta">Découvrir toutes les offres</a>
                </div>
            </div>
        </div>
    </section>

    {% include 'offer/_lastminute.html.twig' with { lastMinute: lastMinute } %}

    <div class="home-container of-news-wrap">
        {% include 'offer/_newsletter.html.twig' %}
    </div>

</div>
{% endblock %}
