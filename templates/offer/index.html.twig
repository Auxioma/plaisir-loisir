{#
    « Offres du moment » — maquette docs/maquettes/offres_moments.jpeg (04/10).
    Données réelles : OfferController::index() (promotions en cours des
    professionnels via OfferCatalog). Styles : assets/styles/pages.css (.ofm-*).
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}
{% import 'provider/space/_ico.html.twig' as ico %}

{% block title %}{{ 'Offres du moment'|trans }}{% endblock %}
{% block meta_description %}{{ 'Profitez des meilleures offres et promotions sur vos activités préférées.'|trans }}{% endblock %}

{% macro price(v) %}{{ v is null ? '' : v|number_format(v == v|round ? 0 : 2, ',', ' ') ~ ' €' }}{% endmacro %}

{% block body %}
<div class="pg ofm">
    <header class="ofm-hero">
        <img class="ofm-hero__bg" src="{{ asset('images/offers/hero-offres.jpg') }}" alt="">
        <div class="ofm-hero__text">
            <h1>{{ 'Offres du moment'|trans }} 🔥</h1>
            <p>{{ 'Profitez des meilleures offres et promotions sur vos activités préférées'|trans }}</p>
            <ul class="ofm-hero__chips">
                <li>{{ icon.check_badge(16) }} {{ 'Meilleurs prix garantis'|trans }}</li>
                <li>{{ icon.flame(16) }} {{ 'Offres limitées'|trans }}</li>
                <li>{{ icon.zap(16) }} {{ 'Réservation immédiate'|trans }}</li>
                <li>{{ icon.shield_check(16) }} {{ 'Annulation facile'|trans }}</li>
            </ul>
        </div>
        {% if max_discount > 0 %}
            <div class="ofm-hero__burst"><small>{{ 'Jusqu’à'|trans }}</small><strong>-{{ max_discount }}%</strong><small>{{ 'sur une sélection d’activités'|trans }}</small></div>
        {% endif %}
    </header>

    <nav class="pg-wrap ofm-tiles" aria-label="{{ 'Catégories'|trans }}">
        <a class="ofm-tile{{ filters.categorie == '' ? ' is-active' }}" href="{{ path('app_offers', params|merge({categorie: null})) }}">
            <span class="ofm-tile__ico is-blue">{{ icon.gift(22) }}</span><span><strong>{{ 'Toutes les offres'|trans }}</strong><small>{{ all_count }} {{ all_count > 1 ? 'offres'|trans : 'offre'|trans }}</small></span>
        </a>
        {% for t in tiles %}
            <a class="ofm-tile{{ filters.categorie == t.slug ? ' is-active' }}{{ t.count == 0 ? ' is-empty' }}" href="{{ path('app_offers', params|merge({categorie: t.slug})) }}">
                <span class="ofm-tile__ico is-{{ t.icon[1] }}">{{ ico.svg(t.icon[0], 22) }}</span><span><strong>{{ t.name|trans }}</strong><small>{{ t.count }} {{ t.count > 1 ? 'offres'|trans : 'offre'|trans }}</small></span>
            </a>
        {% endfor %}
    </nav>

    <div class="pg-wrap ofm-layout">
        <aside class="ofm-filters">
            <form method="get" action="{{ path('app_offers') }}" id="ofm-filters">
                {% if filters.categorie %}<input type="hidden" name="categorie" value="{{ filters.categorie }}">{% endif %}
                {% if filters.tri != 'meilleures' %}<input type="hidden" name="tri" value="{{ filters.tri }}">{% endif %}
                <div class="ofm-filters__head"><h2>{{ 'Filtres'|trans }}</h2><a href="{{ path('app_offers') }}">{{ 'Réinitialiser'|trans }}</a></div>
                <fieldset>
                    <legend>{{ 'Prix'|trans }}</legend>
                    <div class="ofm-range"><span>0 €</span><output id="ofm-prix-out">{{ filters.prix }} €</output></div>
                    <input type="range" name="prix" min="0" max="500" step="10" value="{{ filters.prix }}" data-pg-range="ofm-prix-out" aria-label="{{ 'Prix maximum'|trans }}">
                </fieldset>
                <fieldset>
                    <legend>{{ 'Réduction'|trans }}</legend>
                    {% for r in [10, 20, 30, 40, 50] %}<label class="ofm-check"><input type="checkbox" name="reduction[]" value="{{ r }}"{{ r in filters.reduction ? ' checked' }}> -{{ r }}% {{ 'et plus'|trans }}</label>{% endfor %}
                </fieldset>
                <fieldset>
                    <legend>{{ 'Disponibilité'|trans }}</legend>
                    {% for k, label in availability %}<label class="ofm-check"><input type="checkbox" name="dispo[]" value="{{ k }}"{{ k in filters.dispo ? ' checked' }}> {{ label|trans }}</label>{% endfor %}
                </fieldset>
                <fieldset>
                    <legend>{{ "Type d'offre"|trans }}</legend>
                    {% for k, label in types %}<label class="ofm-check"><input type="checkbox" name="type[]" value="{{ k }}"{{ k in filters.type ? ' checked' }}> {{ label|trans }}</label>{% endfor %}
                </fieldset>
                <button class="pg-btn pg-btn--block">{{ 'Voir les'|trans }} {{ total }} {{ total > 1 ? 'offres'|trans : 'offre'|trans }}</button>
            </form>
        </aside>

        <div class="ofm-main">
            <div class="ofm-bar">
                <h2 class="pg-h3">{{ 'Offres exclusives pour vous'|trans }} 🎉</h2>
                <form method="get" class="ofm-sort">
                    {% for k, v in params|filter((v, k) => k != 'tri') %}
                        {% if v is iterable %}{% for x in v %}<input type="hidden" name="{{ k }}[]" value="{{ x }}">{% endfor %}{% else %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endif %}
                    {% endfor %}
                    <label for="ofm-tri">{{ 'Trier par'|trans }}</label>
                    <select id="ofm-tri" name="tri" onchange="this.form.submit()">{% for k, label in sorts %}<option value="{{ k }}"{{ filters.tri == k ? ' selected' }}>{{ label|trans }}</option>{% endfor %}</select>
                    <noscript><button class="pg-link">OK</button></noscript>
                </form>
            </div>

            {% if offers is empty %}
                <div class="ofm-empty">{{ icon.tag(32) }}<strong>{{ 'Aucune offre ne correspond à vos critères.'|trans }}</strong><a class="pg-btn pg-btn--outline" href="{{ path('app_offers') }}">{{ 'Voir toutes les offres'|trans }}</a></div>
            {% else %}
                <div class="ofm-grid">
                    {% for o in offers %}
                        <article class="ofm-card" id="of-{{ loop.index }}">
                            <a class="ofm-card__media" href="{{ path('app_activity_show', {slug: o.slug, offre: o.id}) }}">
                                <img src="{{ asset(o.image) }}" alt="{{ o.title }}" loading="lazy">
                                <span class="ofm-badge{{ o.discount is null ? ' is-alt' }}">{{ o.badge|trans }}</span>
                                <span class="ofm-card__timer">{{ icon.clock(13) }} {{ 'Se termine dans'|trans }} <b data-pg-countdown="{{ o.endsAt|date('c') }}"></b></span>
                            </a>
                            {% include '_partials/_event_fav.html.twig' with { type: 'activite', key: o.slug, class: 'ofm-card__fav' } %}
                            <div class="ofm-card__body">
                                <small class="ofm-card__place">{{ icon.map_pin(12) }} {{ o.place }}</small>
                                <a class="ofm-card__title" href="{{ path('app_activity_show', {slug: o.slug, offre: o.id}) }}">{{ o.title }}</a>
                                <small class="ofm-card__offer">{{ o.offer }}</small>
                                <div class="ofm-card__row">
                                    <span>
                                        {% if o.rating %}<small>{{ icon.star_solid(13) }} {{ o.rating }} ({{ o.reviews }})</small>{% endif %}
                                        {% if o.duration %}<small>{{ icon.clock(13) }} {{ o.duration }}</small>{% endif %}
                                    </span>
                                    <span class="ofm-price">{% if o.oldPrice %}<s>{{ _self.price(o.oldPrice) }}</s>{% endif %}<strong>{{ _self.price(o.price) }}</strong></span>
                                </div>
                                <a class="pg-btn pg-btn--outline pg-btn--block" href="{{ path('app_activity_show', {slug: o.slug, offre: o.id}) }}">{{ "Voir l'offre"|trans }}</a>
                            </div>
                        </article>
                    {% endfor %}
                </div>
                {% if has_more %}
                    <a class="ofm-more" href="{{ path('app_offers', params|merge({page: page + 1})) }}#of-{{ offers|length + 1 }}">{{ "Voir plus d'offres"|trans }} {{ icon.chevron_down(16) }}</a>
                {% endif %}
            {% endif %}

            {% if last_minute is not empty %}
                <div class="ofm-bar ofm-bar--mt">
                    <h2 class="pg-h3">{{ 'Dernière minute'|trans }} {{ icon.clock(18) }}</h2>
                    <a class="pg-link" href="{{ path('app_offers', {dispo: ['derniere-minute'], tri: 'fin'}) }}">{{ 'Voir toutes les dernières minutes'|trans }} {{ icon.arrow_right(14) }}</a>
                </div>
                <div class="ofm-last">
                    {% for o in last_minute %}
                        {% set ends = o.endsAt|date('Y-m-d') %}
                        <a class="ofm-mini" href="{{ path('app_activity_show', {slug: o.slug, offre: o.id}) }}">
                            <span class="ofm-mini__media">
                                <img src="{{ asset(o.image) }}" alt="" loading="lazy">
                                <span class="ofm-badge{{ o.discount is null ? ' is-alt' }}">{{ o.badge|trans }}</span>
                                <span class="ofm-mini__when">{{ ends == 'now'|date('Y-m-d') ? 'Aujourd’hui'|trans : (ends == '+1 day'|date('Y-m-d') ? 'Demain'|trans : 'Jusqu’au'|trans ~ ' ' ~ o.endsAt|date('d/m')) }}</span>
                            </span>
                            <strong>{{ o.title }}</strong>
                            <small>{{ o.place }}</small>
                            <span class="ofm-card__row">{% if o.rating %}<small>{{ icon.star_solid(12) }} {{ o.rating }} ({{ o.reviews }})</small>{% else %}<small></small>{% endif %}<span class="ofm-price">{% if o.oldPrice %}<s>{{ _self.price(o.oldPrice) }}</s>{% endif %}<strong>{{ _self.price(o.price) }}</strong></span></span>
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <aside class="ofm-side">
            {% if flash %}
                <section class="ofm-flash">
                    <h2>{{ 'Vente flash'|trans }} ⚡</h2>
                    <p>{{ 'Offres limitées à ne pas manquer !'|trans }}</p>
                    <div class="ofm-flash__count" data-pg-countdown="{{ flash.endsAt|date('c') }}">
                        <span><b data-unit="j">00</b>{{ 'Jours'|trans }}</span><span><b data-unit="h">00</b>{{ 'Heures'|trans }}</span><span><b data-unit="m">00</b>{{ 'Min'|trans }}</span><span><b data-unit="s">00</b>{{ 'Sec'|trans }}</span>
                    </div>
                    <p class="ofm-flash__big"><small>{{ flash.title }}</small><strong>{{ flash.badge|trans }}</strong>{% if flash.oldPrice %}<small><s>{{ _self.price(flash.oldPrice) }}</s> → {{ _self.price(flash.price) }}</small>{% endif %}</p>
                    <a class="ofm-flash__btn" href="{{ path('app_activity_show', {slug: flash.slug, offre: flash.id}) }}">{{ "Profiter de l'offre"|trans }}</a>
                </section>
            {% endif %}
            <section class="ofm-news">
                <h2>{{ 'Ne manquez aucune offre !'|trans }}</h2>
                <p>{{ 'Recevez les meilleures offres directement dans votre boîte mail.'|trans }}</p>
                <form method="post" action="{{ path('app_newsletter_subscribe') }}" data-newsletter>
                    <input type="hidden" name="_token" value="{{ csrf_token('newsletter') }}">
                    <input type="hidden" name="source" value="offres">
                    <label class="visually-hidden" for="ofm-email">{{ 'Votre email'|trans }}</label>
                    <input id="ofm-email" type="email" name="email" placeholder="{{ 'Votre email'|trans }}" required maxlength="180" autocomplete="email">
                    <button class="pg-btn">{{ "S'abonner"|trans }}</button>
                </form>
                <p class="ofm-news__msg" data-newsletter-msg role="status" hidden></p>
            </section>
        </aside>
    </div>

    <ul class="pg-wrap ofm-features">
        <li>{{ icon.check_badge(26) }}<span><strong>{{ 'Meilleurs prix garantis'|trans }}</strong><small>{{ 'Des offres négociées avec nos partenaires'|trans }}</small></span></li>
        <li>{{ icon.shield_check(26) }}<span><strong>{{ 'Réservation sécurisée'|trans }}</strong><small>{{ 'Paiement 100% sécurisé'|trans }}</small></span></li>
        <li>{{ icon.calendar_check(26) }}<span><strong>{{ 'Annulation facile'|trans }}</strong><small>{{ 'Jusqu’à 24h avant'|trans }}</small></span></li>
        <li>{{ icon.headset(26) }}<span><strong>{{ 'Support 7j/7'|trans }}</strong><small>{{ 'Notre équipe à votre écoute'|trans }}</small></span></li>
    </ul>
</div>
{% endblock %}
