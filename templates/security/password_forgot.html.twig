{#
    Mot de passe oublié — étape 1/3 : saisie de l'e-mail.
    ⚠️ Front-end uniquement : le bouton « Envoyer » enchaîne visuellement vers
    l'étape suivante. L'envoi réel du code par e-mail sera branché plus tard.
#}
{% extends 'security/_layout.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Mot de passe oublié'|trans }}{% endblock %}

{% block auth_card %}
    <div class="auth-card auth-card--pw">
        <a class="auth-back" href="{{ path('app_login') }}">{{ icon.chevron_left(20) }} {{ 'Retour à la page de connexion'|trans }}</a>

        <div class="auth-card__header">
            <h2 class="auth-card__title">{{ 'Vous avez oublié votre mot de passe ?'|trans }}</h2>
            <p class="auth-card__subtitle">{{ 'Pas de panique, ça arrive à tout le monde. Entrez votre adresse e-mail ci-dessous pour le récupérer.'|trans }}</p>
        </div>

        <div class="auth-fields">
            <div class="auth-field">
                <label class="auth-field__label" for="inputEmail">{{ 'Adresse e-mail'|trans }}</label>
                <div class="auth-input">
                    <span class="auth-input__icon">{{ icon.mail() }}</span>
                    <input id="inputEmail" class="auth-input__control" type="email" name="email"
                           placeholder="{{ 'Votre@email.com'|trans }}" autocomplete="email">
                </div>
            </div>
        </div>

        {# Provisoire : simple lien vers l'étape suivante (remplacé par un vrai POST au câblage). #}
        <a class="pl-btn pl-btn--primary pl-btn--block" href="{{ path('app_forgot_password_code') }}">{{ 'Envoyer'|trans }}</a>

        {% include 'security/_social_login.html.twig' %}
    </div>
{% endblock %}
