{#
    Mot de passe oublié — étape 3/3 : définition du nouveau mot de passe.

    Câblé le 17/08. Le code est revérifié côté serveur au moment de
    l'enregistrement : atteindre cet écran ne suffit pas à changer un mot de
    passe. C'est ici que la confirmation de saisie de la maquette prend tout
    son sens — l'écran d'inscription, lui, n'en comporte pas.
#}
{% extends 'security/_layout.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Définir un mot de passe'|trans }}{% endblock %}

{% block auth_card %}
    <div class="auth-card auth-card--pw">
        <a class="auth-back" href="{{ path('app_login') }}">{{ icon.chevron_left(20) }} {{ 'Retour à la page de connexion'|trans }}</a>

        <div class="auth-card__header">
            <h2 class="auth-card__title">{{ 'Définir un mot de passe'|trans }}</h2>
            <p class="auth-card__subtitle">{{ 'Votre ancien mot de passe a été réinitialisé. Veuillez définir un nouveau mot de passe pour votre compte.'|trans }}</p>
        </div>

        <form class="auth-form" method="post" action="{{ path('app_forgot_password_reset') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">

            <div class="auth-fields">
                <div class="auth-field">
                    <label class="auth-field__label" for="inputPassword">{{ 'Créer un mot de passe'|trans }}</label>
                    <div class="auth-input" data-controller="password-toggle">
                        <span class="auth-input__icon">{{ icon.lock() }}</span>
                        <input id="inputPassword" class="auth-input__control" type="password" name="password"
                               data-password-toggle-target="input" placeholder="{{ '8 caractères minimum'|trans }}" autocomplete="new-password">
                        <button type="button" class="auth-input__eye" data-action="password-toggle#toggle" aria-label="{{ 'Afficher ou masquer le mot de passe'|trans }}">
                            <span data-password-toggle-target="show">{{ icon.eye() }}</span>
                            <span data-password-toggle-target="hide" hidden>{{ icon.eye_off() }}</span>
                        </button>
                    </div>
                </div>

                <div class="auth-field">
                    <label class="auth-field__label" for="inputPasswordConfirm">{{ 'Saisissez à nouveau'|trans }}</label>
                    <div class="auth-input" data-controller="password-toggle">
                        <span class="auth-input__icon">{{ icon.lock() }}</span>
                        <input id="inputPasswordConfirm" class="auth-input__control" type="password" name="passwordConfirm"
                               data-password-toggle-target="input" placeholder="{{ 'Retapez votre mot de passe'|trans }}" autocomplete="new-password">
                        <button type="button" class="auth-input__eye" data-action="password-toggle#toggle" aria-label="{{ 'Afficher ou masquer le mot de passe'|trans }}">
                            <span data-password-toggle-target="show">{{ icon.eye() }}</span>
                            <span data-password-toggle-target="hide" hidden>{{ icon.eye_off() }}</span>
                        </button>
                    </div>
                </div>
            </div>

            <button type="submit" class="pl-btn pl-btn--primary pl-btn--block">{{ 'Définir un mot de passe'|trans }}</button>
        </form>
    </div>
{% endblock %}
