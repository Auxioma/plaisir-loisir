{#
    Mot de passe oublié — étape 3/3 : définition du nouveau mot de passe.
    ⚠️ Front-end uniquement : le bouton renvoie vers la connexion.
    L'enregistrement réel du nouveau mot de passe sera branché plus tard.
#}
{% extends 'security/_layout.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}Définir un mot de passe{% endblock %}

{% block auth_card %}
    <div class="auth-card">
        <a class="auth-back" href="{{ path('app_login') }}">{{ icon.chevron_left(20) }} Retour à la page de connexion</a>

        <div class="auth-card__header">
            <h2 class="auth-card__title">Définir un mot de passe</h2>
            <p class="auth-card__subtitle">Votre ancien mot de passe a été réinitialisé. Veuillez définir un nouveau mot de passe pour votre compte.</p>
        </div>

        <div class="auth-fields">
            <div class="auth-field">
                <label class="auth-field__label" for="inputPassword">Créer un mot de passe</label>
                <div class="auth-input" data-controller="password-toggle">
                    <span class="auth-input__icon">{{ icon.lock() }}</span>
                    <input id="inputPassword" class="auth-input__control" type="password" name="password"
                           data-password-toggle-target="input" placeholder="8 caractères minimum" autocomplete="new-password">
                    <button type="button" class="auth-input__eye" data-action="password-toggle#toggle" aria-label="Afficher ou masquer le mot de passe">
                        <span data-password-toggle-target="show">{{ icon.eye() }}</span>
                        <span data-password-toggle-target="hide" hidden>{{ icon.eye_off() }}</span>
                    </button>
                </div>
            </div>

            <div class="auth-field">
                <label class="auth-field__label" for="inputPasswordConfirm">Saisissez à nouveau</label>
                <div class="auth-input" data-controller="password-toggle">
                    <span class="auth-input__icon">{{ icon.lock() }}</span>
                    <input id="inputPasswordConfirm" class="auth-input__control" type="password" name="passwordConfirm"
                           data-password-toggle-target="input" placeholder="Retapez votre mot de passe" autocomplete="new-password">
                    <button type="button" class="auth-input__eye" data-action="password-toggle#toggle" aria-label="Afficher ou masquer le mot de passe">
                        <span data-password-toggle-target="show">{{ icon.eye() }}</span>
                        <span data-password-toggle-target="hide" hidden>{{ icon.eye_off() }}</span>
                    </button>
                </div>
            </div>
        </div>

        {# Provisoire : retour à la connexion (remplacé par un vrai POST au câblage). #}
        <a class="pl-btn pl-btn--primary pl-btn--block" href="{{ path('app_login') }}">Définir un mot de passe</a>
    </div>
{% endblock %}
