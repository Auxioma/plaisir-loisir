{#
    Écran d'inscription.
    ⚠️ Front-end uniquement pour l'instant : les champs sont en HTML « brut ».
    Le branchement sur le formulaire Symfony (RegistrationFormType), la
    validation et le traitement du POST seront faits dans la phase « câblage ».
    Choix retenu : fidèle au design (Nom & prénom, téléphone) + on GARDE un
    champ de confirmation du mot de passe pour la sécurité.
#}
{% extends 'security/_layout.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Inscription'|trans }}{% endblock %}

{% block auth_card %}
    <div class="auth-card">
        <div class="auth-card__header">
            <h2 class="auth-card__title">{{ 'Inscription'|trans }}</h2>
            <p class="auth-card__subtitle">{{ 'Nous allons tout mettre en place pour que vous puissiez accéder à votre compte personnel.'|trans }}</p>
        </div>

        <form class="auth-form" method="post" action="{{ path('app_register') }}">
            {% include 'security/_account_type.html.twig' %}

            <div class="auth-fields">
                <div class="auth-field">
                    <label class="auth-field__label" for="inputFullName">{{ 'Nom & prénom'|trans }}</label>
                    <div class="auth-input">
                        <span class="auth-input__icon">{{ icon.person() }}</span>
                        <input id="inputFullName" class="auth-input__control" type="text" name="fullName"
                               placeholder="{{ 'Jean Dupont'|trans }}" autocomplete="name">
                    </div>
                </div>

                <div class="auth-field">
                    <label class="auth-field__label" for="inputEmail">{{ 'Adresse e-mail'|trans }}</label>
                    <div class="auth-input">
                        <span class="auth-input__icon">{{ icon.mail() }}</span>
                        <input id="inputEmail" class="auth-input__control" type="email" name="email"
                               placeholder="{{ 'Votre@email.com'|trans }}" autocomplete="email">
                    </div>
                </div>

                <div class="auth-field">
                    <label class="auth-field__label" for="inputPhone">{{ 'Numéro de téléphone'|trans }}</label>
                    <div class="auth-input">
                        <span class="auth-input__icon">{{ icon.phone() }}</span>
                        <input id="inputPhone" class="auth-input__control" type="tel" name="phone"
                               placeholder="06 12 34 56 78" autocomplete="tel">
                    </div>
                </div>

                {# Champ réservé aux professionnels (demande client) : révélé
                   en CSS quand « Professionnel » est coché (:has, sans JS). #}
                <div class="auth-field auth-field--pro">
                    <label class="auth-field__label" for="inputLegalStatus">{{ 'Statut juridique'|trans }}</label>
                    <div class="auth-input auth-input--select">
                        <span class="auth-input__icon">{{ icon.building() }}</span>
                        <select id="inputLegalStatus" class="auth-input__control" name="legalStatus">
                            <option value="" selected disabled>{{ 'Choisissez votre statut'|trans }}</option>
                            <option value="ei">{{ 'Entreprise individuelle (EI)'|trans }}</option>
                            <option value="micro">{{ 'Micro-entreprise'|trans }}</option>
                            <option value="eurl">EURL</option>
                            <option value="sarl">SARL</option>
                            <option value="sas">SAS</option>
                            <option value="sasu">SASU</option>
                            <option value="association">{{ 'Association'|trans }}</option>
                            <option value="autre">{{ 'Autre'|trans }}</option>
                        </select>
                    </div>
                </div>

                <div class="auth-field">
                    <label class="auth-field__label" for="inputPassword">{{ 'Mot de passe'|trans }}</label>
                    <div class="auth-input" data-controller="password-toggle">
                        <span class="auth-input__icon">{{ icon.lock() }}</span>
                        <input id="inputPassword" class="auth-input__control" type="password" name="password"
                               data-password-toggle-target="input" placeholder="{{ '8 caractères minimum'|trans }}"
                               autocomplete="new-password">
                        <button type="button" class="auth-input__eye" data-action="password-toggle#toggle" aria-label="{{ 'Afficher ou masquer le mot de passe'|trans }}">
                            <span data-password-toggle-target="show">{{ icon.eye() }}</span>
                            <span data-password-toggle-target="hide" hidden>{{ icon.eye_off() }}</span>
                        </button>
                    </div>
                </div>

                <div class="auth-field">
                    <label class="auth-field__label" for="inputPasswordConfirm">{{ 'Confirmer le mot de passe'|trans }}</label>
                    <div class="auth-input" data-controller="password-toggle">
                        <span class="auth-input__icon">{{ icon.lock() }}</span>
                        <input id="inputPasswordConfirm" class="auth-input__control" type="password" name="passwordConfirm"
                               data-password-toggle-target="input" placeholder="{{ 'Retapez votre mot de passe'|trans }}"
                               autocomplete="new-password">
                        <button type="button" class="auth-input__eye" data-action="password-toggle#toggle" aria-label="{{ 'Afficher ou masquer le mot de passe'|trans }}">
                            <span data-password-toggle-target="show">{{ icon.eye() }}</span>
                            <span data-password-toggle-target="hide" hidden>{{ icon.eye_off() }}</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="auth-actions">
                <label class="auth-terms">
                    <input type="checkbox" name="agreeTerms">
                    <span>{{ "J'accepte les"|trans }} <a class="auth-inline-link" href="#">{{ 'conditions générales'|trans }}</a> {{ 'et la'|trans }} <a class="auth-inline-link" href="#">{{ 'politique de confidentialité'|trans }}</a></span>
                </label>

                <button type="submit" class="pl-btn pl-btn--primary pl-btn--block">{{ 'Créer un compte'|trans }}</button>

                <p class="auth-switch">
                    {{ 'Vous avez déjà un compte ?'|trans }}
                    <a class="auth-inline-link" href="{{ path('app_login') }}">{{ 'Connectez-vous'|trans }}</a>
                </p>
            </div>
        </form>

        {% include 'security/_social_login.html.twig' %}
    </div>
{% endblock %}
