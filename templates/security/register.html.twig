{#
    Écran d'inscription — conforme à la maquette Figma 591:65942.

    Câblé sur RegistrationFormType (câblage back du 17/08). Le balisage ne
    change PAS : chaque champ écrit à la main est remplacé par le widget
    Symfony équivalent, auquel on repasse la même classe, le même id et le
    même placeholder. Ce que le widget apporte en plus est invisible à
    l'écran mais indispensable :
      - le nom posté devient « registration_form[...] », celui qu'attend le
        contrôleur (avant, les noms bruts ne correspondaient à rien et aucun
        compte n'était créé) ;
      - form_end() dépose le jeton CSRF, absent jusqu'ici alors que l'écran
        de connexion en avait un.
    Aucun attribut `required` n'est ajouté (`required => false` dans le type) :
    la validation est côté serveur, comme dans la maquette qui n'en porte pas.

    La maquette ne comporte NI bascule Client/Professionnel, NI champ Statut
    juridique, NI confirmation du mot de passe : l'accès professionnel passe
    par le lien « Accéder à votre espace » vers l'écran de choix. Retirés le
    2026-08-10 sur consigne « fais la maquette exactement ». La confirmation
    du mot de passe sera à réintroduire au câblage si la sécurité l'exige.
#}
{% extends 'security/_layout.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Inscription'|trans }}{% endblock %}

{% block auth_card %}
    <div class="auth-card auth-card--register">
        <div class="auth-card__header">
            <h2 class="auth-card__title">{{ 'Inscription'|trans }}</h2>
            <p class="auth-card__subtitle">{{ 'Nous allons tout mettre en place pour que vous puissiez accéder à votre compte personnel.'|trans }}</p>
        </div>

        {{ form_start(registrationForm, { attr: { class: 'auth-form' }, action: path('app_register'), method: 'post' }) }}
            <div class="auth-fields">
                <div class="auth-field">
                    <label class="auth-field__label" for="inputFullName">{{ 'Nom & prénom'|trans }}</label>
                    <div class="auth-input">
                        <span class="auth-input__icon">{{ icon.person() }}</span>
                        {{ form_widget(registrationForm.fullName, {
                            id: 'inputFullName',
                            attr: { class: 'auth-input__control', placeholder: 'martinthomas@gmail.com', autocomplete: 'name' }
                        }) }}
                    </div>
                </div>

                <div class="auth-field">
                    <label class="auth-field__label" for="inputEmail">{{ 'Adresse e-mail'|trans }}</label>
                    <div class="auth-input">
                        <span class="auth-input__icon">{{ icon.mail() }}</span>
                        {{ form_widget(registrationForm.email, {
                            id: 'inputEmail',
                            attr: { class: 'auth-input__control', placeholder: 'Votre@email.com'|trans, autocomplete: 'email' }
                        }) }}
                    </div>
                </div>

                <div class="auth-field">
                    <label class="auth-field__label" for="inputPhone">{{ 'Numéro de téléphone'|trans }}</label>
                    <div class="auth-input">
                        <span class="auth-input__icon">{{ icon.phone() }}</span>
                        {{ form_widget(registrationForm.phone, {
                            id: 'inputPhone',
                            attr: { class: 'auth-input__control', placeholder: 'Votre@email.com'|trans, autocomplete: 'tel' }
                        }) }}
                    </div>
                </div>

                <div class="auth-field">
                    <label class="auth-field__label" for="inputPassword">{{ 'Mot de passe'|trans }}</label>
                    <div class="auth-input" data-controller="password-toggle">
                        <span class="auth-input__icon">{{ icon.lock() }}</span>
                        {{ form_widget(registrationForm.password, {
                            id: 'inputPassword',
                            attr: {
                                class: 'auth-input__control',
                                placeholder: '8 caractères minimum'|trans,
                                autocomplete: 'new-password',
                                'data-password-toggle-target': 'input'
                            }
                        }) }}
                        <button type="button" class="auth-input__eye" data-action="password-toggle#toggle" aria-label="{{ 'Afficher ou masquer le mot de passe'|trans }}">
                            <span data-password-toggle-target="show">{{ icon.eye() }}</span>
                            <span data-password-toggle-target="hide" hidden>{{ icon.eye_off() }}</span>
                        </button>
                    </div>
                </div>

            </div>

            <div class="auth-actions">
                <label class="auth-terms">
                    {{ form_widget(registrationForm.agreeTerms) }}
                    {# « conditions générales » pointe sur la page qui existe.
                       « politique de confidentialité » reste sans lien : cette
                       page n'a jamais été maquettée ni écrite, et la faire
                       pointer sur les mentions légales serait faux. #}
                    <span>{{ "J'accepte les"|trans }} <a class="auth-inline-link" href="{{ path('app_corporate_terms') }}">{{ 'conditions générales'|trans }}</a> {{ 'et de la'|trans }} <a class="auth-inline-link" href="{{ path('app_corporate_privacy') }}">{{ 'politique de confidentialité'|trans }}</a></span>
                </label>

                <button type="submit" class="pl-btn pl-btn--primary pl-btn--block">{{ 'Créer un compte'|trans }}</button>

                <p class="auth-switch">
                    {{ 'Vous avez déjà un compte ?'|trans }}
                    <a class="auth-inline-link" href="{{ path('app_login') }}">{{ 'Connectez-vous'|trans }}</a>
                </p>

                {# Maquette : l'accès professionnel passe par ce lien, et non par
                   une bascule dans le formulaire.

                   IL MÈNE AU PARCOURS PROFESSIONNEL, PAS À L'ÉCRAN DE CHOIX.
                   Jusqu'au 02/09 il renvoyait sur « /authentification?type=pro »,
                   qui ramenait à CE MÊME formulaire client avec un type caché :
                   le professionnel tournait en rond et finissait avec un compte
                   sans activité, sans siège social et sans pièce justificative.
                   Depuis cet écran on s'inscrit, donc on part sur l'inscription
                   professionnelle — et non sur sa connexion. #}
                <p class="auth-switch auth-switch--pro">
                    {{ 'Vous êtes un professionnel ?'|trans }}<br>
                    <a class="auth-inline-link" href="{{ path('app_pro_register') }}">{{ 'Créer votre espace pro'|trans }}</a>
                </p>
            </div>
        {{ form_end(registrationForm) }}

        {% include 'security/_social_login.html.twig' %}
    </div>
{% endblock %}
