{#
    Écran d'inscription particulier — même modèle que la connexion (maquette
    connexion_particulier.jpeg, 30/09), via security/_tm_shell.html.twig.
    Auparavant : maquette Figma 591:65942.

    Câblé sur RegistrationFormType (câblage back du 17/08). Le balisage ne
    change PAS : chaque champ écrit à la main est remplacé par le widget
    Symfony équivalent, auquel on repasse la même classe, le même id et le
    même placeholder. Ce que le widget apporte en plus est invisible à
    l'écran mais indispensable :
      - le nom posté devient « registration_form[...] », celui qu'attend le
        contrôleur (avant, les noms bruts ne correspondaient à rien et aucun
        compte n'était créé) ;
      - form_end() dépose le jeton CSRF, absent jusqu'ici alors que l'écran
        de connexion en avait un.
    Les champs obligatoires portent désormais l'attribut `required` (hérité
    du type) : le navigateur bloque l'envoi et signale les champs vides avant
    même d'atteindre le serveur, qui reste la validation de référence.

    La maquette ne comporte NI bascule Client/Professionnel, NI champ Statut
    juridique, NI confirmation du mot de passe : l'accès professionnel passe
    par le lien « Accéder à votre espace » vers l'écran de choix. Retirés le
    2026-08-10 sur consigne « fais la maquette exactement ». La confirmation
    du mot de passe sera à réintroduire au câblage si la sécurité l'exige.
#}
{% extends 'security/_tm_shell.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Inscription'|trans }}{% endblock %}

{% block tm_card %}
    <h2 class="tm-login__card-title">{{ 'Inscription'|trans }}</h2>
    <p class="tm-login__card-sub">{{ 'Nous allons tout mettre en place pour que vous puissiez accéder à votre compte personnel.'|trans }}</p>

    {# data-turbo="false" : le contrôleur ré-affiche ce formulaire avec ses
       erreurs (HTTP 200, pas de redirection) ; Turbo Drive rejetterait
       silencieusement cette réponse et l'erreur ne s'afficherait jamais. #}
    {{ form_start(registrationForm, { attr: { class: 'tm-login__form', 'data-turbo': 'false' }, action: path('app_register'), method: 'post' }) }}
        {% set errors = form_errors(registrationForm) %}
        {% if errors|striptags|trim %}<div class="tm-login__alert" role="alert">{{ errors }}</div>{% endif %}

        <label class="tm-login__label" for="inputFullName">{{ 'Nom & prénom'|trans }}</label>
        <div class="tm-login__input">
            {{ icon.person(20) }}
            {{ form_widget(registrationForm.fullName, { id: 'inputFullName', attr: { placeholder: 'Martin Thomas', autocomplete: 'name' } }) }}
        </div>
        {{ form_errors(registrationForm.fullName) }}

        <label class="tm-login__label" for="inputEmail">{{ 'Adresse e-mail'|trans }}</label>
        <div class="tm-login__input">
            {{ icon.mail(20) }}
            {{ form_widget(registrationForm.email, { id: 'inputEmail', attr: { placeholder: 'votre@email.com'|trans, autocomplete: 'email' } }) }}
        </div>
        {{ form_errors(registrationForm.email) }}

        <label class="tm-login__label" for="inputPhone">{{ 'Numéro de téléphone'|trans }}</label>
        <div class="tm-login__input tm-login__input--phone">
            {# Indicatif pays compact (assets/controllers/phone_country_controller.js) :
               le <select> reste réel, réduit à un drapeau + indicatif cliquables. #}
            <span class="phone-country phone-country--prefix" data-controller="phone-country">
                <span class="phone-country__flag" data-phone-country-target="flag"></span>
                <span class="phone-country__code" data-phone-country-target="code"></span>
                {{ form_widget(registrationForm.phone.country, {
                    attr: { class: 'phone-country__select', 'data-phone-country-target': 'select', 'data-action': 'change->phone-country#sync' }
                }) }}
            </span>
            {{ form_widget(registrationForm.phone.number, { id: 'inputPhone', attr: { placeholder: '06 12 34 56 78', autocomplete: 'tel' } }) }}
        </div>
        {{ form_errors(registrationForm.phone) }}

        <label class="tm-login__label" for="inputPassword">{{ 'Mot de passe'|trans }}</label>
        <div class="tm-login__input" data-controller="password-toggle">
            {{ icon.padlock(20) }}
            {{ form_widget(registrationForm.password, { id: 'inputPassword', attr: {
                placeholder: '8 caractères minimum'|trans, autocomplete: 'new-password', 'data-password-toggle-target': 'input'
            } }) }}
            <button type="button" class="tm-login__eye" data-action="password-toggle#toggle" aria-label="{{ 'Afficher ou masquer le mot de passe'|trans }}">
                <span data-password-toggle-target="show">{{ icon.eye(20) }}</span>
                <span data-password-toggle-target="hide" hidden>{{ icon.eye_off(20) }}</span>
            </button>
        </div>
        {{ form_errors(registrationForm.password) }}

        <label class="tm-login__terms">
            {{ form_widget(registrationForm.agreeTerms) }}
            <span>{{ "J'accepte les"|trans }} <a href="{{ path('app_corporate_terms') }}">{{ 'conditions générales'|trans }}</a> {{ 'et de la'|trans }} <a href="{{ path('app_corporate_privacy') }}">{{ 'politique de confidentialité'|trans }}</a></span>
        </label>
        {{ form_errors(registrationForm.agreeTerms) }}

        <button type="submit" class="tm-login__submit">{{ 'Créer un compte'|trans }}</button>
    {{ form_end(registrationForm) }}

    {% include 'security/_tm_socials.html.twig' %}

    <p class="tm-login__signup">
        {{ 'Vous avez déjà un compte ?'|trans }}
        <a href="{{ path('app_login') }}">{{ 'Connectez-vous'|trans }}</a>
    </p>

    {# Un professionnel arrivé ici part sur SON parcours (activité, siège,
       pièces justificatives), pas sur ce formulaire client. #}
    <p class="tm-login__switch">
        {{ 'Vous êtes un professionnel ?'|trans }}
        <a href="{{ path('app_pro_register') }}">{{ 'Créer votre espace pro'|trans }}</a>
    </p>
{% endblock %}
