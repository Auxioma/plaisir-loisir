{#
    Écran de connexion.
    Le formulaire est déjà fonctionnel : il est intercepté par le firewall
    Symfony (voir config/packages/security.yaml, section form_login).
    Champs attendus : _email, _password, _csrf_token (id « authenticate »),
    _remember_me.

    L'attribut `autofocus` a été retiré : il posait l'anneau de focus violet sur
    le champ e-mail dès l'ouverture, alors que la maquette montre le champ au
    repos.

    La maquette « Connexion » ne comporte PAS de bascule Client/Professionnel
    (retirée le 13/08 comme sur l'inscription) : l'accès professionnel passe par
    le lien « Accéder à votre espace » vers l'écran de choix.
#}
{% extends 'security/_layout.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Connexion'|trans }}{% endblock %}

{% block auth_card %}
    <div class="auth-card auth-card--login">
        <div class="auth-card__header">
            <h2 class="auth-card__title">{{ 'Connexion'|trans }}</h2>
            <p class="auth-card__subtitle">{{ 'Accédez à votre TrouveMoi'|trans }}</p>
        </div>

        <form class="auth-form" method="post" action="{{ path('app_login') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            {% if error %}
                <div class="auth-alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <div class="auth-fields">
                <div class="auth-field">
                    <label class="auth-field__label" for="inputEmail">{{ 'Adresse e-mail'|trans }}</label>
                    <div class="auth-input">
                        <span class="auth-input__icon">{{ icon.mail() }}</span>
                        <input id="inputEmail" class="auth-input__control" type="email" name="_email"
                               value="{{ last_username }}" placeholder="{{ 'Votre@email.com'|trans }}"
                               autocomplete="email" required>
                    </div>
                </div>

                <div class="auth-field">
                    <label class="auth-field__label" for="inputPassword">{{ 'Mot de passe'|trans }}</label>
                    <div class="auth-input" data-controller="password-toggle">
                        <span class="auth-input__icon">{{ icon.lock() }}</span>
                        <input id="inputPassword" class="auth-input__control" type="password" name="_password"
                               data-password-toggle-target="input" placeholder="{{ 'Votre mot de passe'|trans }}"
                               autocomplete="current-password" required>
                        <button type="button" class="auth-input__eye" data-action="password-toggle#toggle" aria-label="{{ 'Afficher ou masquer le mot de passe'|trans }}">
                            <span data-password-toggle-target="show">{{ icon.eye() }}</span>
                            <span data-password-toggle-target="hide" hidden>{{ icon.eye_off() }}</span>
                        </button>
                    </div>
                </div>

                <div class="auth-options">
                    <label class="auth-remember">
                        <input type="checkbox" name="_remember_me"> {{ 'Se souvenir de moi'|trans }}
                    </label>
                    <a class="auth-link" href="{{ path('app_forgot_password_request') }}">{{ 'Mot de passe oublié ?'|trans }}</a>
                </div>
            </div>

            <div class="auth-actions">
                <button type="submit" class="pl-btn pl-btn--primary pl-btn--block">{{ 'Se connecter'|trans }}</button>
                <p class="auth-switch">
                    {{ "Vous n'avez pas de compte ?"|trans }}
                    <a class="auth-inline-link" href="{{ path('app_register') }}">{{ 'Créer un compte'|trans }}</a>
                </p>

                {# Maquette : l'accès professionnel passe par ce lien, sur deux
                   lignes centrées — et non par une bascule Client/Professionnel
                   dans le formulaire.

                   IL MÈNE À LA CONNEXION PROFESSIONNELLE, PAS À L'ÉCRAN DE CHOIX.
                   Depuis cet écran on se connecte : le pendant professionnel est
                   /pro/connexion, qui porte la bande latérale des avantages. #}
                <p class="auth-switch auth-switch--pro">
                    {{ 'Vous êtes un professionnel ?'|trans }}<br>
                    <a class="auth-inline-link" href="{{ path('app_pro_login') }}">{{ 'Accéder à votre espace'|trans }}</a>
                </p>
            </div>
        </form>

        {% include 'security/_social_login.html.twig' %}
    </div>
{% endblock %}
