{#
    Connexion particulier — maquette assets/maquettes/connexion_particulier.jpeg
    (30/09). Styles : assets/styles/layout.css (.tm-login).

    Mise en page commune : security/_tm_shell.html.twig.

    Formulaire intercepté par le firewall (security.yaml, form_login) :
    _email, _password, _csrf_token (id « authenticate »).

    Retirés parce que la maquette ne les montre pas : « Se souvenir de moi »
    et le lien vers l'espace professionnel (joignable par « Se connecter » de
    l'en-tête → Prestataire).
#}
{% extends 'security/_tm_shell.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Connexion'|trans }}{% endblock %}

{% block tm_card %}
            <h2 class="tm-login__card-title">{{ 'Connexion'|trans }}</h2>
            <p class="tm-login__card-sub">{{ 'Accédez à votre compte TrouveMoi'|trans }}</p>

            <form class="tm-login__form" method="post" action="{{ path('app_login') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                {% if error %}
                    <div class="tm-login__alert" role="alert">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                        {# Compte « en attente » (AccountChecker::checkPreAuth) : il doit
                           pouvoir redemander un code. #}
                        {% if 'pas encore vérifiée' in error.messageKey %}
                            <a href="{{ path('app_email_verification_request') }}">{{ 'Recevoir un nouveau code'|trans }}</a>
                        {% endif %}
                    </div>
                {% endif %}

                <label class="tm-login__label" for="inputEmail">{{ 'Adresse e-mail'|trans }}</label>
                <div class="tm-login__input">
                    {{ icon.mail(20) }}
                    <input id="inputEmail" type="email" name="_email" value="{{ last_username }}"
                           placeholder="{{ 'votre@email.com'|trans }}" autocomplete="email" required>
                </div>

                <label class="tm-login__label" for="inputPassword">{{ 'Mot de passe'|trans }}</label>
                <div class="tm-login__input" data-controller="password-toggle">
                    {{ icon.padlock(20) }}
                    <input id="inputPassword" type="password" name="_password" data-password-toggle-target="input"
                           placeholder="•••••••••••••" autocomplete="current-password" required>
                    <button type="button" class="tm-login__eye" data-action="password-toggle#toggle" aria-label="{{ 'Afficher ou masquer le mot de passe'|trans }}">
                        <span data-password-toggle-target="show">{{ icon.eye(20) }}</span>
                        <span data-password-toggle-target="hide" hidden>{{ icon.eye_off(20) }}</span>
                    </button>
                </div>

                <a class="tm-login__forgot" href="{{ path('app_forgot_password_request') }}">{{ 'Mot de passe oublié ?'|trans }}</a>

                <button type="submit" class="tm-login__submit">{{ 'Se connecter'|trans }}</button>
            </form>

            {% include 'security/_tm_socials.html.twig' %}

            <p class="tm-login__signup">
                {{ "Vous n'avez pas de compte ?"|trans }}
                <a href="{{ path('app_auth_choice') }}">{{ "S'inscrire maintenant"|trans }}</a>
            </p>
{% endblock %}
