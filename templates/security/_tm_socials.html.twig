{% set social_buttons = [
    { service: 'google',   label: 'Continuer avec Google' },
    { service: 'facebook', label: 'Continuer avec Facebook' }
] %}
<div class="tm-login__or"><span>{{ 'ou'|trans }}</span></div>

<div class="tm-login__socials">
    {% for button in social_buttons %}
        <a class="tm-login__social" href="{{ path('app_social_start', { service: button.service }) }}" data-turbo="false">
            <img src="{{ asset('images/social-' ~ button.service ~ '.svg') }}" alt="" loading="lazy" decoding="async">{{ button.label|trans }}
        </a>
    {% endfor %}
</div>


<p class="auth-social-terms">{{ 'En continuant avec Google ou Facebook, vous acceptez les'|trans }} <a href="{{ path('app_corporate_terms') }}">{{ 'conditions générales'|trans }}</a> {{ 'et la'|trans }} <a href="{{ path('app_corporate_privacy') }}">{{ 'politique de confidentialité'|trans }}</a>.</p>
