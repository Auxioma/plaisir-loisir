{#
    Mot de passe oublié — étape 2/3 : vérification du code reçu par e-mail.
    ⚠️ Front-end uniquement : le bouton « Vérifier » enchaîne vers l'étape
    suivante. La vérification réelle du code sera branchée plus tard.
#}
{% extends 'security/_layout.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}Vérifier le code{% endblock %}

{% block auth_card %}
    <div class="auth-card">
        <a class="auth-back" href="{{ path('app_login') }}">{{ icon.chevron_left(20) }} Retour à la page de connexion</a>

        <div class="auth-card__header">
            <h2 class="auth-card__title">Vérifier le code</h2>
            <p class="auth-card__subtitle">Un code d'authentification vous a été envoyé par e-mail. Saisir le code.</p>
        </div>

        <div class="auth-fields">
            <div class="auth-field">
                <label class="auth-field__label" for="inputCode">Saisir le code</label>
                <div class="auth-input" data-controller="password-toggle">
                    <input id="inputCode" class="auth-input__control" type="text" name="code"
                           data-password-toggle-target="input" placeholder="7759BK5X" autocomplete="one-time-code">
                    <button type="button" class="auth-input__eye" data-action="password-toggle#toggle" aria-label="Afficher ou masquer le code">
                        <span data-password-toggle-target="show">{{ icon.eye() }}</span>
                        <span data-password-toggle-target="hide" hidden>{{ icon.eye_off() }}</span>
                    </button>
                </div>
            </div>
            <p class="auth-switch" style="justify-content: flex-start;">
                Vous n'avez pas reçu de code ?
                <a class="auth-inline-link" href="#">Renvoyer</a>
            </p>
        </div>

        {# Provisoire : simple lien vers l'étape suivante (remplacé par un vrai POST au câblage). #}
        <a class="pl-btn pl-btn--primary pl-btn--block" href="{{ path('app_forgot_password_reset') }}">Vérifier</a>
    </div>
{% endblock %}
