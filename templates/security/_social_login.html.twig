{% set social_buttons = [
    { service: 'google',   alt: 'Continuer avec Google' },
    { service: 'facebook', alt: 'Continuer avec Facebook' }
] %}

<div class="auth-separator">{{ 'Ou'|trans }}</div>

<div class="auth-socials">
    {% for button in social_buttons %}
        <a class="auth-social" href="{{ path('app_social_start', { service: button.service }) }}" data-turbo="false">
            <img src="{{ asset('images/social-' ~ button.service ~ '.svg') }}" alt="{{ button.alt|trans }}" loading="lazy" decoding="async">
        </a>
    {% endfor %}
</div>

<p class="auth-social-terms">{{ 'En continuant avec Google ou Facebook, vous acceptez les'|trans }} <a href="{{ path('app_corporate_terms') }}">{{ 'conditions générales'|trans }}</a> {{ 'et la'|trans }} <a href="{{ path('app_corporate_privacy') }}">{{ 'politique de confidentialité'|trans }}</a>.</p>
