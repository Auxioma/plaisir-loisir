{#
    Vérification de l'adresse e-mail à l'inscription (Lot I, 15/09). Aucune
    maquette : repris du gabarit de l'étape 2/3 « mot de passe oublié »
    (security/password_code.html.twig), le seul écran de saisie de code déjà
    dessiné par la designer.
#}
{% extends 'security/_layout.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Vérifier votre adresse e-mail'|trans }}{% endblock %}

{% block auth_card %}
    <div class="auth-card auth-card--pw">
        <div class="auth-card__header">
            <h2 class="auth-card__title">{{ 'Vérifiez votre adresse e-mail'|trans }}</h2>
            <p class="auth-card__subtitle">{{ 'Un code de vérification vous a été envoyé par e-mail. Saisissez-le pour activer votre compte.'|trans }}</p>
        </div>

        <form class="auth-form" method="post" action="{{ path('app_email_verification') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">

            <div class="auth-fields">
                <div class="auth-field">
                    <label class="auth-field__label" for="inputCode">{{ 'Saisir le code'|trans }}</label>
                    <div class="auth-input" data-controller="password-toggle">
                        <input id="inputCode" class="auth-input__control" type="text" name="code"
                               data-password-toggle-target="input" placeholder="7759BK5X" autocomplete="one-time-code">
                        <button type="button" class="auth-input__eye" data-action="password-toggle#toggle" aria-label="{{ 'Afficher ou masquer le code'|trans }}">
                            <span data-password-toggle-target="show">{{ icon.eye() }}</span>
                            <span data-password-toggle-target="hide" hidden>{{ icon.eye_off() }}</span>
                        </button>
                    </div>
                </div>
            </div>

            <button type="submit" class="pl-btn pl-btn--primary pl-btn--block">{{ 'Vérifier'|trans }}</button>
        </form>

        <form method="post" action="{{ path('app_email_verification_resend') }}" class="auth-switch auth-switch--start">
            <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
            {{ "Vous n'avez pas reçu de code ?"|trans }}
            <button type="submit" class="auth-inline-link" style="background: none; border: none; padding: 0; cursor: pointer;">{{ 'Renvoyer'|trans }}</button>
        </form>
    </div>
{% endblock %}
