{#
    Retour après passage par Stripe Checkout (ou activation immédiate en
    mode simulé). Cet écran ne confirme jamais rien lui-même : c'est le
    webhook Stripe qui active l'abonnement (SubscriptionService::
    activateFromCheckout()), souvent avant que le navigateur n'arrive ici — sauf
    en mode simulé, où il n'y a pas de webhook et l'abonnement est déjà actif
    au moment de la redirection (voir MockSubscriptionGateway).
#}
{% extends 'provider/space/_layout.html.twig' %}

{% block title %}{{ 'Abonnement confirmé'|trans }}{% endblock %}

{% block space %}
    <section class="pf-card pf-empty">
        <strong>{{ 'Merci !'|trans }}</strong>
        {% if subscription and subscription.status.value == 'active' %}
            {{ 'Votre abonnement'|trans }} « {{ subscription.plan.name }} » {{ 'est actif.'|trans }}
        {% else %}
            {{ 'Votre paiement est en cours de confirmation.'|trans }}
        {% endif %}
        <div><a href="{{ path('app_pro_subscription') }}" class="pf-btn pf-btn--primary">{{ 'Voir mon abonnement'|trans }}</a></div>
    </section>
{% endblock %}
