{#
    Abonnement professionnel (§17 du CDC, /pro/abonnement). Dans l'espace pro
    depuis le 20/10 (gabarit provider/space/_layout, on y arrive par
    Paramètres > Abonnement). Sans abonnement en cours, c'est la seule page
    utile de l'espace (ProviderSubscriptionGateSubscriber).
    Données : SubscriptionController::index().
#}
{% extends 'provider/space/_layout.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Abonnement'|trans }}{% endblock %}

{% set status_labels = {active: ['Actif', 'green'], past_due: ['Paiement en retard', 'orange'], incomplete: ['En attente de confirmation', 'blue'], cancelled: ['Résilié', 'grey']} %}
{% set period = {monthly: 'mois', yearly: 'an'} %}

{% block space %}
    <header class="pf-head pp-head">
        <div>
            <h1 class="pf-title">{{ 'Abonnement professionnel'|trans }} <span class="pp-title-ico">{{ icon.crown(24) }}</span></h1>
            <p class="pf-sub">{{ 'Votre offre et sa facturation.'|trans }}</p>
        </div>
        <a class="pf-btn" href="{{ path('app_pro_settings', {section: 'abonnement'}) }}">{{ icon.arrow_left(16) }} {{ 'Paramètres'|trans }}</a>
    </header>

    {% if not has_access %}
        <div class="pp-plan-alert">
            {{ icon.info(18) }}
            <p>{{ 'Un abonnement en cours est nécessaire pour utiliser votre espace professionnel : publier vos activités, recevoir des réservations, suivre vos revenus et vos statistiques. Vos réservations déjà prises restent accessibles.'|trans }}</p>
        </div>
    {% endif %}

    {% if subscription %}
        {% set s = status_labels[subscription.status.value] ?? ['Résilié', 'grey'] %}
        <section class="pf-card pp-plan-current">
            <div class="pp-plan-current__head">
                <div>
                    <p class="pf-muted">{{ 'Offre actuelle'|trans }}</p>
                    <h2 class="pf-card__title">{{ subscription.plan.name }}</h2>
                    <p class="pp-plan__price">{{ subscription.plan.priceAmount|number_format(2, ',', ' ') }} {{ subscription.plan.currency }} <small>/ {{ (period[subscription.plan.billingPeriod.value] ?? 'mois')|trans }}</small></p>
                </div>
                <span class="pf-pill pf-pill--{{ s[1] }}">{{ s[0]|trans }}</span>
            </div>
            {% if subscription.currentPeriodEnd %}
                <p class="pf-muted">
                    {% if subscription.cancelAtPeriodEnd %}
                        {{ 'Résiliation programmée pour le'|trans }} {{ subscription.currentPeriodEnd|date('d/m/Y') }}.
                    {% else %}
                        {{ 'Prochain renouvellement le'|trans }} {{ subscription.currentPeriodEnd|date('d/m/Y') }}.
                    {% endif %}
                </p>
            {% endif %}
            {% if subscription.status.value == 'active' and not subscription.cancelAtPeriodEnd %}
                <form method="post" action="{{ path('app_pro_subscription_cancel') }}" onsubmit="return confirm('{{ 'Résilier votre abonnement à la fin de la période en cours ?'|trans|e('js') }}')">
                    <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                    <button type="submit" class="pf-btn">{{ 'Résilier'|trans }}</button>
                </form>
            {% endif %}
        </section>
    {% else %}
        <div class="pp-plans">
            {% for plan in plans %}
                <section class="pf-card pp-plan{{ plan.featured ? ' is-featured' }}">
                    {% if plan.featured %}<span class="pf-pill pf-pill--blue pp-plan__flag">{{ 'Recommandée'|trans }}</span>{% endif %}
                    <h2 class="pf-card__title">{{ plan.name }}</h2>
                    <p class="pp-plan__price">{{ plan.priceAmount|number_format(2, ',', ' ') }} {{ plan.currency }} <small>/ {{ (period[plan.billingPeriod.value] ?? 'mois')|trans }}</small></p>
                    {% if plan.description %}<p class="pf-muted">{{ plan.description }}</p>{% endif %}
                    <ul class="pp-plan__features">
                        <li>{{ icon.check(16) }} {{ plan.maxRequestsPerMonth ? plan.maxRequestsPerMonth ~ ' ' ~ 'demandes par mois'|trans : 'Demandes illimitées'|trans }}</li>
                        <li>{{ icon.check(16) }} {{ plan.maxResponsesPerMonth ? plan.maxResponsesPerMonth ~ ' ' ~ 'devis par mois'|trans : 'Devis illimités'|trans }}</li>
                        {% if plan.featured %}<li>{{ icon.check(16) }} {{ 'Mise en avant dans les résultats'|trans }}</li>{% endif %}
                        {% if plan.advancedStatistics %}<li>{{ icon.check(16) }} {{ 'Statistiques avancées'|trans }}</li>{% endif %}
                    </ul>
                    <form method="post" action="{{ path('app_pro_subscription_subscribe', {slug: plan.slug}) }}" data-turbo="false">
                        <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                        <button type="submit" class="pf-btn pf-btn--primary pp-plan__cta">{{ 'S’abonner'|trans }}</button>
                    </form>
                </section>
            {% else %}
                <div class="pf-card pf-empty"><strong>{{ 'Aucune offre pour le moment.'|trans }}</strong>{{ 'Revenez bientôt ou contactez-nous depuis le support.'|trans }}</div>
            {% endfor %}
        </div>
    {% endif %}

    <p class="pf-muted pp-plan-note">{{ 'Votre abonnement est réglé à TrouveMoi par paiement sécurisé (Stripe). Les prestations que vous vendez, elles, vous sont payées directement par vos clients : TrouveMoi n’en encaisse aucune et ne prélève aucune commission.'|trans }}</p>

    {% if history is not empty %}
        <section class="pf-card">
            <h2 class="pf-card__title pp-mb">{{ 'Historique'|trans }}</h2>
            <ul class="pf-list pf-list--lined">
                {% for past in history %}
                    <li><div class="pf-list__body"><strong>{{ past.plan.name }}</strong><small>{{ past.createdAt|date('d/m/Y') }}</small></div><span class="pf-pill pf-pill--grey">{{ 'Résilié'|trans }}</span></li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
{% endblock %}
