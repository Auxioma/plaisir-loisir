{#
    Abonnement professionnel (§17 du CDC, route indicative /pro/abonnement du
    §33.1). Aucune maquette Figma pour cet écran. Rejoint la coquille
    account/_layout.html.twig le 14/09 (voir provider/space/dashboard.html.twig).
#}
{% extends 'account/_layout.html.twig' %}

{% block title %}{{ 'Abonnement'|trans }}{% endblock %}

{% block account %}
    {% include 'account/_page_head.html.twig' with {
        crumbs: [{ label: 'Abonnement'|trans }],
        title: 'Abonnement professionnel'|trans,
        subtitle: 'Votre offre et sa facturation.'|trans,
    } %}

    {% if subscription %}
        <div class="card shadow-sm mb-5">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <h2 class="h4 mb-1">{{ subscription.plan.name }}</h2>
                        <p class="text-muted mb-0">
                            {{ subscription.plan.priceAmount|number_format(2, ',', ' ') }} {{ subscription.plan.currency }}
                            / {{ subscription.plan.billingPeriod.value == 'yearly' ? 'an'|trans : 'mois'|trans }}
                        </p>
                    </div>
                    <span class="badge rounded-pill {{ subscription.status.value == 'active' ? 'text-bg-success' : (subscription.status.value == 'past_due' ? 'text-bg-warning' : 'text-bg-secondary') }}">
                        {{ subscription.status.value == 'active' ? 'Actif'|trans : (subscription.status.value == 'past_due' ? 'Paiement en retard'|trans : (subscription.status.value == 'incomplete' ? 'En attente de confirmation'|trans : 'Résilié'|trans)) }}
                    </span>
                </div>

                {% if subscription.currentPeriodEnd %}
                    <p class="text-muted small mt-3 mb-0">
                        {% if subscription.cancelAtPeriodEnd %}
                            {{ 'Résiliation programmée pour le'|trans }} {{ subscription.currentPeriodEnd|date('d/m/Y') }}.
                        {% else %}
                            {{ 'Prochain renouvellement le'|trans }} {{ subscription.currentPeriodEnd|date('d/m/Y') }}.
                        {% endif %}
                    </p>
                {% endif %}

                {% if subscription.status.value == 'active' and not subscription.cancelAtPeriodEnd %}
                    <form method="post" action="{{ path('app_pro_subscription_cancel') }}" class="mt-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                        <button type="submit" class="btn btn-sm pl-btn pl-btn--outline-dark">{{ 'Résilier'|trans }}</button>
                    </form>
                {% endif %}
            </div>
        </div>
    {% else %}
        <p class="text-muted mb-4">{{ 'Vous n\'avez pas encore d\'abonnement. Choisissez une offre pour publier vos activités.'|trans }}</p>

        <div class="row g-4 mb-5">
            {% for plan in plans %}
                <div class="col-sm-6 col-lg-4">
                    <div class="card h-100 shadow-sm {{ plan.featured ? 'border-2' }}" style="{{ plan.featured ? 'border-color: var(--pl-action);' }}">
                        <div class="card-body d-flex flex-column">
                            {% if plan.featured %}
                                <span class="badge rounded-pill align-self-start mb-2" style="background: var(--pl-action-light); color: var(--pl-action);">{{ 'Recommandée'|trans }}</span>
                            {% endif %}
                            <h2 class="h5">{{ plan.name }}</h2>
                            <p class="fs-3 fw-bold mb-1">
                                {{ plan.priceAmount|number_format(2, ',', ' ') }} {{ plan.currency }}
                            </p>
                            <p class="text-muted small mb-3">
                                / {{ plan.billingPeriod.value == 'yearly' ? 'an'|trans : 'mois'|trans }}
                            </p>
                            {% if plan.description %}
                                <p class="small mb-3">{{ plan.description }}</p>
                            {% endif %}
                            <ul class="small text-muted mb-4">
                                <li>{{ plan.maxRequestsPerMonth ? plan.maxRequestsPerMonth ~ ' ' ~ 'demandes par mois'|trans : 'Demandes illimitées'|trans }}</li>
                                <li>{{ plan.maxResponsesPerMonth ? plan.maxResponsesPerMonth ~ ' ' ~ 'devis par mois'|trans : 'Devis illimités'|trans }}</li>
                                {% if plan.featured %}<li>{{ 'Mise en avant dans les résultats'|trans }}</li>{% endif %}
                                {% if plan.advancedStatistics %}<li>{{ 'Statistiques avancées'|trans }}</li>{% endif %}
                            </ul>
                            <form method="post" action="{{ path('app_pro_subscription_subscribe', {slug: plan.slug}) }}" class="mt-auto">
                                <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                                <button type="submit" class="btn pl-btn pl-btn--cta w-100">{{ 'S\'abonner'|trans }}</button>
                            </form>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {% if history is not empty %}
        <h2 class="h5 mb-3">{{ 'Historique'|trans }}</h2>
        <div class="list-group">
            {% for past in history %}
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <span>{{ past.plan.name }} — {{ past.createdAt|date('d/m/Y') }}</span>
                    <span class="badge text-bg-secondary">{{ 'Résilié'|trans }}</span>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
