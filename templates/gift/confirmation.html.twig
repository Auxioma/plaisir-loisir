{#
    Bon cadeau acheté (GiftController::confirmation()) : le code, à imprimer
    ou à transférer. Lien reçu par e-mail par l'acheteur.
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Votre bon cadeau'|trans }}{% endblock %}
{% block meta_description %}{{ 'Votre bon cadeau TrouveMoi.'|trans }}{% endblock %}

{% block body %}
<div class="pg gc-done">
    <div class="pg-wrap">
        {% import '_partials/_ga.html.twig' as ga %}
        {% if card.paid and card.paidAt %}{{ ga.event('purchase', {transaction_id: card.code, currency: 'EUR', value: card.amount + 0, items: [{item_id: 'bon-cadeau', item_name: card.label, item_category: 'Bon cadeau', price: card.amount + 0, quantity: 1}]}, 'gift-' ~ card.code) }}{% endif %}
        {% if card.paid and card.paidAt %}
            <p class="gc-done__ok">{{ icon.check_badge(28) }} {{ 'Merci ! Votre bon cadeau est prêt.'|trans }}</p>
            <article class="gc-voucher">
                <header><span>TrouveMoi <small>Plaisirs &amp; Loisirs</small></span><strong>{{ 'Bon cadeau'|trans }}</strong></header>
                <p class="gc-voucher__for">{{ 'Pour'|trans }} <strong>{{ card.recipientName }}</strong>, {{ 'de la part de'|trans }} <strong>{{ card.buyerName }}</strong></p>
                <p class="gc-voucher__what">{{ card.label }}</p>
                {% if card.service %}<p>{{ 'Valable uniquement pour cette activité'|trans }} : <strong>{{ card.service.title }}</strong>{% if card.service.provider %} · {{ card.service.provider.displayName }}{% endif %}</p>{% endif %}
                <p class="gc-voucher__amount">{{ card.amount|number_format(2, ',', ' ') }} €</p>
                {% if card.message %}<blockquote>« {{ card.message }} »</blockquote>{% endif %}
                <p class="gc-voucher__code">{{ 'Code'|trans }} <strong>{{ card.code }}</strong></p>
                <small>{{ 'Valable jusqu’au'|trans }} {{ card.expiresAt|date('d/m/Y') }} · {{ 'à utiliser lors de la réservation de cette activité sur trouvemoi.eu'|trans }}</small>
            </article>
            <p class="gc-done__info">
                {% if card.delivery == 'email' %}
                    {% if card.recipientEmailSentAt %}{{ 'Le bon a été envoyé par e-mail à'|trans }} {{ card.recipientEmail }}.
                    {% else %}{{ 'Le paiement est confirmé. L’envoi au bénéficiaire a rencontré un problème ; actualisez cette page pour réessayer.'|trans }}{% endif %}
                    {% if card.buyerEmailSentAt %} {{ 'Une copie vous a été adressée.'|trans }}{% endif %}
                {% elseif card.delivery == 'postal' %}{{ 'Le bon sera envoyé par courrier sous 3 à 5 jours ouvrés.'|trans }}
                {% else %}{{ 'Imprimez-le ou enregistrez-le en PDF pour l’offrir de la main à la main.'|trans }}{% endif %}
            </p>
            {% if verification_error %}<p role="alert">{{ 'Le paiement est confirmé, mais un e-mail n’a pas pu être envoyé. Actualisez cette page pour réessayer.'|trans }}</p>{% endif %}
            <div class="gc-done__actions">
                <a class="pg-btn" href="{{ path('app_gifts_pdf', {id: card.id}) }}">{{ icon.download(16) }} {{ 'Télécharger le bon en PDF'|trans }}</a>
                {% if activity %}<a class="pg-btn pg-btn--outline" href="{{ path('app_activity_show', {slug: activity.slug}) }}">{{ 'Voir l’activité'|trans }}</a>{% endif %}
                <a class="pg-btn pg-btn--outline" href="{{ path('app_gifts') }}">{{ 'Offrir un autre bon'|trans }}</a>
            </div>
        {% else %}
            <div class="ofm-empty">
                {{ icon.hourglass(32) }}
                <strong>{{ 'Paiement en cours de validation…'|trans }}</strong>
                {% if verification_error %}<p role="alert">{{ 'La vérification du paiement est momentanément indisponible. Actualisez cette page dans un instant.'|trans }}</p>{% endif %}
                <span>{{ 'Votre bon cadeau apparaîtra ici dès la confirmation du paiement. Vous le recevrez aussi par e-mail.'|trans }}</span>
                <a class="pg-btn pg-btn--outline" href="{{ app.request.uri }}">{{ 'Actualiser'|trans }}</a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
