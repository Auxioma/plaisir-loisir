{#
    « Offrir un bon cadeau » — saisie puis paiement (GiftController::offer()).
    Prolonge la maquette bons_cadeaux.jpeg : récapitulatif à droite, champs
    obligatoires contrôlés côté serveur (422 + message sous le champ) et
    côté navigateur (assets/gifts.js).
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Offrir un bon cadeau'|trans }}{% endblock %}
{% block meta_description %}{{ 'Personnalisez et offrez un bon cadeau TrouveMoi, valable 12 mois.'|trans }}{% endblock %}

{% macro err(errors, key) %}{% if errors[key] is defined %}<span class="gc-err" role="alert">{{ errors[key]|trans }}</span>{% endif %}{% endmacro %}

{% block body %}
<div class="pg gc-buy">
    <div class="pg-wrap">
        <nav class="act-breadcrumb gc-crumb" aria-label="{{ "Fil d'Ariane"|trans }}"><a href="{{ path('app_home') }}">{{ 'Accueil'|trans }}</a> <span aria-hidden="true">|</span> <a href="{{ path('app_gifts') }}">{{ 'Cadeaux'|trans }}</a> <span aria-hidden="true">|</span> <span aria-current="page">{{ 'Offrir'|trans }}</span></nav>
        <h1 class="gc-buy__title">{{ icon.gift(28) }} {{ 'Offrir un bon cadeau'|trans }}</h1>

        {% if errors._token is defined %}<p class="gc-alert" role="alert">{{ errors._token|trans }}</p>{% endif %}

        <form id="gift-form" class="gc-buy__cols" method="post" action="{{ path('app_gifts_offer') }}" data-turbo="false" novalidate data-gc-form data-unit="{{ unit }}">
            <input type="hidden" name="_token" value="{{ csrf_token('gift_offer') }}">
            {% if activity %}<input type="hidden" name="activite" value="{{ activity.slug }}">{% endif %}

            <div class="gc-buy__main">
                <section class="pg-card">
                    <h2 class="pg-h3">1. {{ 'Le bon cadeau'|trans }}</h2>
                    {% if activity %}
                        <label class="gc-field{{ errors.people is defined ? ' is-invalid' }}">{{ 'Nombre de personnes'|trans }} *
                            <input type="number" name="people" value="{{ data.people }}" min="1" max="{{ limits.people }}" step="1" inputmode="numeric" required data-gc-people aria-describedby="gc-people-help">
                            <small id="gc-people-help">{{ 'Saisissez le nombre souhaité, jusqu’à'|trans }} {{ limits.people }} {{ 'personnes.'|trans }}</small>
                            {{ _self.err(errors, 'people') }}</label>
                    {% endif %}
                </section>

                <section class="pg-card">
                    <h2 class="pg-h3">2. {{ 'Pour qui ?'|trans }}</h2>
                    <label class="gc-field{{ errors.recipient_name is defined ? ' is-invalid' }}">{{ 'Prénom du bénéficiaire'|trans }} *
                        <input name="recipient_name" value="{{ data.recipient_name }}" required minlength="2" maxlength="120">
                        {{ _self.err(errors, 'recipient_name') }}</label>
                    <fieldset class="gc-field{{ errors.delivery is defined ? ' is-invalid' }}">
                        <legend>{{ 'Mode d’envoi'|trans }} *</legend>
                        <div class="gc-radios">
                            {% for k, label in deliveries %}
                                <label class="gc-radio"><input type="radio" name="delivery" value="{{ k }}"{{ data.delivery == k ? ' checked' }} required data-gc-delivery> {{ (k == 'email' ? icon.mail(18) : (k == 'print' ? icon.receipt(18) : icon.send(18))) }} {{ label|trans }}</label>
                            {% endfor %}
                        </div>
                        {{ _self.err(errors, 'delivery') }}
                    </fieldset>
                    <label class="gc-field{{ errors.recipient_email is defined ? ' is-invalid' }}" data-gc-show="email">{{ 'E-mail du bénéficiaire'|trans }} *
                        <input type="email" name="recipient_email" value="{{ data.recipient_email }}" maxlength="180">
                        <small class="pg-muted">{{ 'Le bon lui est envoyé dès le paiement validé.'|trans }}</small>
                        {{ _self.err(errors, 'recipient_email') }}</label>
                    <label class="gc-field{{ errors.postal_address is defined ? ' is-invalid' }}" data-gc-show="postal">{{ 'Adresse postale du bénéficiaire'|trans }} *
                        <textarea name="postal_address" rows="3" maxlength="400" placeholder="{{ 'N°, rue, code postal, ville'|trans }}">{{ data.postal_address }}</textarea>
                        {{ _self.err(errors, 'postal_address') }}</label>
                    <label class="gc-field{{ errors.message is defined ? ' is-invalid' }}">{{ 'Votre message (facultatif)'|trans }}
                        <textarea name="message" rows="3" maxlength="300" data-gc-message placeholder="{{ 'Joyeux anniversaire ! Profite bien…'|trans }}">{{ data.message }}</textarea>
                        <small class="pg-muted"><span data-gc-count>{{ data.message|length }}</span>/300</small>
                        {{ _self.err(errors, 'message') }}</label>
                </section>

                <section class="pg-card">
                    <h2 class="pg-h3">3. {{ 'Vos coordonnées'|trans }}</h2>
                    <div class="pg-form__row">
                        <label class="gc-field{{ errors.buyer_name is defined ? ' is-invalid' }}">{{ 'Nom et prénom'|trans }} *
                            <input name="buyer_name" value="{{ data.buyer_name }}" required minlength="2" maxlength="200" autocomplete="name">
                            {{ _self.err(errors, 'buyer_name') }}</label>
                        <label class="gc-field{{ errors.buyer_email is defined ? ' is-invalid' }}">{{ 'E-mail'|trans }} *
                            <input type="email" name="buyer_email" value="{{ data.buyer_email }}" required maxlength="180" autocomplete="email">
                            {{ _self.err(errors, 'buyer_email') }}</label>
                    </div>
                    <label class="gc-field{{ errors.buyer_phone is defined ? ' is-invalid' }}">{{ 'Téléphone (facultatif)'|trans }}
                        <input type="tel" name="buyer_phone" value="{{ data.buyer_phone }}" maxlength="20" autocomplete="tel" pattern="\+?[0-9 .()\-]{6,20}">
                        {{ _self.err(errors, 'buyer_phone') }}</label>
                    <label class="gc-check{{ errors.accept_terms is defined ? ' is-invalid' }}">
                        <input type="checkbox" name="accept_terms" value="1" required{{ data.accept_terms == '1' ? ' checked' }}>
                        <span>{{ 'J’accepte les'|trans }} <a href="{{ path('app_corporate_sales_terms') }}" target="_blank">{{ 'conditions générales de vente'|trans }}</a> {{ 'et la'|trans }} <a href="{{ path('app_corporate_privacy') }}" target="_blank">{{ 'politique de confidentialité'|trans }}</a>. *</span>
                    </label>
                    {{ _self.err(errors, 'accept_terms') }}
                </section>

                <section class="pg-card">
                    <h2 class="pg-h3">4. Paiement auprès du prestataire</h2>
                    {% if payment_methods is empty %}
                        <p class="pg-muted">Ce prestataire n’a pas encore configuré de moyen de paiement en ligne. Le bon ne peut pas être acheté pour le moment.</p>
                    {% else %}
                        <fieldset class="gc-field"><legend>Choisissez un moyen de paiement</legend><div class="gc-radios">
                            {% for key, method in payment_methods %}<label class="gc-radio"><input type="radio" name="moyen" value="{{ key }}"{{ loop.first ? ' checked' }} required> {{ method.label|trans }}</label>{% endfor %}
                        </div></fieldset>
                        <p class="pg-muted">Le paiement est versé directement au prestataire de cette activité. Le bon sera valable uniquement pour celle-ci.</p>
                    {% endif %}
                </section>
            </div>

            <aside class="gc-buy__side">
                <section class="pg-card gc-summary">
                    {% if activity %}
                        <img src="{{ asset(activity.image) }}" alt="" loading="lazy" decoding="async">
                        <strong>{{ activity.title }}</strong>
                        <small>{{ activity.place }}</small>
                        <p class="gc-summary__line">{{ unit|number_format(unit == unit|round ? 0 : 2, ',', ' ') }} € × <span data-gc-people-out>{{ data.people }}</span> {{ 'pers.'|trans }}</p>
                    {% endif %}
                    <p class="gc-summary__total">{{ 'Total'|trans }} <strong data-gc-total>{{ total|number_format(2, ',', ' ') }} €</strong></p>
                    <ul class="gc-summary__perks">
                        <li>{{ icon.check(14) }} {{ 'Valable 12 mois'|trans }}</li>
                        <li>{{ icon.check(14) }} Activité et prestataire indiqués avant paiement</li>
                        <li>{{ icon.check(14) }} {{ 'Paiement 100% sécurisé'|trans }}</li>
                    </ul>
                    <button class="pg-btn pg-btn--block"{{ payment_methods is empty ? ' disabled' }}>{{ icon.padlock(16) }} {{ 'Payer et offrir'|trans }}</button>
                </section>
            </aside>
        </form>
    </div>
</div>
{% endblock %}
