{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Offrir un cadeau — Vos informations'|trans }}{% endblock %}
{% block meta_description %}{{ 'Offrez une carte cadeau TrouveMoi : saisissez vos informations et personnalisez votre message.'|trans }}{% endblock %}

{% block header %}
    {% include '_partials/navbar.html.twig' with { nav_active: 'cadeaux' } %}
{% endblock %}

{% block body %}
<div class="gift-page gift-tunnel-page">
    <div class="container">

        <nav class="act-breadcrumb" aria-label="{{ "Fil d'Ariane"|trans }}">
            <a href="{{ path('app_home') }}">{{ 'Accueil'|trans }}</a>
            <span aria-hidden="true">|</span>
            <a href="{{ path('app_gifts') }}">{{ 'Cadeaux'|trans }}</a>
            <span aria-hidden="true">|</span>
            <span aria-current="page">{{ 'Offrir un cadeau'|trans }}</span>
        </nav>

        <div class="gift-tunnel">
            {# POST, ET NON GET — corrigé le 25/08.

               Ce formulaire recueille des données personnelles : nom, adresse
               e-mail, téléphone, nom du destinataire et message privé. En GET,
               elles partaient dans l'adresse de la page suivante :

                   /cadeaux/offrir/paiement?fullName=…&email=…&message=…

               Une URL n'est pas un endroit discret. Elle est conservée dans
               l'historique du navigateur, écrite en clair dans les journaux
               d'accès du serveur, et transmise dans l'en-tête « Referer » à
               tout service tiers que la page de paiement viendrait à charger.

               Le jeton accompagne le reste du site (contact, partenaire,
               assistants) : le contrôleur le vérifie avant d'afficher l'écran
               de paiement. #}
            {# data-turbo="false" : réponse 200 (pas de redirection) sur erreur, pour
               réafficher ce même écran avec ses erreurs — le formulaire poste vers
               GiftController::payment(), qui réaffiche ce template en cas d'échec.
               Même correctif que security/register.html.twig. #}
            {{ form_start(giftForm, {
                attr: { class: 'gift-steps', id: 'gift-form', novalidate: 'novalidate', 'data-turbo': 'false' },
                action: path('app_gifts_offer_payment'), method: 'post',
            }) }}

                {# ==========================================================
                   CARTE 1 : VOS INFORMATIONS (états vide / erreur / rempli
                   gérés au blur et à la soumission — spec écrans 5-7).
                   ======================================================== #}
                <section class="gift-formcard">
                    <h1 class="gift-formcard__title">{{ 'Vos informations'|trans }}</h1>
                    <p class="gift-formcard__lead">{{ 'Saisissez vos informations ici'|trans }}</p>
                    <p class="gift-formcard__required">{{ 'Champ obligatoire'|trans }}<span>*</span></p>

                    <div class="gift-field">
                        <label class="gift-field__label" for="giftFullName">{{ 'Nom & prénom'|trans }}</label>
                        <div class="gift-input">
                            <span class="gift-input__icon">{{ icon.person(18) }}</span>
                            {{ form_widget(giftForm.fullName, {
                                id: 'giftFullName',
                                attr: { placeholder: 'martinthomas', autocomplete: 'name', required: true, 'data-gift-required': true, 'data-sync': 'name' }
                            }) }}
                        </div>
                        <p class="gift-field__error" hidden>{{ '*Champ obligatoire'|trans }}</p>
                    </div>

                    <div class="gift-row">
                        <div class="gift-field">
                            <label class="gift-field__label" for="giftEmail">{{ 'Adresse e-mail'|trans }}</label>
                            <div class="gift-input">
                                <span class="gift-input__icon">{{ icon.mail(18) }}</span>
                                {{ form_widget(giftForm.email, {
                                    id: 'giftEmail',
                                    attr: { placeholder: 'Votre@email.com'|trans, autocomplete: 'email', required: true, 'data-gift-required': true, 'data-sync': 'email' }
                                }) }}
                            </div>
                            <p class="gift-field__hint">{{ 'Votre bon cadeau sera envoyé à cette adresse'|trans }}</p>
                            <p class="gift-field__error" hidden>{{ '*Champ obligatoire'|trans }}</p>
                        </div>
                        <div class="gift-field">
                            <label class="gift-field__label" for="giftPhone">{{ 'Numéro de téléphone'|trans }}</label>
                            {# Indicateur pays compact en préfixe interne, comme l'icône
                               statique qu'il remplace visuellement (icon.phone) — voir
                               assets/controllers/phone_country_controller.js. #}
                            <div class="gift-input gift-input--phone">
                                <span class="phone-country phone-country--prefix" data-controller="phone-country">
                                    <span class="phone-country__flag" data-phone-country-target="flag"></span>
                                    <span class="phone-country__code" data-phone-country-target="code"></span>
                                    {{ form_widget(giftForm.phone.country, {
                                        attr: { class: 'phone-country__select', 'data-phone-country-target': 'select', 'data-action': 'change->phone-country#sync' }
                                    }) }}
                                </span>
                                {{ form_widget(giftForm.phone.number, {
                                    id: 'giftPhone',
                                    attr: { placeholder: '06 12 34 56 78', autocomplete: 'tel' }
                                }) }}
                            </div>
                            <p class="gift-field__error" hidden>{{ '*Champ obligatoire'|trans }}</p>
                        </div>
                    </div>

                    <label class="gift-consent">
                        {{ form_widget(giftForm.agreeTerms, { attr: { required: true, 'data-gift-required': true } }) }}
                        <span>{{ "J'accepte les"|trans }} <a class="auth-inline-link" href="{{ path('app_corporate_terms') }}">{{ 'conditions générales'|trans }}</a> {{ 'et la'|trans }} <a class="auth-inline-link" href="{{ path('app_corporate_privacy') }}">{{ 'politique de confidentialité'|trans }}</a></span>
                    </label>
                </section>

                {# ==========================================================
                   CARTE 2 : A QUI VOUS L'OFFREZ.
                   ======================================================== #}
                <section class="gift-formcard gift-formcard--recipient">
                    {# Maquette : la seconde carte n'a pas de gros titre — son intitulé est
                       au même corps que « Saisissez vos informations ici ». #}
                    <h2 class="gift-formcard__lead gift-formcard__lead--head">{{ "A qui vous l'offrez"|trans }}</h2>
                    <p class="gift-formcard__required">{{ 'Champ obligatoire'|trans }}<span>*</span></p>

                    <div class="gift-field">
                        <label class="gift-field__label" for="giftSender">{{ "Nom & Prénom de l'expéditeur"|trans }}</label>
                        <div class="gift-input">
                            <span class="gift-input__icon">{{ icon.person(18) }}</span>
                            <input id="giftSender" type="text" name="senderName" placeholder="martinthomas" data-sync="sender">
                        </div>
                    </div>

                    <div class="gift-field">
                        <label class="gift-field__label" for="giftRecipient">{{ 'Nom & Prénom du destinataire'|trans }}</label>
                        <div class="gift-input">
                            <span class="gift-input__icon">{{ icon.person(18) }}</span>
                            <input id="giftRecipient" type="text" name="recipientName" placeholder="martinthomas" data-sync="recipient">
                        </div>
                    </div>

                    <div class="gift-field">
                        <div class="gift-textarea">
                            <textarea id="giftMessage" name="message" maxlength="150" rows="4"
                                      placeholder="{{ 'Un petit message avec le cadeau ?'|trans }}" data-sync="message"
                                      aria-label="{{ 'Un petit message avec le cadeau ?'|trans }}"></textarea>
                        </div>
                        <p class="gift-field__counter"><span data-gift-counter>0</span>/150</p>
                    </div>
                </section>

                <div class="gift-tunnel__foot">
                    <p class="gift-tunnel__total">{{ 'Total :'|trans }} <strong>160€</strong></p>
                    <button type="submit" class="pl-btn pl-btn--outline-action gift-next">{{ 'Suivant'|trans }} {{ icon.chevron_right(16) }}</button>
                </div>
            {{ form_end(giftForm) }}

            {% include 'gift/_order_summary.html.twig' %}
        </div>

    </div>
</div>
{% endblock %}
