{#
    Paramètres du compte (Lot I, 15/09). Aucune maquette : réutilise le
    gabarit de l'espace compte et des cartes Bootstrap, comme les autres
    écrans ajoutés sans Figma (quote/mes_demandes.html.twig et consorts).
    Variable : account (l'entité User).
#}
{% extends 'account/_layout.html.twig' %}

{% block title %}{{ 'Paramètres du compte'|trans }}{% endblock %}

{% block account %}
    {% include 'account/_page_head.html.twig' with {
        crumbs: [{ label: 'Paramètres du compte'|trans }],
        title: 'Paramètres du compte'|trans,
    } %}

    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">
            <h2 class="h5 mb-3">{{ 'Vos informations'|trans }}</h2>
            {# data-turbo="false" : réponse 200 (pas de redirection) sur erreur, pour
               réafficher le formulaire avec ses erreurs — voir security/register.html.twig
               pour le même correctif appliqué à l'inscription. #}
            {{ form_start(settingsForm, { action: path('app_account_settings'), method: 'post', attr: { enctype: 'multipart/form-data', 'data-turbo': 'false' } }) }}
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label" for="prenom">{{ 'Prénom'|trans }}</label>
                        {{ form_widget(settingsForm.firstName, { id: 'prenom', attr: { class: 'form-control', maxlength: 100 } }) }}
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label" for="nom">{{ 'Nom'|trans }}</label>
                        {{ form_widget(settingsForm.lastName, { id: 'nom', attr: { class: 'form-control', maxlength: 100 } }) }}
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="telephone">{{ 'Téléphone'|trans }}</label>
                    {# Pas de maquette Figma pour cet écran : un select pays classique
                       suffit, pas besoin de l'indicateur compact des autres formulaires. #}
                    <div class="input-group">
                        {{ form_widget(settingsForm.phone.country, { attr: { class: 'form-select', style: 'max-width: 12rem;' } }) }}
                        {{ form_widget(settingsForm.phone.number, { id: 'telephone', attr: { class: 'form-control' } }) }}
                    </div>
                </div>

                <div class="mb-4" data-controller="photo-preview">
                    <label class="form-label" for="photo">{{ 'Photo de profil'|trans }}</label>
                    <div class="mb-2">
                        <img class="acc-photo-preview" src="{{ account.avatarPath ? asset(account.avatarPath) : '' }}" alt="" data-photo-preview-target="image" {{ account.avatarPath ? '' : 'hidden' }}>
                    </div>
                    {{ form_widget(settingsForm.photo, { id: 'photo', attr: { class: 'form-control', accept: 'image/jpeg,image/png,image/webp', 'data-photo-preview-target': 'input', 'data-action': 'change->photo-preview#preview' } }) }}
                    <div class="form-text">{{ 'JPEG, PNG ou WebP, 4 Mo maximum.'|trans }}</div>
                </div>

                <button type="submit" class="btn pl-btn pl-btn--cta">{{ 'Enregistrer'|trans }}</button>
            {{ form_end(settingsForm) }}
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">
            <h2 class="h5 mb-2">{{ 'Vos données'|trans }}</h2>
            <p class="text-muted small mb-3">{{ 'Téléchargez une copie de vos données personnelles (profil, favoris, demandes, activités privées, avis, messages envoyés).'|trans }}</p>
            <a href="{{ path('app_account_export') }}" class="btn btn-outline-secondary">{{ 'Exporter mes données'|trans }}</a>
        </div>
    </div>

    <div class="card border-danger shadow-sm">
        <div class="card-body p-4">
            <h2 class="h5 mb-3 text-danger">{{ 'Zone de danger'|trans }}</h2>

            {# `confirm()` natif remplacé (signalé le 18/09) : pas une vraie
               boîte de dialogue de l'application — bloquée par certains
               navigateurs/webviews (elle se contente alors de logger dans la
               console, sans jamais rien demander à la personne), pas de
               charte graphique, aucun moyen de la personnaliser. Une vraie
               modale Bootstrap (déjà chargée globalement, voir app.js) pour
               ces deux décisions irréversibles : elle force un second clic
               EXPLICITE sur le bouton rouge, « Annuler » ferme sans rien
               envoyer. #}
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirm-deactivate">{{ 'Désactiver mon compte'|trans }}</button>
                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#confirm-delete">{{ 'Supprimer mon compte'|trans }}</button>
            </div>
        </div>
    </div>

    <div class="modal fade" id="confirm-deactivate" tabindex="-1" aria-labelledby="confirm-deactivate-title" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" action="{{ path('app_account_deactivate') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                    <div class="modal-header">
                        <h2 class="modal-title h5 text-danger" id="confirm-deactivate-title">{{ 'Désactiver mon compte ?'|trans }}</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Fermer'|trans }}"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">{{ 'Vous ne pourrez plus vous connecter tant qu\'un administrateur ne l\'aura pas réactivé.'|trans }}</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'Annuler'|trans }}</button>
                        <button type="submit" class="btn btn-outline-danger">{{ 'Désactiver mon compte'|trans }}</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="confirm-delete" tabindex="-1" aria-labelledby="confirm-delete-title" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" action="{{ path('app_account_delete') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                    <div class="modal-header">
                        <h2 class="modal-title h5 text-danger" id="confirm-delete-title">{{ 'Supprimer mon compte ?'|trans }}</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Fermer'|trans }}"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">{{ 'Suppression définitive de votre compte et de vos données personnelles. Cette action est irréversible.'|trans }}</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'Annuler'|trans }}</button>
                        <button type="submit" class="btn btn-danger">{{ 'Supprimer définitivement'|trans }}</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
