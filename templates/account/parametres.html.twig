{#
    Paramètres du compte — maquette docs/maquettes/profil_particulier/
    profil_parametres_particulier.jpeg (30/09). Action : AccountController::settings().

    La modification de l'identité, du téléphone, de la photo, de la langue et
    de l'adresse se fait dans « Informations personnelles » : les boutons
    « Modifier » y mènent. Le mot de passe se change par le parcours « mot de
    passe oublié » (code envoyé par e-mail). Export, désactivation et
    suppression sont réels (RGPD, §26 du CDC).

    Écarts assumés : pas de suivi des appareils connectés ni de double
    authentification (aucun back) ; le fuseau horaire est celui de la
    plateforme (Europe/Paris).
#}
{% extends 'account/_layout.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}
{% import 'account/_ui.html.twig' as ui %}

{% block title %}{{ 'Paramètres du compte'|trans }}{% endblock %}

{% block account %}
    <header class="pf-head">
        <div>
            <h1 class="pf-title">{{ 'Paramètres du compte'|trans }}</h1>
            <p class="pf-sub">{{ 'Gérez vos préférences de compte et de sécurité.'|trans }}</p>
        </div>
    </header>

    <nav class="pf-tabs pf-tabs--line">
        <a class="pf-tab is-active" href="#general">{{ icon.sliders(18) }} {{ 'Général'|trans }}</a>
        <a class="pf-tab" href="#securite">{{ icon.shield(18) }} {{ 'Sécurité'|trans }}</a>
        <a class="pf-tab" href="#donnees">{{ icon.eye(18) }} {{ 'Confidentialité'|trans }}</a>
        <a class="pf-tab" href="{{ path('app_account_profile') }}">{{ icon.gear(18) }} {{ 'Préférences'|trans }}</a>
        <a class="pf-tab" href="{{ path('app_account_notification_preferences') }}">{{ icon.mail(18) }} {{ 'Communications'|trans }}</a>
        <a class="pf-tab" href="#zone-dangereuse">{{ icon.trash(18) }} {{ 'Supprimer le compte'|trans }}</a>
    </nav>

    <section class="pf-card pf-settings-account" id="general">
        <div class="pf-card__head">
            <h2 class="pf-card__title">{{ 'Informations du compte'|trans }}</h2>
            <a class="pf-btn" href="{{ path('app_account_profile') }}">{{ 'Modifier'|trans }}</a>
        </div>
        <div class="pf-settings-account__body">
            <span class="pf-settings-account__avatar">
                <img src="{{ asset(user.avatar) }}" alt="">
                <a href="{{ path('app_account_profile') }}" aria-label="{{ 'Changer la photo'|trans }}">{{ icon.camera(14) }}</a>
            </span>
            <dl>
                <div><dt>{{ 'Nom complet'|trans }}</dt><dd>{{ user.name }}</dd></div>
                <div><dt>{{ 'Email'|trans }}</dt><dd>{{ account.email }} {% if account.status.value == 'active' %}{{ ui.pill('Vérifié'|trans, 'green') }}{% endif %}</dd></div>
                <div><dt>{{ 'Numéro de téléphone'|trans }}</dt><dd>{{ account.phone ?: '—' }}</dd></div>
            </dl>
        </div>
    </section>

    <section class="pf-card pf-setting" id="securite">
        <span class="pf-setting__ico">{{ icon.padlock(22) }}</span>
        <div class="pf-setting__body">
            <strong>{{ 'Mot de passe'|trans }}</strong>
            <span class="pf-setting__dots">••••••••••••••</span>
            <small>{{ 'Un code de vérification vous est envoyé par e-mail pour le changer.'|trans }}</small>
        </div>
        <a class="pf-btn" href="{{ path('app_forgot_password_request') }}">{{ 'Modifier le mot de passe'|trans }}</a>
    </section>

    <section class="pf-card pf-setting">
        <span class="pf-setting__ico">{{ icon.globe_simple(22) }}</span>
        <div class="pf-setting__body pf-setting__body--cols">
            <strong>{{ 'Langue et région'|trans }}</strong>
            <div><small>{{ 'Langue'|trans }}</small><span>{{ (account.preferredLocale ?? app.request.locale) == 'en' ? 'English' : 'Français' }}</span></div>
            <div><small>{{ 'Région'|trans }}</small><span>{{ account.country ? account.country|pf_country : 'France' }}</span></div>
        </div>
        <a class="pf-btn" href="{{ path('app_account_profile') }}">{{ 'Modifier'|trans }}</a>
    </section>

    <section class="pf-card pf-setting">
        <span class="pf-setting__ico">{{ icon.clock(22) }}</span>
        <div class="pf-setting__body">
            <strong>{{ 'Fuseau horaire'|trans }}</strong>
            <small>{{ 'Fuseau horaire actuel'|trans }}</small>
            <span>(UTC+01:00) Paris, Bruxelles</span>
        </div>
    </section>

    <section class="pf-card pf-setting">
        <span class="pf-setting__ico">{{ icon.monitor(22) }}</span>
        <div class="pf-setting__body">
            <strong>{{ 'Appareils connectés'|trans }}</strong>
            <small>{{ 'Vous êtes connecté sur cet appareil. Déconnectez-vous pour fermer votre session.'|trans }}</small>
        </div>
        <a class="pf-btn" href="{{ path('app_account_logout_confirm') }}">{{ 'Se déconnecter'|trans }}</a>
    </section>

    <section class="pf-card pf-setting" id="donnees">
        <span class="pf-setting__ico">{{ icon.download(22) }}</span>
        <div class="pf-setting__body">
            <strong>{{ 'Télécharger mes données'|trans }}</strong>
            <small>{{ 'Obtenez une copie de toutes vos données personnelles.'|trans }}</small>
        </div>
        <a class="pf-btn" href="{{ path('app_account_export') }}">{{ 'Demander mes données'|trans }}</a>
    </section>
{% endblock %}

{% block account_aside %}
    <section class="pf-card">
        <h2 class="pf-card__title">{{ 'Résumé du compte'|trans }}</h2>
        <ul class="pf-list pf-summary-list">
            <li><span class="pf-ico pf-ico--xs">{{ icon.calendar_grid(16) }}</span><span class="pf-list__body">{{ 'Membre depuis'|trans }}</span><span class="pf-list__end">{{ user.memberSince|capitalize }}</span></li>
            <li><span class="pf-ico pf-ico--xs">{{ icon.shield(16) }}</span><span class="pf-list__body">{{ 'Statut du compte'|trans }}</span><span class="pf-list__end">{{ account.status.value == 'active' ? ui.pill('Actif'|trans, 'green') : ui.pill('En attente'|trans, 'orange') }}</span></li>
            <li><span class="pf-ico pf-ico--xs">{{ icon.edit_square(16) }}</span><span class="pf-list__body">{{ 'Activités publiées'|trans }}</span><span class="pf-list__end">{{ published_count }}</span></li>
            <li><span class="pf-ico pf-ico--xs">{{ icon.calendar_grid(16) }}</span><span class="pf-list__body">{{ 'Réservations'|trans }}</span><span class="pf-list__end">{{ reservations_count }}</span></li>
            <li><span class="pf-ico pf-ico--xs">{{ icon.star(16) }}</span><span class="pf-list__body">{{ 'Avis laissés'|trans }}</span><span class="pf-list__end">{{ reviews_count }}</span></li>
        </ul>
        <a class="pf-btn pf-btn--block" href="{{ path('app_account_dashboard') }}">{{ 'Voir mon tableau de bord'|trans }}</a>
    </section>

    <section class="pf-card pf-card--soft">
        <h2 class="pf-card__title pf-card__title--icon"><span class="pf-shield">{{ icon.shield(22) }}</span>{{ 'Conseil sécurité'|trans }}</h2>
        <p class="pf-card__sub">{{ 'Pour protéger votre compte, nous vous recommandons :'|trans }}</p>
        <ul class="pf-checks pf-checks--spaced">
            <li>{{ icon.check(14) }} {{ 'Un mot de passe fort et unique'|trans }}</li>
            <li>{{ icon.check(14) }} {{ 'Ne jamais communiquer vos codes de vérification'|trans }}</li>
            <li>{{ icon.check(14) }} {{ 'La mise à jour régulière de vos informations'|trans }}</li>
        </ul>
        <a class="pf-link pf-arrow-link" href="{{ path('app_corporate_privacy') }}">{{ 'En savoir plus sur la sécurité'|trans }} {{ icon.arrow_right(14) }}</a>
    </section>

    <section class="pf-card pf-danger" id="zone-dangereuse">
        <h2 class="pf-card__title pf-card__title--icon"><span>{{ icon.trash(22) }}</span>{{ 'Zone dangereuse'|trans }}</h2>
        <p class="pf-card__sub">{{ 'Des actions irréversibles pour votre compte.'|trans }}</p>
        <form method="post" action="{{ path('app_account_delete') }}" onsubmit="return confirm('{{ 'Supprimer définitivement votre compte et vos données personnelles ? Cette action est irréversible.'|trans|e('js') }}')">
            <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
            <button type="submit" class="pf-btn pf-btn--danger pf-btn--block">{{ 'Supprimer mon compte'|trans }}</button>
        </form>
        <p class="pf-danger__or">{{ 'ou'|trans }}</p>
        <form method="post" action="{{ path('app_account_deactivate') }}" onsubmit="return confirm('{{ 'Désactiver votre compte ? Vous devrez nous contacter pour le réactiver.'|trans|e('js') }}')">
            <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
            <button type="submit" class="pf-danger__link">{{ 'Désactiver temporairement'|trans }}</button>
        </form>
    </section>
{% endblock %}
