{#
    Notifications — maquette docs/maquettes/profil_particulier/
    profil_notifications_particulier.jpeg (30/09).
    Données : AccountController::notifications() (NotificationFeed).

    « Archives » = notifications déjà lues. Seul le canal e-mail est
    réellement câblé (NotificationEmailListener) : push, SMS et rappels sont
    affichés comme « Bientôt disponible ».
#}
{% extends 'account/_layout.html.twig' %}

{% block title %}{{ 'Notifications'|trans }}{% endblock %}

{% set routes = {list: 'app_account_notifications', mark_all: 'app_account_notifications_mark_all_read', preferences: 'app_account_notification_preferences'} %}

{% block account %}
    {% include 'notification/_feed.html.twig' with { part: 'main' } %}
{% endblock %}

{% block account_aside %}
    {% include 'notification/_feed.html.twig' with { part: 'aside' } %}
{% endblock %}
