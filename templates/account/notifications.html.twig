{#
    Écran 3 — Notifications : onglets à compteurs + actions violettes,
    regroupement Aujourd'hui/Hier, items typés (icône ronde colorée +
    vignette), bouton « Charger plus ». ?vide=1 = état vide.
    Reconnecté au Lot K (16/09) : `groups`, `total` et `unread` viennent de
    NotificationRepository/NotificationPresenter, plus de la démo. Les
    onglets filtrent réellement (`?filtre=`), « Tout marquer comme lu » est
    une action POST (effet de bord, jamais un lien GET — même règle qu'au
    Lot 1 pour « Renvoyer le code »). « Paramètres » mène à l'écran de
    préférences (§7.2/§8.3 du CDC), lui aussi sans maquette.
#}
{% extends 'account/_layout.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Notifications'|trans }}{% endblock %}
{% block meta_description %}{{ 'Restez informé de toutes les nouveautés et activités qui vous intéressent.'|trans }}{% endblock %}

{% block account %}
    {% include 'account/_page_head.html.twig' with {
        crumbs: [{ label: 'Notifications'|trans }],
        title: 'Notifications'|trans,
        subtitle: 'Restez informé de toutes les nouveautés et activités qui vous intéressent.'|trans,
    } %}

    <div class="acc-ntabs-row">
        <nav class="acc-ntabs" aria-label="{{ 'Filtres de notifications'|trans }}">
            <a href="{{ path('app_account_notifications', { filtre: 'toutes' }) }}" class="acc-ntab{{ filter == 'toutes' ? ' is-active' }}">{{ 'Toutes'|trans }} <span class="acc-ntab__count">{{ total }}</span></a>
            <a href="{{ path('app_account_notifications', { filtre: 'non-lues' }) }}" class="acc-ntab{{ filter == 'non-lues' ? ' is-active' }}">{{ 'Non lues'|trans }} <span class="acc-ntab__count">{{ unread }}</span></a>
            <a href="{{ path('app_account_notifications', { filtre: 'lues' }) }}" class="acc-ntab{{ filter == 'lues' ? ' is-active' }}">{{ 'Lues'|trans }} <span class="acc-ntab__count">{{ total - unread }}</span></a>
        </nav>
        <div class="acc-nactions">
            <form method="post" action="{{ path('app_account_notifications_mark_all_read') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                <button type="submit" class="acc-nlink">{{ icon.check_badge(17) }} {{ 'Tout marquer comme lu'|trans }}</button>
            </form>
            <a href="{{ path('app_account_notification_preferences') }}" class="acc-nlink">{{ icon.gear(17) }} {{ 'Paramètres'|trans }}</a>
        </div>
    </div>

    {% if empty %}
        {% include 'account/_empty.html.twig' with { message: "Il semblerait que vous n'avez aucune notifications pour<br>le moments."|trans } %}
    {% else %}
        {% for group in groups %}
            <h2 class="acc-nsection">{{ group.section }}</h2>
            <div class="acc-nlist">
                {% for n in group.items %}
                    <article class="acc-notif{{ n.muted ? ' acc-notif--muted' }}">
                        <span class="acc-notif__icon acc-notif__icon--{{ n.tone }}">
                            {%- if n.icon == 'calendar_check' %}{{ icon.calendar_check(26) }}
                            {%- elseif n.icon == 'star' %}{{ icon.star(26) }}
                            {%- elseif n.icon == 'card' %}{{ icon.card(26) }}
                            {%- elseif n.icon == 'mail' %}{{ icon.mail(26) }}
                            {%- elseif n.icon == 'gear' %}{{ icon.gear(26) }}
                            {%- elseif n.icon == 'receipt' %}{{ icon.receipt(26) }}
                            {%- elseif n.icon == 'users' %}{{ icon.users(26) }}
                            {%- else %}{{ icon.heart(26) }}
                            {%- endif -%}
                        </span>
                        <div class="acc-notif__body">
                            <strong>{{ n.title }}</strong>
                            <span class="acc-notif__detail">{{ n.detail }}{% if n.meta|default(false) %} <span class="acc-notif__sep">|</span> {{ n.meta }}{% endif %}</span>
                            <span class="acc-notif__time">{{ n.time }}</span>
                        </div>
                        {% if n.thumb %}
                            <img class="acc-notif__thumb" src="{{ asset(n.thumb) }}" alt="">
                        {% endif %}
                    </article>
                {% endfor %}
            </div>
        {% endfor %}
    {% endif %}
{% endblock %}
