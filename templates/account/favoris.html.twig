{#
    Mes favoris — maquette docs/maquettes/profil_particulier/
    profil_favoris_particulier.jpeg (30/09). Données : AccountController::favorites().

    Le cœur de chaque carte retire le favori (assets/favorites.js) : la grille
    porte `data-favorite-list`, la carte disparaît avec un bandeau
    « Annuler ».

    Écart assumé : seuls les activités et les lieux (destinations) peuvent
    être mis en favori ; les onglets Événements / Hébergements / Restaurants
    de la maquette n'ont pas d'équivalent.
#}
{% extends 'account/_layout.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}
{% import 'account/_ui.html.twig' as ui %}

{% block title %}{{ 'Mes favoris'|trans }}{% endblock %}

{% macro stars(rating) %}
    {%- import '_partials/_icons.html.twig' as icon -%}
    <span class="pf-stars" aria-label="{{ rating }} / 5">{% for i in 1..5 %}<span class="{{ i <= (rating|round(0, 'floor')) ? 'is-on' }}">{{ icon.star_solid(12) }}</span>{% endfor %}</span>
{% endmacro %}

{% block account %}
    <header class="pf-head">
        <div>
            <h1 class="pf-title">{{ icon.heart(26) }} {{ 'Mes favoris'|trans }}</h1>
            <p class="pf-sub">{{ 'Retrouvez ici toutes les activités, lieux et expériences que vous avez ajoutés à vos favoris.'|trans }}</p>
        </div>
    </header>

    <nav class="pf-tabs pf-tabs--line">
        {% for key, label in {toutes: 'Toutes', activites: 'Activités', lieux: 'Lieux & destinations'} %}
            <a class="pf-tab{{ tab == key ? ' is-active' }}" href="{{ path('app_account_favorites', {onglet: key}) }}">{{ label|trans }}</a>
        {% endfor %}
    </nav>

    <div class="pf-row pf-row--4">
        {{ ui.stat('Total des favoris'|trans, counts.all, 'éléments'|trans, '+%n% ce mois-ci'|trans({'%n%': counts.month}), 'violet', 'heart') }}
        {{ ui.stat('Activités'|trans, counts.activities, 'activités'|trans, counts.all ? (counts.activities * 100 / counts.all)|round ~ '% ' ~ 'du total'|trans : '', 'green', 'calendar') }}
        {{ ui.stat('Lieux & destinations'|trans, counts.places, 'lieux'|trans, counts.all ? (counts.places * 100 / counts.all)|round ~ '% ' ~ 'du total'|trans : '', 'orange', 'pin') }}
        {{ ui.stat('Ajoutés ce mois-ci'|trans, counts.month, 'favoris'|trans, '', 'red', 'star') }}
    </div>

    <form class="pf-toolbar" method="get">
        <input type="hidden" name="onglet" value="{{ tab }}">
        <div class="pf-search">
            <input type="search" name="q" value="{{ query }}" placeholder="{{ 'Rechercher dans mes favoris...'|trans }}" aria-label="{{ 'Rechercher dans mes favoris'|trans }}">
            <button type="submit" aria-label="{{ 'Rechercher'|trans }}">{{ icon.search(18) }}</button>
        </div>
        <div class="pf-select">
            <select name="tri" onchange="this.form.submit()" aria-label="{{ 'Trier'|trans }}">
                <option value="recents"{{ sort == 'recents' ? ' selected' }}>{{ 'Trier par : Plus récents'|trans }}</option>
                <option value="note"{{ sort == 'note' ? ' selected' }}>{{ 'Trier par : Mieux notés'|trans }}</option>
                <option value="nom"{{ sort == 'nom' ? ' selected' }}>{{ 'Trier par : Nom'|trans }}</option>
            </select>
        </div>
    </form>

    {% if items is empty %}
        <div class="pf-card pf-empty">
            <strong>{{ query or types or region or tab != 'toutes' ? 'Aucun favori ne correspond.'|trans : 'Vous n’avez pas encore de favori.'|trans }}</strong>
            {{ 'Touchez le cœur d’une activité ou d’une destination pour la retrouver ici.'|trans }}
            <br><a class="pf-btn" href="{{ path('app_activities') }}">{{ 'Découvrir les activités'|trans }}</a>
        </div>
    {% else %}
        <div class="pf-favs" data-favorite-list
             data-favorite-removed="{{ 'Retiré de vos favoris.'|trans }}"
             data-favorite-undo="{{ 'Annuler'|trans }}">
            {% for f in items %}
                {% set is_activity = f.kind == 'activite' %}
                {% set href = is_activity ? path('app_activity_show', {slug: f.slug}) : path('app_destination_city', {ville: f.slug}) %}
                <article class="pf-fav">
                    <a class="pf-fav__media" href="{{ href }}">
                        <img src="{{ asset(f.image) }}" alt="" loading="lazy">
                        <span class="pf-fav__type pf-fav__type--{{ is_activity ? 'activity' : 'place' }}">{{ is_activity ? 'Activité'|trans : 'Lieu'|trans }}</span>
                    </a>
                    <button type="button" class="pf-fav__heart is-active"
                            aria-pressed="true" aria-label="{{ 'Retirer des favoris'|trans }}"
                            data-favorite-slug="{{ f.slug }}"
                            data-favorite-type="{{ f.kind }}"
                            data-favorite-url="{{ path('app_favorite_toggle') }}"
                            data-favorite-token="{{ csrf_token('submit') }}"
                            data-favorite-label-on="{{ 'Retirer des favoris'|trans }}"
                            data-favorite-label-off="{{ 'Ajouter aux favoris'|trans }}">{{ icon.heart_solid(18) }}</button>
                    <div class="pf-fav__body">
                        <a class="pf-fav__title" href="{{ href }}">{{ f.title }}</a>
                        {% if f.place %}<span class="pf-fav__place">{{ icon.map_pin(13) }} {{ f.place }}</span>{% endif %}
                        {% if f.rating %}<span class="pf-fav__rating">{{ _self.stars(f.rating) }} {{ f.rating }} ({{ f.reviews }} {{ 'avis'|trans }})</span>{% endif %}
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}

{% block account_aside %}
    <section class="pf-card">
        <form method="get" class="pf-filters">
            <input type="hidden" name="onglet" value="{{ tab }}">
            <div class="pf-card__head">
                <h2 class="pf-card__title">{{ 'Filtres'|trans }}</h2>
                <a class="pf-link" href="{{ path('app_account_favorites') }}">{{ 'Effacer tout'|trans }}</a>
            </div>
            <fieldset>
                <legend>{{ 'Type'|trans }}</legend>
                <label><input type="checkbox" name="type[]" value="activite"{{ 'activite' in types ? ' checked' }}> {{ 'Activités'|trans }}<span>{{ counts.activities }}</span></label>
                <label><input type="checkbox" name="type[]" value="destination"{{ 'destination' in types ? ' checked' }}> {{ 'Lieux & destinations'|trans }}<span>{{ counts.places }}</span></label>
            </fieldset>
            <div class="pf-field pf-select">
                <label for="fav-region">{{ 'Région'|trans }}</label>
                <select id="fav-region" name="region">
                    <option value="">{{ 'Toutes les régions'|trans }}</option>
                    {% for r in regions %}<option value="{{ r }}"{{ region == r ? ' selected' }}>{{ r }}</option>{% endfor %}
                </select>
            </div>
            <button type="submit" class="pf-btn pf-btn--primary pf-btn--block">{{ 'Appliquer les filtres'|trans }}</button>
        </form>
    </section>

    <section class="pf-card">
        <h2 class="pf-card__title">{{ 'Suggestions pour vous'|trans }}</h2>
        {% if suggestions is empty %}
            <p class="pf-card__sub">{{ 'Vous avez déjà tout mis en favori !'|trans }}</p>
        {% else %}
            <ul class="pf-list pf-suggest">
                {% for s in suggestions %}
                    <li>
                        <img src="{{ asset(s.image) }}" alt="" loading="lazy">
                        <a class="pf-list__body" href="{{ path('app_activity_show', {slug: s.slug}) }}">
                            <strong>{{ s.title }}</strong>
                            <small>{{ s.place }}</small>
                            <small>{{ icon.star_solid(11) }} {{ s.rating }} ({{ s.reviews }} {{ 'avis'|trans }})</small>
                        </a>
                        <button type="button" class="pf-suggest__heart" aria-pressed="false" aria-label="{{ 'Ajouter aux favoris'|trans }}"
                                data-favorite-slug="{{ s.slug }}" data-favorite-type="activite"
                                data-favorite-url="{{ path('app_favorite_toggle') }}"
                                data-favorite-token="{{ csrf_token('submit') }}"
                                data-favorite-label-on="{{ 'Retirer des favoris'|trans }}"
                                data-favorite-label-off="{{ 'Ajouter aux favoris'|trans }}">{{ icon.heart(18) }}</button>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        <a class="pf-btn pf-btn--block" href="{{ path('app_activities') }}">{{ 'Découvrir plus d’activités'|trans }}</a>
    </section>
{% endblock %}
