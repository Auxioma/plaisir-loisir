{#
    Tableau de bord de l'espace client (spec profil, entrée « Tableau de
    bord » de la sidebar). Câblé le 14/09, même mouvement que
    provider/tableau_de_bord.html.twig : agrège ce qui existe réellement
    (demandes de devis, activités privées, favoris) plutôt que d'ajouter un
    nouvel écran statique. Aucune maquette Figma pour cet écran.
#}
{% extends 'account/_layout.html.twig' %}

{% block title %}{{ 'Tableau de bord'|trans }}{% endblock %}

{% block account %}
    {% include 'account/_page_head.html.twig' with {
        crumbs: [{ label: 'Tableau de bord'|trans }],
        title: ('Bonjour'|trans) ~ ' ' ~ user.firstName,
        subtitle: 'Aperçu de votre activité sur TrouveMoi.'|trans,
    } %}

    <div class="row g-4 mb-4">
        <div class="col-sm-4">
            <a href="{{ path('app_account_requests') }}" class="text-decoration-none">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="fs-2 fw-bold" style="color: var(--pl-action);">{{ requests_count }}</div>
                        <div class="text-muted small">{{ 'Demandes de devis envoyées'|trans }}</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-sm-4">
            <a href="{{ path('app_account_private_activities') }}" class="text-decoration-none">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="fs-2 fw-bold" style="color: var(--pl-action);">{{ organized_count + joined_count }}</div>
                        <div class="text-muted small">{{ 'Activités privées organisées ou rejointes'|trans }}</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-sm-4">
            <a href="{{ path('app_account_favorites') }}" class="text-decoration-none">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="fs-2 fw-bold" style="color: var(--pl-action);">{{ favorites_count }}</div>
                        <div class="text-muted small">{{ 'Activités et destinations favorites'|trans }}</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    {% if recent_requests is not empty %}
        <h2 class="h5 mb-3">{{ 'Vos dernières demandes'|trans }}</h2>
        <div class="list-group mb-4">
            {% for demande in recent_requests %}
                <a href="{{ path('app_account_requests_show', {id: demande.id}) }}"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <span>{{ demande.title }}</span>
                    <span class="badge rounded-pill {{ demande.open ? 'text-bg-success' : 'text-bg-secondary' }}">
                        {{ demande.open ? 'Ouverte'|trans : 'Clôturée'|trans }}
                    </span>
                </a>
            {% endfor %}
        </div>
    {% else %}
        {% include 'account/_empty.html.twig' with { message: "Vous n'avez encore rien demandé ni rejoint : vos demandes de devis et vos activités privées apparaîtront ici."|trans } %}
    {% endif %}

    <p class="text-muted small">
        {{ 'Albums photos, activités créées et réservations arrivent avec un prochain lot du projet.'|trans }}
    </p>
{% endblock %}
