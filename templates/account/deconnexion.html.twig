{#
    Écran 5 — Déconnexion : illustration + « À bientôt, {prénom} ! 👋 »,
    3 arguments rassurants, confirmation (Oui = vraie déconnexion via
    app_logout ; Annuler = retour page précédente, géré par account.js) et
    bandeau « Besoin d'aide ? ».
    Coquille maquette corrigée : « Mom compte » → Mon compte.
#}
{% extends 'account/_layout.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}Déconnexion{% endblock %}
{% block meta_description %}Déconnectez-vous de votre compte TrouveMoi Plaisirs & Loisirs en toute sécurité.{% endblock %}

{% block account %}
    {% include 'account/_page_head.html.twig' with {
        crumbs: [{ label: 'Mon compte' }, { label: 'Déconnexion' }],
        title: 'Déconnexion',
    } %}

    <div class="acc-logout">
        <img class="acc-logout__img" src="{{ asset('images/account/logout-door.jpg') }}" alt="">

        <div class="acc-logout__side">
            <h2 class="acc-logout__hello">À bientôt, {{ user.firstName }} ! 👋</h2>
            <p class="acc-logout__text">Vous êtes sur le point de vous déconnecter de votre compte TrouveMoi Plaisirs &amp; Loisirs.</p>

            <div class="acc-logout__args">
                <div class="acc-logout__arg">
                    <span class="acc-logout__argicon">{{ icon.lock(20) }}</span>
                    <div><strong>Vos informations sont en sécurité</strong><span>Vos données personnelles restent protégées.</span></div>
                </div>
                <div class="acc-logout__arg">
                    <span class="acc-logout__argicon">{{ icon.heart(20) }}</span>
                    <div><strong>Retrouvez vos favoris</strong><span>Connectez-vous à tout moment pour retrouver vos activités favorites.</span></div>
                </div>
                <div class="acc-logout__arg">
                    <span class="acc-logout__argicon">{{ icon.bell(20) }}</span>
                    <div><strong>Ne manquez rien</strong><span>Restez informé de vos réservations et des nouvelles activités.</span></div>
                </div>
            </div>

            <p class="acc-logout__confirm">Êtes-vous sûr de vouloir vous déconnecter ?</p>
            <div class="acc-logout__actions">
                <a href="{{ path('app_logout') }}" class="acc-logout__yes">{{ icon.logout(17) }} Oui, me déconnecter</a>
                <button type="button" class="acc-logout__cancel" data-acc-back>Annuler</button>
            </div>
        </div>
    </div>

    <div class="acc-help">
        <span class="acc-help__icon">{{ icon.calendar_check(26) }}</span>
        <div class="acc-help__text">
            <strong>Besoin d'aide ?</strong>
            <span>Si vous rencontrez un problème ou avez des questions, notre équipe est là pour vous aider.</span>
        </div>
        <a href="#" class="acc-help__btn">{{ icon.mail(16) }} Nous contacter</a>
    </div>
{% endblock %}
