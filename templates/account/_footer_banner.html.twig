{#
    <FavoritesFooterBanner> : bandeau bas des grilles de favoris.
#}
{% import '_partials/_icons.html.twig' as icon %}

<div class="acc-banner">
    <span class="acc-banner__icon">{{ icon.heart(28) }}</span>
    <div class="acc-banner__text">
        <strong>{{ "Une activité n'est plus disponible ou ne vous intéresse plus ?"|trans }}</strong>
        <span>{{ 'Vous pouvez la supprimer de vos favoris à tout moment.'|trans }}</span>
    </div>
    <a href="{{ path('app_activities') }}" class="pl-btn pl-btn--outline-action">{{ 'Parcourir les activités'|trans }}</a>
</div>
