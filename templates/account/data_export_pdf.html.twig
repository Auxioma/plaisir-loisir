<!doctype html><html lang="fr"><meta charset="utf-8"><style>
@page{margin:32px 38px}body{font:11px DejaVu Sans,sans-serif;color:#243047;line-height:1.5}h1{font-size:23px;color:#392473;margin:0 0 5px}h2{font-size:15px;color:#392473;border-bottom:1px solid #ddd7ed;padding-bottom:5px;margin:20px 0 8px}.intro{color:#687083;margin-bottom:20px}.item{padding:7px 0;border-bottom:1px solid #eee}.key{font-weight:bold;color:#555}.value{white-space:pre-wrap;overflow-wrap:anywhere}.empty{color:#778094;font-style:italic}
</style><body><h1>Mes données personnelles</h1><div class="intro">Export de votre compte TrouveMoi · généré le {{ 'now'|date('d/m/Y à H:i') }}</div>
{% for section, values in data %}<h2>{{ section|replace({'_':' '})|capitalize }}</h2>{% if values is iterable and values is not empty %}{% if values is not empty and values|first is iterable %}{% for row in values %}<div class="item">{% for key, value in row %}<div><span class="key">{{ key|replace({'_':' '})|capitalize }} :</span> <span class="value">{{ value is iterable ? value|json_encode : (value is null ? '—' : value) }}</span></div>{% endfor %}</div>{% endfor %}{% else %}{% for key, value in values %}<div class="item"><span class="key">{{ key|replace({'_':' '})|capitalize }} :</span> <span class="value">{{ value is iterable ? value|join(', ') : (value is null ? '—' : value) }}</span></div>{% endfor %}{% endif %}{% else %}<p class="empty">Aucune donnée enregistrée.</p>{% endif %}{% endfor %}
</body></html>
