{#
    Sidebar de l'espace compte (maquettes profil_particulier, 30/09) :
    profil (avatar, nom, e-mail, « Membre depuis »), puis le menu par
    groupes (`item.section` ouvre un groupe titré, voir StaticAccount).
    Item actif sur fond violet sombre ; Déconnexion en rouge.
    Compteurs rouges : Messages, Notifications (et, côté pro, Demandes et
    Avis reçus).
#}
{% import '_partials/_icons.html.twig' as icon %}

<div class="pf-profile">
    <img class="pf-profile__avatar" src="{{ asset(user.avatar) }}" alt="">
    <div class="pf-profile__id">
        <strong>{{ user.name }}</strong>
        <span>{{ user.email }}</span>
        <em>{{ 'Membre depuis'|trans }} {{ user.memberSince }}</em>
    </div>
</div>

<nav class="pf-menu" aria-label="{{ 'Menu du compte'|trans }}">
    {% for item in menu %}
        {% if item.section is defined %}
            {% if item.section %}<p class="pf-menu__section">{{ item.section|trans }}</p>{% else %}<span class="pf-menu__gap"></span>{% endif %}
        {% endif %}
        {% set is_active = item.title == active %}
        {% set is_logout = item.icon == 'logout' %}
        <a href="{{ path(item.route) }}"
           class="pf-menu__item{{ is_active ? ' is-active' }}{{ is_logout ? ' is-danger' }}"
           {% if is_active %}aria-current="page"{% endif %}>
            <span class="pf-menu__icon">
                {%- if item.icon == 'grid' %}{{ icon.dashboard_frame(22) }}
                {%- elseif item.icon == 'camera' %}{{ icon.camera(22) }}
                {%- elseif item.icon == 'edit' %}{{ icon.edit_square(22) }}
                {%- elseif item.icon == 'calendar' %}{{ icon.calendar_grid(22) }}
                {%- elseif item.icon == 'person' %}{{ icon.user_round(22) }}
                {%- elseif item.icon == 'wallet' %}{{ icon.wallet(22) }}
                {%- elseif item.icon == 'bell' %}{{ icon.bell(22) }}
                {%- elseif item.icon == 'heart' %}{{ icon.heart(22) }}
                {%- elseif item.icon == 'users' %}{{ icon.users(22) }}
                {%- elseif item.icon == 'gear' %}{{ icon.gear(22) }}
                {%- elseif item.icon == 'mail' %}{{ icon.mail(22) }}
                {%- elseif item.icon == 'receipt' %}{{ icon.receipt(22) }}
                {%- elseif item.icon == 'card' %}{{ icon.card(22) }}
                {%- elseif item.icon == 'badge_check' %}{{ icon.badge_check(22) }}
                {%- elseif item.icon == 'star' %}{{ icon.star(22) }}
                {%- elseif item.icon == 'hand_heart' %}{{ icon.hand_heart(22) }}
                {%- else %}{{ icon.logout_box(22) }}
                {%- endif -%}
            </span>
            <span class="pf-menu__text">
                <strong>{{ item.title|trans }}</strong>
                <small>{{ item.subtitle|trans }}</small>
            </span>
            {% set badge_count = item.badge == 'messages' ? user.unreadMessages : (item.badge == 'notifications' ? user.unreadNotifications : (item.badge == 'requests' ? user.pendingProviderRequests : (item.badge == 'reviews' ? user.pendingProviderReviews : 0))) %}
            {% if item.badge and badge_count > 0 %}
                <span class="pf-menu__count">{{ badge_count > 99 ? '99+' : badge_count }}</span>
            {% endif %}
        </a>
    {% endfor %}
</nav>
