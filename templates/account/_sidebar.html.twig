{#
    <AccountSidebar> : en-tête profil (avatar, nom, email, badge membre) +
    menu de 9 entrées. Item actif violet (rouge pour Déconnexion) ; badge
    compteur rouge sur Notifications (même source que la cloche du header,
    spec point 8). Les entrées sans route (albums, activités créées,
    réservations, paramètres — aucune entité derrière pour l'instant)
    s'affichent en <span>, non cliquables, avec un badge « Bientôt
    disponible » plutôt qu'un lien mort silencieux (signalé le 14/09 : un
    clic sans effet ni indice se lisait comme un menu cassé).
#}
{% import '_partials/_icons.html.twig' as icon %}

<div class="acc-card">
    <div class="acc-profile">
        <img class="acc-profile__avatar" src="{{ asset(user.avatar) }}" alt="">
        <div class="acc-profile__id">
            <strong>{{ user.name }}</strong>
            <span>{{ user.email }}</span>
            <span class="acc-profile__badge">{{ 'Membre depuis'|trans }} {{ user.memberSince }}</span>
        </div>
    </div>

    <nav class="acc-menu" aria-label="{{ 'Menu du compte'|trans }}">
        {% for item in menu %}
            {% set is_active = item.title == active %}
            {% set tag = item.route ? 'a' : 'span' %}
            <{{ tag }}
               {% if item.route %}href="{{ path(item.route) }}"{% endif %}
               class="acc-menu__item{{ is_active ? (item.title == 'Déconnexion' ? ' is-active is-danger' : ' is-active') }}{{ item.route ? '' : ' is-disabled' }}"
               {% if is_active %}aria-current="page"{% endif %}
               {% if not item.route %}aria-disabled="true"{% endif %}>
                <span class="acc-menu__icon">
                    {%- if item.icon == 'grid' %}{{ icon.grid(26) }}
                    {%- elseif item.icon == 'camera' %}{{ icon.camera(26) }}
                    {%- elseif item.icon == 'badge_check' %}{{ icon.badge_check(26) }}
                    {%- elseif item.icon == 'receipt' %}{{ icon.receipt(26) }}
                    {%- elseif item.icon == 'users' %}{{ icon.users(26) }}
                    {%- elseif item.icon == 'card' %}{{ icon.card(26) }}
                    {%- elseif item.icon == 'heart' %}{{ icon.heart(26) }}
                    {%- elseif item.icon == 'bell' %}{{ icon.bell(26) }}
                    {%- elseif item.icon == 'hand_heart' %}{{ icon.hand_heart(26) }}
                    {%- elseif item.icon == 'gear' %}{{ icon.gear(26) }}
                    {%- else %}{{ icon.logout(26) }}
                    {%- endif -%}
                </span>
                <span class="acc-menu__text">
                    <strong>{{ item.title }}</strong>
                    <small>{{ item.route ? item.subtitle : ('Bientôt disponible'|trans) }}</small>
                </span>
                {% if item.badge and user.unread > 0 %}
                    <span class="acc-menu__count">{{ user.unread }}</span>
                {% endif %}
            </{{ tag }}>
        {% endfor %}
    </nav>
</div>
