{#
    Page d'accueil, d'après la maquette Figma « Acceuil - Plaisirs & Loisirs ».
    ⚠️ Front-end : le contenu (activités, destinations, catégories) est pour
    l'instant STATIQUE et d'exemple. On branchera les vraies données
    (Category / Service / Destination) à la phase de câblage.
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Accueil'|trans }}{% endblock %}

{# En-tête propre à l'accueil plateforme : « Découvrez » + langue + S'inscrire,
   sans les entrées Activités/Destinations (précision client du 27/07). #}
{% block header %}
    {% include '_partials/navbar_home.html.twig' %}
{% endblock %}

{% block body %}

    {# ===================== HERO ===================== #}
    <section class="home-hero">
        <img class="home-hero__bg" src="{{ asset('images/home/hero.png') }}" alt="">
        <div class="home-hero__overlay"></div>
        <div class="container home-hero__inner">
            <h1 class="home-hero__title">
                {{ 'Explore tes envies et Crée des'|trans }} <span class="is-accent">{{ 'souvenirs'|trans }}&nbsp;!</span>
            </h1>
            <p class="home-hero__subtitle">
                {{ 'Découvrez des lieux, des événements exceptionnels, à des prix exclusifs et vivez des expériences inoubliables'|trans }}
            </p>
            {# Destinations reprises de l'accueil CONNECTÉ, qui porte les mêmes
               libellés déjà câblés (home/connected.html.twig, lignes 28-29) :
               « Découvrez nos événements » y mène à app_events. Aucune cible
               n'est inventée ici, la convention existait déjà. #}
            <div class="home-hero__actions">
                <a href="{{ path('app_activities') }}" class="pl-btn pl-btn--cta">{{ 'Explorez nos activités'|trans }} {{ icon.chevron_right(18) }}</a>
                <a href="{{ path('app_events') }}" class="pl-btn pl-btn--hero-ghost">{{ 'Découvrez nos événements'|trans }} {{ icon.chevron_right(18) }}</a>
            </div>
            {# Preuve sociale : 4 avatars empilés + compteur d'utilisateurs. #}
            <div class="home-hero__proof">
                <div class="home-hero__avatars" aria-hidden="true">
                    <img class="home-avatar" src="{{ asset('images/home/avatar-1.png') }}" alt="">
                    <img class="home-avatar" src="{{ asset('images/home/avatar-2.png') }}" alt="">
                    <img class="home-avatar" src="{{ asset('images/home/avatar-3.png') }}" alt="">
                    <img class="home-avatar" src="{{ asset('images/home/avatar-4.png') }}" alt="">
                </div>
                <span class="home-hero__proof-text"><strong>+250.000</strong> {{ 'utilisateurs satisfaits.'|trans }}</span>
            </div>
        </div>
    </section>

    {# ===================== BARRE DE RECHERCHE ===================== #}
    {# .container--search : la carte est hors grille (x=68 sur 1304) et chevauche
       la photo du héros de 73px. Les onglets sont DANS la carte, qui est en
       verre : c'est elle qui produit le bandeau translucide de la maquette. #}
    <div class="container container--search">
        <div class="home-search-wrap">
            <div class="home-search">
                {# Maquette : deux onglets courts, « Événements » actif (blanc,
                   violet). Les libellés longs « Consulter Vos Plaisirs… »
                   venaient d'un commentaire de Loïc du 27/07 : ils ne sont pas
                   dans la maquette et sont donc retirés (note-revue-11-08 §4). #}
                {# Des LIENS et non des boutons : ces deux onglets n'ouvrent
                   aucun panneau, ils annoncent deux univers du site. En
                   <button type="button"> ils ne faisaient rien du tout. #}
                <div class="home-search__tabs">
                    <a href="{{ path('app_activities') }}" class="home-search__tab">{{ icon.ferris_wheel(20) }} {{ 'Activités'|trans }}</a>
                    <a href="{{ path('app_events') }}" class="home-search__tab is-active">{{ icon.cat_culture(20) }} {{ 'Événements'|trans }}</a>
                </div>
                {# LES QUATRE CHAMPS SONT DES BOUTONS, PAS DES <div>.
                   Ils étaient inertes : le fichier assets/home_search.js, chargé
                   sur toutes les pages, ouvre pourtant leurs panneaux depuis le
                   23/07 — il attend les attributs data-search-field et
                   data-search-panel. L'accueil connecté les portait, celui-ci
                   non. Même oubli que pour les liens, corrigé le 29/08. #}
                <div class="home-search__fields">
                    <button type="button" class="home-search__field" data-search-field="destination">
                        {{ icon.map_pin(20) }}
                        <span>
                            <span class="home-search__field-label">{{ 'Où voulez-vous aller ?'|trans }}</span>
                            <span class="home-search__field-value" data-field-value>{{ 'Destination, ville, lieu…'|trans }} {{ icon.chevron_down(16) }}</span>
                        </span>
                    </button>
                    <button type="button" class="home-search__field" data-search-field="activite">
                        {{ icon.ferris_wheel(20) }}
                        <span>
                            <span class="home-search__field-label">{{ 'Activité ou loisir ?'|trans }}</span>
                            <span class="home-search__field-value" data-field-value>{{ 'Canoë, musée, VTT…'|trans }} {{ icon.chevron_down(16) }}</span>
                        </span>
                    </button>
                    <button type="button" class="home-search__field" data-search-field="date">
                        {{ icon.calendar_days(20) }}
                        <span>
                            <span class="home-search__field-label">{{ 'Date'|trans }}</span>
                            <span class="home-search__field-value" data-field-value>{{ 'Choisissez une date'|trans }} {{ icon.chevron_down(16) }}</span>
                        </span>
                    </button>
                    <button type="button" class="home-search__field" data-search-field="participants">
                        {{ icon.person(20) }}
                        <span>
                            <span class="home-search__field-label">{{ 'Participant(s)'|trans }}</span>
                            <span class="home-search__field-value" data-field-value>{{ '1 participant'|trans }} {{ icon.chevron_down(16) }}</span>
                        </span>
                    </button>
                    {# Maquette : bouton VIOLET, loupe après le libellé (l'accueil
                       connecté, lui, le porte en orange — ne pas uniformiser).
                       Reste un <a> : sans JavaScript il mène au catalogue complet
                       plutôt que nulle part. data-search-submit lui fait porter
                       les critères choisis. #}
                    <a href="{{ path('app_activities') }}" class="pl-btn pl-btn--primary home-search__submit" data-search-submit>{{ 'Recherche'|trans }} {{ icon.search(20) }}</a>
                </div>

                {# Panneau 1 : les lieux QUI ONT des activités, pris en base.
                   Les libellés de la maquette (« Île-de-France », « Toulouse »)
                   ne correspondaient au lieu d'aucune activité : la recherche
                   renvoyait zéro résultat et paraissait cassée. #}
                <div class="home-search__panel" data-search-panel="destination" hidden>
                    {% for lieu in searchPlaces %}
                        <button type="button" class="home-search__option" data-option>{{ lieu }}</button>
                    {% else %}
                        <p class="home-search__option">{{ 'Aucun lieu au catalogue pour le moment.'|trans }}</p>
                    {% endfor %}
                </div>

                {# Panneau 2 : les activités publiées, pour la même raison. #}
                <div class="home-search__panel" data-search-panel="activite" hidden>
                    {% for titre in searchActivities %}
                        <button type="button" class="home-search__option" data-option>{{ titre }}</button>
                    {% else %}
                        <p class="home-search__option">{{ 'Aucune activité publiée pour le moment.'|trans }}</p>
                    {% endfor %}
                </div>

                {# Panneau 3 : calendrier. Le jour choisi part en critère « date »
                   et s'appuie sur les créneaux déclarés (entité Availability).
                   Une activité qui n'a déclaré AUCUN créneau reste proposée :
                   on ne sait pas si elle est ouverte, ce n'est pas la même
                   chose que fermée. #}
                <div class="home-search__panel home-search__panel--calendar" data-search-panel="date" hidden>
                    <div class="home-cal" data-calendar data-year="2026" data-month="7" data-selected="16">
                        <div class="home-cal__head">
                            <button type="button" data-cal-prev aria-label="{{ 'Mois précédent'|trans }}">{{ icon.chevron_left(18) }}</button>
                            <strong data-cal-title>{{ 'Juillet'|trans }} 2026</strong>
                            <button type="button" data-cal-next aria-label="{{ 'Mois suivant'|trans }}">{{ icon.chevron_right(18) }}</button>
                        </div>
                        <div class="home-cal__days" aria-hidden="true">
                            <span>{{ 'lun'|trans }}</span><span>{{ 'mar'|trans }}</span><span>{{ 'mer'|trans }}</span><span>{{ 'jeu'|trans }}</span><span>{{ 'ven'|trans }}</span><span>{{ 'sam'|trans }}</span><span>{{ 'dim'|trans }}</span>
                        </div>
                        <div class="home-cal__grid" data-cal-grid></div>
                    </div>
                </div>

                {# Panneau 4 : participants. Le total part en critère et se
                   compare au « Nombre de places » de l'activité, celui que le
                   back-office expose. Une capacité non renseignée n'exclut
                   pas. #}
                <div class="home-search__panel home-search__panel--travellers" data-search-panel="participants" hidden>
                    <div class="act-stepper" data-stepper data-min="1" data-count="1">
                        <span>{{ 'Adulte'|trans }} <small>{{ '(18 et +)'|trans }}</small></span>
                        <span class="act-stepper__controls">
                            <button type="button" data-step="-1" aria-label="{{ "Moins d'adultes"|trans }}">{{ icon.minus(14) }}</button>
                            <output data-stepper-value>1</output>
                            <button type="button" data-step="1" aria-label="{{ "Plus d'adultes"|trans }}">{{ icon.plus(14) }}</button>
                        </span>
                    </div>
                    <div class="act-stepper" data-stepper data-min="0" data-count="0">
                        <span>{{ 'Enfants'|trans }} <small>{{ '(0 à 17 ans)'|trans }}</small></span>
                        <span class="act-stepper__controls">
                            <button type="button" data-step="-1" aria-label="{{ "Moins d'enfants"|trans }}">{{ icon.minus(14) }}</button>
                            <output data-stepper-value>0</output>
                            <button type="button" data-step="1" aria-label="{{ "Plus d'enfants"|trans }}">{{ icon.plus(14) }}</button>
                        </span>
                    </div>
                    <button type="button" class="pl-btn pl-btn--outline-action pl-btn--block" data-travellers-validate>{{ 'Valider'|trans }}</button>
                </div>
            </div>
        </div>
    </div>

    {# ===================== ACTIVITÉS COUP DE CŒUR ===================== #}
    {% set activities = [
        {img: 'act-canoe.jpg', slug: 'descente-en-canoe',      title: 'Descente en Canoë',      place: 'Gorges de l\'Ardèche',         reviews: 256, extra: '2h-3h',   price: 25, tag: 'Bestseller'},
        {img: 'act-vtt.jpg', slug: 'location-vtt-electrique',        title: 'Location VTT électrique', place: 'Massif du Vercors',            reviews: 178, extra: 'Journée', price: 45, tag: null},
        {img: 'act-labyrinthe.jpg', slug: 'visite-guidee-de-labyrinthe', title: 'Visite de labyrinthe',    place: 'Labyrinthe en Provence',       reviews: 124, extra: '1h30',    price: 12, tag: null},
        {img: 'act-musee.jpg', slug: 'visite-du-musee',      title: 'Visite du Musée',         place: 'Muséum d\'Histoire Naturelle', reviews: 312, extra: '2h',      price: 16, tag: null},
    ] %}
    <div class="container">
        <section class="home-section">
            <div class="home-section__head">
                <div>
                    <h2 class="home-section__title">{{ 'Activités coup de coeur'|trans }}</h2>
                    <p class="home-section__subtitle">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus tincidunt sem eget magna gravida consequat. Nunc dictum facilisis dolor ac luctus.</p>
                </div>
                <a href="{{ path('app_activities') }}" class="btn-see-all">{{ 'Voir toutes les activités'|trans }} {{ icon.arrow_up_right(16) }}</a>
            </div>
            <div class="card-grid">
                {# Le champ `slug` relie chaque carte a SA fiche : les quatre
                   activites existent en base sous ces noms, elles avaient ete
                   recopiees ici a la main sans leur identifiant. Un test verifie
                   que les adresses repondent, pour qu'un renommage en base ne
                   les casse pas en silence. #}
                {% for a in activities %}
                    <a href="{{ path('app_activity_show', {slug: a.slug}) }}" class="pl-card">
                        <div class="pl-card__media">
                            <img src="{{ asset('images/home/' ~ a.img) }}" alt="{{ a.title }}">
                            {% if a.tag %}<span class="pl-card__tag pl-card__tag--bestseller">{{ a.tag }}</span>{% endif %}
                            <button type="button" class="pl-card__fav" aria-label="{{ 'Ajouter aux favoris'|trans }}">{{ icon.heart(18) }}</button>
                        </div>
                        <div class="pl-card__body">
                            <div class="pl-card__title">{{ a.title }}</div>
                            <div class="pl-card__place">{{ icon.map_pin(14) }} {{ a.place }}</div>
                            <div class="pl-card__meta">
                                <span class="pl-card__rating">{{ icon.star(14) }} {{ a.reviews }} <span>{{ 'reviews'|trans }}</span></span>
                                <span class="pl-card__extra">{{ icon.clock(14) }} {{ a.extra }}</span>
                            </div>
                            <div class="pl-card__foot">
                                <span class="pl-card__from">{{ 'À partir de'|trans }}</span>
                                <span class="pl-card__price">{{ a.price }}€</span>
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>
        </section>
    </div>

    {# ===================== DESTINATIONS POPULAIRES ===================== #}
    {% set destinations = [
        {img: 'dest-paris.png', slug: 'paris-france',        title: 'Paris, France',   desc: 'Ville lumière et capitale de la culture', reviews: 256, count: '32 activités', price: 25, tag: 'Populaire'},
        {img: 'dest-annecy.png', slug: 'annecy-france',       title: 'Annecy, France',  desc: 'Entre lac et Montagnes',                  reviews: 178, count: '24 activités', price: 20, tag: 'Bestseller'},
        {img: 'dest-cinqueterre.jpg', slug: 'cinque-italie',  title: 'Cinque, Italie',  desc: 'Vue à couper le souffle',                 reviews: 134, count: '18 activités', price: 30, tag: 'Tendance'},
        {img: 'dest-bali.png', slug: 'bali-indonesie',         title: 'Bali, Indonésie', desc: 'Détente, nature et spiritualité',         reviews: 312, count: '27 activités', price: 35, tag: null},
    ] %}
    <div class="container">
        <section class="home-section">
            <div class="home-section__head">
                <div>
                    <h2 class="home-section__title">{{ 'Destinations populaires'|trans }}</h2>
                    <p class="home-section__subtitle">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus tincidunt sem eget magna gravida consequat. Nunc dictum facilisis dolor ac luctus.</p>
                </div>
                <a href="{{ path('app_destinations') }}" class="btn-see-all">{{ 'Voir toutes les destinations'|trans }} {{ icon.arrow_up_right(16) }}</a>
            </div>
            <div class="card-grid">
                {% for d in destinations %}
                    <a href="{{ path('app_destination_city', {ville: d.slug}) }}" class="pl-card">
                        <div class="pl-card__media">
                            <img src="{{ asset('images/home/' ~ d.img) }}" alt="{{ d.title }}">
                            {% if d.tag %}<span class="pl-card__tag {{ d.tag == 'Bestseller' ? 'pl-card__tag--bestseller' : 'pl-card__tag--popular' }}">{{ d.tag }}</span>{% endif %}
                            <button type="button" class="pl-card__fav" aria-label="{{ 'Ajouter aux favoris'|trans }}">{{ icon.heart(18) }}</button>
                        </div>
                        <div class="pl-card__body">
                            <div class="pl-card__title">{{ d.title }}</div>
                            <div class="pl-card__place">{{ d.desc }}</div>
                            <div class="pl-card__meta">
                                <span class="pl-card__rating">{{ icon.star(14) }} {{ d.reviews }} <span>{{ 'reviews'|trans }}</span></span>
                                <span class="pl-card__extra">{{ d.count }}</span>
                            </div>
                            <div class="pl-card__foot">
                                <span class="pl-card__from">{{ 'À partir de'|trans }}</span>
                                <span class="pl-card__price">{{ d.price }}€</span>
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>
        </section>
    </div>

    {# ===================== POURQUOI NOUS CHOISIR ===================== #}
    <section class="home-provider">
        <div class="container home-section">
            <div class="home-provider__inner">
                <div>
                    <h2 class="home-provider__title">{{ 'Pourquoi nous choisir !'|trans }}</h2>
                    <p class="home-provider__text">
                        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus tincidunt sem eget
                        magna gravida consequat. Nunc dictum facilisis dolor ac luctus.
                    </p>
                    <div class="home-provider__list">
                        <div class="home-provider__arg">{{ icon.check_badge(22) }} {{ 'Réservez en quelques clics'|trans }}</div>
                        <div class="home-provider__arg">{{ icon.check_badge(22) }} {{ 'Meilleurs prix garantis'|trans }}</div>
                        <div class="home-provider__arg">{{ icon.check_badge(22) }} {{ 'Transactions 100% sécurisées'|trans }}</div>
                        <div class="home-provider__arg">{{ icon.check_badge(22) }} {{ "Des milliers d'avis authentiques"|trans }}</div>
                        <div class="home-provider__arg">{{ icon.check_badge(22) }} {{ 'Notre équipe est à votre écoute 7j/7'|trans }}</div>
                    </div>
                    {# La section s'intitule « Pourquoi nous choisir ! » et
                       s'adresse au visiteur : « en savoir plus » mene donc a la
                       page qui presente la societe. A redire si vous visiez
                       plutot l'espace prestataire. #}
                    <a href="{{ path('app_corporate_about') }}" class="pl-btn pl-btn--cta">{{ 'En savoir plus !'|trans }} {{ icon.arrow_up_right(16) }}</a>
                </div>
                <div class="home-provider__media">
                    <div class="home-provider__circles"></div>
                    <img src="{{ asset('images/home/provider.png') }}" alt="Rejoignez TrouveMoi">
                </div>
            </div>
        </div>
    </section>

    {# ===================== ÉVÉNEMENTS POPULAIRES ===================== #}
    {% set events = [
        {img: 'event-1.jpg', cat: 'Randonnée', title: 'Randonnée dans le Vercors',  place: 'Autrans, 38880',  time: '9h00 - 16h00',  participants: 12, date: '15 Mai 2026'},
        {img: 'event-2.jpg', cat: 'Sports',    title: 'Match de foot amical',        place: 'Toulouse, 31000', time: '10h00 - 12h00', participants: 8,  date: '15 Mai 2026'},
        {img: 'event-3.jpg', cat: 'Repas',     title: 'Barbecue entre amis',         place: 'Lyon, 69000',     time: '12h00 - 18h00', participants: 12, date: '18 Mai 2026'},
        {img: 'event-4.jpg', cat: 'Bien-être', title: 'Séance de yoga en plein air', place: 'Nantes, 44000',   time: '10h00 - 11h30', participants: 12, date: '02 Juin 2026'},
    ] %}
    <div class="container">
        <section class="home-section">
            <div class="home-section__head">
                <div>
                    <h2 class="home-section__title">{{ 'Évènements gratuits populaires à partager'|trans }}</h2>
                    <p class="home-section__subtitle">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus tincidunt sem eget magna gravida consequat. Nunc dictum facilisis dolor ac luctus.</p>
                </div>
                <a href="{{ path('app_events_all') }}" class="btn-see-all">{{ 'Voir tous les événements'|trans }} {{ icon.arrow_up_right(16) }}</a>
            </div>
            <div class="card-grid">
                {% for e in events %}
                    <a href="{{ path('app_events_detail') }}" class="pl-card pl-card--event">
                        <div class="pl-card__media">
                            <img src="{{ asset('images/home/' ~ e.img) }}" alt="{{ e.title }}">
                            <span class="pl-card__tag pl-card__tag--cat">{{ e.cat }}</span>
                            <button type="button" class="pl-card__fav" aria-label="{{ 'Ajouter aux favoris'|trans }}">{{ icon.heart(18) }}</button>
                            <span class="pl-card__date">{{ e.date }}</span>
                        </div>
                        <div class="pl-card__body">
                            <div class="pl-card__title">{{ e.title }}</div>
                            <div class="pl-card__place">{{ icon.map_pin(14) }} {{ e.place }}</div>
                            <div class="pl-card__meta">
                                <span class="pl-card__extra">{{ icon.clock(14) }} {{ e.time }}</span>
                            </div>
                            <div class="pl-card__event-foot">
                                <span class="pl-card__participants">{{ icon.users(16) }} {{ e.participants }} {{ 'Participants'|trans }}</span>
                                <span class="home-mini-avatars" aria-hidden="true"><img src="{{ asset('images/home/avatar-1.png') }}" alt=""><img src="{{ asset('images/home/avatar-2.png') }}" alt=""><img src="{{ asset('images/home/avatar-3.png') }}" alt=""></span>
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>
        </section>
    </div>

    {# ===================== CE QUE DISENT NOS CLIENTS ===================== #}
    {% set reviews = [
        {rating: 5, title: 'Efficient and Reliable', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus tincidunt sem eget magna gravida consequat.', author: 'John Mans',   place: 'France, Nantes', date: '10 Juillet 2026', avatar: 'avatar-1.png'},
        {rating: 4, title: 'Une expérience au top',  text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc dictum facilisis dolor ac luctus, sit amet.', author: 'Marie Leroy', place: 'France, Lyon',   date: '08 Juillet 2026', avatar: 'avatar-3.png'},
    ] %}
    <section class="home-reviews">
        <div class="container home-section">
            <div class="home-reviews__head">
                <h2 class="home-section__title">{{ 'Ce que disent nos clients'|trans }}</h2>
                <div class="home-reviews__score">
                    <div class="home-reviews__score-box">
                        <div class="home-reviews__score-label">{{ 'Note globale'|trans }}</div>
                        <div class="home-reviews__score-value">4.5<span>/5</span></div>
                        <div class="home-reviews__stars">{{ icon.star(18) }}{{ icon.star(18) }}{{ icon.star(18) }}{{ icon.star(18) }}{{ icon.star(18) }}</div>
                        <div class="home-reviews__score-count">{{ 'Basé sur %count% avis'|trans({'%count%': '8955'}) }}</div>
                    </div>
                    <a href="#" class="btn-see-all">{{ "Voir plus d'avis"|trans }} {{ icon.arrow_up_right(16) }}</a>
                </div>
            </div>
            <div class="home-reviews__grid">
                {% for r in reviews %}
                    <article class="review-card">
                        <div class="review-card__top">
                            <div class="review-card__stars">
                                {% for i in 1..5 %}<span class="{{ i <= r.rating ? 'is-on' : 'is-off' }}">{{ icon.star(16) }}</span>{% endfor %}
                            </div>
                            <button type="button" class="review-card__more" aria-label="{{ 'Options'|trans }}">{{ icon.dots(20) }}</button>
                        </div>
                        <h3 class="review-card__title">{{ r.title }}</h3>
                        <p class="review-card__text">{{ r.text }}</p>
                        <div class="review-card__author">
                            <img class="review-card__avatar" src="{{ asset('images/home/' ~ r.avatar) }}" alt="">
                            <div>
                                <div class="review-card__name">{{ r.author }}</div>
                                <div class="review-card__meta">{{ r.place }} · {{ r.date }}</div>
                            </div>
                        </div>
                        <div class="review-card__foot">
                            <span>{{ 'Est-ce que ça vous a aidé ?'|trans }} {{ icon.thumbs_up(16) }}</span>
                            <a href="#">{{ 'Traduire'|trans }}</a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

{% endblock %}
