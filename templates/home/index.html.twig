{#
    Page d'accueil — maquette docs/maquettes/landing_page.jpeg (05/10).
    Une seule page pour visiteurs et membres connectés (voir HomeController).
    Toutes les données viennent de la base : activités des prestataires
    (Service), activités gratuites entre membres (PrivateActivity),
    destinations. Styles : assets/styles/landing.css (.ld-*).
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Explorez vos envies, partagez vos passions'|trans }}{% endblock %}
{% block meta_description %}{{ 'Découvrez des activités avec nos prestataires ou créez et rejoignez gratuitement des activités entre particuliers près de chez vous.'|trans }}{% endblock %}

{% block header %}
    {% include '_partials/navbar_landing.html.twig' %}
{% endblock %}

{% block body %}
<div class="ld">
    {# ===================== HÉROS + 3 ENTRÉES ===================== #}
    <section class="ld-hero">
        <img class="ld-hero__bg" src="{{ asset('images/home/hero.png') }}" alt="">
        <div class="ld-hero__shade" aria-hidden="true"></div>
        <div class="ld-wrap ld-hero__inner">
            <h1 class="ld-hero__title">{{ 'Explorez vos envies,'|trans }}<br><span>{{ 'partagez vos passions.'|trans }}</span></h1>
            <p class="ld-hero__lead">{{ 'Découvrez des activités avec nos prestataires ou créez et rejoignez gratuitement des activités entre particuliers près de chez vous.'|trans }}</p>

            <div class="ld-entries">
                <article class="ld-entry">
                    <div class="ld-entry__head">
                        <span class="ld-entry__ico is-blue">{{ icon.store(30) }}</span>
                        <span><strong>{{ 'Trouver une activité'|trans }}</strong><small>{{ 'Découvrez des activités proposées par nos prestataires'|trans }}</small></span>
                    </div>
                    <a class="ld-btn ld-btn--blue" href="{{ path('app_activities') }}">{{ 'Découvrir les activités'|trans }} {{ icon.chevron_right(14) }}</a>
                </article>
                <article class="ld-entry">
                    <div class="ld-entry__head">
                        <span class="ld-entry__ico is-green">{{ icon.users_solid(30) }}</span>
                        <span><strong>{{ 'Activités gratuites'|trans }}</strong><small>{{ 'Créez, rejoignez et partagez des activités près de chez vous'|trans }}</small></span>
                    </div>
                    <a class="ld-btn ld-btn--green-outline" href="{{ path('app_private_activities') }}">{{ 'Voir les activités gratuites'|trans }} {{ icon.chevron_right(14) }}</a>
                </article>
                <article class="ld-entry">
                    <div class="ld-entry__head">
                        <span class="ld-entry__ico is-violet">{{ icon.image_frame(30) }}</span>
                        <span><strong>{{ 'Voir les photos'|trans }}</strong><small>{{ 'Découvrez les photos de la communauté'|trans }}</small></span>
                    </div>
                    <div class="ld-entry__pair">
                        <a class="ld-btn ld-btn--soft" href="{{ path('app_photo_albums') }}">{{ icon.camera(14) }} {{ 'Photos publiques'|trans }}</a>
                        {# Les albums privés sont ceux des activités auxquelles on a participé : connexion requise. #}
                        <a class="ld-btn ld-btn--violet" href="{{ path('app_account_albums') }}">{{ icon.padlock(14) }} {{ 'Photos privées'|trans }}</a>
                    </div>
                </article>
            </div>
        </div>
    </section>

    {# ===================== RECHERCHE ===================== #}
    {# Sans JavaScript, tout part vers /activites, qui renvoie les recherches
       « Activités gratuites » vers /activites-privees (ActivityController). #}
    <form class="ld-wrap ld-search" id="recherche" action="{{ path('app_activities') }}" method="get" role="search" data-ld-search
          data-url-pro="{{ path('app_activities') }}" data-url-free="{{ path('app_private_activities') }}">
        <fieldset class="ld-search__modes">
            <legend class="visually-hidden">{{ 'Type d’activités'|trans }}</legend>
            {% for value, label in {toutes: 'Toutes', prestataires: 'Activités avec prestataires', gratuites: 'Activités gratuites'} %}
                <label class="ld-radio"><input type="radio" name="type" value="{{ value }}"{{ loop.first ? ' checked' }}> {{ label|trans }}</label>
            {% endfor %}
        </fieldset>
        <div class="ld-search__fields">
            <label class="ld-field">
                {{ icon.map_pin(22) }}
                <span><strong>{{ 'Où souhaitez-vous aller ?'|trans }}</strong><input name="lieu" list="ld-places" placeholder="{{ 'Destination, ville…'|trans }}" autocomplete="off"></span>
            </label>
            <label class="ld-field">
                {{ icon.cat_hiking(22) }}
                <span><strong>{{ 'Quelle activité ?'|trans }}</strong><input name="q" list="ld-titles" placeholder="{{ 'Ex : Randonnée, Parc, Musée…'|trans }}" autocomplete="off"></span>
            </label>
            <label class="ld-field">
                {{ icon.calendar_grid(22) }}
                <span><strong>{{ 'Quand ?'|trans }}</strong><input type="date" name="date" min="{{ 'today'|date('Y-m-d') }}" aria-label="{{ 'Date'|trans }}"></span>
            </label>
            <label class="ld-field" data-ld-participants>
                {{ icon.users(22) }}
                <span><strong>{{ 'Participants'|trans }}</strong>
                    <select name="participants">{% for n in 1..10 %}<option value="{{ n }}"{{ n == 2 ? ' selected' }}>{{ n }} {{ n > 1 ? 'personnes'|trans : 'personne'|trans }}</option>{% endfor %}</select>
                </span>
            </label>
            <button class="ld-search__submit">{{ 'Rechercher'|trans }}</button>
        </div>
        <datalist id="ld-places">{% for p in search_places %}<option value="{{ p }}">{% endfor %}</datalist>
        <datalist id="ld-titles">{% for t in search_titles %}<option value="{{ t }}">{% endfor %}</datalist>
    </form>

    {# ===================== ACTIVITÉS COUP DE CŒUR ===================== #}
    <section class="ld-section" data-pg-carousel>
        <div class="ld-wrap">
            <header class="ld-section__head">
                <span class="ld-section__ico is-red">{{ icon.heart_solid(34) }}</span>
                <div><h2>{{ 'Activités coup de cœur'|trans }}</h2><p>{{ 'Nos meilleures offres du moment avec nos prestataires'|trans }}</p></div>
                <a class="ld-more" href="{{ path('app_activities') }}">{{ 'Voir toutes les activités'|trans }} {{ icon.arrow_right(16) }}</a>
            </header>
            {% if featured is empty %}
                <p class="ld-empty">{{ 'Les premières activités arrivent bientôt.'|trans }}</p>
            {% else %}
                <div class="ld-carousel">
                    <button type="button" class="ld-arrow is-prev" data-pg-dir="-1" aria-label="{{ 'Précédent'|trans }}">{{ icon.chevron_left(18) }}</button>
                    <div class="ld-track" data-pg-track>
                        {% for a in featured %}
                            <article class="ld-card">
                                <a class="ld-card__media" href="{{ path('app_activity_show', {slug: a.slug}) }}">
                                    <img src="{{ asset(a.image) }}" alt="{{ a.title }}" loading="lazy">
                                    {% if a.price is not null %}<span class="ld-card__price">{{ a.price|number_format(a.price == a.price|round ? 0 : 2, ',', ' ') }} €</span>{% endif %}
                                </a>
                                {% include '_partials/_event_fav.html.twig' with { type: 'activite', key: a.slug, class: 'ld-card__fav' } %}
                                <div class="ld-card__body">
                                    <a class="ld-card__title" href="{{ path('app_activity_show', {slug: a.slug}) }}">{{ a.title }}</a>
                                    <small>{{ icon.map_pin(13) }} {{ a.place }}</small>
                                    {% if a.rating %}<small class="ld-card__rating">{{ icon.star_solid(13) }} <b>{{ a.rating }}</b> ({{ a.reviews }})</small>{% endif %}
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                    <button type="button" class="ld-arrow is-next" data-pg-dir="1" aria-label="{{ 'Suivant'|trans }}">{{ icon.chevron_right(18) }}</button>
                </div>
            {% endif %}
        </div>
    </section>

    {# ===================== ACTIVITÉS GRATUITES ===================== #}
    <section class="ld-section ld-section--green" data-pg-carousel>
        <div class="ld-wrap">
            <header class="ld-section__head">
                <span class="ld-section__ico is-green">{{ icon.users_solid(34) }}</span>
                <div><h2>{{ 'Activités gratuites populaires à partager'|trans }}</h2><p>{{ 'Rejoignez des activités entre particuliers ou créez la vôtre gratuitement !'|trans }}</p></div>
                <a class="ld-more" href="{{ path('app_private_activities') }}">{{ 'Voir toutes les activités gratuites'|trans }} {{ icon.arrow_right(16) }}</a>
            </header>
            {% if free is empty %}
                <div class="ld-empty">
                    <p>{{ 'Aucune activité gratuite à venir pour le moment.'|trans }}</p>
                    <a class="ld-btn ld-btn--green-outline" href="{{ path('app_account_private_activities_new', {vierge: 1}) }}">{{ 'Proposer la première'|trans }}</a>
                </div>
            {% else %}
                <div class="ld-carousel">
                    <button type="button" class="ld-arrow is-prev" data-pg-dir="-1" aria-label="{{ 'Précédent'|trans }}">{{ icon.chevron_left(18) }}</button>
                    <div class="ld-track" data-pg-track>
                        {% for row in free %}
                            {% set activity = row.activity %}
                            <article class="ld-card">
                                <a class="ld-card__media" href="{{ path('app_private_activity_show', {id: activity.id}) }}">
                                    <img src="{% include 'private_activity/_cover.html.twig' %}" alt="{{ activity.title }}" loading="lazy">
                                    <span class="ld-card__free">{{ 'Gratuit'|trans }}</span>
                                </a>
                                {% if not app.user or activity.organizer != app.user %}
                                    {% include '_partials/_event_fav.html.twig' with { type: 'activite-privee', key: activity.id ~ '', class: 'ld-card__fav' } %}
                                {% endif %}
                                <div class="ld-card__body">
                                    <a class="ld-card__title" href="{{ path('app_private_activity_show', {id: activity.id}) }}">{{ activity.title }}</a>
                                    {% if activity.city %}<small>{{ icon.map_pin(13) }} {{ activity.city }}{{ activity.postalCode ? ' (' ~ activity.postalCode|slice(0, 2) ~ ')' }}</small>{% endif %}
                                    <small>{{ icon.users(13) }} {% if activity.scheduledAt %}{{ activity.scheduledAt|pf_date('EEE d MMM')|capitalize }} • {% endif %}{{ row.going }} {{ row.going > 1 ? 'participants'|trans : 'participant'|trans }}</small>
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                    <button type="button" class="ld-arrow is-next" data-pg-dir="1" aria-label="{{ 'Suivant'|trans }}">{{ icon.chevron_right(18) }}</button>
                </div>
            {% endif %}
        </div>
    </section>

    {# ===================== DESTINATIONS ===================== #}
    <section class="ld-section" data-pg-carousel>
        <div class="ld-wrap">
            <header class="ld-section__head">
                <span class="ld-section__ico is-blue">{{ icon.map_pin_solid(34) }}</span>
                <div><h2>{{ 'Destinations populaires'|trans }}</h2><p>{{ 'Découvrez les meilleures activités par ville et région'|trans }}</p></div>
                <a class="ld-more" href="{{ path('app_destinations') }}">{{ 'Voir toutes les destinations'|trans }} {{ icon.arrow_right(16) }}</a>
            </header>
            <div class="ld-carousel">
                <button type="button" class="ld-arrow is-prev" data-pg-dir="-1" aria-label="{{ 'Précédent'|trans }}">{{ icon.chevron_left(18) }}</button>
                <div class="ld-track ld-track--dest" data-pg-track>
                    {% for d in destinations %}
                        <a class="ld-dest" href="{{ path('app_destination_city', {ville: d.slug}) }}">
                            <img src="{{ asset(d.image) }}" alt="" loading="lazy">
                            <span><strong>{{ d.name|split(',')|first }}</strong><small>{{ d.count }} {{ d.count > 1 ? 'activités'|trans : 'activité'|trans }}</small></span>
                        </a>
                    {% endfor %}
                </div>
                <button type="button" class="ld-arrow is-next" data-pg-dir="1" aria-label="{{ 'Suivant'|trans }}">{{ icon.chevron_right(18) }}</button>
            </div>
        </div>
    </section>

    {# ===================== POURQUOI NOUS CHOISIR ===================== #}
    <section class="ld-section ld-why">
        <div class="ld-wrap">
            <h2 class="ld-why__title"><span class="ld-why__badge">{{ icon.user_round(18) }}</span> {{ 'Pourquoi nous choisir ?'|trans }}</h2>
            <ul class="ld-why__list">
                <li><span class="ld-why__ico is-orange">{{ icon.store(28) }}</span><span><strong>{{ 'Large choix d’activités'|trans }}</strong><small>{{ 'Des centaines d’activités avec nos prestataires et entre particuliers'|trans }}</small></span></li>
                <li><span class="ld-why__ico is-green-plain">{{ icon.users_solid(34) }}</span><span><strong>{{ 'Activités gratuites'|trans }}</strong><small>{{ 'Créez et rejoignez gratuitement des activités près de chez vous'|trans }}</small></span></li>
                <li><span class="ld-why__ico is-blue-plain">{{ icon.shield_check(34) }}</span><span><strong>{{ 'Prestataires de confiance'|trans }}</strong><small>{{ 'Des professionnels sélectionnés pour des expériences de qualité'|trans }}</small></span></li>
                <li><span class="ld-why__ico is-pink">{{ icon.heart(28) }}</span><span><strong>{{ 'Une communauté active'|trans }}</strong><small>{{ 'Des passionnés comme vous pour partager vos loisirs'|trans }}</small></span></li>
            </ul>
        </div>
    </section>
</div>
{% endblock %}
