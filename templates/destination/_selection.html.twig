{#
    Section « Votre sélection d'activités » : destinations et catégories du
    catalogue, avec leurs nombres réels d'activités (CatalogShowcase, 06/11).
    Variables : selections (title, slug, count, image), cities (name, slug).
#}
{% import '_partials/_icons.html.twig' as icon %}

{% if selections is not empty %}
<section class="act-section">
    <div class="container">
        <div class="home-section__head">
            <div>
                <h2 class="home-section__title">{{ "Votre sélection d'activités"|trans }}</h2>
            </div>
        </div>
        {% if cities is not empty %}
            <div class="act-citybar">
                <div class="act-citybar__scroll">
                    {% for c in cities %}
                        <a class="act-chip {{ c.slug == citySlug|default('') ? 'is-active' }}" href="{{ path('app_destination_city', { ville: c.slug }) }}">{{ c.name }}</a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
        <div class="card-grid">
            {% for s in selections %}
                {% include 'activity/_selection_card.html.twig' with { s: s } %}
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}
