{#
    Destinations (menu principal) — maquette docs/maquettes/destinations.jpeg
    (01/10). Action : DestinationController::index() — filtres réels dans
    l'URL : q, continent, type, budget, note.

    Écart assumé : le filtre « Activités populaires » de la maquette n'est
    pas repris, une destination ne portant pas de catégories d'activités.
    Styles : assets/styles/discover.css (.ex-*, .ds-*).
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Destinations'|trans }}{% endblock %}

{% set continents = {'': 'Toutes', france: 'France', europe: 'Europe', 'amerique-nord': 'Amérique du Nord', 'amerique-sud': 'Amérique du Sud', afrique: 'Afrique', asie: 'Asie', oceanie: 'Océanie'} %}
{% set types_labels = {villes: 'Villes', montagne: 'Montagne', mer: 'Mer & Plage', campagne: 'Campagne', lacs: 'Lacs & Rivières'} %}
{% set types = {'': 'Toutes les destinations', villes: 'Villes', montagne: 'Montagne', mer: 'Mer & Plage', campagne: 'Campagne', lacs: 'Lacs & Rivières'} %}
{% set badgeTone = {'Populaire': 'violet', 'Bestseller': 'red', 'Best-seller': 'red', 'Tendance': 'blue'} %}

{% block body %}
<div class="ex">
    <aside class="ex-filters" aria-label="{{ 'Filtres'|trans }}">
        <form class="ex-filters__form" method="get" action="{{ path('app_destinations') }}" data-autosubmit>
            {% if continent %}<input type="hidden" name="continent" value="{{ continent }}">{% endif %}
            <div class="ex-filters__head">
                <p class="ex-filters__title">{{ 'Filtres'|trans }}</p>
                <a class="ex-link" href="{{ path('app_destinations') }}">{{ 'Réinitialiser'|trans }}</a>
            </div>

            <label class="ex-label" for="ds-q">{{ 'Où voulez-vous partir ?'|trans }}</label>
            <span class="ex-input pl-suggest-anchor">
                <input id="ds-q" type="text" name="q" data-suggest="lieu" value="{{ query }}" placeholder="{{ 'Pays, région, ville...'|trans }}">
                {{ icon.map_pin(18) }}
            </span>

            <fieldset class="ex-fieldset">
                <legend class="ex-label">{{ 'Type de destination'|trans }}</legend>
                <div class="ds-types">
                    {% for key, label in types %}
                        <label class="ds-type{{ type == key ? ' is-active' }}">
                            <input type="radio" name="type" value="{{ key }}"{{ type == key ? ' checked' }}>
                            {%- if key == '' %}{{ icon.globe_simple(18) }}{% elseif key == 'villes' %}{{ icon.building(18) }}{% elseif key == 'mer' %}{{ icon.beach(18) }}{% elseif key == 'campagne' %}{{ icon.tree(18) }}{% else %}{{ icon.cat_hiking(18) }}{% endif %} {{ label|trans }}
                        </label>
                    {% endfor %}
                </div>
            </fieldset>

            <fieldset class="ex-fieldset">
                <legend class="ex-label">{{ 'Budget (par personne)'|trans }}</legend>
                <div class="ex-range" data-ex-range data-max="{{ budget_max }}" data-single>
                    <div class="ex-range__labels"><span>0 €</span><span data-ex-range-max-label>{{ budget is null ? budget_max ~ ' € ' ~ 'et +'|trans : budget ~ ' €' }}</span></div>
                    <div class="ex-range__track"><span data-ex-range-bar></span></div>
                    <input type="range" min="0" max="0" value="0" tabindex="-1" aria-hidden="true" data-ex-range-min disabled>
                    <input type="range" min="0" max="{{ budget_max }}" step="5" name="budget" value="{{ budget ?? budget_max }}" aria-label="{{ 'Budget maximum'|trans }}" data-ex-range-max>
                    <span hidden data-ex-range-min-label></span>
                </div>
            </fieldset>

            <fieldset class="ex-fieldset">
                <legend class="ex-label">{{ 'Note des utilisateurs'|trans }}</legend>
                <div class="ex-ratings ds-ratings">
                    <label class="ex-rating"><input type="radio" name="note" value=""{{ rating is null ? ' checked' }}><span>{{ 'Toutes'|trans }}</span></label>
                    {% for n in ratings %}
                        <label class="ex-rating"><input type="radio" name="note" value="{{ n }}"{{ rating == n ? ' checked' }}><span>{{ icon.star_solid(12) }}&nbsp;{{ n|number_format(1, ',') }}+</span></label>
                    {% endfor %}
                </div>
            </fieldset>

            <button type="submit" class="pf-btn pf-btn--primary pf-btn--block pf-btn--lg">{{ 'Afficher les résultats'|trans }}</button>
            <p class="ex-count"><strong>{{ total }}</strong> {{ (total > 1 ? 'destinations trouvées' : 'destination trouvée')|trans }}</p>
        </form>
    </aside>

    <div class="ex-main">
        <header class="ex-head">
            <h1>{{ 'Destinations'|trans }}</h1>
            <p>{{ 'Explorez les plus belles destinations et trouvez des activités inoubliables.'|trans }}</p>
        </header>

        <nav class="ex-tabs" aria-label="{{ 'Continents'|trans }}">
            {% for key, label in continents %}
                <a class="{{ continent == key ? 'is-active' }}" href="{{ path('app_destinations', app.request.query.all|merge({continent: key ?: null})) }}">
                    {%- if key == '' %}{{ icon.grid(20) }}{% elseif key == 'france' %}{{ icon.building(20) }}{% else %}{{ icon.globe_simple(20) }}{% endif %} {{ label|trans }}</a>
            {% endfor %}
        </nav>

        <section class="ds-hero{{ filtering ? ' is-filtering' }}">
            <img class="ds-hero__bg" src="{{ asset('images/destinations/banniere-monde.jpg') }}" alt="" fetchpriority="high">
            <div class="ds-hero__text">
                <h2>{{ 'Partez à la'|trans }} <span>{{ 'découverte du monde'|trans }}</span></h2>
                <p>{{ 'Des expériences uniques vous attendent,'|trans }}<br>{{ 'où que vous soyez.'|trans }}</p>
                <a class="pf-btn pf-btn--primary pf-btn--lg" href="{{ path('app_activities') }}#carte">{{ 'Explorer la carte'|trans }} {{ icon.map(20) }}</a>
            </div>
            <div class="ds-ideas">
                <h3>{{ 'Idées du moment'|trans }}</h3>
                <ul>
                    {% for idea in ideas %}
                        <li><img src="{{ asset(idea.image) }}" alt="" loading="lazy"><span><strong>{{ idea.title|trans }}</strong><small>{{ idea.subtitle|trans }}</small></span></li>
                    {% endfor %}
                </ul>
            </div>
        </section>

        {# Filtres actifs (13/10) : visibles au-dessus des résultats, retirables d'un clic. #}
        {% if filtering %}
            {% set q = app.request.query.all|filter((v, k) => k != 'page') %}
            <div class="ds-active" aria-label="{{ 'Filtres actifs'|trans }}">
                {% if query %}<a href="{{ path('app_destinations', q|filter((v, k) => k != 'q')) }}">« {{ query }} » {{ icon.x(12) }}</a>{% endif %}
                {% if continent %}<a href="{{ path('app_destinations', q|filter((v, k) => k != 'continent')) }}">{{ continents[continent]|trans }} {{ icon.x(12) }}</a>{% endif %}
                {% if type %}<a href="{{ path('app_destinations', q|filter((v, k) => k != 'type')) }}">{{ types_labels[type]|trans }} {{ icon.x(12) }}</a>{% endif %}
                {% if budget is not null %}<a href="{{ path('app_destinations', q|filter((v, k) => k != 'budget')) }}">{{ 'Jusqu’à'|trans }} {{ budget }} € {{ icon.x(12) }}</a>{% endif %}
                {% if rating is not null %}<a href="{{ path('app_destinations', q|filter((v, k) => k != 'note')) }}">{{ icon.star_solid(12) }} {{ rating|number_format(1, ',') }}+ {{ icon.x(12) }}</a>{% endif %}
                <a class="ds-active__reset" href="{{ path('app_destinations') }}">{{ 'Tout effacer'|trans }}</a>
            </div>
        {% endif %}

        <div class="ds-section-head">
            <h2>{% if filtering %}{{ total }} {{ (total > 1 ? 'destinations trouvées' : 'destination trouvée')|trans }}{% else %}{{ 'Destinations populaires'|trans }}{% endif %}</h2>
            <a href="{{ path('app_destinations_popular') }}">{{ 'Voir toutes les destinations'|trans }} {{ icon.arrow_right(16) }}</a>
        </div>

        {% if destinations is empty %}
            <div class="pf-card pf-empty">
                <strong>{{ 'Aucune destination ne correspond à votre recherche.'|trans }}</strong>
                <a class="pf-btn" href="{{ path('app_destinations') }}">{{ 'Voir toutes les destinations'|trans }}</a>
            </div>
        {% else %}
            <div class="ds-grid">
                {% for d in destinations %}
                    <a class="ds-card" href="{{ path('app_destination_city', {ville: d.slug}) }}">
                        <span class="ds-card__media">
                            <img src="{{ asset(d.image) }}" alt="{{ d.name }}" loading="lazy">
                            {% if d.badge %}<span class="ds-card__badge ds-card__badge--{{ badgeTone[d.badge] ?? 'violet' }}">{{ d.badge|trans }}</span>{% endif %}
                            <button type="button" class="ex-card__fav{{ d.favorite ? ' is-active' }}"
                                    aria-pressed="{{ d.favorite ? 'true' : 'false' }}"
                                    aria-label="{{ (d.favorite ? 'Retirer des favoris' : 'Ajouter aux favoris')|trans }}"
                                    data-favorite-slug="{{ d.slug }}" data-favorite-type="destination"
                                    data-favorite-url="{{ path('app_favorite_toggle') }}"
                                    data-favorite-token="{{ csrf_token('submit') }}"
                                    data-favorite-label-on="{{ 'Retirer des favoris'|trans }}"
                                    data-favorite-label-off="{{ 'Ajouter aux favoris'|trans }}">{{ d.favorite ? icon.heart_solid(20) : icon.heart(20) }}</button>
                        </span>
                        <span class="ds-card__body">
                            <strong>{{ d.name }}</strong>
                            {% if d.tagline %}<small>{{ d.tagline|trans }}</small>{% endif %}
                            {% if d.rating %}<span class="ex-card__rating">{{ icon.star_solid(14) }} {{ d.rating }} <em>({{ d.reviews }})</em></span>{% endif %}
                            <span class="ds-card__foot">
                                <span>{{ icon.calendar_grid(14) }} {{ d.count }} {{ 'activités'|trans }}</span>
                                {% if d.price %}<span class="ds-card__price"><small>{{ 'À partir de'|trans }}</small><strong>{{ d.price }} €</strong></span>{% endif %}
                            </span>
                        </span>
                    </a>
                {% endfor %}
            </div>
            {% if has_more %}
                <div class="act-more ex-more">
                    <a class="pf-btn pf-btn--lg" href="{{ path('app_destinations', app.request.query.all|merge({page: page + 1})) }}">{{ 'Voir plus de destinations'|trans }} {{ icon.chevron_down(16) }}</a>
                </div>
            {% endif %}
        {% endif %}

        <section class="ex-trust ds-trust">
            <div>{{ icon.cat_bike(30) }}<span><strong>{{ 'Meilleurs prix garantis'|trans }}</strong>{{ 'On s’aligne si vous trouvez moins cher'|trans }}</span></div>
            <div>{{ icon.calendar_grid(30) }}<span><strong>{{ 'Réservation facile'|trans }}</strong>{{ 'En quelques clics'|trans }}</span></div>
            <div>{{ icon.shield(30) }}<span><strong>{{ 'Paiement sécurisé'|trans }}</strong>{{ 'Transactions 100% sécurisées'|trans }}</span></div>
            <div>{{ icon.star(30) }}<span><strong>{{ 'Avis vérifiés'|trans }}</strong>{{ 'Des milliers d’avis authentiques'|trans }}</span></div>
            <div>{{ icon.headset_mic(30) }}<span><strong>{{ 'Support 7j/7'|trans }}</strong>{{ 'Notre équipe est à votre écoute'|trans }}</span></div>
        </section>
    </div>
</div>
{% endblock %}
