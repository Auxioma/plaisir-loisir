{#
    Bandeau « Ce que disent les voyageurs » (spec Destinations §1.14) :
    fond gris, titre navy, note globale + nombre d'avis, puis 2 cartes d'avis
    (réutilise activity/_review_card).
    07/10 : VRAIS avis et vraie moyenne (ReviewPresenter::band()) — fini
    « Basé sur 999.589 avis ». Sans avis publié, le bandeau n'apparaît pas.
    Variables : reviews ({rating, count, cards}), in_column (bool, défaut false).
#}
{% import '_partials/_icons.html.twig' as icon %}

{% if reviews.cards is not empty %}
<section class="home-section dest-reviews {{ in_column|default(false) ? 'dest-reviews--column' }}">
    <div class="{{ in_column|default(false) ? '' : 'container' }}">
        <h2 class="home-section__title dest-reviews__title">{{ 'Ce que disent les voyageurs'|trans }}</h2>

        {% if reviews.rating %}
            <div class="dest-reviews__score">
                <span class="dest-reviews__score-label">{{ 'Note globale'|trans }}</span>
                <span class="home-reviews__score-value">{{ reviews.rating|number_format(1, ',') }} <span>/5</span></span>
                <span class="home-reviews__stars" aria-label="{{ '%n% étoiles sur 5'|trans({'%n%': reviews.rating|number_format(1, ',')}) }}">
                    {% for i in 1..5 %}
                        <span class="{{ i <= reviews.rating|round ? 'is-on' : 'is-off' }}">{{ icon.star(18) }}</span>
                    {% endfor %}
                </span>
                <span class="home-reviews__score-count">{{ 'Basé sur %n% avis'|trans({'%n%': reviews.count|number_format(0, ',', ' ')}) }}</span>
            </div>
        {% endif %}

        <div class="home-reviews__grid">
            {% for r in reviews.cards %}
                {% include 'activity/_review_card.html.twig' with { r: r } %}
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}
