{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Destinations populaires'|trans }}{% endblock %}
{% block meta_description %}{{ 'Découvrez les meilleures destinations et réservez vos activités : meilleur prix garanti, annulation gratuite.'|trans }}{% endblock %}

{% block header %}
    {% if connected %}
        {% include '_partials/navbar_connected.html.twig' with { nav_active: 'destinations' } %}
    {% else %}
        {% include '_partials/navbar_guest.html.twig' with { nav_active: 'destinations' } %}
    {% endif %}
{% endblock %}

{% block body %}
<div class="act-page dest-page" id="dest-page">

    {# ==================================================================
       EN-TÊTE DE PAGE (écran 2) : fil d'Ariane, titre non gras, intro,
       recherche compacte, outils d'affichage, chips, ligne de résultats.
       ================================================================ #}
    <section class="act-head">
        <div class="home-container">

            <nav class="act-breadcrumb" aria-label="{{ "Fil d'Ariane"|trans }}">
                <a href="{{ path('app_home') }}">{{ 'Accueil'|trans }}</a>
                <span aria-hidden="true">/</span>
                <a href="{{ path('app_destinations') }}">{{ 'Destinations'|trans }}</a>
                <span aria-hidden="true">/</span>
                <span aria-current="page">{{ 'Destination populaires'|trans }}</span>
            </nav>

            <h1 class="act-head__title dest-title">{{ 'Destinations populaires'|trans }}</h1>
            <p class="act-head__subtitle">{{ "Découvrez les meilleures destinations à explorer. Choisissez parmi un choix varié d'expériences pour créer des souvenirs inoubliables, en famille ou entre amis. Meilleur prix garanti - Annulation gratuite"|trans }}</p>

            <form class="act-search" role="search" action="{{ path('app_destinations_popular') }}" method="get">
                <div class="act-search__bar">
                    <label class="act-search__field">
                        {{ icon.map_pin(18) }}
                        <input type="text" name="lieu" value="Lille" data-dest-lieu aria-label="{{ 'Lieu'|trans }}">
                    </label>
                    <span class="act-search__sep" aria-hidden="true"></span>
                    <label class="act-search__field">
                        {{ icon.search(18) }}
                        <input type="text" name="q" placeholder="{{ 'Recherches par mots-clés'|trans }}" aria-label="{{ 'Mots-clés'|trans }}">
                    </label>
                </div>
                <button type="submit" class="act-search__submit" aria-label="{{ 'Rechercher'|trans }}">{{ icon.search(20) }}</button>
            </form>

            {# Outils d'affichage, alignés à droite (spec §1.6). #}
            <div class="act-toolbar dest-toolbar">
                <div class="act-toolbar__right">
                    <button type="button" class="act-tool">{{ icon.map(18) }} {{ 'Afficher la carte'|trans }}</button>
                    <div class="act-viewswitch" role="group" aria-label="{{ "Mode d'affichage"|trans }}">
                        <button type="button" class="act-viewbtn" id="dest-filter-toggle" aria-label="{{ 'Ouvrir les filtres'|trans }}">{{ icon.sliders(18) }}</button>
                        <button type="button" class="act-viewbtn is-active" aria-label="{{ 'Affichage en grille'|trans }}">{{ icon.list_view(18) }}</button>
                    </div>
                </div>
            </div>

            {# Chips (spec §1.7). « ‹ Filtre » violet + « Gastronomies » en
               violet clair apparaissent quand le panneau est ouvert (écran 5). #}
            <div class="act-chipbar">
                <button type="button" class="act-chip act-chip--filter" id="dest-chip-filter" aria-expanded="false" aria-controls="dest-filters">
                    <span class="dest-chip-filter__back" hidden>{{ icon.chevron_left(14) }}</span>
                    {{ icon.sliders(16) }} {{ 'Filtre'|trans }}
                    <span class="act-chip__counter" id="dest-filter-counter" hidden>1</span>
                </button>
                <span class="act-chipbar__sep" aria-hidden="true"></span>
                <div class="act-chipbar__scroll">
                    <button type="button" class="act-chip act-chip--soft" id="dest-chip-gastro" hidden>{{ 'Gastronomies'|trans }}</button>
                    {% for chip in ['Toutes'|trans, 'Natures & Plein-air'|trans, 'Cultures & Découverte'|trans, 'Ateliers & Créations'|trans, 'Soirées & Évènements'|trans, 'Bien-être'|trans] %}
                        <button type="button" class="act-chip {{ loop.first ? 'is-active' }}">{{ chip }}</button>
                    {% endfor %}
                </div>
                <button type="button" class="act-chipbar__more" aria-label="{{ 'Faire défiler les filtres'|trans }}">{{ icon.chevron_right(16) }}</button>
            </div>

            <div class="act-results">
                <p class="act-results__count"><strong>400+</strong> {{ 'de résultats trouvés'|trans }}</p>
                <div class="dest-sort">
                    <button type="button" class="act-tool act-tool--plain" id="dest-sort-toggle" aria-expanded="false" aria-controls="dest-sort-menu">
                        {{ icon.sort(16) }} {{ 'Trier par:'|trans }} <strong id="dest-sort-label">{{ 'Les plus populaires'|trans }}</strong> {{ icon.chevron_down(14) }}
                    </button>
                    {# Dropdown de tri (écran 7.B) : visuel « case à cocher »,
                       comportement exclusif (radiogroup) — point signalé designer. #}
                    <div class="dest-sort__menu" id="dest-sort-menu" role="radiogroup" aria-label="{{ 'Trier les résultats'|trans }}" hidden>
                        {% for s in ['Les plus populaires'|trans, 'Les plus récents'|trans, 'Note des voyageurs'|trans, 'Prix croissant'|trans, 'Prix décroissant'|trans, 'Durée'|trans] %}
                            <button type="button" class="dest-sort__option {{ loop.first ? 'is-checked' }}" role="radio" aria-checked="{{ loop.first ? 'true' : 'false' }}" data-sort-option>
                                <span class="dest-sort__box" aria-hidden="true"></span> {{ s }}
                            </button>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ==================================================================
       ZONE COMMUTABLE : sidebar de filtres (écran 5) + contenu.
       ================================================================ #}
    <div class="act-body" id="dest-body">

    <aside class="act-filters" id="dest-filters" aria-label="{{ 'Filtres'|trans }}" hidden>
        <div class="act-filters__head">
            <span class="act-filters__title">{{ 'Filtres'|trans }}</span>
            <button type="button" class="act-filters__reset" id="dest-filters-reset">{{ 'Réinitialiser'|trans }}</button>
        </div>

        <div class="act-filters__applied">
            <span class="act-filters__label">{{ 'Filtres appliqués'|trans }}</span>
            <button type="button" class="act-chip is-active" id="dest-applied-gastro">{{ icon.cat_crafts(14) }} {{ 'Gastronomie'|trans }} {{ icon.x(14) }}</button>
        </div>

        {# Date : readonly, ouvre le calendrier de plage (écran 6). #}
        <label class="act-filters__field dest-anchor">
            <span>{{ 'Date'|trans }}</span>
            <span class="act-filters__input">
                {{ icon.calendar(16) }}
                <input type="text" placeholder="{{ 'Sélectionnez une date'|trans }}" readonly id="dest-date-input" aria-haspopup="dialog">
            </span>
        </label>

        {# Calendrier « Choisir vos dates » (écran 6). #}
        <div class="dest-popover dest-popover--cal" id="dest-cal" role="dialog" aria-label="{{ 'Choisir vos dates'|trans }}" hidden
             data-year="2026" data-month="7" data-start="16" data-end="17">
            <div class="dest-popover__head">
                <strong>{{ 'Choisir vos dates'|trans }}</strong>
                <button type="button" class="dest-popover__close" data-cal-close aria-label="{{ 'Fermer'|trans }}">{{ icon.x(16) }}</button>
            </div>
            <div class="dest-cal__nav">
                <button type="button" data-cal-prev aria-label="{{ 'Mois précédent'|trans }}">{{ icon.chevron_left(16) }}</button>
                <strong data-cal-title>Juillet 2026</strong>
                <button type="button" data-cal-next aria-label="{{ 'Mois suivant'|trans }}">{{ icon.chevron_right(16) }}</button>
            </div>
            <div class="dest-cal__days" aria-hidden="true">
                <span>{{ 'lun.'|trans }}</span><span>{{ 'mar.'|trans }}</span><span>{{ 'mer.'|trans }}</span><span>{{ 'jeu.'|trans }}</span><span>{{ 'ven.'|trans }}</span><span>{{ 'sam.'|trans }}</span><span>{{ 'dim.'|trans }}</span>
            </div>
            <div class="dest-cal__grid" data-cal-grid></div>
            <div class="dest-popover__foot">
                <button type="button" class="dest-popover__reset" data-cal-reset>{{ 'Réinitialiser'|trans }}</button>
                <button type="button" class="pl-btn pl-btn--primary" data-cal-apply>{{ 'Appliquer'|trans }}</button>
            </div>
        </div>

        {# Participants : readonly, ouvre le popover voyageurs (écran 7.A). #}
        <label class="act-filters__field dest-anchor">
            <span>{{ 'Participants'|trans }}</span>
            <span class="act-filters__input">
                {{ icon.users(16) }}
                <input type="text" value="01 participant" readonly id="dest-trav-input" aria-haspopup="dialog">
            </span>
        </label>

        {# Popover « Nombre de voyageurs » (écran 7.A). #}
        <div class="dest-popover dest-popover--trav" id="dest-trav" role="dialog" aria-label="{{ 'Nombre de voyageurs'|trans }}" hidden>
            <div class="dest-popover__head">
                <strong>{{ 'Nombre de voyageurs'|trans }}</strong>
                <button type="button" class="dest-popover__close" data-trav-close aria-label="{{ 'Fermer'|trans }}">{{ icon.x(16) }}</button>
            </div>
            <p class="dest-popover__note" data-trav-note>{{ "*Vous pouvez choisir jusqu'à 10 voyageurs au total"|trans }}</p>
            <div class="act-stepper" data-stepper data-min="1" data-count="2">
                <span>{{ 'Adulte'|trans }} <small>{{ '(18 et +)'|trans }}</small></span>
                <span class="act-stepper__controls">
                    <button type="button" data-step="-1" aria-label="{{ "Moins d'adultes"|trans }}">{{ icon.minus(14) }}</button>
                    <output data-stepper-value>2</output>
                    <button type="button" data-step="1" aria-label="{{ "Plus d'adultes"|trans }}">{{ icon.plus(14) }}</button>
                </span>
            </div>
            <div class="dest-popover__sep" aria-hidden="true"></div>
            <div class="act-stepper" data-stepper data-min="0" data-count="0">
                <span>{{ 'Enfants'|trans }} <small>{{ '(0 à 17 ans)'|trans }}</small></span>
                <span class="act-stepper__controls">
                    <button type="button" data-step="-1" aria-label="{{ "Moins d'enfants"|trans }}">{{ icon.minus(14) }}</button>
                    <output data-stepper-value>0</output>
                    <button type="button" data-step="1" aria-label="{{ "Plus d'enfants"|trans }}">{{ icon.plus(14) }}</button>
                </span>
            </div>
            <div class="dest-popover__foot">
                <button type="button" class="dest-popover__reset" data-trav-reset>{{ 'Réinitialiser'|trans }}</button>
                <button type="button" class="pl-btn pl-btn--primary" data-trav-apply>{{ 'Appliquer'|trans }}</button>
            </div>
        </div>

        {# Distinction validée par le client (« Option 1 », 2026-07-27). #}
        <fieldset class="act-filters__group">
            <legend>{{ "Type d'activité"|trans }}</legend>
            <label class="act-filters__check">
                <input type="checkbox" checked> <span>🎟️ {{ 'Activités professionnelles'|trans }}</span>
            </label>
            <label class="act-filters__check">
                <input type="checkbox"> <span>👥 {{ 'Activités entre particuliers « Gratuite »'|trans }}</span>
            </label>
        </fieldset>

        <fieldset class="act-filters__group">
            <legend>{{ 'Type de destination'|trans }}</legend>
            <button type="button" class="act-filters__dest is-active" data-dest-type>{{ icon.globe(18) }} {{ 'Toutes les destinations'|trans }}</button>
            <button type="button" class="act-filters__dest" data-dest-type>{{ icon.building(18) }} {{ 'Villes'|trans }}</button>
            <button type="button" class="act-filters__dest" data-dest-type>{{ icon.cat_hiking(18) }} {{ 'Montagnes'|trans }}</button>
            <button type="button" class="act-filters__dest" data-dest-type>{{ icon.beach(18) }} {{ 'Mers & Plages'|trans }}</button>
            <button type="button" class="act-filters__dest" data-dest-type>{{ icon.tree(18) }} {{ 'Campagnes'|trans }}</button>
            <button type="button" class="act-filters__dest" data-dest-type>{{ icon.cat_canoe(18) }} {{ 'Lacs & Rivières'|trans }}</button>
        </fieldset>

        <fieldset class="act-filters__group">
            <legend>{{ 'Activités populaires'|trans }}</legend>
            {% for c in ['Sports & Aventures'|trans, 'Bien-être'|trans, 'Culture & Découverte'|trans, 'En famille'|trans, 'Romantique'|trans, 'Gastronomie'|trans] %}
                <label class="act-filters__check">
                    <input type="checkbox" data-filter-check {{ loop.last ? 'checked' }}> {{ c }}
                </label>
            {% endfor %}
        </fieldset>

        <fieldset class="act-filters__group" id="dest-budget">
            <legend>{{ 'Budget (par personne)'|trans }}</legend>
            <div class="act-budget__slider">
                <div class="act-budget__track" aria-hidden="true"></div>
                <div class="act-budget__range" data-budget-range aria-hidden="true"></div>
                <input type="range" min="0" max="1050" step="1" value="154" data-budget-min aria-label="{{ 'Budget minimum'|trans }}">
                <input type="range" min="0" max="1050" step="1" value="1050" data-budget-max aria-label="{{ 'Budget maximum'|trans }}">
            </div>
            <div class="act-budget__bounds"><span>0€</span><span>{{ '1050€ et +'|trans }}</span></div>
            <div class="act-budget__inputs">
                <input type="text" inputmode="numeric" value="154€" data-budget-input-min aria-label="{{ 'Budget minimum en euros'|trans }}">
                <input type="text" inputmode="numeric" value="1050+€" data-budget-input-max aria-label="{{ 'Budget maximum en euros'|trans }}">
            </div>
        </fieldset>

        <fieldset class="act-filters__group">
            <legend>{{ 'Note des utilisateurs'|trans }}</legend>
            {% for n in [5, 4, 3, 2, 1] %}
                <label class="act-filters__check act-filters__check--stars">
                    <input type="checkbox" data-filter-check>
                    <span class="act-filters__stars" aria-label="{{ n > 1 ? '%n% étoiles et plus'|trans({'%n%': n}) : '%n% étoile et plus'|trans({'%n%': n}) }}">
                        {% for i in 1..5 %}<span class="{{ i <= n ? 'is-on' : 'is-off' }}">{{ icon.star(16) }}</span>{% endfor %}
                    </span>
                </label>
            {% endfor %}
        </fieldset>

        <button type="button" class="pl-btn pl-btn--primary pl-btn--block">{{ 'Affichez les résultats'|trans }}</button>
        <p class="act-filters__count"><strong id="dest-found-count">126</strong> {{ 'activités trouvées'|trans }}</p>
    </aside>

    <div class="act-content">

    {# ==================================================================
       GRILLE PAR DÉFAUT (écran 2) : 16 destinations, 4×4.
       ================================================================ #}
    <section class="act-section" id="dest-grid-default">
        <div class="home-container">
            <div class="card-grid dest-default-grid">
                {% for d in destinations %}
                    {% include 'destination/_card.html.twig' with { d: d } %}
                {% endfor %}
            </div>
            <div class="act-more">
                <button type="button" class="pl-btn pl-btn--outline-action">{{ 'Voir plus de destinations'|trans }} {{ icon.chevron_down(16) }}</button>
            </div>
        </div>
    </section>

    {# ==================================================================
       GRILLE FILTRÉE (écran 5) : 12 activités Gastronomie, 3×4.
       ================================================================ #}
    <section class="act-section" id="dest-grid-filtered" hidden>
        <div class="home-container">
            <div class="card-grid dest-gastro-grid">
                {% for a in gastronomy %}
                    {% include 'activity/_card.html.twig' with { a: a } %}
                {% endfor %}
            </div>
            <div class="act-more">
                <button type="button" class="pl-btn pl-btn--outline-action">{{ "Voir plus d'activités"|trans }} {{ icon.chevron_down(16) }}</button>
            </div>
        </div>
    </section>

    {# Votre sélection d'activités + pagination (spec §1.12-1.13). #}
    {% include 'destination/_selection.html.twig' with { selections: selections, cities: cities } %}

    {# Ce que disent les voyageurs (spec §1.14) : pleine largeur par
       défaut, borné à la colonne quand la sidebar est ouverte. #}
    {% include 'destination/_reviews_band.html.twig' with { reviews: reviews } %}

    </div>{# /.act-content #}
    </div>{# /.act-body #}

</div>
{% endblock %}
