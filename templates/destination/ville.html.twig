{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Activités à %ville%'|trans({'%ville%': city}) }}{% endblock %}
{% block meta_description %}{{ 'Découvrez les meilleures activités à faire à %ville% : expériences variées, meilleur prix garanti, annulation gratuite.'|trans({'%ville%': city}) }}{% endblock %}

{% block header %}
    {# Un seul include : navbar.html.twig choisit lui-même l'état connecté
       ou visiteur d'après la session. #}
    {% include '_partials/navbar.html.twig' with { nav_active: 'destinations' } %}
{% endblock %}

{% block body %}
<div class="act-page dest-page">

    {# ==================================================================
       EN-TÊTE DE PAGE (écrans 3-4) : identique à l'écran 2, mais H1
       « Activités à Lille » et dropdown de localisation sur le champ lieu.
       ================================================================ #}
    <section class="act-head">
        <div class="container">

            <nav class="act-breadcrumb" aria-label="{{ "Fil d'Ariane"|trans }}">
                <a href="{{ path('app_home') }}">{{ 'Accueil'|trans }}</a>
                <span aria-hidden="true">|</span>
                <a href="{{ path('app_destinations') }}">{{ 'Destinations'|trans }}</a>
                <span aria-hidden="true">|</span>
                <span aria-current="page">{{ city }}</span>
            </nav>

            <p>{% include '_partials/_event_fav.html.twig' with {type: 'destination', key: citySlug, class: 'pa-fav'} %} {{ 'Ajouter cette destination aux favoris'|trans }}</p>
            <h1 class="act-head__title dest-title">{{ 'Activités à %ville%'|trans({'%ville%': city}) }}</h1>
            <p class="act-head__subtitle">{{ "Découvrez les meilleures activités à faire à %ville%. Choisissez parmi un choix varié d'expériences pour créer des souvenirs inoubliables, en famille ou entre amis. Meilleur prix garanti - Annulation gratuite"|trans({'%ville%': city}) }}</p>

            <form class="act-search" role="search" action="{{ path('app_destination_city', { ville: citySlug }) }}" method="get">
                <div class="act-search__bar">
                    <label class="act-search__field dest-locfield">
                        {{ icon.map_pin(18) }}
                        <input type="text" name="lieu" data-suggest="lieu" value="{{ city }}" aria-label="{{ 'Lieu'|trans }}"
                               id="dest-loc-input" autocomplete="off"
                               role="combobox" aria-expanded="false" aria-controls="dest-locpanel">
                    </label>
                    <span class="act-search__sep" aria-hidden="true"></span>
                    <label class="act-search__field">
                        {{ icon.search(18) }}
                        <input type="text" name="q" data-suggest="activite" value="{{ q }}" placeholder="{{ 'Recherches par mots-clés'|trans }}" aria-label="{{ 'Mots-clés'|trans }}">
                    </label>
                </div>
                <button type="submit" class="act-search__submit" aria-label="{{ 'Rechercher'|trans }}">{{ icon.search(20) }}</button>

                {# Dropdown de localisation (écran 4). #}
                <div class="dest-locpanel" id="dest-locpanel" role="listbox" aria-label="{{ 'Choisir une localisation'|trans }}" hidden>
                    <button type="button" class="dest-locpanel__item" role="option" aria-selected="false" data-loc-anywhere>
                        {{ icon.send(18) }} {{ "N'importe où"|trans }}
                    </button>
                    <button type="button" class="dest-locpanel__item" role="option" aria-selected="false" data-loc-nearby>
                        {{ icon.crosshair(18) }} {{ 'Autour de moi'|trans }}
                    </button>
                    <div class="dest-locpanel__sep" aria-hidden="true"></div>
                    {% if suggestions is not empty %}
                        <p class="dest-locpanel__label">{{ 'Suggestions'|trans }}</p>
                        <div class="dest-locpanel__scroll">
                            {% for v in suggestions %}
                                <a class="dest-locpanel__item" role="option" aria-selected="false" href="{{ path('app_destination_city', { ville: v.slug }) }}">
                                    {{ icon.map_pin(18) }} {{ v.name }}
                                </a>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </form>

            <div class="act-toolbar dest-toolbar">
                <div class="act-toolbar__right">
                    <a class="act-tool" href="{{ path('app_activities', { lieu: city }) }}#carte">{{ icon.map(18) }} {{ 'Afficher la carte'|trans }}</a>
                    <div class="act-viewswitch" role="group" aria-label="{{ "Mode d'affichage"|trans }}">
                        <a class="act-viewbtn" href="{{ path('app_activities', { lieu: city, panneau: 1 }) }}" aria-label="{{ 'Ouvrir les filtres'|trans }}">{{ icon.sliders(18) }}</a>
                        <span class="act-viewbtn is-active" aria-label="{{ 'Affichage en grille'|trans }}">{{ icon.list_view(18) }}</span>
                    </div>
                </div>
            </div>

            {# Pastilles : les catégories présentes dans cette destination (06/11). #}
            {% if chips|length > 1 %}
                <div class="act-chipbar">
                    <div class="act-chipbar__scroll">
                        <a class="act-chip {{ categorie is empty ? 'is-active' }}" href="{{ path('app_destination_city', { ville: citySlug, q: q ?: null }) }}">{{ 'Toutes'|trans }}</a>
                        {% for slug, label in chips %}
                            <a class="act-chip {{ categorie == slug ? 'is-active' }}" href="{{ path('app_destination_city', { ville: citySlug, categorie: slug, q: q ?: null }) }}">{{ label }}</a>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            <div class="act-results">
                <p class="act-results__count"><strong>{{ total }}</strong> {{ (total > 1 ? 'résultats trouvés' : 'résultat trouvé')|trans }}</p>
                {% if total > 1 %}<p class="act-tool act-tool--plain">{{ icon.sort(16) }} {{ 'Trier par:'|trans }} <strong>{{ 'Les plus populaires'|trans }}</strong></p>{% endif %}
            </div>
        </div>
    </section>

    {# ==================================================================
       GRILLE 4×3 DES ACTIVITÉS (mode « catégorie », libellé rouge).
       ================================================================ #}
    <section class="act-section">
        <div class="container">
            {# Aucune activite n'est encore rattachee a une destination : la
               page se remplirait d'un vide muet. On le dit, et on renvoie vers
               le catalogue. Le bouton « Voir plus » n'a plus de sens non plus
               dans ce cas. #}
            {% if activities is empty %}
                <p class="act-results__count">
                    {% if q or categorie %}
                        {{ 'Aucune activité ne correspond à cette recherche.'|trans }}
                        <a class="auth-inline-link" href="{{ path('app_destination_city', { ville: citySlug }) }}">{{ 'Voir toutes les activités de %ville%'|trans({'%ville%': city}) }}</a>
                    {% else %}
                        {{ "Aucune activité n'est encore proposée dans cette destination."|trans }}
                        <a class="auth-inline-link" href="{{ path('app_activities') }}">{{ 'Voir toutes les activités'|trans }}</a>
                    {% endif %}
                </p>
            {% else %}
                <div class="card-grid">
                    {% for a in activities %}
                        {% include 'activity/_card.html.twig' with { a: a } %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>

    {% include 'destination/_selection.html.twig' with { selections: selections, cities: cities } %}

    {% include 'destination/_reviews_band.html.twig' with { reviews: reviews } %}

</div>
{% endblock %}
