{#
    Avis reçus par le professionnel (§16.2 du CDC). Aucune maquette : réutilise
    le gabarit de l'espace compte et une liste Bootstrap.
    Variables : reviews (list de Review), average (float|null).
#}
{% extends 'account/_layout.html.twig' %}

{% block title %}{{ 'Avis reçus'|trans }}{% endblock %}

{% block account %}
    {% include 'account/_page_head.html.twig' with {
        crumbs: [{ label: 'Avis reçus'|trans }],
        title: 'Avis reçus'|trans,
        subtitle: average is not null
            ? (('Note moyenne :'|trans) ~ ' ' ~ average|number_format(1) ~ '/5')
            : 'Vous n\'avez pas encore reçu d\'avis.'|trans,
    } %}

    {% if reviews is empty %}
        {% include 'account/_empty.html.twig' with { message: "Vous n'avez pas encore reçu d'avis. Ils apparaîtront ici une fois vos devis acceptés et honorés."|trans } %}
    {% else %}
        <div class="d-flex flex-column gap-3">
            {% for review in reviews %}
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                            <strong>{{ review.author.firstName }} {{ review.author.lastName }}</strong>
                            <span class="fw-bold" style="color: var(--pl-action);">{{ review.rating }}/5</span>
                        </div>
                        <div class="text-muted small mb-2">{{ review.createdAt|date('d/m/Y') }}</div>
                        {% if review.comment %}
                            <p class="mb-2">{{ review.comment|nl2br }}</p>
                        {% endif %}

                        {% if review.providerReply %}
                            <div class="border-start ps-3 mt-2">
                                <div class="text-muted small">{{ 'Votre réponse'|trans }}</div>
                                <p class="mb-0">{{ review.providerReply|nl2br }}</p>
                            </div>
                        {% else %}
                            <form method="post" action="{{ path('app_pro_reviews_reply', {id: review.id}) }}" class="d-flex gap-2 mt-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                                <input type="text" name="reponse" class="form-control form-control-sm" required maxlength="2000" placeholder="{{ 'Répondre à cet avis...'|trans }}">
                                <button type="submit" class="btn btn-sm pl-btn pl-btn--outline-dark">{{ 'Répondre'|trans }}</button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
