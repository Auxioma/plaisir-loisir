<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Plaisir & Loisir{% endblock %} — Plaisir & Loisir</title>
        <meta name="description" content="{% block meta_description %}Trouvez et réservez les meilleurs prestataires de loisirs près de chez vous.{% endblock %}">
        {# Referencement multilingue. Chaque page existe a une adresse par
           langue : la canonique designe celle de la page affichee, les balises
           alternate declarent les autres. Sans elles, un moteur de recherche
           traite les deux versions comme du contenu duplique et n'en garde
           qu'une. x-default pointe vers le francais, langue de reference. #}
        {% set alternates = locale_alternates() %}
        {% if alternates is not empty %}
            <link rel="canonical" href="{{ alternates[app.request.locale] ?? app.request.uri }}">
            {% for hreflang, href in alternates %}
                <link rel="alternate" hreflang="{{ hreflang }}" href="{{ href }}">
            {% endfor %}
            <link rel="alternate" hreflang="x-default" href="{{ alternates.fr }}">
        {% endif %}

        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🎯</text></svg>">

        {# Inter est désormais hébergée par le projet (assets/styles/fonts.css) :
           plus de requête vers Google, plus de clignotement de police. #}
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    {# L'adresse des suggestions est posée ICI, une seule fois, plutôt que
       répétée sur la douzaine de champs de recherche du site. Elle passe par
       `path()` parce qu'elle est traduite : /suggestions en français,
       /en/suggestions en anglais. #}
    <body data-suggest-url="{{ path('app_suggestions') }}">
        {% block header %}
            {% include '_partials/navbar.html.twig' %}
        {% endblock %}

        {% block flash_messages %}
            {% include '_partials/flash_messages.html.twig' %}
        {% endblock %}

        <main id="main-content">
            {% block body %}{% endblock %}
        </main>

        {% block footer %}
            {% include '_partials/footer.html.twig' %}
        {% endblock %}
    </body>
</html>
