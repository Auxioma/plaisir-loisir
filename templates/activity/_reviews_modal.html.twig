{#
    Modale « Tous les avis » (écran G, spec §9).

    Bâtie sur la MODALE BOOTSTRAP (.modal / .modal-dialog / .modal-content) :
    l'ouverture, la fermeture, le voile, la touche Échap, le blocage du
    défilement de fond, le piège à focus et sa restitution au bouton d'origine
    sont fournis par le framework. Notre code maison réimplémentait les quatre
    premiers points et n'avait ni piège à focus ni restitution — un lecteur
    d'écran continuait de lire la page derrière la modale.

    Reste à notre charge dans assets/activities.js, car propre au métier :
      G.2 scrollé : l'en-tête se contextualise (titre de l'activité + note)
      G.3 tri     : dropdown « Trier par » et tri effectif de la liste

    Variables : detail (reviewsSummary, modalTitle), reviews.
#}
{% import '_partials/_icons.html.twig' as icon %}

<div class="modal fade reviews-modal" id="reviews-modal" tabindex="-1" aria-labelledby="reviews-modal-title">
  <div class="modal-dialog">
    <div class="modal-content reviews-modal__panel">

        <header class="reviews-modal__head">
            <button type="button" class="reviews-modal__close" data-bs-dismiss="modal" aria-label="{{ 'Fermer les avis'|trans }}">{{ icon.x(20) }}</button>

            {# En-tête par défaut (G.1). #}
            <div class="reviews-modal__intro" data-modal-intro>
                <h2 class="reviews-modal__title" id="reviews-modal-title">{{ 'Avis clients'|trans }}</h2>
                <div class="reviews-modal__score">
                    <span class="reviews-modal__score-label">{{ 'Note globale'|trans }}</span>
                    <span class="reviews-modal__score-value">{{ detail.reviewsSummary.score }} <span>/{{ detail.reviewsSummary.outOf }}</span></span>
                    <span class="reviews-modal__stars" aria-hidden="true">
                        {% for i in 1..5 %}{{ icon.star(20) }}{% endfor %}
                    </span>
                    <span class="reviews-modal__count">{{ "D'après"|trans }} {{ detail.reviewsSummary.total }} {{ 'avis'|trans }}</span>
                </div>
            </div>

            {# En-tête contextualisé, affiché au défilement (G.2). #}
            <div class="reviews-modal__context" data-modal-context hidden>
                <h2 class="reviews-modal__context-title">{{ detail.modalTitle }}</h2>
                <span class="reviews-modal__context-note">{{ icon.star(14) }} {{ detail.reviewsSummary.score }} ({{ detail.reviewsSummary.total }} {{ 'avis'|trans }})</span>
            </div>

            <div class="reviews-modal__tools">
                <button type="button" class="act-tool">{{ icon.sliders(16) }} {{ 'Filtre'|trans }}</button>
                <div class="reviews-sort">
                    <button type="button" class="act-tool" data-sort-toggle aria-haspopup="listbox" aria-expanded="false">
                        {{ icon.sort(16) }} {{ 'Trier par:'|trans }} <strong data-sort-label>{{ 'Les plus récents'|trans }}</strong> {{ icon.chevron_down(14) }}
                    </button>
                    <div class="reviews-sort__menu" data-sort-menu role="listbox" aria-label="{{ 'Ordre de tri'|trans }}" hidden>
                        {% for option in ['Les plus récents'|trans, 'Les plus anciens'|trans, 'Les mieux notés'|trans, 'Les moins notés'|trans] %}
                            <button type="button" class="reviews-sort__option {{ loop.first ? 'is-selected' }}" role="option" aria-selected="{{ loop.first ? 'true' : 'false' }}" data-sort-option="{{ loop.index0 }}">
                                <span class="reviews-sort__check" aria-hidden="true">✓</span> {{ option }}
                            </button>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </header>

        <div class="reviews-modal__body" data-modal-body>
            {% for r in reviews %}
                <div class="reviews-modal__item" data-review data-stars="{{ r.stars }}" data-index="{{ loop.index0 }}">
                    {% include 'activity/_review_card.html.twig' with { r: r } %}
                </div>
            {% endfor %}
        </div>

    </div>
  </div>
</div>
