{#
    Carte activité « standard » (spec §2.2) — réutilisée sur l'accueil
    connecté, le listing (C/D), la vue carte (variante horizontale) et
    les suggestions du détail.

    Variables :
      - a         : l'activité (place, title, rating, reviews, duration,
                    price, badge, image, slug)
      - href      : lien de la carte (par défaut « # », branché sur le
                    détail quand la page existe)
      - horizontal : true = image à gauche (panneau liste de la vue carte)
#}
{% import '_partials/_icons.html.twig' as icon %}

<a href="{{ href|default('#') }}" class="pl-card act-card {{ horizontal|default(false) ? 'act-card--horizontal' }}">
    <div class="pl-card__media">
        <img src="{{ asset(a.image) }}" alt="{{ a.title }}">
        {% if a.badge %}
            <span class="pl-card__tag pl-card__tag--bestseller">{{ a.badge }}</span>
        {% endif %}
        <button type="button" class="pl-card__fav" aria-label="Ajouter aux favoris">{{ icon.heart(16) }}</button>
    </div>
    <div class="pl-card__body">
        <span class="pl-card__place">{{ icon.map_pin(14) }} {{ a.place }}</span>
        <span class="pl-card__title">{{ a.title }}</span>
        <div class="act-card__meta">
            <span class="act-rating">{{ icon.star(12) }} {{ a.rating }}</span>
            <span class="act-card__reviews">{{ a.reviews }} reviews</span>
            <span class="act-card__duration">{{ icon.clock(14) }} {{ a.duration }}</span>
        </div>
        <div class="pl-card__foot">
            <span class="pl-card__from">À partir de</span>
            <span class="pl-card__price">{{ a.price }}€</span>
        </div>
    </div>
</a>
