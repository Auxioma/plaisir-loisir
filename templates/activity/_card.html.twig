{#
    Carte activité « standard » (spec §2.2) — réutilisée sur l'accueil
    connecté, le listing (C/D), la vue carte (variante horizontale) et
    les suggestions du détail.

    Variables :
      - a         : l'activité (place, title, rating, reviews, duration,
                    price, badge, image, slug)
      - href      : lien de la carte (par défaut « # », branché sur le
                    détail quand la page existe)
      - horizontal : true = image à gauche (panneau liste de la vue carte)
#}
{% import '_partials/_icons.html.twig' as icon %}

{% set card_href = href|default(a.slug is defined and a.slug ? path('app_activity_show', { slug: a.slug }) : path('app_activities')) %}
<a href="{{ card_href }}" class="pl-card act-card {{ horizontal|default(false) ? 'act-card--horizontal' }}">
    <div class="pl-card__media">
        <img src="{{ asset(a.image) }}" alt="{{ a.title }}">
        {% if a.badge %}
            {# « Nouvelle activité » est bleu, les autres badges (Bestseller,
               Bientôt complet) restent rouges — spec Destinations §1.10. #}
            <span class="pl-card__tag {{ a.badge == 'Nouvelle activité' ? 'pl-card__tag--popular' : 'pl-card__tag--bestseller' }}">{{ a.badge }}</span>
        {% endif %}
        <button type="button" class="pl-card__fav" aria-label="{{ 'Ajouter aux favoris'|trans }}">{{ icon.heart(16) }}</button>
        {# Pastille « Pro » / « Gratuite » : demandée par Loïc mais ABSENTE de
           toutes les maquettes (vérifié sur Activités, Activités - Filtre et
           Destinations). Retirée pour se conformer à la maquette, comme
           demandé par le CTO le 12/08. Pour la rétablir, repasser
           kind_badge à true. Voir docs/note-conformite-12-08.md §5. #}
        {% if kind_badge|default(false) %}
            {% if a.free is defined and a.free %}
                <span class="act-card__kind act-card__kind--free">👥 {{ 'Gratuite'|trans }}</span>
            {% else %}
                <span class="act-card__kind act-card__kind--pro">🎟️ {{ 'Pro'|trans }}</span>
            {% endif %}
        {% endif %}
    </div>
    <div class="pl-card__body">
        {% if a.category is defined and a.category %}
            {# Mode « catégorie » (flow Destinations, écran ville) : libellé rouge. #}
            <span class="act-card__cat">
                {%- if a.category starts with 'Sports' %}{{ icon.cat_sports(14) }}
                {%- elseif a.category starts with 'Cultures' %}{{ icon.cat_culture(14) }}
                {%- elseif a.category starts with 'Ateliers' %}{{ icon.cat_crafts(14) }}
                {%- elseif a.category starts with 'Bien' %}{{ icon.cat_wellness(14) }}
                {%- elseif a.category starts with 'Soirées' %}{{ icon.flame(14) }}
                {%- else %}{{ icon.compass(14) }}
                {%- endif %} {{ a.category }}</span>
        {% else %}
            <span class="pl-card__place">{{ icon.map_pin(14) }} {{ a.place }}</span>
        {% endif %}
        <span class="pl-card__title">{{ a.title }}</span>
        <div class="act-card__meta">
            <span class="act-rating">{{ icon.star(12) }} {{ a.rating }}</span>
            <span class="act-card__reviews">{{ a.reviews }} {{ 'reviews'|trans }}</span>
            <span class="act-card__duration">{{ icon.clock(14) }} {{ a.duration }}</span>
        </div>
        <div class="pl-card__foot">
            {% if a.free is defined and a.free %}
                <span class="pl-card__from">{{ 'Entre particuliers'|trans }}</span>
                <span class="pl-card__price pl-card__price--free">{{ 'Gratuit'|trans }}</span>
            {% else %}
                <span class="pl-card__from">{{ 'À partir de'|trans }}</span>
                <span class="pl-card__price">{{ a.price }}€</span>
            {% endif %}
        </div>
    </div>
</a>
