{#
    Activités (menu principal) — maquette docs/maquettes/activites.jpeg (01/10).
    Action : ActivityController::index() — tous les filtres sont réels et
    vivent dans l'URL (q, lieu, date, participants, categories[], prix_min,
    prix_max, note[], tri, page).

    Colonne de filtres à gauche (défilement indépendant, voir layout.css),
    onglets de catégories, tri, bascule « Voir sur la carte » (vue carte
    Leaflet existante, assets/activities.js), grille de 4 colonnes,
    « Voir plus d'activités » (page suivante) et bandeau de réassurance.
    Styles : assets/styles/discover.css (.ex-*).
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Activités'|trans }}{% endblock %}
{% block meta_description %}{{ "Découvrez et réservez directement en ligne des milliers d'activités inoubliables partout en France. Meilleur prix garanti - Annulation gratuite"|trans }}{% endblock %}

{% macro cat_icon(slug) %}
    {%- import '_partials/_icons.html.twig' as icon -%}
    {%- if slug starts with 'sports' %}{{ icon.cat_bike(20) }}{% elseif slug starts with 'natures' %}{{ icon.cat_hiking(20) }}{% elseif slug starts with 'cultures' %}{{ icon.cat_culture(20) }}{% elseif slug starts with 'bien' %}{{ icon.cat_wellness(20) }}{% elseif slug starts with 'en-famille' %}{{ icon.cat_family(20) }}{% elseif slug starts with 'ateliers' %}{{ icon.cat_crafts(20) }}{% elseif slug starts with 'soirees' %}{{ icon.party(20) }}{% else %}{{ icon.utensils(20) }}{% endif -%}
{% endmacro %}

{% block body %}
{% set selected = categories|default([]) %}
<div class="ex">
    {# ---- Filtres ---- #}
    <aside class="ex-filters" aria-label="{{ 'Filtres'|trans }}">
        <form class="ex-filters__form" method="get" action="{{ path('app_activities') }}">
            {% if q %}<input type="hidden" name="q" value="{{ q }}">{% endif %}
            {% if app.request.query.get('tri') %}<input type="hidden" name="tri" value="{{ tri.value }}">{% endif %}
            <div class="ex-filters__head">
                <h2>{{ 'Filtres'|trans }}</h2>
                <a href="{{ path('app_activities') }}">{{ 'Réinitialiser'|trans }}</a>
            </div>

            <label class="ex-label" for="ex-lieu">{{ 'Où voulez-vous ?'|trans }}</label>
            <span class="ex-input pl-suggest-anchor">
                <input id="ex-lieu" type="text" name="lieu" data-suggest="lieu" value="{{ lieu }}" placeholder="{{ 'Destination, ville, lieu...'|trans }}">
                {{ icon.map_pin(18) }}
            </span>

            <label class="ex-label" for="ex-date">{{ 'Date'|trans }}</label>
            <span class="ex-input">
                <input id="ex-date" type="date" name="date" value="{{ date ? date|date('Y-m-d') : '' }}">
            </span>

            <label class="ex-label" for="ex-participants">{{ 'Participants'|trans }}</label>
            <span class="ex-input">
                <input id="ex-participants" type="number" min="1" max="200" name="participants" value="{{ participants }}" placeholder="1 {{ 'participant'|trans }}">
                {{ icon.users(18) }}
            </span>

            <fieldset class="ex-fieldset">
                <legend class="ex-label">{{ 'Catégorie'|trans }}</legend>
                {% for c in catalogCategories %}
                    <label class="ex-check"><input type="checkbox" name="categories[]" value="{{ c.slug }}"{{ c.slug in selected ? ' checked' }}> {{ c.name|trans }}</label>
                {% endfor %}
            </fieldset>

            <fieldset class="ex-fieldset">
                <legend class="ex-label">{{ 'Prix'|trans }}</legend>
                <div class="ex-range" data-ex-range data-max="1050">
                    <div class="ex-range__labels"><span data-ex-range-min-label>{{ prixMin ?? 0 }} €</span><span data-ex-range-max-label>{{ prixMax is null or prixMax >= 1050 ? '1050 € et +' : prixMax ~ ' €' }}</span></div>
                    <div class="ex-range__track"><span data-ex-range-bar></span></div>
                    <input type="range" min="0" max="1050" step="5" name="prix_min" value="{{ prixMin ?? 0 }}" aria-label="{{ 'Prix minimum'|trans }}" data-ex-range-min>
                    <input type="range" min="0" max="1050" step="5" name="prix_max" value="{{ prixMax ?? 1050 }}" aria-label="{{ 'Prix maximum'|trans }}" data-ex-range-max>
                </div>
            </fieldset>

            <fieldset class="ex-fieldset">
                <legend class="ex-label">{{ 'Note des utilisateurs'|trans }}</legend>
                <div class="ex-ratings">
                    {% for n in [4, 3, 2] %}
                        <label class="ex-rating"><input type="radio" name="note[]" value="{{ n }}"{{ note == n ? ' checked' }}><span>{{ icon.star_solid(12) }} {{ n }} {{ 'et +'|trans }}</span></label>
                    {% endfor %}
                </div>
            </fieldset>

            <button type="submit" class="pf-btn pf-btn--primary pf-btn--block pf-btn--lg">{{ 'Afficher les résultats'|trans }}</button>
            <p class="act-results__count ex-count"><strong id="act-found-count">{{ total }}</strong> {{ (total > 1 ? 'activités trouvées' : 'activité trouvée')|trans }}</p>
        </form>
    </aside>

    {# ---- Résultats ---- #}
    <div class="ex-main">
        <header class="ex-head">
            <h1>{{ 'Activités'|trans }}</h1>
            <p>{{ 'Découvrez et réservez des activités inoubliables partout en France.'|trans }}</p>
        </header>
        {# Recherche « Toutes » de l'accueil : les activités gratuites qui répondent aussi. #}
        {% if free_matches %}
            <a class="ex-free-banner" href="{{ path('app_private_activities', free_params) }}">
                {{ icon.users(18) }} <span><strong>{{ free_matches }} {{ free_matches > 1 ? 'activités gratuites entre membres correspondent aussi à votre recherche'|trans : 'activité gratuite entre membres correspond aussi à votre recherche'|trans }}</strong></span> {{ icon.arrow_right(16) }}
            </a>
        {% endif %}

        <nav class="ex-tabs" aria-label="{{ 'Catégories'|trans }}">
            <a class="{{ selected is empty ? 'is-active' }}" href="{{ path('app_activities', app.request.query.all|merge({categorie: null, 'categories': null, page: null})) }}">{{ icon.grid(20) }} {{ 'Toutes'|trans }}</a>
            {% for c in catalogCategories %}
                <a class="{{ selected == [c.slug] ? 'is-active' }}" href="{{ path('app_activities', app.request.query.all|merge({categorie: c.slug, 'categories': null, page: null})) }}">{{ _self.cat_icon(c.slug) }} {{ c.name|trans }}</a>
            {% endfor %}
        </nav>

        <div class="ex-toolbar">
            <span class="ex-toolbar__label">{{ 'Trier par'|trans }}</span>
            <details class="pl-dropdown act-sort ex-sort">
                <summary>{{ tri.label|trans }} {{ icon.chevron_down(16) }}</summary>
                <div class="pl-dropdown__menu act-sort__menu">
                    {% for t in tris %}
                        <a class="pl-dropdown__item{{ t == tri ? ' is-active' }}" href="{{ path('app_activities', app.request.query.all|merge({ tri: t.value, page: null })) }}">{{ t.label|trans }}</a>
                    {% endfor %}
                </div>
            </details>
            <label class="ex-switch">
                <input type="checkbox" id="ex-map-toggle">
                <span class="ex-switch__track"></span>
                {{ 'Voir sur la carte'|trans }}
            </label>
            <span class="ex-toolbar__view">{{ 'Affichage :'|trans }}
                <button type="button" class="is-active" data-ex-view="grid" aria-label="{{ 'Vue en grille'|trans }}">{{ icon.grid(18) }}</button>
                <button type="button" data-ex-view="list" aria-label="{{ 'Vue en liste'|trans }}">{{ icon.list_view(18) }}</button>
            </span>
        </div>

        <div id="ex-results">
            <section class="act-section">
                {% if gridActivities is empty %}
                    <div class="pf-card pf-empty">
                        <strong>{{ 'Aucune activité ne correspond à votre recherche.'|trans }}</strong>
                        <a class="pf-btn" href="{{ path('app_activities') }}">{{ 'Voir toutes les activités'|trans }}</a>
                    </div>
                {% else %}
                    <div class="card-grid act-grid ex-grid" data-ex-grid>
                        {% for a in gridActivities %}
                            {% include 'activity/_ex_card.html.twig' with { a: a } %}
                        {% endfor %}
                    </div>
                {% endif %}

                {% if page < pages %}
                    <div class="act-more ex-more">
                        <a class="pf-btn pf-btn--lg" href="{{ path('app_activities', app.request.query.all|merge({ page: page + 1 })) }}">{{ "Voir plus d'activités"|trans }} {{ icon.chevron_down(16) }}</a>
                    </div>
                {% endif %}
            </section>
        </div>

        {# Vue carte : liste + carte Leaflet (assets/activities.js). #}
        <section class="act-mapview ex-mapview" id="act-mapview" hidden aria-label="{{ 'Résultats sur la carte'|trans }}">
            <div class="act-mapview__list">
                {% for a in activities %}
                    {% include 'activity/_card.html.twig' with { a: a, horizontal: true } %}
                {% endfor %}
            </div>
            <div class="act-mapview__map">
                <div id="act-map"
                     data-markers="{{ activities|map(a => {
                         title: a.title, place: a.place, rating: a.rating, reviews: a.reviews,
                         duration: a.duration, price: a.price, badge: a.badge, image: asset(a.image),
                         lat: a.lat, lng: a.lng,
                         url: a.slug ? path('app_activity_show', { slug: a.slug }) : null,
                     })|json_encode|e('html_attr') }}"
                     data-clusters="{{ clusters|json_encode|e('html_attr') }}"></div>
            </div>
        </section>

        <section class="ex-trust">
            <div>{{ icon.calendar_grid(30) }}<span><strong>{{ 'Réservation facile'|trans }}</strong>{{ 'Réservez en quelques clics'|trans }}</span></div>
            <div>{{ icon.cat_bike(30) }}<span><strong>{{ 'Meilleurs prix garantis'|trans }}</strong>{{ 'On s’aligne si vous trouvez moins cher'|trans }}</span></div>
            <div>{{ icon.shield(30) }}<span><strong>{{ 'Paiement sécurisé'|trans }}</strong>{{ 'Transactions 100% sécurisées'|trans }}</span></div>
            <div>{{ icon.star(30) }}<span><strong>{{ 'Avis vérifiés'|trans }}</strong>{{ 'Des milliers d’avis authentiques'|trans }}</span></div>
            <div>{{ icon.headset_mic(30) }}<span><strong>{{ 'Support 7j/7'|trans }}</strong>{{ 'Notre équipe est à votre écoute'|trans }}</span></div>
        </section>
    </div>
</div>
{% endblock %}
