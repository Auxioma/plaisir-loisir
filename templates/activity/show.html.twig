{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ detail.title }}{% endblock %}
{% block meta_description %}{{ detail.presentation.subtitle }} — {{ 'réservation en ligne, annulation gratuite.'|trans }}{% endblock %}

{% block header %}
    {% include '_partials/navbar_connected.html.twig' with { nav_active: 'activites' } %}
{% endblock %}

{% block body %}
{% set review_total = reviews|length %}
{% set review_score = review_total > 0 ? (reviews|reduce((c, r) => c + r.stars, 0) / review_total)|round(1) : null %}
<div class="act-detail">

    {# ==================================================================
       FIL D'ARIANE + EN-TÊTE (titre, note, organisateur).
       ================================================================ #}
    <section class="act-head">
        <div class="container">
            <nav class="act-breadcrumb" aria-label="{{ "Fil d'Ariane"|trans }}">
                {# Chaque maillon porte sa propre route (ActivityPresenter) :
                   le gabarit ne devine plus la destination d'après la place du
                   libellé dans la liste. #}
                {% for crumb in detail.breadcrumb %}
                    {% if crumb.route %}
                        <a href="{{ path(crumb.route, crumb.params) }}">{{ crumb.label|trans }}</a>
                    {% else %}
                        <span aria-current="page">{{ crumb.label }}</span>
                    {% endif %}
                    {% if not loop.last %}<span aria-hidden="true">|</span>{% endif %}
                {% endfor %}
            </nav>

            <h1 class="act-head__title">{{ detail.title }}</h1>
            <div class="act-detail__subline">
                {% if review_score is not null %}<span class="act-rating">{{ icon.star(12) }} {{ review_score|number_format(1, ',') }}</span>{% endif %}
                <a class="act-detail__reviews-link" href="#avis">{{ review_total }} {{ 'avis'|trans }}</a>
                <span class="act-detail__organizer">{{ "Organisateur de l'activité :"|trans }} <strong>{{ detail.organizer }}</strong></span>
            </div>
        </div>
    </section>

    {# ==================================================================
       CORPS : colonne principale + panneau de réservation sticky.
       ================================================================ #}
    <div class="container act-detail__layout">
        <div class="act-detail__main">

            {# --- Galerie mosaïque : 1 grande + 4 vignettes. --- #}
            <div class="act-gallery">
                {% for img in detail.gallery %}
                    <figure class="act-gallery__item {{ loop.first ? 'act-gallery__item--big' }}">
                        <img src="{{ asset(img) }}" alt="{{ detail.title }} — photo {{ loop.index }}">
                        {% if loop.last %}
                            <button type="button" class="act-gallery__all" data-bs-toggle="modal" data-bs-target="#gallery-modal">{{ icon.grid(16) }} {{ 'Voir toutes les photos'|trans }}</button>
                        {% endif %}
                    </figure>
                {% endfor %}
            </div>

            {# --- Localisation + partage / favori. --- #}
            <div class="act-detail__placebar">
                <span class="act-detail__place">{{ icon.map_pin(18) }} {{ detail.place }}</span>
                <a href="#logistique" class="act-detail__maplink">{{ 'voir sur la carte'|trans }} {{ icon.arrow_up_right(14) }}</a>
                <span class="act-detail__placebar-actions">
                    <button type="button" class="pl-iconbtn pl-iconbtn--bordered" aria-label="{{ 'Partager'|trans }}" data-share-url="{{ url('app_activity_show', {slug: activity.slug}) }}" data-share-title="{{ detail.title }}" data-share-done="{{ 'Lien copié !'|trans }}">{{ icon.share(18) }}</button>
                    {% include '_partials/_event_fav.html.twig' with { type: 'activite', key: activity.slug, class: 'pl-iconbtn pl-iconbtn--bordered' } %}
                </span>
            </div>

            {# --- Bandeau des 5 informations clés. --- #}
            {# Masque si vide : une activite peut etre publiee avant que sa fiche editoriale ne soit ecrite. Un encadre vide se verrait plus qu'une section absente. #}
            {% if detail.keyFacts %}
<div class="act-facts">
                {% for fact in detail.keyFacts %}
                    <div class="act-fact">
                        <span class="act-fact__label">{{ fact.label }}</span>
                        <span class="act-fact__value">
                            {% if fact.star is defined %}{{ icon.star(16) }}{% endif %}
                            {{ fact.value }}
                        </span>
                    </div>
                {% endfor %}
            </div>
            {% endif %}

            {# --- Présentation générale. --- #}
            <section class="act-block">
                <h2 class="act-block__title">{{ 'Présentation générale'|trans }}</h2>
                <hr class="act-block__sep">
                <h3 class="act-block__subtitle">{{ detail.presentation.subtitle }}</h3>
                <p class="act-block__text">{{ detail.presentation.text }}</p>
                <p class="act-block__lead">{{ detail.presentation.bulletsTitle }}</p>
                <ul class="act-bullets">
                    {% for bullet in detail.presentation.bullets %}
                        <li>{{ bullet }}</li>
                    {% endfor %}
                </ul>
            </section>

            {# Masque si vide : une activite peut etre publiee avant que sa fiche editoriale ne soit ecrite. Un encadre vide se verrait plus qu'une section absente. #}
            {% if detail.included or detail.excluded %}
{# --- Inclus / Exclus (encadré 2 colonnes). --- #}
            <section class="act-block act-block--boxed">
                <h2 class="act-block__title">{{ "Inclus dans l'offre / Exclus de l'offre"|trans }}</h2>
                <hr class="act-block__sep">
                <div class="act-includes">
                    <ul class="act-checklist act-checklist--in">
                        {% for item in detail.included %}
                            <li><span class="act-checklist__mark" aria-hidden="true">✓</span> {{ item }}</li>
                        {% endfor %}
                    </ul>
                    <ul class="act-checklist act-checklist--out">
                        {% for item in detail.excluded %}
                            <li><span class="act-checklist__mark" aria-hidden="true">✕</span> {{ item }}</li>
                        {% endfor %}
                    </ul>
                </div>
            </section>
            {% endif %}

            {# Masque si vide : une activite peut etre publiee avant que sa fiche editoriale ne soit ecrite. Un encadre vide se verrait plus qu'une section absente. #}
            {% if detail.cannotParticipate or detail.toBring %}
{# --- Informations pratiques. --- #}
            <section class="act-block">
                <h2 class="act-block__title">{{ 'Informations pratiques'|trans }}</h2>
                <hr class="act-block__sep">
                <h3 class="act-block__minititle">{{ 'Ne peuvent pas participer'|trans }}</h3>
                <ul class="act-checklist act-checklist--out">
                    {% for item in detail.cannotParticipate %}
                        <li><span class="act-checklist__mark" aria-hidden="true">✕</span> {{ item }}</li>
                    {% endfor %}
                </ul>
                <h3 class="act-block__minititle">{{ 'Prévoir'|trans }}</h3>
                <ul class="act-bullets">
                    {% for item in detail.toBring %}
                        <li>{{ item }}</li>
                    {% endfor %}
                </ul>
            </section>
            {% endif %}

            {# Masque si vide : une activite peut etre publiee avant que sa fiche editoriale ne soit ecrite. Un encadre vide se verrait plus qu'une section absente. #}
            {% if detail.logistics.meeting or detail.logistics.guarantees %}
{# --- Bloc logistique : carte + rendez-vous + garanties. --- #}
            <section class="act-block" id="logistique">
                <div class="act-logistics">
                    <div class="act-logistics__map">
                        <img src="{{ asset(detail.logistics.map) }}" alt="Carte du lieu de rendez-vous">
                        <div class="act-logistics__map-actions">
                            {% if detail.place %}
                                {# Lien de navigation Google Maps par adresse texte : ne demande ni
                                   clé d'API ni géocodage propre, contrairement à une vraie carte
                                   intégrée. #}
                                <a href="https://www.google.com/maps/dir/?api=1&destination={{ detail.place|url_encode }}" target="_blank" rel="noopener" class="pl-btn pl-btn--primary">{{ 'Itinéraires'|trans }}</a>
                            {% endif %}
                            <a href="{{ path('app_corporate_contact') }}" class="pl-btn pl-btn--outline-action">{{ 'Nous contacter'|trans }}</a>
                        </div>
                    </div>
                    <div class="act-logistics__info">
                        <h3 class="act-block__minititle">{{ 'Lieu de rendez-vous'|trans }}</h3>
                        <ul class="act-meeting">
                            {% for m in detail.logistics.meeting %}
                                <li><strong>{{ m.label }}</strong><span>{{ m.value }}</span></li>
                            {% endfor %}
                        </ul>
                        <ul class="act-guarantees">
                            {% for g in detail.logistics.guarantees %}
                                <li>
                                    <span class="act-guarantees__mark" aria-hidden="true">{{ icon.check_badge(20) }}</span>
                                    <span><strong>{{ g.title }}</strong> {{ g.text }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </section>
            {% endif %}
        </div>

        {# --- Panneau de réservation sticky (spec §F). --- #}
        <aside class="act-booking" aria-label="{{ 'Réserver cette activité'|trans }}">
            {#
                Panneau de réservation (03/10) : vrai formulaire. Dates et
                heures = créneaux ouverts par le professionnel (data-slots) ;
                sans créneau, date libre et horaires d'ouverture. Envoi vers
                BookingController::create → récapitulatif → paiement.
            #}
            {% set draft = booking.draft %}
            {% set adults = draft.adults ?? 2 %}
            {% set children = draft.children ?? 0 %}
            {% set full = booking.price ?? detail.price %}
            {% set unit = promotion is defined and promotion and promotion.kind.value == 'reduction' and promotion.discountPercent and full ? ((full * (100 - promotion.discountPercent)) / 100)|round(2) : full %}
            <form class="act-booking__panel" id="reserver" method="post" action="{{ path('app_booking_create', {slug: activity.slug}) }}"
                  data-booking data-price="{{ unit }}" data-slots="{{ booking.slots|json_encode }}" data-times="{{ booking.times|json_encode }}" data-capacity="{{ booking.capacity }}">
                <input type="hidden" name="_token" value="{{ csrf_token('booking') }}">
                {# Offre en cours du professionnel (espace pro « Offres & Promotions », 02/10). #}
                {% if promotion is defined and promotion %}
                    <p class="act-booking__promo"><b>{{ promotion.badge }}</b> {{ promotion.title }}{% if promotion.subtitle %} — {{ promotion.subtitle }}{% endif %}<small>{{ 'Jusqu’au'|trans }} {{ promotion.endsAt|date('d/m/Y') }}</small></p>
                {% endif %}
                <p class="act-booking__price">{{ 'À partir de'|trans }} {% if unit != full %}<s>{{ full|number_format(full == full|round ? 0 : 2, ',', ' ') }}€</s> {% endif %}<strong>{{ unit|number_format(unit == unit|round ? 0 : 2, ',', ' ') }}€</strong> / {{ 'personne'|trans }}</p>

                <label class="act-booking__field" for="booking-date">
                    <span>{{ 'Date'|trans }}</span>
                    <span class="act-booking__input act-booking__input--control">
                        {{ icon.calendar(18) }}
                        {% if booking.slots is not empty %}
                            <select id="booking-date" name="date" required data-booking-date>
                                <option value="">{{ 'choisissez une date'|trans }}</option>
                                {% for day, times in booking.slots %}
                                    <option value="{{ day }}"{{ draft.date is defined and draft.date == day ? ' selected' }}>{{ day|date('d/m/Y') }}</option>
                                {% endfor %}
                            </select>
                        {% else %}
                            <input id="booking-date" type="date" name="date" required min="{{ 'tomorrow'|date('Y-m-d') }}" max="{{ '+1 year'|date('Y-m-d') }}" value="{{ draft.date ?? '' }}" data-booking-date>
                        {% endif %}
                    </span>
                </label>
                <label class="act-booking__field" for="booking-time">
                    <span>{{ 'Heure'|trans }}</span>
                    <span class="act-booking__input act-booking__input--control">
                        {{ icon.clock(18) }}
                        <select id="booking-time" name="time" required data-booking-time data-selected="{{ draft.time ?? '' }}">
                            <option value="">{{ 'Sélectionner une heure'|trans }}</option>
                            {% if booking.slots is empty %}
                                {% for t in booking.times %}<option value="{{ t }}"{{ (draft.time ?? '') == t ? ' selected' }}>{{ t|replace({':': 'h'}) }}</option>{% endfor %}
                            {% endif %}
                        </select>
                    </span>
                </label>
                {% if booking.slots is empty %}
                    <p class="act-booking__hint">{{ 'L’organisateur confirme votre créneau après la réservation.'|trans }}</p>
                {% endif %}

                <div class="act-booking__travellers">
                    <span class="act-booking__field-label">{{ 'Voyageurs'|trans }}</span>
                    <div class="act-stepper" data-stepper data-min="1" data-count="{{ adults }}">
                        <span>{{ 'Adulte'|trans }} <small>{{ '(18 et +)'|trans }}</small></span>
                        <span class="act-stepper__controls">
                            <button type="button" data-step="-1" aria-label="{{ "Moins d'adultes"|trans }}">{{ icon.minus(14) }}</button>
                            <output data-stepper-value>{{ adults }}</output>
                            <button type="button" data-step="1" aria-label="{{ "Plus d'adultes"|trans }}">{{ icon.plus(14) }}</button>
                        </span>
                        <input type="hidden" name="adults" value="{{ adults }}" data-stepper-input>
                    </div>
                    <div class="act-stepper" data-stepper data-min="0" data-count="{{ children }}">
                        <span>{{ 'Enfants'|trans }} <small>{{ '(0 à 17 ans)'|trans }}</small></span>
                        <span class="act-stepper__controls">
                            <button type="button" data-step="-1" aria-label="{{ "Moins d'enfants"|trans }}">{{ icon.minus(14) }}</button>
                            <output data-stepper-value>{{ children }}</output>
                            <button type="button" data-step="1" aria-label="{{ "Plus d'enfants"|trans }}">{{ icon.plus(14) }}</button>
                        </span>
                        <input type="hidden" name="children" value="{{ children }}" data-stepper-input>
                    </div>
                    <p class="act-booking__hint" data-booking-seats hidden></p>
                </div>

                <p class="act-booking__total">{{ 'Total'|trans }} <strong data-booking-total>{{ unit * (adults + children) }}€</strong></p>

                <button type="submit" class="pl-btn pl-btn--primary pl-btn--block">{{ 'Réservez maintenant'|trans }}</button>
                <p class="act-booking__note"><span aria-hidden="true">✓</span> <strong>{{ 'Annulation gratuite'|trans }}</strong> {{ "Jusqu'à 7 jours avant"|trans }}</p>
            </form>

            <div class="act-booking__gift">
                <h3>{{ "C'est pour offrir ?"|trans }}</h3>
                <p>{{ 'Choisissez le bon cadeau Plaisirs & Loisirs et offrez cette expérience en quelques minutes !'|trans }}</p>
                {# Maquette : bouton violet plein, pleine largeur (et non un contour). #}
                <a href="{{ path('app_gifts_offer') }}" class="pl-btn pl-btn--primary pl-btn--block">{{ 'Offrir maintenant'|trans }}</a>
            </div>
        </aside>
    </div>

    {# ==================================================================
       CE QUE DISENT NOS CLIENTS (fond gris) → ouvre la modale (écran G).
       ================================================================ #}
    <section class="act-section act-section--alt" id="avis">
        <div class="container">
            {# Maquette : titre puis note globale EMPILÉS à gauche, bouton
               « Voir plus d'avis » seul à droite — même disposition que le
               bandeau partagé de Destinations et Cadeaux. #}
            <div class="home-reviews__head">
                <div class="home-reviews__headline">
                    <h2 class="home-section__title dest-reviews__title">{{ 'Ce que disent nos clients'|trans }}</h2>
                    <div class="dest-reviews__score">
                        <span class="dest-reviews__score-label">{{ 'Note globale'|trans }}</span>
                        <span class="home-reviews__score-value">{{ review_score is not null ? review_score|number_format(1, ',') : '—' }}<span>/5</span></span>
                        <span class="home-reviews__stars" aria-hidden="true">{% for i in 1..5 %}<span class="{{ review_score is not null and i <= review_score|round ? 'is-on' : 'is-off' }}">{{ icon.star(18) }}</span>{% endfor %}</span>
                        <span class="home-reviews__score-count">{{ 'Basé sur'|trans }} {{ review_total }} {{ 'avis'|trans }}</span>
                    </div>
                </div>
                {% if review_total > 2 %}<button type="button" class="btn-see-all" data-bs-toggle="modal" data-bs-target="#reviews-modal">{{ "Voir plus d'avis"|trans }}</button>{% endif %}
            </div>
            <div class="home-reviews__grid">
                {% for r in reviews|slice(0, 2) %}
                    {% include 'activity/_review_card.html.twig' with { r: r } %}
                {% else %}
                    <p class="act-noreview">{{ 'Pas encore d’avis sur cette activité : soyez le premier à partager votre expérience après votre participation.'|trans }}</p>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ==================================================================
       AJOUTER UN AVIS (formulaire, spec §F).
       ================================================================ #}
    <section class="act-section">
        <div class="container">
            {# Seule une participation terminée ouvre le formulaire (avis vérifiés). #}
            {% if reviewable %}
                <form class="act-review-form" action="{{ path('app_account_booking_review', {id: reviewable.id}) }}" method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                    <input type="hidden" name="note" value="" data-review-note>
                    <div class="act-review-form__stars" role="radiogroup" aria-label="{{ 'Votre note'|trans }}">
                        {% for i in 1..5 %}
                            <button type="button" class="act-review-form__star" data-rate="{{ i }}" aria-label="{{ i }} {{ (i > 1 ? 'étoiles' : 'étoile')|trans }}">{{ icon.star(28) }}</button>
                        {% endfor %}
                    </div>
                    <h2 class="home-section__title">{{ 'Ajouter un avis'|trans }}</h2>
                    <p class="act-noreview">{{ 'Votre séance du'|trans }} {{ reviewable.startsAt ? reviewable.startsAt|pf_date('d MMMM y') : reviewable.createdAt|pf_date('d MMMM y') }}</p>
                    <textarea name="commentaire" rows="7" maxlength="2000" placeholder="{{ 'Écrivez votre commentaire'|trans }}" aria-label="{{ 'Votre commentaire'|trans }}"></textarea>
                    <button type="submit" class="pl-btn pl-btn--primary">{{ 'Envoyer un avis'|trans }}</button>
                </form>
            {% else %}
                <div class="act-review-form act-review-form--locked">
                    <h2 class="home-section__title">{{ 'Ajouter un avis'|trans }}</h2>
                    <p class="act-noreview">{{ 'Les avis sont réservés aux participants : après votre séance, vous pourrez noter cette activité ici ou depuis « Mes réservations ».'|trans }}</p>
                    <a class="pl-btn pl-btn--primary" href="#reserver">{{ 'Réserver cette activité'|trans }}</a>
                </div>
            {% endif %}
        </div>
    </section>

    {# ==================================================================
       VOUS POURRIEZ AUSSI AIMER…
       ================================================================ #}
    <section class="act-section">
        <div class="container">
            <div class="home-section__head">
                <h2 class="home-section__title">{{ 'Vous pourriez aussi aimer…'|trans }}</h2>
                <a href="{{ path('app_activities') }}" class="btn-see-all">{{ 'Voir toutes les activités'|trans }}</a>
            </div>
            <div class="card-grid">
                {% for a in suggestions %}
                    {% include 'activity/_card.html.twig' with { a: a } %}
                {% endfor %}
            </div>
        </div>
    </section>

    {# Modale « Toutes les photos ». #}
    <div class="modal fade" id="gallery-modal" tabindex="-1" aria-label="{{ 'Toutes les photos'|trans }}">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5">{{ detail.title }}</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Fermer'|trans }}"></button>
                </div>
                <div class="modal-body act-gallery-all">
                    {% for img in detail.gallery %}<img src="{{ asset(img) }}" alt="{{ detail.title }} — photo {{ loop.index }}" loading="lazy">{% endfor %}
                </div>
            </div>
        </div>
    </div>

    {# Modale « Tous les avis » (écran G). #}
    {% include 'activity/_reviews_modal.html.twig' %}
</div>
{% endblock %}
