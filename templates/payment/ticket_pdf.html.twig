{#
    Billet de réservation PDF (20/10), téléchargé par le client pour le jour
    de l'activité : en haut l'essentiel de l'activité, au milieu la facture
    (ou le récapitulatif à régler sur place), en bas le QR à présenter pour
    vérification. Mise en page en tableaux (dompdf), couleurs de la facture.
    Données : InvoiceRenderer::ticketHtml().
#}
{% set client = booking.client %}
{% set service = booking.service %}
{% set paid = payment and payment.paid and payment.invoiceNumber %}
{% set place = service ? (service.meetingPoint ?: service.address ?: service.placeLabel ?: service.city) : null %}
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>{{ 'Billet de réservation'|trans }} #{{ booking.reference }}</title>
<style>
    @page { margin: 16mm 16mm 14mm; }
    body { font-family: "DejaVu Sans", sans-serif; font-size: 10px; color: #0f172a; }
    h1 { margin: 0; font-size: 18px; color: #061b56; }
    h2 { margin: 0 0 8px; font-size: 11.5px; color: #061b56; text-transform: uppercase; letter-spacing: .4px; }
    .muted { color: #64748b; }
    .logo { display: inline-block; padding: 8px 12px; background: #061b56; border-radius: 6px; }
    .meta { text-align: right; }
    .meta p { margin: 2px 0; }
    .block { margin-top: 16px; padding: 14px 16px; border: 1px solid #e5e7eb; border-radius: 8px; }
    .title { margin: 0 0 10px; font-size: 15px; font-weight: bold; color: #0f172a; }
    .facts { width: 100%; border-collapse: collapse; }
    .facts td { width: 50%; padding: 5px 8px 5px 0; vertical-align: top; }
    .facts small { display: block; color: #64748b; font-size: 8.5px; text-transform: uppercase; letter-spacing: .3px; }
    .facts strong { font-size: 10.5px; }
    .lines { width: 100%; border-collapse: collapse; }
    .lines th { padding: 6px 8px; background: #f0eafb; color: #061b56; font-size: 9px; text-align: left; border: 1px solid #e5e7eb; }
    .lines td { padding: 6px 8px; border: 1px solid #e5e7eb; }
    .num, .lines th.num { text-align: right; white-space: nowrap; }
    .total td { font-weight: bold; font-size: 11px; background: #f8fafc; }
    .state { margin-top: 10px; padding: 8px 10px; border-radius: 6px; }
    .state.is-paid { background: #e4f8e8; color: #166534; }
    .state.is-due { background: #fcf0e0; color: #9a5800; }
    .qr { margin-top: 16px; padding: 16px; border: 2px dashed #061b56; border-radius: 10px; text-align: center; }
    .qr img { width: 170px; height: 170px; }
    .qr .ref { margin: 6px 0 0; font-size: 16px; font-weight: bold; letter-spacing: 1px; color: #061b56; }
    .qr .hint { margin: 8px 0 0; font-size: 11px; font-weight: bold; }
    .notes { margin-top: 12px; font-size: 8px; color: #64748b; line-height: 1.5; }
</style>
</head>
<body>
    <table width="100%">
        <tr>
            <td>{% if logo %}<div class="logo"><img src="{{ logo }}" alt="TrouveMoi" height="28"></div>{% else %}<strong>TrouveMoi</strong>{% endif %}</td>
            <td class="meta">
                <h1>{{ 'Billet de réservation'|trans }}</h1>
                <p><strong>{{ 'Réservation'|trans }} :</strong> #{{ booking.reference }}</p>
                <p class="muted">{{ 'Émis le'|trans }} {{ 'now'|date('d/m/Y') }}</p>
            </td>
        </tr>
    </table>

    {# 1. L'essentiel de l'activité #}
    <div class="block">
        <h2>{{ 'Votre activité'|trans }}</h2>
        <p class="title">{{ service ? service.title : (booking.items|first ? (booking.items|first).label : '') }}</p>
        <table class="facts">
            <tr>
                <td><small>{{ 'Date'|trans }}</small><strong>{{ booking.startsAt ? booking.startsAt|pf_date('EEEE d MMMM y')|capitalize : '—' }}</strong></td>
                <td><small>{{ 'Heure'|trans }}</small><strong>{{ booking.startsAt ? booking.startsAt|date('H\\hi') : '—' }}{% if service and service.durationLabel %} <span class="muted">· {{ service.durationLabel }}</span>{% endif %}</strong></td>
            </tr>
            <tr>
                <td><small>{{ 'Lieu'|trans }}</small><strong>{{ place ?: '—' }}</strong>{% if service and service.city and place != service.city %}<br><span class="muted">{{ service.city }}</span>{% endif %}</td>
                <td><small>{{ 'Participants'|trans }}</small><strong>{{ booking.participants }} {{ booking.participants > 1 ? 'personnes'|trans : 'personne'|trans }}</strong></td>
            </tr>
            <tr>
                <td><small>{{ 'Réservé par'|trans }}</small><strong>{{ client.firstName }} {{ client.lastName }}</strong><br><span class="muted">{{ client.email }}{% if client.phone %} · {{ client.phone }}{% endif %}</span></td>
                <td><small>{{ 'Organisateur'|trans }}</small><strong>{{ provider ? provider.displayName : '—' }}</strong>{% if provider and provider.user %}<br><span class="muted">{{ provider.user.email }}{% if provider.user.phone %} · {{ provider.user.phone }}{% endif %}</span>{% endif %}</td>
            </tr>
        </table>
    </div>

    {# 2. Facture (ou récapitulatif à régler sur place) #}
    <div class="block">
        <h2>{{ paid ? 'Facture'|trans ~ ' ' ~ payment.invoiceNumber : 'Récapitulatif'|trans }}</h2>
        <table class="lines">
            <thead><tr><th>{{ 'Description'|trans }}</th><th class="num">{{ 'Quantité'|trans }}</th><th class="num">{{ 'Prix unitaire'|trans }}</th><th class="num">{{ 'Total'|trans }}</th></tr></thead>
            <tbody>
                {% for item in booking.items %}
                    <tr>
                        <td>{{ item.label }}</td>
                        <td class="num">{{ item.quantity }}</td>
                        <td class="num">{{ item.unitPrice|number_format(2, ',', ' ') }} €</td>
                        <td class="num">{{ (item.unitPrice * item.quantity)|number_format(2, ',', ' ') }} €</td>
                    </tr>
                {% endfor %}
                <tr class="total"><td colspan="3" class="num">{{ 'Total TTC'|trans }}</td><td class="num">{{ booking.totalPrice|number_format(2, ',', ' ') }} €</td></tr>
            </tbody>
        </table>
        {% if paid %}
            <div class="state is-paid">
                <strong>{{ 'Payé'|trans }}</strong> — {{ (payment.paidAt ?? payment.updatedAt)|date('d/m/Y à H:i') }} ·
                {% if payment.method == 'card' %}{{ 'Carte bancaire'|trans }}{% if payment.cardLast4 %} {{ payment.cardBrand|capitalize }} **** {{ payment.cardLast4 }}{% endif %}{% elseif payment.method %}{{ payment.methodLabel|trans }}{% endif %}
            </div>
        {% else %}
            <div class="state is-due"><strong>{{ 'À régler sur place'|trans }}</strong> — {{ 'le jour de l’activité, directement à l’organisateur.'|trans }}</div>
        {% endif %}
    </div>

    {# 3. QR à présenter #}
    <div class="qr">
        <img src="{{ qr }}" alt="QR">
        <p class="ref">#{{ booking.reference }}</p>
        <p class="hint">{{ 'À présenter à l’organisateur le jour de l’activité pour vérification de votre réservation.'|trans }}</p>
        <p class="muted">{{ 'Sur téléphone ou imprimé. L’organisateur scanne ce QR code ou saisit le code de réservation.'|trans }}</p>
    </div>

    <p class="notes">{{ 'Le paiement a été effectué directement auprès du prestataire, seul vendeur de la prestation. TrouveMoi (trouvemoi.eu), plateforme de mise en relation, n’encaisse aucune somme et ne prélève aucune commission sur cette réservation.'|trans }}</p>
</body>
</html>
