{#
    Rapport des réservations, mis en page pour l'impression (« Télécharger
    le rapport » → Enregistrer en PDF depuis la boîte d'impression).
#}
<!doctype html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="utf-8">
    <title>{{ 'Rapport des réservations'|trans }} — {{ provider.displayName }}</title>
    <style>
        body { font: 14px/1.5 system-ui, sans-serif; color: #0b1437; margin: 32px; }
        h1 { font-size: 22px; margin: 0 0 4px; }
        .muted { color: #6b6f85; }
        .kpis { display: flex; gap: 16px; margin: 24px 0; }
        .kpis div { flex: 1; border: 1px solid #e3e5ec; border-radius: 8px; padding: 12px 16px; }
        .kpis strong { display: block; font-size: 20px; }
        table { width: 100%; border-collapse: collapse; margin-top: 16px; font-size: 13px; }
        th, td { padding: 8px; border-bottom: 1px solid #eceef3; text-align: left; }
        th { background: #f6f7fb; }
        .actions { margin-bottom: 24px; }
        @media print { .actions { display: none; } body { margin: 0; } }
    </style>
</head>
<body>
    <p class="actions"><button onclick="window.print()">{{ 'Imprimer / Enregistrer en PDF'|trans }}</button></p>
    <h1>{{ 'Rapport des réservations'|trans }}</h1>
    <p class="muted">{{ provider.displayName }} · {{ 'du'|trans }} {{ from|pf_date('d MMMM y') }} {{ 'au'|trans }} {{ to|pf_date('d MMMM y') }}</p>

    <div class="kpis">
        <div><span class="muted">{{ 'Réservations'|trans }}</span><strong>{{ bookings|length }}</strong></div>
        <div><span class="muted">{{ 'Revenus encaissés'|trans }}</span><strong>{{ money.gross|number_format(2, ',', ' ') }} €</strong></div>
        <div><span class="muted">{{ 'Commission TrouveMoi'|trans }}</span><strong>-{{ money.commission|number_format(2, ',', ' ') }} €</strong></div>
        <div><span class="muted">{{ 'Montant net'|trans }}</span><strong>{{ money.net|number_format(2, ',', ' ') }} €</strong></div>
    </div>

    <p>{% for label, n in by_status %}{% if n > 0 %}<strong>{{ label|trans }}</strong> : {{ n }}{% if not loop.last %} · {% endif %}{% endif %}{% endfor %}</p>

    <table>
        <thead><tr><th>{{ 'Réf.'|trans }}</th><th>{{ 'Réservée le'|trans }}</th><th>{{ 'Client'|trans }}</th><th>{{ 'Activité'|trans }}</th><th>{{ 'Séance'|trans }}</th><th>{{ 'Pers.'|trans }}</th><th>{{ 'Montant'|trans }}</th><th>{{ 'Statut'|trans }}</th></tr></thead>
        <tbody>
            {% for b in bookings %}
                <tr>
                    <td>#{{ b.reference }}</td>
                    <td>{{ b.createdAt|date('d/m/Y') }}</td>
                    <td>{{ b.client.firstName }} {{ b.client.lastName }}</td>
                    <td>{{ b.service.title }}</td>
                    <td>{{ b.startsAt ? b.startsAt|date('d/m/Y H:i') : '—' }}</td>
                    <td>{{ b.participants }}</td>
                    <td>{{ b.totalPrice|number_format(2, ',', ' ') }} €</td>
                    <td>{{ b.status.label|trans }}</td>
                </tr>
            {% else %}
                <tr><td colspan="8" class="muted">{{ 'Aucune réservation sur la période.'|trans }}</td></tr>
            {% endfor %}
        </tbody>
    </table>
</body>
</html>
