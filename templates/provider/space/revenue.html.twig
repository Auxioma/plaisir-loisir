{#
    Revenus & Paiements — maquette profil_Revenus&Paiements_professionnel.jpeg
    (02/10). Données : ProviderRevenueController::index().
#}
{% extends 'provider/space/_layout.html.twig' %}
{% import 'provider/space/_ui.html.twig' as ui %}
{% import 'provider/space/_ico.html.twig' as ico %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Revenus & Paiements'|trans }}{% endblock %}

{% block space %}
    <header class="pf-head pp-head">
        <div>
            <h1 class="pf-title">{{ 'Revenus & Paiements'|trans }} <span class="pp-title-ico">{{ icon.card(24) }}</span></h1>
            <p class="pf-sub">{{ 'Vos clients vous règlent directement : suivez les règlements reçus et attendus. TrouveMoi ne prélève aucune commission.'|trans }}</p>
        </div>
    </header>

    <form method="get" class="pp-periods">
        <input type="hidden" name="par" value="{{ granularity }}">
        <label class="pp-period-box"><small>{{ 'Période'|trans }}</small>
            <select name="mois" onchange="this.form.submit()">{% for m in months %}<option value="{{ m|date('Y-m') }}"{{ m|date('Y-m') == month|date('Y-m') ? ' selected' }}>{{ m|pf_date('MMMM y')|capitalize }}</option>{% endfor %}</select>
        </label>
        <label class="pp-period-box"><small>{{ 'Comparer à'|trans }}</small>
            <select name="comparer" onchange="this.form.submit()">{% for m in months %}<option value="{{ m|date('Y-m') }}"{{ m|date('Y-m') == compare|date('Y-m') ? ' selected' }}>{{ m|pf_date('MMMM y')|capitalize }}</option>{% endfor %}</select>
        </label>
        <a class="pf-btn pp-btn-ghost pp-push" href="{{ path('app_pro_revenue_export') }}">{{ icon.download(16) }} {{ 'Exporter le rapport'|trans }}</a>
    </form>

    {% set vs = 'vs ' ~ compare|pf_date('MMMM y') %}
    <div class="pp-tiles pp-tiles--4">
        {{ ui.tile('Revenus reçus', ui.money(tiles.gross.value), 'green', 'wallet', tiles.gross.trend, vs) }}
        {{ ui.tile('Réservations réglées', tiles.count.value, 'blue', 'calendar', tiles.count.trend, vs) }}
        {{ ui.tile('Panier moyen', ui.money(tiles.avg.value), 'orange', 'bag', tiles.avg.trend, vs) }}
        {{ ui.tile('À régler par vos clients', ui.money(tiles.pending.value), 'violet', 'doc', null, tiles.pending.count ~ ' ' ~ (tiles.pending.count > 1 ? 'règlements' : 'règlement')) }}
    </div>

    <section class="pf-card">
        <div class="pf-card__head">
            <h2 class="pf-card__title">{{ 'Évolution des revenus'|trans }}</h2>
            <form method="get" class="pf-select pf-select--sm">
                <input type="hidden" name="mois" value="{{ month|date('Y-m') }}"><input type="hidden" name="comparer" value="{{ compare|date('Y-m') }}">
                <select name="par" onchange="this.form.submit()" aria-label="{{ 'Granularité'|trans }}">
                    <option value="jour"{{ granularity == 'jour' ? ' selected' }}>{{ 'Par jour'|trans }}</option>
                    <option value="semaine"{{ granularity == 'semaine' ? ' selected' }}>{{ 'Par semaine'|trans }}</option>
                </select>
            </form>
        </div>
        <div class="pp-legend">
            <span><i style="background:#2f5be7"></i>{{ month|pf_date('MMMM y')|capitalize }}</span>
            <span><i class="is-dashed"></i>{{ compare|pf_date('MMMM y')|capitalize }}</span>
        </div>
        {% set labels = [] %}
        {% if granularity == 'jour' %}
            {% for d in [1, 6, 11, 16, 21, 26, month|date('t')] %}{% set labels = labels|merge([d ~ ' ' ~ month|pf_date('MMM')|trim('.')]) %}{% endfor %}
        {% else %}
            {% for k in 1..(series|length) %}{% set labels = labels|merge(['Sem. ' ~ k]) %}{% endfor %}
        {% endif %}
        {{ ui.line([{values: compare_series, color: '#a9b0c4', dashed: true}, {values: series, color: '#2f5be7', area: true}], labels, '€', 170) }}
    </section>

    <section class="pf-card pf-table-wrap">
        <div class="pf-card__head pp-pad"><h2 class="pf-card__title">{{ show_all ? 'Tous les règlements'|trans : 'Règlements récents'|trans }}</h2></div>
        {% if transactions is empty %}
            <p class="pf-empty">{{ 'Aucun règlement pour le moment.'|trans }}</p>
        {% else %}
            <table class="pf-table pp-table">
                <thead><tr><th>{{ 'Date'|trans }}</th><th>{{ 'Réservation'|trans }}</th><th>{{ 'Activité'|trans }}</th><th>{{ 'Client'|trans }}</th><th>{{ 'Montant'|trans }}</th><th>{{ 'Statut'|trans }}</th><th>{{ 'Moyen'|trans }}</th><th></th></tr></thead>
                <tbody>
                    {% for p in transactions %}
                        {% set b = p.booking %}
                        <tr>
                            <td>{{ p.createdAt|pf_date('d MMM y')|trim('.') }}<small>{{ p.createdAt|date('H:i') }}</small></td>
                            <td><a class="pp-strong" href="{{ path('app_pro_booking_show', {id: b.id}) }}">#{{ b.reference }}</a></td>
                            <td><div class="pf-table__item pp-mini-item"><img src="{{ asset(b.service|pp_cover) }}" alt="" loading="lazy" decoding="async"><span>{{ b.service.title }}</span></div></td>
                            <td><div class="pp-client">{{ ui.avatar(b.client, 28) }}<span>{{ b.client.firstName }} {{ b.client.lastName }}</span></div></td>
                            <td><strong class="pp-strong">{{ ui.money(p.amount) }}</strong></td>
                            <td>{% set st = {pending: ['À régler', 'orange'], paid: ['Réglé', 'green'], failed: ['Échoué', 'red'], refunded: ['Remboursé', 'grey']}[p.status.value] %}<span class="pf-pill pf-pill--{{ st[1] }} pp-pill">{{ st[0]|trans }}</span></td>
                            <td class="pp-paytype">{% if p.method == 'paypal' %}{{ icon.pay_paypal() }} PayPal{% elseif p.method == 'transfer' %}{{ icon.building(16) }} {{ 'Virement'|trans }}{% elseif p.method %}{{ icon.card(16) }} {{ p.methodLabel|trans }}{% else %}<span class="pf-muted">—</span>{% endif %}</td>
                            <td>
                                <details class="pl-dropdown pf-kebab">
                                    <summary aria-label="{{ 'Actions'|trans }}">{{ icon.dots(18) }}</summary>
                                    <div class="tm-menu tm-menu--right">
                                        <a class="tm-menu__item" href="{{ path('app_pro_booking_show', {id: b.id}) }}">{{ 'Détail du paiement'|trans }}</a>
                                        {% if p.invoiceNumber %}<a class="tm-menu__item" href="{{ path('app_pro_booking_invoice', {id: b.id, telecharger: 1}) }}">{{ 'Télécharger la facture'|trans }}</a>{% endif %}
                                        <a class="tm-menu__item" href="{{ path('app_pro_messages', {client: b.client.id}) }}">{{ 'Contacter le client'|trans }}</a>
                                        <a class="tm-menu__item" href="{{ path('app_pro_support', {sujet: 'Paiement #' ~ b.reference}) }}#ticket">{{ 'Signaler un problème'|trans }}</a>
                                    </div>
                                </details>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
        {% if show_all %}
            <div class="pp-pad">{{ ui.pager(page, pages, transactions|length, total_transactions, 'transactions') }}</div>
        {% elseif total_transactions > 5 %}
            <a class="pf-link pp-arrow pp-pad" href="{{ path('app_pro_revenue', {toutes: 1, mois: month|date('Y-m'), comparer: compare|date('Y-m')}) }}">{{ 'Voir tous les règlements'|trans }} {{ icon.arrow_right(16) }}</a>
        {% endif %}
    </section>
{% endblock %}

{% block space_aside %}
    <section class="pf-card">
        <h2 class="pf-card__title pp-mb">{{ 'Résumé'|trans }} <small class="pf-muted">· {{ month|pf_date('MMMM y') }}</small></h2>
        <dl class="pp-kvs">
            <div><dt>{{ 'Règlements reçus'|trans }}</dt><dd>{{ ui.money(gross) }}</dd></div>
            <div><dt>{{ 'Commission TrouveMoi'|trans }}</dt><dd>{{ ui.money(0) }}</dd></div>
            <div class="pp-kvs__total"><dt>{{ 'Vous percevez'|trans }}</dt><dd class="is-green">{{ ui.money(gross) }}</dd></div>
        </dl>
        <p class="pf-muted">{{ 'Vos clients vous paient directement : les sommes arrivent sur vos propres comptes, sans passer par TrouveMoi. Une fois le règlement reçu, marquez la réservation « réglée » dans Réservations.'|trans }}</p>
        <a class="pf-btn pf-btn--block pp-soft-btn" href="{{ path('app_pro_revenue_export') }}">{{ ico.svg('chart', 16) }} {{ 'Exporter mes règlements'|trans }}</a>
    </section>

    <section class="pf-card">
        <h2 class="pf-card__title pp-mb">{{ 'Moyens de paiement proposés'|trans }}</h2>
        <ul class="pf-list">
            {% for m in payment_methods %}
                <li><span class="pf-ico pf-ico--xs pf-ico--blue">{{ m.type == 'paypal' ? icon.pay_paypal() : (m.type == 'onsite' ? icon.map_pin(16) : (m.type == 'online' ? icon.globe(16) : icon.card(16))) }}</span><div class="pf-list__body"><strong>{{ m.label|trans }}</strong><small class="{{ m.state == 'active' ? 'is-green' : '' }}">{{ {active: 'Activé', pending: 'À finaliser', off: 'Désactivé'}[m.state]|trans }}</small></div></li>
            {% endfor %}
        </ul>
        <a class="pf-btn pf-btn--block pp-soft-btn" href="{{ path('app_pro_settings', {section: 'paiement'}) }}">{{ icon.gear(16) }} {{ 'Gérer mes moyens de paiement'|trans }}</a>
    </section>
{% endblock %}
