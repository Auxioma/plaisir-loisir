{#
    Fil d'un ticket support (réponses de l'équipe depuis le back-office).
    Données : ProviderSupportController::show().
#}
{% extends 'provider/space/_layout.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ ticket.reference }} — {{ 'Support'|trans }}{% endblock %}

{% block space %}
    <header class="pf-head pp-head">
        <div>
            <a class="pp-back" href="{{ path('app_pro_support') }}#tickets">{{ icon.arrow_left(16) }} {{ 'Mes tickets'|trans }}</a>
            <h1 class="pf-title">{{ ticket.reference }} · {{ ticket.subject }}</h1>
            <p class="pf-sub">{{ ticket.category.label|trans }} · <span class="pf-pill pf-pill--{{ ticket.status.tone }}">{{ ticket.status.label|trans }}</span>{% if ticket.phone %} · {{ icon.phone(14) }} {{ ticket.phone }}{% endif %}</p>
        </div>
        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
            {% if ticket.status.value in ['resolved', 'closed'] %}
                <button class="pf-btn pp-btn-ghost" name="action" value="reopen">{{ 'Rouvrir le ticket'|trans }}</button>
            {% else %}
                <button class="pf-btn pp-btn-ghost" name="action" value="close">{{ 'Fermer le ticket'|trans }}</button>
            {% endif %}
        </form>
    </header>

    <section class="pf-card pp-inbox__thread pp-ticket">
        <div class="pp-chat">
            {% for m in ticket.messages %}
                {% set mine = not m.fromStaff %}
                <div class="pp-msg{{ mine ? ' is-mine' }}">
                    {% if not mine %}<span class="pp-avatar pp-avatar--initials" style="width:30px;height:30px;font-size:11px">TM</span>{% endif %}
                    <div class="pp-msg__bubble">
                        {% if not mine %}<strong class="pp-msg__who">{{ 'Équipe TrouveMoi'|trans }}</strong>{% endif %}
                        <p>{{ m.body|nl2br }}</p>
                        <small>{{ m.createdAt|pf_date('d MMM')|trim('.') }} · {{ m.createdAt|date('H:i') }}</small>
                    </div>
                </div>
            {% endfor %}
            {% if ticket.messages|filter(m => m.fromStaff) is empty %}
                <p class="pf-muted pp-center">{{ 'Un conseiller vous répond ici, en général en moins de 2 h (lun.–ven., 9h–18h). Vous recevrez une notification.'|trans }}</p>
            {% endif %}
            <span id="fin"></span>
        </div>
        <form method="post" class="pp-composer">
            <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
            <input type="hidden" name="action" value="reply">
            <label class="visually-hidden" for="pp-body">{{ 'Votre message'|trans }}</label>
            <textarea id="pp-body" name="message" rows="1" placeholder="{{ 'Écrire un message…'|trans }}" required data-pp-autosend></textarea>
            <button class="pp-composer__send" aria-label="{{ 'Envoyer'|trans }}">{{ icon.send(20) }}</button>
        </form>
    </section>
{% endblock %}
