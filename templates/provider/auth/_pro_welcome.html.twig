{#
    Colonne d'accueil des écrans professionnels (pas de maquette : repris du
    modèle connexion_particulier.jpeg, avec les arguments de la carte
    « Pro Prestataire » de l'écran de choix du compte).
#}
{% import '_partials/_icons.html.twig' as icon %}
<p class="tm-login__eyebrow">{{ 'Espace professionnel'|trans }}</p>
<h1 class="tm-login__title">
    {{ 'Développez votre activité avec'|trans }}<br>
    TrouveMoi <span class="is-plaisirs">Plaisirs</span> &amp; <span class="is-loisirs">Loisirs</span>
</h1>
<p class="tm-login__lead">
    {{ 'Commercialisez vos prestations, gérez vos réservations'|trans }}<br>
    {{ 'et gagnez en visibilité auprès de nouveaux clients.'|trans }}
</p>
<ul class="tm-login__feats">
    <li>
        <span class="tm-login__feat-icon">{{ icon.target_frame(26) }}</span>
        <span><strong>{{ 'Vendez vos activités payantes'|trans }}</strong>{{ 'Publiez vos prestations, vos tarifs et vos disponibilités.'|trans }}</span>
    </li>
    <li>
        <span class="tm-login__feat-icon">{{ icon.calendar_grid(26) }}</span>
        <span><strong>{{ 'Gérez réservations et paiements'|trans }}</strong>{{ 'Suivez vos réservations, vos clients et vos revenus.'|trans }}</span>
    </li>
    <li>
        <span class="tm-login__feat-icon">{{ icon.chart_frame(26) }}</span>
        <span><strong>{{ 'Développez votre visibilité'|trans }}</strong>{{ 'Recevez plus de demandes et fidélisez vos clients.'|trans }}</span>
    </li>
</ul>
