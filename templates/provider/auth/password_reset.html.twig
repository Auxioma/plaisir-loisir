{#
    Nouveau mot de passe — étape 3/3.

    CET ÉCRAN N'EST PAS DANS LA MAQUETTE PROFESSIONNELLE, qui s'arrête à la vue
    OTP. Sans lui, « Réinitialisation du mot de passe » vérifie un code puis ne
    réinitialise rien. Il reprend donc exactement le gabarit des deux écrans
    précédents — même pastille, même carte, même bouton — sans rien inventer.
#}
{% extends 'provider/auth/_aside.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Nouveau mot de passe'|trans }}{% endblock %}

{% block pa_card %}
    <div class="pa-card pa-card--pw">
        {% include 'provider/auth/_lock.html.twig' %}

        <h1 class="pa-card__title">{{ 'Nouveau mot de passe'|trans }}</h1>
        <p class="pa-card__lead">{{ 'Choisissez un mot de passe d’au moins 8 caractères, puis saisissez-le une seconde fois.'|trans }}</p>

        <form class="pa-form" method="post" action="{{ path('app_pro_forgot_password_reset') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">

            <div class="pa-field">
                <label class="pa-label" for="proNewPassword">{{ 'Mot de passe'|trans }}</label>
                <div class="pa-input-wrap" data-controller="password-toggle">
                    <input id="proNewPassword" class="pa-input pa-input--eye" type="password" name="password"
                           data-password-toggle-target="input" placeholder="{{ 'Entrer votre mot de passe'|trans }}"
                           autocomplete="new-password" required minlength="8">
                    <button type="button" class="pa-input__eye" data-action="password-toggle#toggle"
                            aria-label="{{ 'Afficher ou masquer le mot de passe'|trans }}">
                        <span data-password-toggle-target="show">{{ icon.eye() }}</span>
                        <span data-password-toggle-target="hide" hidden>{{ icon.eye_off() }}</span>
                    </button>
                </div>
            </div>

            <div class="pa-field">
                <label class="pa-label" for="proConfirmPassword">{{ 'Confirmer le mot de passe'|trans }}</label>
                <div class="pa-input-wrap" data-controller="password-toggle">
                    <input id="proConfirmPassword" class="pa-input pa-input--eye" type="password" name="passwordConfirm"
                           data-password-toggle-target="input" placeholder="{{ 'Entrer votre mot de passe'|trans }}"
                           autocomplete="new-password" required minlength="8">
                    <button type="button" class="pa-input__eye" data-action="password-toggle#toggle"
                            aria-label="{{ 'Afficher ou masquer le mot de passe'|trans }}">
                        <span data-password-toggle-target="show">{{ icon.eye() }}</span>
                        <span data-password-toggle-target="hide" hidden>{{ icon.eye_off() }}</span>
                    </button>
                </div>
            </div>

            <button type="submit" class="pa-btn">{{ 'Valider'|trans }}</button>
        </form>
    </div>
{% endblock %}
