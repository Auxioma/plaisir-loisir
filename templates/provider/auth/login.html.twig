{#
    Connexion professionnelle — pas de maquette dédiée : reprend le modèle
    de la connexion particulier (30/09). Anciennement Figma 955:90119.

    LA MAQUETTE EN PROPOSE DEUX. Celle-ci, avec la bande latérale des
    avantages, est celle que le client a retenue ; la « proposition 1 »
    (955:90010), sans bande, est écartée.

    Le formulaire poste sur /login comme celui des clients : il n'y a qu'un
    pare-feu, donc qu'un seul `check_path`. Deux champs cachés font toute la
    différence :
      · `_failure_path` — sinon un mot de passe erroné renverrait le
        professionnel sur l'écran de connexion CLIENT (le gestionnaire d'échec
        de Symfony retombe sur `login_path`) ;
      · `_csrf_token` — jeton « authenticate », attendu par form_login.

#}
{% extends 'provider/auth/_aside.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Connexion professionnelle'|trans }}{% endblock %}

{% block pa_card %}
    <h2 class="tm-login__card-title">{{ 'Connexion'|trans }}</h2>
    <p class="tm-login__card-sub">{{ 'Accédez à votre espace professionnel'|trans }}</p>

    <form class="tm-login__form" method="post" action="{{ path('app_login') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <input type="hidden" name="_failure_path" value="{{ path('app_pro_login') }}">

        {% if error %}
            <div class="tm-login__alert" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <label class="tm-login__label" for="proEmail">{{ 'Adresse e-mail professionnelle'|trans }}</label>
        <div class="tm-login__input">
            {{ icon.mail(20) }}
            <input id="proEmail" type="email" name="_email" value="{{ last_username }}"
                   placeholder="{{ 'votre@entreprise.com'|trans }}" autocomplete="email" required>
        </div>

        <label class="tm-login__label" for="proPassword">{{ 'Mot de passe'|trans }}</label>
        <div class="tm-login__input" data-controller="password-toggle">
            {{ icon.padlock(20) }}
            <input id="proPassword" type="password" name="_password" data-password-toggle-target="input"
                   placeholder="•••••••••••••" autocomplete="current-password" required>
            <button type="button" class="tm-login__eye" data-action="password-toggle#toggle" aria-label="{{ 'Afficher ou masquer le mot de passe'|trans }}">
                <span data-password-toggle-target="show">{{ icon.eye(20) }}</span>
                <span data-password-toggle-target="hide" hidden>{{ icon.eye_off(20) }}</span>
            </button>
        </div>

        <a class="tm-login__forgot" href="{{ path('app_pro_forgot_password') }}">{{ 'Mot de passe oublié ?'|trans }}</a>

        <button type="submit" class="tm-login__submit">{{ 'Se connecter'|trans }}</button>
    </form>

    {# Passe par l'écran de choix : le visiteur y revoit les deux profils
       avant de s'inscrire (demande du 30/09). #}
    <p class="tm-login__signup">
        {{ "Vous n'avez pas encore de compte professionnel ?"|trans }}<br>
        <a href="{{ path('app_auth_choice') }}">{{ "S'inscrire maintenant"|trans }}</a>
    </p>

    <p class="tm-login__switch">
        {{ 'Vous êtes un particulier ?'|trans }}
        <a href="{{ path('app_login') }}">{{ 'Connexion particulier'|trans }}</a>
    </p>
{% endblock %}
