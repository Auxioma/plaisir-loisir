{#
    Coquille du parcours d'inscription professionnel : informations
    générales, documents, félicitations.

    Refondue le 30/09 sur le modèle de la connexion particulier
    (security/_tm_shell.html.twig) : discours pro à gauche, carte à droite
    avec le fil des deux étapes. Plus de panneau « Plaisirs & Loisirs » ni de
    logo dans la carte : l'en-tête et le pied de page communs sont affichés.

#}
{% extends 'security/_tm_shell.html.twig' %}

{% block tm_variant %}pro{% endblock %}

{% block tm_welcome %}
    {% include 'provider/auth/_pro_welcome.html.twig' %}
{% endblock %}

{% block tm_card %}
    <h2 class="tm-login__card-title">{{ 'Inscription'|trans }}</h2>
    <p class="tm-login__card-sub">{{ 'Merci de renseigner vos informations afin de créer votre service gratuitement'|trans }}</p>

    {# Fil des deux étapes. `step` vaut 1, 2 ou 3 ; au troisième écran les
       deux étapes sont franchies. #}
    {% set step = step|default(1) %}
    <ol class="pa-steps">
        <li class="pa-step{{ step >= 1 ? ' is-done' }}">
            <span class="pa-step__badge">{{ include('provider/auth/_icon_document.html.twig') }}</span>
            <span class="pa-step__label"><b>1-</b> {{ 'Informations générales'|trans }}</span>
        </li>
        <li class="pa-steps__sep" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none"><path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </li>
        <li class="pa-step{{ step >= 2 ? ' is-done' }}">
            <span class="pa-step__badge">{{ include('provider/auth/_icon_document.html.twig') }}</span>
            <span class="pa-step__label"><b>2-</b> {{ 'Documents'|trans }}</span>
        </li>
    </ol>

    {% block pa_signup %}{% endblock %}
{% endblock %}
