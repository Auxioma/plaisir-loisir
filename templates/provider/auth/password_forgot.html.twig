{#
    Réinitialisation du mot de passe, étape 1/3 — Figma 955:90335.
    « Recevoir le code » déclenche l'envoi ; l'écran suivant vérifie le code.
#}
{% extends 'provider/auth/_aside.html.twig' %}

{% block title %}{{ 'Réinitialisation du mot de passe'|trans }}{% endblock %}

{% block pa_card %}
    <div class="pa-card pa-card--pw">
        {% include 'provider/auth/_lock.html.twig' %}

        <h1 class="pa-card__title">{{ 'Réinitialisation du mot de passe'|trans }}</h1>
        <p class="pa-card__lead">{{ 'Mot de passe oublié ? Merci de renseigner votre email et nous vous enverrons un code de vérification'|trans }}</p>

        <form class="pa-form" method="post" action="{{ path('app_pro_forgot_password') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">

            <div class="pa-field">
                <label class="pa-label" for="proResetEmail">{{ 'Email'|trans }}</label>
                <input id="proResetEmail" class="pa-input" type="email" name="email"
                       value="{{ email }}" placeholder="{{ 'Entrer votre mail'|trans }}"
                       autocomplete="email" required>
            </div>

            <button type="submit" class="pa-btn">{{ 'Recevoir le code'|trans }}</button>
        </form>

        <p class="pa-switch">
            <a href="{{ path('app_pro_login') }}">{{ 'Retour à la connexion'|trans }}</a>
        </p>
    </div>
{% endblock %}
