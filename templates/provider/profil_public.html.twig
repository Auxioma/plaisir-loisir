{#
    Fiche publique d'un professionnel vérifié (§5, §9 du CDC) — refonte du
    05/10 : couverture, identité, chiffres réels (ProviderDirectory::card),
    activités réservables, avis publiés avec réponses, carte.
    « Demander un devis » ouvre le formulaire de demande pré-rempli avec son
    métier : la demande reste ouverte à tous les prestataires de ce métier
    (marché d'appels d'offres, voir ServiceRequestVoter et QuoteService) ;
    « Contacter » ouvre une conversation directe avec lui.
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ provider.displayName }}{% endblock %}
{% block meta_description %}{{ provider.displayName }}{{ provider.city ? ' — ' ~ provider.city }} : {{ 'activités, avis et contact.'|trans }}{% endblock %}

{% block body %}
<div class="pg pdp">
    <div class="pg-wrap pdp-wrap">
        <nav class="lg2-crumb act-breadcrumb" aria-label="{{ "Fil d'Ariane"|trans }}"><a href="{{ path('app_home') }}">{{ 'Accueil'|trans }}</a> <span>/</span> <a href="{{ path('app_provider_search') }}">{{ 'Professionnels'|trans }}</a> <span>/</span> <span aria-current="page">{{ provider.displayName }}</span></nav>

        {# En-tête au modèle du profil membre (13/10) : couverture, photo en
           chevauchement, identité, note, actions. Styles : member.css (.mb-head). #}
        <header class="mb-head pdp-head">
            <div class="mb-head__cover">{% if card.cover %}<img src="{{ asset(card.cover) }}" alt="" fetchpriority="high">{% endif %}</div>
            <div class="mb-head__body">
                {% if card.avatar %}<img class="mb-head__avatar" src="{{ asset(card.avatar) }}" alt="" width="160" height="160">{% else %}<span class="mb-head__avatar pdp-head__initial" aria-hidden="true">{{ provider.displayName|first|upper }}</span>{% endif %}
                <div class="mb-head__id">
                    <h1>{{ provider.displayName }} <span class="mb-verified" title="{{ 'Professionnel vérifié'|trans }}">{{ icon.badge_check(22) }}</span></h1>
                    <p class="mb-head__meta">
                        {% if card.category %}<span>{{ icon.tag(16) }} {{ card.category|trans }}</span>{% endif %}
                        {% if provider.city %}<span>{{ icon.map_pin(16) }} {{ provider.city }}</span>{% endif %}
                        {% if summary.since %}<span>{{ icon.calendar(16) }} {{ 'Sur TrouveMoi depuis'|trans }} {{ summary.since|pf_date('MMMM y') }}</span>{% endif %}
                    </p>
                    <p class="mb-chips">
                        <span class="mb-chip is-green">{{ icon.check_badge(14) }} {{ 'Professionnel vérifié'|trans }}</span>
                        {% if provider.companyName %}<span class="mb-chip">{{ icon.building(14) }} {{ provider.companyName }}</span>{% endif %}
                        <span class="mb-chip">{{ summary.activities }} {{ (summary.activities > 1 ? 'activités' : 'activité')|trans }}</span>
                        {% if card.priceFrom is not null %}<span class="mb-chip">{{ 'À partir de'|trans }} {{ card.priceFrom|number_format(card.priceFrom == card.priceFrom|round ? 0 : 2, ',', ' ') }} €</span>{% endif %}
                    </p>
                </div>
                <div class="mb-head__score{{ summary.rating is null ? ' is-new' }}">
                    {% if summary.rating is not null %}
                        <strong>{{ icon.star_solid(26) }} {{ summary.rating|number_format(1, ',') }} <small>/ 5</small></strong>
                        <span>{{ summary.reviews_count }} {{ 'avis'|trans }}{% if summary.positive_rate is not null %} · {{ summary.positive_rate }} % {{ 'positifs'|trans }}{% endif %}</span>
                    {% else %}
                        <strong>{{ icon.star_solid(20) }} {{ 'Nouveau professionnel'|trans }}</strong>
                        <span>{{ 'Pas encore d’avis'|trans }}</span>
                    {% endif %}
                </div>
                <div class="mb-head__actions">
                    <a class="mb-btn mb-btn--primary" href="#activites">{{ icon.calendar_check(18) }} {{ 'Réserver une activité'|trans }}</a>
                    {% if app.user and app.user != provider.user %}
                        <form method="post" action="{{ path('app_account_messages_start', {slug: provider.slug}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                            <button type="submit" class="mb-btn">{{ icon.chat_bubble(18) }} {{ 'Envoyer un message'|trans }}</button>
                        </form>
                    {% elseif not app.user %}
                        <a class="mb-btn" href="{{ path('app_login', {_target_path: app.request.requestUri}) }}">{{ icon.chat_bubble(18) }} {{ 'Envoyer un message'|trans }}</a>
                    {% endif %}
                    <a class="pg-link pdp-head__quote" href="{{ path('app_account_requests_new', provider.mainCategory ? {metier: provider.mainCategory.slug} : {}) }}">{{ icon.receipt(14) }} {{ 'Demander un devis'|trans }}</a>
                </div>
            </div>
        </header>

        {# Confiance : mêmes repères que le profil membre. #}
        <ul class="pdp-trust">
            <li>{{ icon.shield_check(20) }}<span><b>{{ 'Identité et documents vérifiés'|trans }}</b><small>{{ 'par l’équipe TrouveMoi'|trans }}</small></span></li>
            {% if summary.response_hours is not null %}<li>{{ icon.clock(20) }}<span><b>{{ 'Répond en moins de'|trans }} {{ max(1, summary.response_hours|round(0, 'ceil')) }} h</b><small>{{ 'en général'|trans }}</small></span></li>{% endif %}
            <li>{{ icon.card_lock(20) }}<span><b>{{ 'Paiement sécurisé'|trans }}</b><small>{{ 'à la réservation'|trans }}</small></span></li>
            {% if summary.positive_rate is not null %}<li>{{ icon.star(20) }}<span><b>{{ summary.positive_rate }} % {{ 'd’avis positifs'|trans }}</b><small>{{ summary.reviews_count }} {{ 'avis'|trans }}</small></span></li>{% endif %}
        </ul>

        <div class="pdp-cols">
            <div>
                {% if provider.bio %}
                    <section class="pg-card pdp-block">
                        <h2 class="pg-h3">{{ 'À propos'|trans }}</h2>
                        <p>{{ provider.bio|nl2br }}</p>
                        {% if card.categories is not empty %}<ul class="pg-tags">{% for c in card.categories %}<li>{{ c|trans }}</li>{% endfor %}</ul>{% endif %}
                    </section>
                {% endif %}

                <section class="pdp-block" id="activites">
                    <h2 class="pg-h3">{{ 'Ses activités'|trans }} <span class="pdp-count">{{ card.activities|length }}</span></h2>
                    {% if card.activities is empty %}
                        <p class="pg-muted">{{ 'Aucune activité en ligne pour le moment : contactez ce professionnel ou demandez-lui un devis.'|trans }}</p>
                    {% else %}
                        <div class="pdp-acts">
                            {% for a in card.activities %}
                                <article class="gc-card">
                                    <a class="gc-card__media" href="{{ path('app_activity_show', {slug: a.slug}) }}"><img src="{{ asset(a.image) }}" alt="{{ a.title }}" loading="lazy">{% if a.badge %}<span class="gc-badge">{{ a.badge|trans }}</span>{% endif %}</a>
                                    <div class="gc-card__body">
                                        <a class="gc-card__title" href="{{ path('app_activity_show', {slug: a.slug}) }}">{{ a.title }}</a>
                                        <small>{{ a.place }}{% if a.duration %} · {{ a.duration }}{% endif %}</small>
                                        <div class="ofm-card__row">
                                            <span>{% if a.rating %}<small>{{ icon.star_solid(13) }} {{ a.rating }} ({{ a.reviews }})</small>{% endif %}</span>
                                            {% if a.price %}<span class="ofm-price"><small>{{ 'À partir'|trans }}</small><strong>{{ a.price|number_format(a.price == a.price|round ? 0 : 2, ',', ' ') }} €</strong></span>{% endif %}
                                        </div>
                                        <a class="pg-btn pg-btn--outline pg-btn--block gc-card__cta" href="{{ path('app_activity_show', {slug: a.slug}) }}#reserver">{{ 'Réserver'|trans }}</a>
                                    </div>
                                </article>
                            {% endfor %}
                        </div>
                        {% if reviews|length > 6 %}<button type="button" class="pg-btn pg-btn--outline pdp-more" onclick="this.previousElementSibling.querySelectorAll('[hidden]').forEach((e) => e.hidden = false); this.remove();">{{ 'Voir tous les avis'|trans }} ({{ reviews|length }})</button>{% endif %}
                    {% endif %}
                </section>

                <section class="pdp-block">
                    <h2 class="pg-h3">{{ 'Avis des clients'|trans }} <span class="pdp-count">{{ reviews|length }}</span></h2>
                    {% if reviews is empty %}
                        <p class="pg-muted">{{ 'Pas encore d’avis publié sur ce professionnel.'|trans }}</p>
                    {% else %}
                        <div class="pdp-reviews" data-pdp-reviews>
                            {% for review in reviews %}
                                <article class="pg-card pdp-review"{{ loop.index > 6 ? ' hidden' }}>
                                    <header><strong>{{ review.author.firstName }}</strong><span class="pdp-stars" aria-label="{{ review.rating }}/5">{% for i in 1..5 %}{{ i <= review.rating ? icon.star_solid(13) : icon.star(13) }}{% endfor %}</span></header>
                                    {% if review.comment %}<p>{{ review.comment|nl2br }}</p>{% endif %}
                                    {% if review.providerReply %}<blockquote><small>{{ 'Réponse du professionnel'|trans }}</small>{{ review.providerReply|nl2br }}</blockquote>{% endif %}
                                    {% include '_partials/_report_form.html.twig' with { subject_type: 'review', subject_id: review.id, subject_label: 'Avis de ' ~ review.author.firstName } %}
                                </article>
                            {% endfor %}
                        </div>
                    {% endif %}
                </section>
            </div>

            <aside class="pdp-side">
                {% if card.lat %}
                    <section class="pg-card">
                        <h2 class="pg-h3">{{ icon.map_pin(18) }} {{ 'Où le trouver'|trans }}</h2>
                        <div class="pd-map pd-map--sm" data-pg-map data-markers="{{ [{lat: card.lat, lng: card.lng, title: provider.displayName, where: provider.city, url: path('app_provider_profile', {slug: provider.slug})}]|json_encode }}"></div>
                        {% if provider.interventionZone %}<p class="pg-muted">{{ 'Intervient :'|trans }} {{ provider.interventionZone }}</p>{% endif %}
                    </section>
                {% endif %}
                {% if provider.availabilityLabel %}
                    <section class="pg-card"><h2 class="pg-h3">{{ icon.clock(18) }} {{ 'Disponibilités'|trans }}</h2><p>{{ provider.availabilityLabel }}</p></section>
                {% endif %}
                {% if provider.websiteUrl or provider.facebookUrl or provider.instagramUrl or provider.linkedinUrl or provider.youtubeUrl %}
                    <section class="pg-card pdp-links">
                        <h2 class="pg-h3">{{ 'Sur le web'|trans }}</h2>
                        {% if provider.websiteUrl %}<a href="{{ provider.websiteUrl }}" target="_blank" rel="noopener">{{ icon.globe(16) }} {{ 'Site web'|trans }}</a>{% endif %}
                        {% if provider.facebookUrl %}<a href="{{ provider.facebookUrl }}" target="_blank" rel="noopener">{{ icon.facebook(16) }} Facebook</a>{% endif %}
                        {% if provider.instagramUrl %}<a href="{{ provider.instagramUrl }}" target="_blank" rel="noopener">{{ icon.instagram(16) }} Instagram</a>{% endif %}
                        {% if provider.linkedinUrl %}<a href="{{ provider.linkedinUrl }}" target="_blank" rel="noopener">{{ icon.social_linkedin(16) }} LinkedIn</a>{% endif %}
                        {% if provider.youtubeUrl %}<a href="{{ provider.youtubeUrl }}" target="_blank" rel="noopener">{{ icon.youtube(16) }} YouTube</a>{% endif %}
                    </section>
                {% endif %}
                <section class="pg-card pdp-trust">
                    <p>{{ icon.shield_check(18) }} {{ 'Identité et documents vérifiés par TrouveMoi'|trans }}</p>
                    <p>{{ icon.card_lock(18) }} {{ 'Paiement sécurisé à la réservation'|trans }}</p>
                    {% include '_partials/_report_form.html.twig' with { subject_type: 'profile', subject_id: provider.id, subject_label: provider.displayName } %}
                </section>
            </aside>
        </div>
    </div>
</div>
{% endblock %}
