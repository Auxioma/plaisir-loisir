{#
    Tableau de bord professionnel (§8.3 du CDC). Aucune maquette Figma pour
    cet écran — comme /professionnels et /activites-privees.
#}
{% extends 'base.html.twig' %}

{% block title %}{{ 'Tableau de bord'|trans }}{% endblock %}

{% block body %}
<div class="container py-5" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h1 class="mb-1" style="color: var(--pl-text-display); font-weight: var(--pl-fw-bold);">
                {{ 'Bonjour'|trans }} {{ provider.displayName }}
            </h1>
            <span class="badge rounded-pill {{ provider.status.value == 'verified' ? 'text-bg-success' : (provider.status.value == 'suspended' ? 'text-bg-danger' : 'text-bg-warning') }}">
                {{ provider.status.value == 'verified' ? 'Dossier vérifié'|trans : (provider.status.value == 'pending_verification' ? 'Dossier en vérification'|trans : (provider.status.value == 'suspended' ? 'Dossier suspendu'|trans : 'Brouillon'|trans)) }}
            </span>
        </div>
        <a href="{{ path('app_pro_profile_edit') }}" class="btn pl-btn pl-btn--outline-dark">{{ 'Modifier ma fiche'|trans }}</a>
    </div>

    {% if provider.status.value != 'verified' %}
        <div class="alert alert-warning">
            {{ 'Votre dossier n\'est pas encore vérifié : votre fiche n\'apparaît pas dans la recherche publique tant que ce n\'est pas fait.'|trans }}
        </div>
    {% endif %}

    <div class="row g-4 mb-4">
        <div class="col-sm-4">
            <a href="{{ path('app_pro_requests') }}" class="text-decoration-none">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="fs-2 fw-bold" style="color: var(--pl-action);">{{ open_requests_count }}</div>
                        <div class="text-muted small">{{ 'Demandes ouvertes dans votre métier'|trans }}</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-sm-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="fs-2 fw-bold" style="color: var(--pl-action);">{{ pending_quotes_count }}</div>
                    <div class="text-muted small">{{ 'Devis en attente de réponse'|trans }}</div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="fs-2 fw-bold" style="color: var(--pl-success);">{{ accepted_quotes_count }}</div>
                    <div class="text-muted small">{{ 'Devis acceptés'|trans }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h2 class="h6 mb-1">{{ 'Abonnement'|trans }}</h2>
                {% if subscription %}
                    <span class="text-muted small">{{ subscription.plan.name }} — {{ subscription.status.value == 'active' ? 'Actif'|trans : subscription.status.value }}</span>
                {% else %}
                    <span class="text-muted small">{{ 'Aucun abonnement en cours.'|trans }}</span>
                {% endif %}
            </div>
            <a href="{{ path('app_pro_subscription') }}" class="btn btn-sm pl-btn pl-btn--outline-dark">{{ 'Gérer'|trans }}</a>
        </div>
    </div>

    {% if sent_quotes is not empty %}
        <h2 class="h5 mb-3">{{ 'Vos derniers devis envoyés'|trans }}</h2>
        <div class="list-group mb-4">
            {% for quote in sent_quotes|slice(0, 5) %}
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <span>{{ quote.serviceRequest.title }}</span>
                    <span class="badge rounded-pill {{ quote.status.value == 'accepted' ? 'text-bg-success' : (quote.status.value == 'declined' ? 'text-bg-secondary' : 'text-bg-warning') }}">
                        {{ quote.status.value == 'accepted' ? 'Accepté'|trans : (quote.status.value == 'declined' ? 'Refusé'|trans : 'En attente'|trans) }}
                    </span>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <p class="text-muted small">
        {{ 'Messagerie et avis reçus arrivent avec un prochain lot du projet.'|trans }}
    </p>
</div>
{% endblock %}
