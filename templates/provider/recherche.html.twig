{#
    « Trouver un professionnel » (§5, §9 du CDC) — refonte du 05/10 sur le
    modèle des pages Explorer / Activités : filtres à gauche, cartes de
    prestataires avec leurs vraies données (activités publiées, note, prix
    d'appel), carte des prestataires. Données : ProviderSearchController::
    search() et ProviderDirectory. Styles : pages.css (.gc-*, .ex2-*) et
    .pd-* ci-dessous.
    Le rayon s'appuie sur les coordonnées des activités du prestataire, à
    défaut sur sa ville (FrenchCityCoordinates).
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Trouver un professionnel'|trans }}{% endblock %}
{% block meta_description %}{{ 'Trouvez un professionnel du loisir vérifié près de chez vous : activités, avis, tarifs, demande de devis.'|trans }}{% endblock %}

{% block body %}
<div class="pg gc pd">
    <aside class="gc-filters">
        <form method="get" action="{{ path('app_provider_search') }}">
            {% if filters.sort != 'pertinence' %}<input type="hidden" name="tri" value="{{ filters.sort }}">{% endif %}
            <div class="ofm-filters__head"><h2>{{ 'Filtres'|trans }}</h2><a href="{{ path('app_provider_search') }}">{{ 'Réinitialiser'|trans }}</a></div>
            <label class="ex2-field">{{ 'Nom ou activité'|trans }}
                <span class="ex2-input"><input name="q" value="{{ filters.q }}" placeholder="{{ 'Ex : kayak, escape game…'|trans }}" maxlength="80">{{ icon.search(16) }}</span></label>
            <label class="ex2-field">{{ 'Ville'|trans }}
                <span class="ex2-input"><input name="ville" value="{{ filters.city }}" placeholder="{{ 'Ex : Rouen'|trans }}" maxlength="80">{{ icon.map_pin(16) }}</span></label>
            <label class="ex2-field">{{ 'Rayon'|trans }}
                <select name="rayon">
                    <option value="0">{{ 'Dans la ville'|trans }}</option>
                    {% for r in [10, 25, 50, 100, 200, 500] %}<option value="{{ r }}"{{ filters.radius == r ? ' selected' }}>{{ 'Jusqu’à'|trans }} {{ r }} km</option>{% endfor %}
                </select>
            </label>
            <fieldset>
                <legend>{{ 'Catégorie'|trans }}</legend>
                <label class="ofm-check"><input type="radio" name="metier" value=""{{ selected_category ? '' : ' checked' }}> {{ 'Toutes'|trans }}</label>
                {% for c in categories %}<label class="ofm-check"><input type="radio" name="metier" value="{{ c.slug }}"{{ selected_category and selected_category.slug == c.slug ? ' checked' }}> {{ c.name|trans }}</label>{% endfor %}
            </fieldset>
            <fieldset>
                <legend>{{ 'Note des clients'|trans }}</legend>
                <div class="ex2-stars">
                    {% for n in [4.5, 4, 3] %}<label><input type="radio" name="note" value="{{ n }}"{{ filters.rating == n ? ' checked' }}><span>{{ icon.star_solid(13) }} {{ n|number_format(n == n|round ? 0 : 1, ',') }} {{ 'et +'|trans }}</span></label>{% endfor %}
                </div>
            </fieldset>
            <button class="pg-btn pg-btn--block">{{ 'Afficher les résultats'|trans }}</button>
            {% if filters.radius > 0 %}<p class="ex2-total">{{ 'Le rayon se calcule depuis les grandes villes françaises connues.'|trans }}</p>{% endif %}
        </form>
    </aside>

    <div class="gc-main ex2-main">
        <header class="ex2-head pd-head">
            <div>
                <h1>{{ 'Trouver un professionnel'|trans }}</h1>
                <p>{{ 'Des prestataires vérifiés par notre équipe, notés par leurs clients. Réservez une activité, contactez-les ou demandez un devis.'|trans }}</p>
            </div>
            <ul class="pd-badges">
                <li>{{ icon.check_badge(18) }} {{ 'Profils vérifiés'|trans }}</li>
                <li>{{ icon.star(18) }} {{ 'Avis authentiques'|trans }}</li>
                <li>{{ icon.receipt(18) }} {{ 'Devis gratuits'|trans }}</li>
            </ul>
        </header>

        <div class="pd-bar">
            <strong>{{ total }} {{ total > 1 ? 'professionnels trouvés'|trans : 'professionnel trouvé'|trans }}</strong>
            <form method="get" class="ofm-sort">
                {% for k, v in params|filter((v, k) => k != 'tri') %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endfor %}
                <label for="pd-tri">{{ 'Trier par'|trans }}</label>
                <select id="pd-tri" name="tri" onchange="this.form.submit()">{% for k, label in sorts %}<option value="{{ k }}"{{ filters.sort == k ? ' selected' }}>{{ label|trans }}</option>{% endfor %}</select>
                <noscript><button class="pg-link">OK</button></noscript>
            </form>
        </div>

        <div class="pd-cols">
            <div>
                {% if results is empty %}
                    <div class="ofm-empty">
                        {{ icon.users(32) }}
                        <strong>{{ 'Aucun professionnel ne correspond à cette recherche pour le moment.'|trans }}</strong>
                        <span>{{ 'Décrivez votre besoin : les professionnels concernés vous envoient leur devis.'|trans }}</span>
                        <a class="pg-btn" href="{{ path('app_account_requests_new', selected_category ? {metier: selected_category.slug} : {}) }}">{{ 'Déposer une demande'|trans }}</a>
                    </div>
                {% else %}
                    <div class="pd-grid">
                        {% for r in results %}
                            <article class="pd-card" id="pro-{{ loop.index }}">
                                <a class="pd-card__cover" href="{{ path('app_provider_profile', {slug: r.slug}) }}">
                                    {% if r.cover %}<img src="{{ asset(r.cover) }}" alt="" loading="lazy">{% endif %}
                                    <span class="pd-card__verified">{{ icon.check_badge(14) }} {{ 'Vérifié'|trans }}</span>
                                </a>
                                <div class="pd-card__body">
                                    <div class="pd-card__id">
                                        <span class="pd-avatar">{% if r.avatar %}<img src="{{ asset(r.avatar) }}" alt="">{% else %}{{ r.name|first|upper }}{% endif %}</span>
                                        <span>
                                            <a class="pd-card__name" href="{{ path('app_provider_profile', {slug: r.slug}) }}">{{ r.name }}</a>
                                            <small>{% if r.category %}{{ r.category|trans }}{% endif %}{% if r.city %} · {{ icon.map_pin(12) }} {{ r.city }}{% endif %}{% if r.distance is not null %} · {{ r.distance }} km{% endif %}</small>
                                        </span>
                                    </div>
                                    <div class="pd-card__stats">
                                        <span>{% if r.rating %}{{ icon.star_solid(14) }} <b>{{ r.rating|number_format(1, ',') }}</b> ({{ r.reviews }} {{ 'avis'|trans }}){% else %}<em>{{ 'Nouveau sur TrouveMoi'|trans }}</em>{% endif %}</span>
                                        <span>{{ r.activities|length }} {{ r.activities|length > 1 ? 'activités'|trans : 'activité'|trans }}</span>
                                        {% if r.priceFrom is not null %}<span>{{ 'dès'|trans }} <b>{{ r.priceFrom|number_format(r.priceFrom == r.priceFrom|round ? 0 : 2, ',', ' ') }} €</b></span>{% endif %}
                                    </div>
                                    {% if r.activities is not empty %}
                                        <ul class="pd-card__acts">
                                            {% for a in r.activities|slice(0, 3) %}<li><a href="{{ path('app_activity_show', {slug: a.slug}) }}">{{ a.title }}</a></li>{% endfor %}
                                        </ul>
                                    {% endif %}
                                    <div class="pd-card__actions">
                                        <a class="pg-btn pd-btn" href="{{ path('app_provider_profile', {slug: r.slug}) }}">{{ 'Voir le profil'|trans }}</a>
                                        <a class="pg-btn pg-btn--outline pd-btn" href="{{ path('app_account_requests_new', r.provider.mainCategory ? {metier: r.provider.mainCategory.slug} : {}) }}">{{ 'Demander un devis'|trans }}</a>
                                    </div>
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                    {% if has_more %}
                        <a class="ofm-more" href="{{ path('app_provider_search', params|merge({page: page + 1})) }}#pro-{{ results|length + 1 }}">{{ 'Voir plus de professionnels'|trans }} {{ icon.chevron_down(16) }}</a>
                    {% endif %}
                {% endif %}
            </div>

            <aside class="pd-side">
                <section class="pg-card">
                    <h2 class="pg-h3">{{ icon.map_pin(18) }} {{ 'Sur la carte'|trans }}</h2>
                    <div class="pd-map" data-pg-map data-markers="{{ markers|json_encode }}" aria-label="{{ 'Carte des professionnels'|trans }}"></div>
                </section>
                <section class="pg-card pd-cta">
                    <h2 class="pg-h3">{{ 'Un besoin précis ?'|trans }}</h2>
                    <p>{{ 'Décrivez votre projet (séminaire, anniversaire, sortie de groupe…) : les professionnels concernés vous envoient leur devis.'|trans }}</p>
                    <a class="pg-btn pg-btn--block" href="{{ path('app_account_requests_new', selected_category ? {metier: selected_category.slug} : {}) }}">{{ 'Déposer une demande'|trans }}</a>
                </section>
                {% if not is_granted('ROLE_PROVIDER') %}
                    <section class="pg-card pd-cta pd-cta--pro">
                        <h2 class="pg-h3">{{ 'Vous êtes professionnel ?'|trans }}</h2>
                        <p>{{ 'Rejoignez TrouveMoi et proposez vos activités à des milliers de clients.'|trans }}</p>
                        <a class="pg-btn pg-btn--outline pg-btn--block" href="{{ path('app_corporate_partner') }}">{{ 'Devenir partenaire'|trans }}</a>
                    </section>
                {% endif %}
            </aside>
        </div>
    </div>
</div>
{% endblock %}
