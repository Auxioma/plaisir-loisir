{# Encart de chiffres clés posé sur la photo d'en-tête (Carrières, Devenir partenaire).
   items : chiffres réels de PlatformFigures::band() ({icon, tone, value, label}) ; rien si vide. #}
{% import 'provider/space/_ico.html.twig' as ico %}
{% if items is not empty %}
<ul class="pg-hero__stats">
    {% for it in items %}
        <li><span class="pg-ico is-{{ it.tone }}">{{ ico.svg(it.icon, 20) }}</span><span><strong>{{ it.value }}</strong><small>{{ it.label|trans }}</small></span></li>
    {% endfor %}
</ul>
{% endif %}
