{#
    « Devenez partenaire » — maquette docs/maquettes/devenir_partenaire.jpeg (04/10).
    Les boutons mènent au formulaire de candidature (app_corporate_partner_form,
    PartnerApplication, traité dans le back-office).
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}
{% import 'provider/space/_ico.html.twig' as ico %}

{% block title %}{{ 'Devenez partenaire'|trans }}{% endblock %}
{% block meta_description %}{{ 'Rejoignez TrouveMoi Plaisirs & Loisirs et développez votre activité.'|trans }}{% endblock %}

{% block body %}
<div class="pg">
    <header class="pg-hero">
        <div class="pg-hero__text">
            <h1>{{ 'Devenez partenaire'|trans }}</h1>
            <p class="pg-hero__sub"><strong>{{ 'Rejoignez TrouveMoi Plaisirs & Loisirs et développez votre activité'|trans }}</strong></p>
            <p class="pg-hero__lead">{{ 'Vous êtes un professionnel du loisir, du tourisme ou de l’expérience ? Gagnez en visibilité, attirez plus de clients et développez votre activité grâce à notre plateforme.'|trans }}</p>
            <div class="pg-hero__actions">
                <a class="pg-btn" href="{{ path('app_corporate_partner_form') }}">{{ 'Devenir partenaire'|trans }}</a>
                <a class="pg-btn pg-btn--outline" href="{{ path('app_corporate_contact', {sujet: 'Devenir partenaire'}) }}">{{ 'Nous contacter'|trans }}</a>
            </div>
            <ul class="pg-hero__checks pg-mt"><li>{{ icon.shield_check(18) }} {{ 'Partenariat 100% gratuit à la création • Sans engagement'|trans }}</li></ul>
        </div>
        <img class="pg-hero__img" src="{{ asset('images/corporate/partner-hero.jpg') }}" alt="">
        {% include 'corporate/_partials/_hero_stats.html.twig' with { items: stats } %}
    </header>

    <section class="pg-wrap pg-section">
        <h2 class="pg-title">{{ 'Pourquoi devenir partenaire ?'|trans }}</h2>
        <div class="pg-features pg-features--5">
            {% for b in benefits %}
                <article class="pg-card pg-feature"><span class="pg-ico is-{{ b.tone }}">{{ ico.svg(b.icon, 24) }}</span><div><h3>{{ b.title|trans }}</h3><p>{{ b.text|trans }}</p></div></article>
            {% endfor %}
        </div>
    </section>

    <section class="pg-wrap pg-how">
        <div>
            <h2 class="pg-h3">{{ 'Comment ça marche ?'|trans }}</h2>
            <ol class="pg-steps">
                {% for s in steps %}
                    <li><span class="pg-ico">{{ ico.svg(s.icon, 26) }}</span><strong>{{ loop.index }}. {{ s.title|trans }}</strong><small>{{ s.text|trans }}</small></li>
                {% endfor %}
            </ol>
        </div>
        <aside class="pg-card pg-quotes" data-pg-carousel>
            <h2 class="pg-h3">{{ 'Ils nous font confiance'|trans }}</h2>
            <div class="pg-quotes__track" data-pg-track>
                {% for t in testimonials %}
                    <figure class="pg-quote">
                        <blockquote>« {{ t.quote|trans }} »</blockquote>
                        <figcaption><img src="{{ asset(t.photo) }}" alt=""><span><strong>{{ t.author }}</strong><small>{{ t.role|trans }}</small></span></figcaption>
                    </figure>
                {% endfor %}
            </div>
            <div class="pg-quotes__nav"><button type="button" data-pg-dir="-1" aria-label="{{ 'Précédent'|trans }}">{{ icon.chevron_left(16) }}</button><button type="button" data-pg-dir="1" aria-label="{{ 'Suivant'|trans }}">{{ icon.chevron_right(16) }}</button></div>
        </aside>
    </section>

    <section class="pg-wrap">
        <div class="pg-ready">
            <div><h2>{{ 'Prêt à rejoindre l’aventure ?'|trans }}</h2><p>{{ 'Inscrivez-vous gratuitement et proposez vos activités dès aujourd’hui !'|trans }}</p></div>
            <ul>
                {% for a in arguments %}<li><span class="pg-ico">{{ ico.svg(a.icon, 20) }}</span><span><strong>{{ a.title|trans }}</strong><small>{{ a.text|trans }}</small></span></li>{% endfor %}
            </ul>
            <a class="pg-btn" href="{{ path('app_corporate_partner_form') }}">{{ 'Devenir partenaire'|trans }} {{ icon.arrow_right(16) }}</a>
        </div>
    </section>
</div>
{% endblock %}
