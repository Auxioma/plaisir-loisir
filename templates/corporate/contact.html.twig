{#
    « Contactez-nous » — maquette docs/maquettes/contactez_nous.jpeg (04/10).
    Formulaire réel (ContactMessage, back-office « Messages de contact »),
    pièce jointe facultative, chat (ticket support), FAQ, adresse + carte.
    Données : CorporateController::contact(). Styles : assets/styles/pages.css (.pg-*).
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Contactez-nous'|trans }}{% endblock %}
{% block meta_description %}{{ 'Une question, une suggestion ou besoin d’aide ? L’équipe TrouveMoi vous répond sous 24h.'|trans }}{% endblock %}

{% block body %}
<div class="pg">
    <header class="pg-hero">
        <div class="pg-hero__text">
            <h1>{{ 'Contactez-nous'|trans }}</h1>
            <p class="pg-hero__lead">{{ "Une question, une suggestion ou besoin d'aide ? Notre équipe est à votre écoute et vous répond dans les meilleurs délais."|trans }}</p>
            <ul class="pg-hero__checks">
                <li>{{ icon.shield_check(18) }} {{ 'Réponse rapide sous 24h'|trans }}</li>
                <li>{{ icon.padlock(18) }} {{ 'Vos données sont 100% confidentielles'|trans }}</li>
            </ul>
        </div>
        <img class="pg-hero__img" src="{{ asset('images/corporate/contact-hero.jpg') }}" alt="">
    </header>

    <div class="pg-wrap pg-contact">
        <section>
            <h2 class="pg-h2">{{ 'Envoyez-nous un message'|trans }}</h2>
            <form class="pg-form" method="post" action="{{ path('app_corporate_contact') }}" enctype="multipart/form-data" data-pg-form>
                <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                <div class="pg-form__row">
                    <label class="pg-field"><span class="visually-hidden">{{ 'Votre nom'|trans }}</span>
                        <input name="nom" value="{{ values.nom }}" placeholder="{{ 'Votre nom'|trans }}" required minlength="2" maxlength="120" autocomplete="name"></label>
                    <label class="pg-field"><span class="visually-hidden">{{ 'Votre email'|trans }}</span>
                        <input type="email" name="email" value="{{ values.email }}" placeholder="{{ 'Votre email'|trans }}" required maxlength="180" autocomplete="email"></label>
                </div>
                <label class="pg-field"><span class="visually-hidden">{{ 'Sujet de votre demande'|trans }}</span>
                    <select name="sujet" required>
                        <option value="">{{ 'Sujet de votre demande'|trans }}</option>
                        {% set known = false %}
                        {% for s in subjects %}
                            <option value="{{ s }}"{{ values.sujet == s ? ' selected' }}>{{ s|trans }}</option>
                            {% if values.sujet == s %}{% set known = true %}{% endif %}
                        {% endfor %}
                        {% if values.sujet and not known %}<option value="{{ values.sujet }}" selected>{{ values.sujet|trans }}</option>{% endif %}
                    </select>
                </label>
                <label class="pg-field"><span class="visually-hidden">{{ 'Votre message'|trans }}</span>
                    <textarea name="message" rows="6" placeholder="{{ 'Votre message'|trans }}" required minlength="10" maxlength="5000">{{ values.message }}</textarea></label>
                <label class="pg-attach">
                    {{ icon.link(16) }} <span data-pg-attach-label>{{ 'Ajouter une pièce jointe (facultatif)'|trans }}</span>
                    <input type="file" name="piece_jointe" accept=".pdf,image/jpeg,image/png,image/webp" hidden data-pg-attach>
                </label>
                <button class="pg-btn pg-btn--block">{{ 'Envoyer le message'|trans }} {{ icon.arrow_right(16) }}</button>
            </form>
        </section>

        <section>
            <h2 class="pg-h2">{{ 'Autres moyens de nous contacter'|trans }}</h2>
            <div class="pg-ways">
                <div class="pg-way"><span class="pg-ico">{{ icon.mail(22) }}</span><div><strong>{{ 'Par email'|trans }}</strong><a href="mailto:{{ contact.email }}">{{ contact.email }}</a><small>{{ 'Réponse sous 24h'|trans }}</small></div></div>
                <div class="pg-way"><span class="pg-ico is-green">{{ icon.phone(22) }}</span><div><strong>{{ 'Par téléphone'|trans }}</strong><a href="tel:{{ contact.phone|replace({' ': ''}) }}">{{ contact.phone }}</a><small>{{ 'Lun. – Ven. 9h – 18h'|trans }}</small></div></div>
                <div class="pg-way"><span class="pg-ico is-orange">{{ icon.chat_bubble(22) }}</span><div><strong>{{ 'Chat en ligne'|trans }}</strong><small>{{ 'Discutez avec notre équipe en direct'|trans }}</small>
                    <form method="post" action="{{ path('app_support_chat') }}"><input type="hidden" name="_token" value="{{ csrf_token('submit') }}"><button class="pg-link">{{ 'Démarrer le chat'|trans }} {{ icon.arrow_right(14) }}</button></form></div></div>
                <div class="pg-way"><span class="pg-ico">{{ icon.help_circle(22) }}</span><div><strong>{{ 'FAQ'|trans }}</strong><small>{{ 'Trouvez des réponses à vos questions courantes'|trans }}</small><a class="pg-link" href="{{ path('app_faq') }}">{{ 'Voir la FAQ'|trans }} {{ icon.arrow_right(14) }}</a></div></div>
                <div class="pg-way pg-way--wide"><span class="pg-ico">{{ icon.map_pin(22) }}</span><div><strong>{{ 'Notre adresse'|trans }}</strong><small>TrouveMoi Plaisirs &amp; Loisirs<br>28 rue de la Paix<br>75002 Paris, France</small></div>
                    <a class="pg-way__map" href="https://www.openstreetmap.org/?mlat=48.8693&amp;mlon=2.3315#map=17/48.8693/2.3315" target="_blank" rel="noopener" aria-label="{{ 'Voir sur la carte'|trans }}"><img src="{{ asset('images/corporate/contact-map.jpg') }}" alt=""></a></div>
            </div>
        </section>
    </div>

    <ul class="pg-wrap pg-band">
        <li>{{ icon.shield_check(28) }}<span><strong>{{ 'Support 7j/7'|trans }}</strong><small>{{ 'Notre équipe est disponible tous les jours'|trans }}</small></span></li>
        <li>{{ icon.users(28) }}<span><strong>{{ 'Une équipe à votre écoute'|trans }}</strong><small>{{ 'Des conseillers passionnés pour vous aider'|trans }}</small></span></li>
        <li>{{ icon.clock(28) }}<span><strong>{{ 'Réponse rapide'|trans }}</strong><small>{{ 'Nous nous engageons à vous répondre sous 24h'|trans }}</small></span></li>
        <li>{{ icon.heart(28) }}<span><strong>{{ 'Votre satisfaction'|trans }}</strong><small>{{ 'Votre satisfaction est notre priorité'|trans }}</small></span></li>
    </ul>
</div>
{% endblock %}
