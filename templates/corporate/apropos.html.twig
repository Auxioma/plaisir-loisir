{#
    « Qui sommes-nous ? » — maquette docs/maquettes/qui_sommes_nous.jpeg (04/10).
    Données : CorporateController::about() (StaticCorporate). Styles : pages.css (.pg-*).
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}
{% import 'provider/space/_ico.html.twig' as ico %}

{% block title %}{{ 'Qui sommes-nous ?'|trans }}{% endblock %}
{% block meta_description %}{{ 'TrouveMoi Plaisirs & Loisirs est la plateforme qui vous aide à trouver les meilleures activités et loisirs partout en France.'|trans }}{% endblock %}

{% block body %}
<div class="pg">
    <header class="pg-hero pg-hero--about">
        <div class="pg-hero__text">
            <h1>{{ 'Qui sommes-nous ?'|trans }}</h1>
            <p class="pg-hero__lead">{{ 'TrouveMoi Plaisirs & Loisirs est la plateforme qui vous aide à trouver les meilleures activités et loisirs partout en France.'|trans }}</p>
            <div class="pg-hero__actions">
                <a class="pg-btn" href="{{ path('app_activities') }}">{{ 'Découvrir nos activités'|trans }}</a>
                <a class="pg-link" href="{{ path('app_corporate_contact') }}">{{ 'Nous contacter'|trans }} {{ icon.arrow_right(16) }}</a>
            </div>
        </div>
        <img class="pg-hero__img" src="{{ asset('images/corporate/hero-equipe.jpg') }}" alt="">
    </header>

    <div class="pg-wrap">
        <ul class="pg-stats">
            {% for s in stats %}
                <li><span class="pg-ico is-{{ s.tone }}">{{ ico.svg(s.icon, 24) }}</span><span><strong>{{ s.value }}</strong><small>{{ s.label|trans }}</small></span></li>
            {% endfor %}
        </ul>

        <div class="pg-about">
            <section class="pg-mission">
                <h2 class="pg-h2 pg-h2--green">{{ 'Notre mission'|trans }}</h2>
                <p>{{ 'Nous avons créé TrouveMoi Plaisirs & Loisirs avec une idée simple : rendre les loisirs et les expériences inoubliables accessibles à tous. Que vous soyez en quête d’aventure, de détente, de découvertes culturelles ou d’activités en famille, notre plateforme rassemble les meilleures offres près de chez vous.'|trans }}</p>
                <p><strong>{{ 'Vivez plus. Explorez plus. Partagez plus.'|trans }}</strong> 🔥</p>
            </section>
            <section>
                <h2 class="pg-h2">{{ 'Nos valeurs'|trans }}</h2>
                <div class="pg-values">
                    {% for v in values %}
                        <article class="pg-card pg-value">
                            <h3><span class="pg-ico is-{{ v.tone }}">{{ ico.svg(v.icon, 22) }}</span>{{ v.title|trans }}</h3>
                            <p>{{ v.text|trans }}</p>
                        </article>
                    {% endfor %}
                </div>
            </section>
        </div>

        <div class="pg-team">
            <section class="pg-team__intro">
                <h2 class="pg-h2 pg-h2--green">{{ 'Notre équipe'|trans }}</h2>
                <p>{{ 'Une équipe passionnée, à votre écoute, et mobilisée chaque jour pour vous offrir la meilleure expérience possible.'|trans }}</p>
            </section>
            <ul class="pg-team__list">
                {% for m in team %}
                    <li class="pg-card">
                        <img src="{{ asset(m.photo) }}" alt="{{ m.name }}" loading="lazy">
                        <strong>{{ m.name }}</strong>
                        <small>{{ m.role|trans }}</small>
                        <a href="{{ social_links.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn — {{ m.name }}">{{ icon.social_linkedin(18) }}</a>
                    </li>
                {% endfor %}
            </ul>
            <aside class="pg-join">
                <h2>{{ 'Rejoignez l’aventure !'|trans }}</h2>
                <p>{{ 'Vous partagez notre passion pour les loisirs et les belles expériences ? Rejoignez-nous et participez à cette belle aventure.'|trans }}</p>
                <a class="pg-btn pg-btn--ghost" href="{{ path('app_corporate_jobs') }}">{{ icon.users(16) }} {{ 'Voir nos offres d’emploi'|trans }}</a>
            </aside>
        </div>
    </div>
</div>
{% endblock %}
