{#
    Pages juridiques — maquettes docs/maquettes/cgu.jpeg,
    mentions_legales.jpeg et politique_de_confidentialite.jpeg (04/10).

    Le contenu vient de la base (LegalDocument, versionné, géré dans le
    back-office) ; chaque titre de niveau 2 devient une carte numérotée et une
    entrée du sommaire. Sans version publiée, le texte initial
    (App\Legal\LegalDefaults) s'affiche.

    Le HTML des sections est affiché sans échappement parce qu'il est filtré
    en amont par LegalContentRenderer (config/packages/html_sanitizer.yaml).
    Variables : page_title, intro, sections, document|null, type.
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}
{% import 'provider/space/_ico.html.twig' as ico %}

{% block title %}{{ page_title|trans }}{% endblock %}
{% block meta_description %}{{ intro|trans }}{% endblock %}

{% macro sectionIcon(title) %}
    {%- import 'provider/space/_ico.html.twig' as ico -%}
    {%- set t = title|lower -%}
    {%- set name = 'doc' -%}
    {%- for key, value in {'objet': 'doc', 'éditeur': 'briefcase', 'heberg': 'monitor', 'accès': 'lock', 'utilisation de la': 'monitor', 'compte': 'person', 'contenu': 'star', 'propriété': 'doc', 'réservation': 'calendar', 'paiement': 'card', 'responsab': 'shield', 'données': 'person', 'sécurité': 'lock', 'droit': 'shield', 'cookie': 'globe', 'contact': 'mail', 'lien': 'link', 'modification': 'edit', 'partage': 'share', 'utilisation des': 'chart'} -%}
        {%- if key in t and name == 'doc' -%}{%- set name = value -%}{%- endif -%}
    {%- endfor -%}
    {{ ico.svg(name, 24) }}
{% endmacro %}

{% block body %}
{% set numbered = sections|filter(s => s.title) %}
{% set preamble = sections|filter(s => not s.title) %}
<div class="lg2">
    <header class="lg2-hero">
        <div class="lg2-hero__text">
            <nav class="lg2-crumb act-breadcrumb" aria-label="{{ "Fil d'Ariane"|trans }}"><a href="{{ path('app_home') }}">{{ 'Accueil'|trans }}</a> <span>/</span> <span aria-current="page">{{ page_title|trans }}</span></nav>
            <h1>{{ page_title|trans }}</h1>
            <p class="lg2-hero__date">
                {% if document %}{{ 'Dernière mise à jour :'|trans }} {{ (document.publishedAt ?? document.createdAt)|pf_date('d MMMM y') }} · {{ 'version'|trans }} {{ document.version }}
                {% else %}{{ 'Texte en vigueur'|trans }}{% endif %}
            </p>
            <p class="lg2-hero__intro">{{ intro|trans }}</p>
        </div>
        <img class="lg2-hero__img" src="{{ asset('images/events/ev-rando-clean.jpg') }}" alt="">
    </header>

    <div class="lg2-body">
        <div class="lg2-main">
            {% if not document %}
                {# Aucune version publiée en base : on affiche le texte de référence, en le disant. #}
                <p class="lg-pending">{{ icon.info(16) }} {{ 'La version officielle de ce texte est en cours de préparation ; voici le texte de référence actuellement appliqué. Une question ?'|trans }} <a href="{{ path('app_corporate_contact', {sujet: page_title}) }}">{{ 'Contactez-nous'|trans }}</a></p>
            {% endif %}
            {% for s in preamble %}<div class="lg2-preamble">{{ s.html|raw }}</div>{% endfor %}
            {% if numbered is empty %}
                <p class="lg2-empty">{{ 'Ce document est en cours de rédaction.'|trans }}</p>
            {% elseif type == 'privacy_policy' %}
                <ol class="lg2-list">
                    {% for s in numbered %}
                        <li id="lg-{{ loop.index }}">
                            <details{{ loop.first ? ' open' }}>
                                <summary>
                                    <span class="lg2-num">{{ loop.index }}</span>
                                    <span class="lg2-ico">{{ _self.sectionIcon(s.title) }}</span>
                                    <span class="lg2-list__title">{{ s.title }}</span>
                                    {{ icon.chevron_right(18) }}
                                </summary>
                                <div class="lg2-text">{{ s.html|raw }}</div>
                            </details>
                        </li>
                    {% endfor %}
                </ol>
            {% else %}
                <div class="lg2-grid">
                    {% for s in numbered %}
                        <article class="lg2-card" id="lg-{{ loop.index }}">
                            <span class="lg2-num">{{ loop.index }}</span>
                            <span class="lg2-ico is-{{ ['blue', 'violet', 'green', 'orange', 'red', 'teal'][loop.index0 % 6] }}">{{ _self.sectionIcon(s.title) }}</span>
                            <div>
                                <h2>{{ type == 'legal_notice' ? loop.index ~ '. ' }}{{ s.title }}</h2>
                                <div class="lg2-text">{{ s.html|raw }}</div>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <aside class="lg2-side">
            {% if numbered is not empty %}
                <nav class="lg2-toc" aria-label="{{ 'Dans cette page'|trans }}">
                    <h2>{{ 'Dans cette page'|trans }}</h2>
                    <ol class="lg-toc__list">{% for s in numbered %}<li><a href="#lg-{{ loop.index }}">{{ s.title }}</a></li>{% endfor %}</ol>
                </nav>
            {% endif %}
            <section class="lg2-engage">
                <span class="lg2-engage__ico">{{ type == 'legal_notice' ? icon.headset(26) : icon.shield_check(26) }}</span>
                {% if type == 'legal_notice' %}
                    <h2>{{ 'Une question ?'|trans }}</h2>
                    <p>{{ 'Notre équipe est à votre disposition pour toute question relative aux mentions légales.'|trans }}</p>
                {% elseif type == 'privacy_policy' %}
                    <h2>{{ 'Notre engagement'|trans }}</h2>
                    <p>{{ 'Nous nous engageons à respecter la confidentialité de vos données et à être transparents sur leur utilisation. Votre confiance est essentielle pour nous.'|trans }}</p>
                {% else %}
                    <h2>{{ 'Notre engagement'|trans }}</h2>
                    <p>{{ 'Chez TrouveMoi Plaisirs & Loisirs, la transparence et la confiance sont au cœur de notre relation avec vous. Nous nous engageons à vous offrir une expérience sécurisée et fiable.'|trans }}</p>
                {% endif %}
                <a class="lg2-btn" href="{{ path('app_corporate_contact', {sujet: page_title}) }}">{{ 'Nous contacter'|trans }} {{ icon.arrow_right(16) }}</a>
            </section>
            {% if document %}
                <a class="lg2-print" href="#" onclick="window.print(); return false;">{{ icon.download(16) }} {{ 'Imprimer / enregistrer en PDF'|trans }}</a>
            {% endif %}
        </aside>
    </div>
</div>
{% endblock %}
