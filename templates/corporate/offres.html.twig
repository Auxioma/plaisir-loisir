{#
    « Nos offres d'emploi » (/carrieres/offres) — prolonge la maquette
    carrieres.jpeg : filtre par service, fiche d'une offre en modale
    (?offre=slug, sans JavaScript), « Postuler » vers le formulaire de contact
    pré-rempli (CV en pièce jointe).
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ detail ? detail.title : "Nos offres d'emploi"|trans }}{% endblock %}
{% block meta_description %}{{ 'Toutes les offres d’emploi de TrouveMoi Plaisirs & Loisirs.'|trans }}{% endblock %}

{% block body %}
<div class="pg">
    <section class="pg-wrap pg-section">
        <nav class="lg2-crumb" aria-label="{{ "Fil d'Ariane"|trans }}"><a href="{{ path('app_home') }}">{{ 'Accueil'|trans }}</a> / <a href="{{ path('app_corporate_careers') }}">{{ 'Carrières'|trans }}</a> / <span aria-current="page">{{ "Nos offres d'emploi"|trans }}</span></nav>
        <h1 class="pg-h2">{{ "Nos offres d'emploi"|trans }}</h1>
        <nav class="pg-filters" aria-label="{{ 'Services'|trans }}">
            <a class="pg-chip{{ dept == '' ? ' is-active' }}" href="{{ path('app_corporate_jobs') }}">{{ 'Toutes'|trans }}</a>
            {% for d in depts %}<a class="pg-chip{{ dept == d ? ' is-active' }}" href="{{ path('app_corporate_jobs', {service: d}) }}">{{ d|trans }}</a>{% endfor %}
        </nav>
        <p class="pg-muted">{{ jobs|length }} {{ jobs|length > 1 ? 'offres'|trans : 'offre'|trans }}</p>
        <div class="pg-jobs pg-jobs--all">
            {% for j in jobs %}{% include 'corporate/_partials/_job_card.html.twig' with { job: j } %}{% else %}<p>{{ 'Aucune offre dans ce service pour le moment.'|trans }}</p>{% endfor %}
        </div>
        <div class="pg-card pg-spont pg-spont--row">
            <h2>{{ 'Envoyez-nous votre candidature spontanée !'|trans }}</h2>
            <a class="pg-btn" href="{{ path('app_corporate_contact', {sujet: 'Candidature spontanée'}) }}">{{ 'Postuler spontanément'|trans }}</a>
        </div>
    </section>

    {% if detail %}
        <div class="pg-modal" role="dialog" aria-modal="true" aria-labelledby="pg-modal-title">
            <a class="pg-modal__veil" href="{{ path('app_corporate_jobs') }}" aria-label="{{ 'Fermer'|trans }}"></a>
            <article class="pg-modal__box">
                <a class="pg-modal__close" href="{{ path('app_corporate_jobs') }}" aria-label="{{ 'Fermer'|trans }}">{{ icon.x(16) }}</a>
                <h2 id="pg-modal-title">{{ detail.title }}</h2>
                <p class="pg-muted">{{ icon.map_pin(14) }} {{ detail.place }} · {{ detail.contract }} · {{ detail.time }}</p>
                <p>{{ detail.text }}</p>
                <p><strong>{{ 'Supérieur hiérarchique :'|trans }}</strong> {{ detail.manager }} — <strong>{{ 'Division :'|trans }}</strong> {{ detail.division }}</p>
                {% for block in [{t: 'Missions', items: detail.mission}, {t: 'Le poste', items: detail.description}, {t: 'Formation', items: detail.education}, {t: 'Expérience', items: detail.experience}] %}
                    <h3>{{ block.t|trans }}</h3>
                    <ul>{% for it in block.items %}<li>{{ it }}</li>{% endfor %}</ul>
                {% endfor %}
                <a class="pg-btn" href="{{ path('app_corporate_contact', {sujet: 'Candidature : ' ~ detail.title}) }}">{{ 'Postulez dès maintenant'|trans }} {{ icon.arrow_right(16) }}</a>
            </article>
        </div>
    {% endif %}
</div>
{% endblock %}
