{#
    « Paiement sécurisé » — maquette docs/maquettes/paiements_securises.jpeg (04/10).
    Styles : assets/styles/pages.css (.pg-*).
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}

{% block title %}{{ 'Paiement sécurisé'|trans }}{% endblock %}
{% block meta_description %}{{ 'Sur TrouveMoi Plaisirs & Loisirs, toutes les transactions sont 100% sécurisées.'|trans }}{% endblock %}

{% block body %}
<div class="pg">
    <header class="pg-hero">
        <div class="pg-hero__text">
            <h1>{{ 'Paiement sécurisé'|trans }}</h1>
            <p class="pg-hero__sub">{{ 'Votre sécurité est notre priorité'|trans }}</p>
            <p class="pg-hero__lead">{{ 'Sur TrouveMoi Plaisirs & Loisirs, toutes les transactions sont 100% sécurisées. Vos données bancaires sont protégées et ne sont jamais stockées sur nos serveurs.'|trans }}</p>
            <ul class="pg-hero__badges">
                <li>{{ icon.shield_check(28) }} {{ 'Transactions 100% sécurisées'|trans }}</li>
                <li>{{ icon.padlock(28) }} {{ 'Données bancaires cryptées'|trans }}</li>
                <li>{{ icon.check_badge(28) }} {{ 'Conforme aux normes bancaires les plus strictes'|trans }}</li>
            </ul>
        </div>
        <img class="pg-hero__img" src="{{ asset('images/corporate/payment-hero.jpg') }}" alt="">
        <aside class="pg-hero__float">
            <span class="pg-ico is-green">{{ icon.shield_check(22) }}</span>
            <div><strong>{{ 'Achetez en toute confiance'|trans }}</strong>{{ 'Profitez de vos activités et expériences en toute sérénité grâce à notre système de paiement sécurisé.'|trans }}</div>
        </aside>
    </header>

    <section class="pg-wrap pg-section">
        <h2 class="pg-h2 pg-h2--center">{{ 'Comment nous protégeons vos paiements'|trans }}</h2>
        <div class="pg-features">
            <article class="pg-card pg-feature"><span class="pg-ico">{{ icon.card_lock(24) }}</span><div><h3>{{ 'Cryptage SSL 256 bits'|trans }}</h3><p>{{ 'Toutes les données échangées entre votre navigateur et notre site sont cryptées avec la technologie SSL 256 bits.'|trans }}</p></div></article>
            <article class="pg-card pg-feature"><span class="pg-ico is-green">{{ icon.padlock(24) }}</span><div><h3>{{ 'Partenaires de confiance'|trans }}</h3><p>{{ 'Nous collaborons avec des prestataires de paiement reconnus et certifiés pour garantir la sécurité de vos transactions.'|trans }}</p></div></article>
            <article class="pg-card pg-feature"><span class="pg-ico is-orange">{{ icon.shield_check(24) }}</span><div><h3>{{ 'Conformité PCI DSS'|trans }}</h3><p>{{ 'Notre plateforme est conforme à la norme PCI DSS, la référence mondiale en matière de sécurité des données de paiement.'|trans }}</p></div></article>
            <article class="pg-card pg-feature"><span class="pg-ico">{{ icon.eye_off(24) }}</span><div><h3>{{ 'Aucune donnée stockée'|trans }}</h3><p>{{ 'Nous ne stockons jamais vos informations bancaires sur nos serveurs.'|trans }}</p></div></article>
        </div>
    </section>

    <section class="pg-wrap pg-pay">
        <div class="pg-card pg-pay__methods">
            <h2 class="pg-h2 pg-h2--center">{{ 'Moyens de paiement acceptés'|trans }}</h2>
            <div class="pg-pay__cols">
                <div>
                    <p>{{ icon.padlock(16) }} {{ 'Cartes bancaires'|trans }}</p>
                    <ul class="pg-logos">
                        <li>{{ icon.paycard_visa(64) }}</li>
                        <li>{{ icon.paycard_mastercard(64) }}</li>
                        <li class="pg-logo-cb">CB</li>
                        <li class="pg-logo-amex">AMEX</li>
                    </ul>
                </div>
                <div>
                    <p>{{ icon.padlock(16) }} {{ 'Paiements en ligne'|trans }}</p>
                    <ul class="pg-logos">
                        <li>{{ icon.paycard_paypal(80) }}</li>
                        <li>{{ icon.paycard_applepay(80) }}</li>
                    </ul>
                </div>
            </div>
        </div>
        <aside class="pg-card pg-help">
            <h2><span class="pg-ico">{{ icon.shield_check(22) }}</span>{{ 'Besoin d’aide ?'|trans }}</h2>
            <p>{{ 'Notre service client est à votre disposition pour toute question concernant le paiement de vos réservations.'|trans }}</p>
            <a class="pg-btn pg-btn--block" href="{{ path('app_corporate_contact', {sujet: 'Paiement'}) }}">{{ 'Nous contacter'|trans }} {{ icon.arrow_right(16) }}</a>
        </aside>
    </section>
</div>
{% endblock %}
