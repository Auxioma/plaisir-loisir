{#
    « Carrières » — maquette docs/maquettes/carrieres.jpeg (04/10).
    Données : CorporateController::careers() (StaticCorporate). Styles : pages.css (.pg-*).
    « Postuler » mène au formulaire de contact pré-rempli (CV en pièce jointe).
#}
{% extends 'base.html.twig' %}
{% import '_partials/_icons.html.twig' as icon %}
{% import 'provider/space/_ico.html.twig' as ico %}

{% block title %}{{ 'Carrières'|trans }}{% endblock %}
{% block meta_description %}{{ 'Rejoignez l’aventure TrouveMoi Plaisirs & Loisirs.'|trans }}{% endblock %}

{% block body %}
<div class="pg">
    <header class="pg-hero">
        <div class="pg-hero__text">
            <h1>{{ 'Carrières'|trans }}</h1>
            <p class="pg-hero__sub"><strong>{{ 'Rejoignez l’aventure TrouveMoi Plaisirs & Loisirs'|trans }}</strong></p>
            <p class="pg-hero__lead">{{ 'Nous construisons chaque jour la meilleure plateforme pour inspirer les loisirs et créer des expériences inoubliables. Et si vous faisiez partie de l’histoire ?'|trans }}</p>
            <div class="pg-hero__actions">
                <a class="pg-btn" href="{{ path('app_corporate_jobs') }}">{{ 'Voir nos offres d’emploi'|trans }}</a>
                <a class="pg-btn pg-btn--outline" href="#culture">{{ 'Notre culture'|trans }}</a>
            </div>
            <ul class="pg-hero__checks pg-mt"><li>{{ icon.users(20) }} {{ 'Rejoignez une équipe passionnée et bienveillante'|trans }}</li></ul>
        </div>
        <img class="pg-hero__img" src="{{ asset('images/corporate/careers-hero.jpg') }}" alt="">
        {% include 'corporate/_partials/_hero_stats.html.twig' with { items: [
            ['users', 'blue', '+2,5 millions', 'd’utilisateurs conquis'],
            ['trend', 'green', '+10 000', 'activités disponibles'],
            ['pin', 'orange', '+350', 'destinations en France'],
            ['star', 'yellow', '4,8/5', 'note moyenne des utilisateurs'],
        ] } %}
    </header>

    <section class="pg-wrap pg-section" id="culture">
        <h2 class="pg-title">{{ 'Nos valeurs au cœur de notre quotidien'|trans }}</h2>
        <div class="pg-values pg-values--6">
            {% for v in values %}
                <article class="pg-card pg-value">
                    <h3><span class="pg-ico is-{{ ['red', 'green', 'orange', 'blue', 'red', 'blue'][loop.index0] }}">{{ ico.svg(v.icon, 22) }}</span>{{ v.title|trans }}</h3>
                    <p>{{ v.text|trans }}</p>
                </article>
            {% endfor %}
        </div>
    </section>

    <section class="pg-wrap pg-careers">
        <div>
            <div class="pg-rowhead"><h2 class="pg-h3">{{ 'Nos offres d’emploi'|trans }}</h2><a class="pg-link" href="{{ path('app_corporate_jobs') }}">{{ 'Voir toutes nos offres'|trans }} {{ icon.arrow_right(14) }}</a></div>
            <div class="pg-jobs">
                {% for j in jobs %}{% include 'corporate/_partials/_job_card.html.twig' with { job: j } %}{% endfor %}
            </div>
        </div>
        <aside class="pg-card pg-quotes" data-pg-carousel>
            <h2 class="pg-h3">{{ 'Ils parlent de leur aventure chez TrouveMoi'|trans }}</h2>
            <div class="pg-quotes__track" data-pg-track>
                {% for t in testimonials %}
                    <figure class="pg-quote">
                        <blockquote>« {{ t.quote|trans }} »</blockquote>
                        <figcaption><img src="{{ asset(t.photo) }}" alt=""><span><strong>{{ t.author }}</strong><small>{{ t.role|trans }}</small></span></figcaption>
                    </figure>
                {% endfor %}
            </div>
            <div class="pg-quotes__nav"><button type="button" data-pg-dir="-1" aria-label="{{ 'Précédent'|trans }}">{{ icon.chevron_left(16) }}</button><button type="button" data-pg-dir="1" aria-label="{{ 'Suivant'|trans }}">{{ icon.chevron_right(16) }}</button></div>
        </aside>
        <aside class="pg-card pg-spont">
            <img src="{{ asset('images/corporate/careers-candidature.png') }}" alt="">
            <h2>{{ 'Envoyez-nous votre candidature spontanée !'|trans }}</h2>
            <p>{{ 'Vous ne trouvez pas l’offre qui vous correspond ?'|trans }}</p>
            <a class="pg-btn" href="{{ path('app_corporate_contact', {sujet: 'Candidature spontanée'}) }}">{{ 'Postuler spontanément'|trans }}</a>
        </aside>
    </section>

    <ul class="pg-wrap pg-band pg-band--5">
        {% for r in reasons %}
            <li><span class="pg-ico is-{{ r.tone }}">{{ ico.svg(r.icon, 22) }}</span><span><strong>{{ r.title|trans }}</strong><small>{{ r.text|trans }}</small></span></li>
        {% endfor %}
    </ul>
</div>
{% endblock %}
